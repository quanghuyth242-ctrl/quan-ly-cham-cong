<%- include("../partials/adminHead", {
    pageTitle: "Quản lý nhân sự",
    activePage: "employees",
    user: user
}) %>

<section class="flex flex-col gap-space-xl">
    <%- include("../partials/alerts", { success: success, error: error }) %>

    <section class="flex flex-col lg:flex-row lg:items-center justify-between gap-space-lg bg-surface-container-lowest p-space-xl rounded-xl shadow-sm">
        <div class="flex flex-col gap-space-xs">
            <div class="flex items-center gap-space-sm text-on-surface-variant font-label-sm text-label-sm">
                <span class="flex h-2 w-2 rounded-full bg-primary-container"></span>
                <span class="uppercase tracking-wider">Hồ sơ nhân viên</span>
            </div>
            <h2 class="font-headline-lg text-headline-lg text-primary tracking-tight">Quản lý nhân sự</h2>
            <p class="font-body-md text-body-md text-on-surface-variant">
                Tra cứu thông tin nhân viên và phân bố nhân sự theo phòng ban.
            </p>
        </div>
        <div class="flex flex-col sm:flex-row gap-space-sm">
            <button
                id="open-create-employee"
                class="flex items-center justify-center gap-space-xs px-space-lg py-space-sm bg-primary hover:bg-primary-container text-on-primary rounded-xl font-label-md text-label-md shadow-md transition-colors"
                type="button"
            >
                <span class="material-symbols-outlined text-[20px]">person_add</span>
                <span>Thêm nhân viên</span>
            </button>
            <a
                href="/admin/shift-assignments"
                class="flex items-center justify-center gap-space-xs px-space-lg py-space-sm bg-primary hover:bg-primary-container text-on-primary rounded-xl font-label-md text-label-md shadow-md transition-colors"
            >
                <span class="material-symbols-outlined text-[20px]">assignment_ind</span>
                <span>Phân ca nhân viên</span>
            </a>
            <button
                id="export-employees"
                class="flex items-center justify-center gap-space-xs px-space-lg py-space-sm bg-surface-container-low hover:bg-surface-container-high text-on-surface-variant rounded-xl font-label-md text-label-md transition-colors disabled:opacity-50 disabled:cursor-not-allowed"
                type="button"
                onclick="exportEmployeesCSV()"
                <%= employees.length === 0 ? "disabled" : "" %>
            >
                <span class="material-symbols-outlined text-[20px]">download</span>
                <span>Xuất CSV</span>
            </button>
        </div>
    </section>

    <section class="grid grid-cols-1 sm:grid-cols-3 gap-space-lg" aria-label="Thống kê nhân sự">
        <article class="bg-surface-container-lowest p-space-lg rounded-xl shadow-sm flex items-center justify-between">
            <div class="flex flex-col">
                <span class="font-label-sm text-label-sm text-on-surface-variant uppercase tracking-wider">Tổng nhân viên</span>
                <span class="font-headline-xl text-headline-xl text-primary font-bold mt-space-xs"><%= stats.total %></span>
            </div>
            <div class="w-11 h-11 rounded-xl bg-primary-fixed text-primary flex items-center justify-center">
                <span class="material-symbols-outlined text-[24px]">groups</span>
            </div>
        </article>
        <article class="bg-surface-container-lowest p-space-lg rounded-xl shadow-sm flex items-center justify-between">
            <div class="flex flex-col">
                <span class="font-label-sm text-label-sm text-on-surface-variant uppercase tracking-wider">Phòng ban</span>
                <span class="font-headline-xl text-headline-xl text-secondary font-bold mt-space-xs"><%= stats.departments %></span>
            </div>
            <div class="w-11 h-11 rounded-xl bg-secondary-fixed text-secondary flex items-center justify-center">
                <span class="material-symbols-outlined text-[24px]">domain</span>
            </div>
        </article>
        <article class="bg-surface-container-lowest p-space-lg rounded-xl shadow-sm flex items-center justify-between">
            <div class="flex flex-col">
                <span class="font-label-sm text-label-sm text-on-surface-variant uppercase tracking-wider">Chưa phân phòng ban</span>
                <span class="font-headline-xl text-headline-xl text-orange-600 font-bold mt-space-xs"><%= stats.unassignedDepartment %></span>
            </div>
            <div class="w-11 h-11 rounded-xl bg-orange-50 text-orange-600 flex items-center justify-center">
                <span class="material-symbols-outlined text-[24px]">person_search</span>
            </div>
        </article>
    </section>

    <section class="bg-surface-container-lowest rounded-xl shadow-sm overflow-hidden">
        <div class="p-space-lg md:p-space-xl border-b border-surface-container-high">
            <form method="GET" action="/admin/employees" class="flex flex-col lg:flex-row lg:items-end justify-between gap-space-md">
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-space-md flex-1">
                    <label class="flex flex-col gap-space-xs">
                        <span class="font-label-sm text-label-sm text-on-surface-variant">Tìm nhân viên</span>
                        <span class="relative">
                            <span class="material-symbols-outlined absolute left-space-md top-1/2 -translate-y-1/2 text-on-surface-variant text-[20px] pointer-events-none">search</span>
                            <input
                                name="search"
                                value="<%= filters.search %>"
                                type="search"
                                maxlength="100"
                                placeholder="Tên, mã, email hoặc số điện thoại..."
                                class="w-full bg-surface-container-low text-on-surface font-body-md text-body-md pl-11 pr-space-md py-space-md rounded-xl outline-none focus:ring-2 focus:ring-primary-container transition-shadow"
                            >
                        </span>
                    </label>
                    <label class="flex flex-col gap-space-xs">
                        <span class="font-label-sm text-label-sm text-on-surface-variant">Phòng ban</span>
                        <select
                            name="department"
                            class="w-full bg-surface-container-low text-on-surface font-body-md text-body-md px-space-md py-space-md rounded-xl outline-none focus:ring-2 focus:ring-primary-container"
                        >
                            <option value="">Tất cả phòng ban</option>
                            <% departments.forEach((department) => { %>
                                <option value="<%= department %>" <%= filters.department === department ? "selected" : "" %>><%= department %></option>
                            <% }); %>
                        </select>
                    </label>
                </div>
                <div class="flex flex-col sm:flex-row gap-space-sm">
                    <button
                        type="submit"
                        class="flex items-center justify-center gap-space-xs px-space-lg py-space-md bg-primary hover:bg-primary-container text-on-primary rounded-xl font-label-md text-label-md transition-colors"
                    >
                        <span class="material-symbols-outlined text-[18px]">filter_alt</span>
                        <span>Lọc danh sách</span>
                    </button>
                    <a
                        href="/admin/employees"
                        class="flex items-center justify-center gap-space-xs px-space-lg py-space-md bg-surface-container-low hover:bg-surface-container-high text-on-surface-variant rounded-xl font-label-md text-label-md transition-colors"
                    >
                        <span class="material-symbols-outlined text-[18px]">restart_alt</span>
                        <span>Xóa bộ lọc</span>
                    </a>
                </div>
            </form>
        </div>

        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-space-sm p-space-lg md:px-space-xl border-b border-surface-container-low">
            <div>
                <h3 class="font-headline-sm text-headline-sm text-on-surface">Danh sách nhân viên</h3>
                <p class="font-body-sm text-body-sm text-on-surface-variant mt-space-xs">Thông tin liên hệ và phòng ban của nhân sự.</p>
            </div>
            <span class="font-body-sm text-body-sm text-on-surface-variant" aria-live="polite">
                Hiển thị <strong class="text-on-surface"><%= employees.length %></strong> / <%= stats.total %> nhân viên
            </span>
        </div>

        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse min-w-[980px]">
                <caption class="sr-only">Danh sách nhân sự</caption>
                <thead>
                    <tr class="bg-surface-container-low text-on-surface-variant font-label-sm text-label-sm uppercase tracking-wider">
                        <th class="py-space-md px-space-lg font-semibold">Mã nhân viên</th>
                        <th class="py-space-md px-space-md font-semibold">Họ và tên</th>
                        <th class="py-space-md px-space-md font-semibold">Phòng ban</th>
                        <th class="py-space-md px-space-md font-semibold">Thông tin liên hệ</th>
                        <th class="py-space-md px-space-md font-semibold">Ngày tạo hồ sơ</th>
                        <th class="py-space-md px-space-lg font-semibold text-right">Thao tác</th>
                    </tr>
                </thead>
                <tbody id="employees-table-body" class="divide-y divide-surface-container-low text-body-sm text-on-surface">
                    <% if (employees.length === 0) { %>
                        <tr>
                            <td colspan="6" class="py-space-2xl px-space-lg text-center">
                                <div class="flex flex-col items-center gap-space-sm text-on-surface-variant">
                                    <span class="material-symbols-outlined text-[40px] text-outline">group_off</span>
                                    <span class="font-label-md text-label-md">Không tìm thấy nhân viên phù hợp</span>
                                    <span class="font-body-sm text-body-sm">Thử thay đổi từ khóa hoặc phòng ban đang chọn.</span>
                                </div>
                            </td>
                        </tr>
                    <% } else { %>
                        <% employees.forEach((employee) => { %>
                            <tr
                                class="employee-row align-middle hover:bg-surface-container-low/70 transition-colors"
                                data-code="<%= employee.employee_code %>"
                                data-name="<%= employee.full_name %>"
                                data-department="<%= employee.department || '' %>"
                                data-email="<%= employee.email || '' %>"
                                data-phone="<%= employee.phone || '' %>"
                                data-created-date="<%= employee.created_date || '' %>"
                            >
                                <td class="py-space-md px-space-lg">
                                    <span class="inline-flex px-space-sm py-1 rounded-lg bg-primary-fixed text-primary font-data-mono text-data-mono font-semibold"><%= employee.employee_code %></span>
                                </td>
                                <td class="py-space-md px-space-md">
                                    <div class="flex items-center gap-space-sm">
                                        <div class="w-9 h-9 rounded-full bg-primary-fixed text-primary font-semibold flex items-center justify-center text-xs shrink-0">
                                            <%= String(employee.full_name || "?").trim().slice(0, 2).toUpperCase() %>
                                        </div>
                                        <span class="font-label-md text-label-md text-on-surface font-semibold"><%= employee.full_name %></span>
                                    </div>
                                </td>
                                <td class="py-space-md px-space-md">
                                    <% if (employee.department) { %>
                                        <span class="inline-flex px-space-sm py-1 rounded-full bg-secondary-fixed text-on-secondary-fixed font-label-sm text-label-sm"><%= employee.department %></span>
                                    <% } else { %>
                                        <span class="text-outline">Chưa phân phòng ban</span>
                                    <% } %>
                                </td>
                                <td class="py-space-md px-space-md">
                                    <div class="flex flex-col gap-1">
                                        <% if (employee.email) { %>
                                            <a class="text-primary hover:underline" href="mailto:<%= employee.email %>"><%= employee.email %></a>
                                        <% } else { %>
                                            <span class="text-outline">Chưa cập nhật email</span>
                                        <% } %>
                                        <% if (employee.phone) { %>
                                            <a class="font-data-mono text-data-mono text-on-surface-variant hover:text-primary" href="tel:<%= employee.phone %>"><%= employee.phone %></a>
                                        <% } else { %>
                                            <span class="text-outline">Chưa cập nhật số điện thoại</span>
                                        <% } %>
                                    </div>
                                </td>
                                <td class="py-space-md px-space-md font-data-mono text-data-mono"><%= employee.created_date || "—" %></td>
                                <td class="py-space-md px-space-lg">
                                    <div class="flex justify-end gap-space-xs">
                                        <button
                                            class="inline-flex items-center gap-1 px-space-sm py-1 bg-surface-container-high hover:bg-surface-variant text-on-surface font-label-sm text-label-sm rounded-lg transition-colors"
                                            data-edit-employee
                                            data-id="<%= employee.id %>"
                                            data-code="<%= employee.employee_code %>"
                                            data-name="<%= employee.full_name %>"
                                            data-email="<%= employee.email || '' %>"
                                            data-phone="<%= employee.phone || '' %>"
                                            data-department="<%= employee.department || '' %>"
                                            type="button"
                                            title="Cập nhật thông tin nhân viên"
                                        >
                                            <span class="material-symbols-outlined text-[16px]">edit</span>
                                            <span>Cập nhật</span>
                                        </button>
                                        <a
                                            class="inline-flex items-center gap-1 px-space-sm py-1 bg-surface-container-high hover:bg-surface-variant text-on-surface font-label-sm text-label-sm rounded-lg transition-colors"
                                            href="/admin/shift-assignments?search=<%= encodeURIComponent(employee.employee_code) %>"
                                            title="Mở phân ca cho nhân viên này"
                                        >
                                            <span class="material-symbols-outlined text-[16px]">event_repeat</span>
                                            <span>Phân ca</span>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        <% }); %>
                    <% } %>
                </tbody>
            </table>
        </div>
    </section>
</section>

<div
    id="employee-modal"
    class="fixed inset-0 z-50 <%= employeeModalOpen ? '' : 'hidden' %>"
    data-available-codes="<%= JSON.stringify(availableEmployeeCodes) %>"
>
    <div class="absolute inset-0 bg-black/40" data-close-employee-modal></div>
    <div class="relative min-h-full flex items-center justify-center p-space-lg">
        <section
            class="w-full max-w-xl bg-surface-container-lowest rounded-xl shadow-[0_16px_48px_rgba(0,0,0,0.18)] overflow-hidden"
            role="dialog"
            aria-modal="true"
            aria-labelledby="employee-modal-title"
        >
            <div class="flex items-center justify-between px-space-xl py-space-lg border-b border-surface-container-high">
                <div>
                    <h3 id="employee-modal-title" class="font-headline-md text-headline-md text-primary font-semibold"><%= formMode === "edit" ? "Cập nhật nhân viên" : "Thêm nhân viên" %></h3>
                    <p id="employee-modal-description" class="font-body-sm text-body-sm text-on-surface-variant mt-space-xs"><%= formMode === "edit" ? "Cập nhật thông tin liên hệ và phòng ban." : "Nhập thông tin hồ sơ nhân viên mới." %></p>
                </div>
                <button class="p-space-sm rounded-xl text-on-surface-variant hover:bg-surface-container-high transition-colors" data-close-employee-modal type="button" aria-label="Đóng">
                    <span class="material-symbols-outlined">close</span>
                </button>
            </div>

            <form
                id="employee-form"
                data-mode="<%= formMode %>"
                action="<%= formMode === 'edit' && formEmployeeId ? `/admin/employees/${formEmployeeId}/update` : '/admin/employees' %>"
                method="POST"
                class="p-space-xl flex flex-col gap-space-lg"
            >
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-space-lg">
                    <label class="flex flex-col gap-space-xs">
                        <span class="font-label-sm text-label-sm text-on-surface">Mã nhân viên tự động</span>
                        <input
                            id="employee-code"
                            name="employee_code"
                            value="<%= formValues.employee_code || '' %>"
                            type="text"
                            maxlength="50"
                            readonly
                            required
                            aria-live="polite"
                            placeholder="Nhập họ tên để tự chọn mã"
                            class="w-full bg-surface-container-low text-on-surface-variant font-data-mono text-data-mono px-space-md py-space-sm rounded-xl outline-none"
                        >
                        <span id="employee-code-help" class="font-body-sm text-body-sm text-on-surface-variant"><%= formMode === "edit" ? "Mã nhân viên được giữ cố định để bảo toàn dữ liệu chấm công." : "Mã sẽ được tự động chọn từ danh sách mã chưa sử dụng." %></span>
                    </label>
                    <label class="flex flex-col gap-space-xs">
                        <span class="font-label-sm text-label-sm text-on-surface">Họ và tên <span class="text-error">*</span></span>
                        <input
                            name="full_name"
                            value="<%= formValues.full_name || '' %>"
                            type="text"
                            maxlength="150"
                            autocomplete="name"
                            required
                            class="w-full bg-surface-container-low text-on-surface font-body-md text-body-md px-space-md py-space-sm rounded-xl outline-none focus:ring-2 focus:ring-primary-container"
                        >
                    </label>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-space-lg">
                    <label class="flex flex-col gap-space-xs">
                        <span class="font-label-sm text-label-sm text-on-surface">Email</span>
                        <input
                            name="email"
                            value="<%= formValues.email || '' %>"
                            type="email"
                            maxlength="150"
                            autocomplete="email"
                            class="w-full bg-surface-container-low text-on-surface font-body-md text-body-md px-space-md py-space-sm rounded-xl outline-none focus:ring-2 focus:ring-primary-container"
                        >
                    </label>
                    <label class="flex flex-col gap-space-xs">
                        <span class="font-label-sm text-label-sm text-on-surface">Số điện thoại</span>
                        <input
                            name="phone"
                            value="<%= formValues.phone || '' %>"
                            type="tel"
                            maxlength="20"
                            autocomplete="tel"
                            class="w-full bg-surface-container-low text-on-surface font-body-md text-body-md px-space-md py-space-sm rounded-xl outline-none focus:ring-2 focus:ring-primary-container"
                        >
                    </label>
                </div>

                <label class="flex flex-col gap-space-xs">
                    <span class="font-label-sm text-label-sm text-on-surface">Phòng ban</span>
                    <input
                        name="department"
                        value="<%= formValues.department || '' %>"
                        type="text"
                        maxlength="100"
                        list="employee-departments"
                        autocomplete="organization-title"
                        placeholder="Chọn hoặc nhập phòng ban mới"
                        class="w-full bg-surface-container-low text-on-surface font-body-md text-body-md px-space-md py-space-sm rounded-xl outline-none focus:ring-2 focus:ring-primary-container"
                    >
                    <datalist id="employee-departments">
                        <% departments.forEach((department) => { %>
                            <option value="<%= department %>"></option>
                        <% }); %>
                    </datalist>
                </label>

                <div class="flex items-center justify-end gap-space-sm pt-space-md border-t border-surface-container-high">
                    <button class="px-space-lg py-space-sm bg-surface-container-high hover:bg-surface-variant text-on-surface font-label-md text-label-md rounded-xl transition-colors" data-close-employee-modal type="button">
                        Hủy
                    </button>
                    <button class="flex items-center gap-space-xs px-space-lg py-space-sm bg-primary hover:bg-primary-container text-on-primary font-label-md text-label-md rounded-xl shadow-md transition-colors" type="submit">
                        <span id="employee-submit-icon" class="material-symbols-outlined text-[18px]"><%= formMode === "edit" ? "save" : "person_add" %></span>
                        <span id="employee-submit-label"><%= formMode === "edit" ? "Lưu thay đổi" : "Lưu nhân viên" %></span>
                    </button>
                </div>
            </form>
        </section>
    </div>
</div>

<script>
document.addEventListener("DOMContentLoaded", () => {
    const modal = document.getElementById("employee-modal");
    const openButton = document.getElementById("open-create-employee");
    const form = document.getElementById("employee-form");
    const modalTitle = document.getElementById("employee-modal-title");
    const modalDescription = document.getElementById("employee-modal-description");
    const submitIcon = document.getElementById("employee-submit-icon");
    const submitLabel = document.getElementById("employee-submit-label");
    const fullNameField = modal.querySelector('[name="full_name"]');
    const employeeCodeField = document.getElementById("employee-code");
    const employeeCodeHelp = document.getElementById("employee-code-help");
    const availableCodes = JSON.parse(modal.dataset.availableCodes || "[]");

    const assignEmployeeCode = () => {
        if (form.dataset.mode === "edit") return;

        if (!fullNameField.value.trim()) {
            employeeCodeField.value = "";
            employeeCodeHelp.textContent = "Nhập họ tên để tự chọn mã nhân viên còn trống.";
            return;
        }

        if (!availableCodes.includes(employeeCodeField.value)) {
            employeeCodeField.value = availableCodes[0] || "";
        }
        employeeCodeHelp.textContent = employeeCodeField.value
            ? "Mã chưa sử dụng đã được tự động chọn."
            : "Không còn mã nhân viên trống. Vui lòng liên hệ quản trị hệ thống.";
    };

    const openModal = () => {
        modal.classList.remove("hidden");
        document.body.classList.add("shift-modal-open");
        fullNameField.focus();
    };
    const openCreateModal = () => {
        form.reset();
        form.action = "/admin/employees";
        form.dataset.mode = "create";
        modalTitle.textContent = "Thêm nhân viên";
        modalDescription.textContent = "Nhập thông tin hồ sơ nhân viên mới.";
        submitIcon.textContent = "person_add";
        submitLabel.textContent = "Lưu nhân viên";
        employeeCodeField.value = "";
        fullNameField.value = "";
        form.elements.email.value = "";
        form.elements.phone.value = "";
        form.elements.department.value = "";
        employeeCodeHelp.textContent = "Mã sẽ được tự động chọn từ danh sách mã chưa sử dụng.";
        openModal();
    };
    const openEditModal = (button) => {
        form.action = `/admin/employees/${button.dataset.id}/update`;
        form.dataset.mode = "edit";
        modalTitle.textContent = "Cập nhật nhân viên";
        modalDescription.textContent = "Cập nhật thông tin liên hệ và phòng ban.";
        submitIcon.textContent = "save";
        submitLabel.textContent = "Lưu thay đổi";
        employeeCodeField.value = button.dataset.code;
        fullNameField.value = button.dataset.name;
        form.elements.email.value = button.dataset.email;
        form.elements.phone.value = button.dataset.phone;
        form.elements.department.value = button.dataset.department;
        employeeCodeHelp.textContent = "Mã nhân viên được giữ cố định để bảo toàn dữ liệu chấm công.";
        openModal();
    };
    const closeModal = () => {
        modal.classList.add("hidden");
        document.body.classList.remove("shift-modal-open");
    };

    fullNameField.addEventListener("input", assignEmployeeCode);
    openButton.addEventListener("click", openCreateModal);
    document.getElementById("employees-table-body").addEventListener("click", (event) => {
        const button = event.target.closest("[data-edit-employee]");
        if (button) openEditModal(button);
    });
    modal.querySelectorAll("[data-close-employee-modal]").forEach((button) => {
        button.addEventListener("click", closeModal);
    });
    document.addEventListener("keydown", (event) => {
        if (event.key === "Escape" && !modal.classList.contains("hidden")) {
            closeModal();
        }
    });

    if (!modal.classList.contains("hidden")) {
        assignEmployeeCode();
        fullNameField.focus();
    }
});

function exportEmployeesCSV() {
    const rows = [...document.querySelectorAll(".employee-row")];
    if (rows.length === 0) return;

    const data = [
        ["Mã nhân viên", "Họ và tên", "Phòng ban", "Email", "Số điện thoại", "Ngày tạo hồ sơ"],
        ...rows.map((row) => [
            row.dataset.code,
            row.dataset.name,
            row.dataset.department,
            row.dataset.email,
            row.dataset.phone,
            row.dataset.createdDate
        ])
    ];
    const csv = "\uFEFF" + data.map((row) =>
        row.map((value) => `"${value.replace(/"/g, '""')}"`).join(",")
    ).join("\n");
    const blob = new Blob([csv], { type: "text/csv;charset=utf-8;" });
    const url = URL.createObjectURL(blob);
    const link = document.createElement("a");

    link.href = url;
    link.download = "danh-sach-nhan-su.csv";
    link.click();
    window.setTimeout(() => URL.revokeObjectURL(url), 0);
}
</script>

