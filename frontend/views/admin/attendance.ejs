            elements.manualActionCheckin.classList.toggle("bg-primary", isCheckIn);
            elements.manualActionCheckin.classList.toggle("text-on-primary", isCheckIn);
            elements.manualActionCheckin.classList.toggle("bg-surface-container-high", !isCheckIn);
            elements.manualActionCheckin.classList.toggle("text-on-surface-variant", !isCheckIn);
            elements.manualActionCheckin.classList.toggle("hover:bg-surface-container", !isCheckIn);

            elements.manualActionCheckout.classList.toggle("bg-primary", !isCheckIn);
            elements.manualActionCheckout.classList.toggle("text-on-primary", !isCheckIn);
            elements.manualActionCheckout.classList.toggle("bg-surface-container-high", isCheckIn);
            elements.manualActionCheckout.classList.toggle("text-on-surface-variant", isCheckIn);
            elements.manualActionCheckout.classList.toggle("hover:bg-surface-container", isCheckIn);
        };

        const openManualModal = (employee, defaultAction) => {
            if (!employee) return;

            manualState.open = true;
            manualState.employee = employee;
            manualState.submitting = false;

            setText(elements.manualEmployeeName, employee.full_name);
            setText(elements.manualEmployeeCode, employee.employee_code);
            elements.manualReason.value = "";

            elements.manualError.classList.add("hidden");
            elements.manualSubmitBtn.disabled = false;
            elements.manualSubmitBtn.innerHTML = `
                <span class="material-symbols-outlined text-[18px]">check</span>
                <span>X├íc nhß║¡n chß║Ñm c├┤ng</span>
            `;

            setManualAction(defaultAction || "check_in");
            openModal(elements.manualModal);
            elements.manualReason.focus();
        };

        const submitManualAttendance = async () => {
            if (!manualState.employee || manualState.submitting) return;

            const reason = elements.manualReason.value.trim();

            if (reason.length < 5 || reason.length > 255) {
                elements.manualErrorMessage.textContent = "Vui l├▓ng nhß║¡p l├╜ do chß║Ñm c├┤ng thß╗º c├┤ng (tß╗½ 5 ─æß║┐n 255 k├╜ tß╗▒).";
                elements.manualError.classList.remove("hidden");
                elements.manualReason.focus();
                return;
            }

            manualState.submitting = true;
            elements.manualError.classList.add("hidden");
            elements.manualSubmitBtn.disabled = true;
            elements.manualSubmitBtn.innerHTML = `
                <span class="material-symbols-outlined text-[18px] animate-spin">progress_activity</span>
                <span>─Éang xß╗¡ l├╜...</span>
            `;

            try {
                const response = await fetch(`${API_BASE}/manual`, {
                    method: "POST",
                    headers: {
                        "Content-Type": "application/json",
                        Accept: "application/json"
                    },
                    body: JSON.stringify({
                        employee_id: manualState.employee.id,
                        action: manualState.action,
                        reason
                    })
                });

                let payload = {};

                try {
                    payload = await response.json();
                } catch {
                    payload = {};
                }

                if (!response.ok || !payload.success) {
                    throw new Error(payload.message || "Kh├┤ng thß╗â chß║Ñm c├┤ng thß╗º c├┤ng.");
                }

                manualState.submitting = false;
                state.lastFocused = null;
                closeModal(elements.manualModal, false);
                elements.refreshBtn.focus();
                showToast("success", payload.message || "Chß║Ñm c├┤ng thß╗º c├┤ng th├ánh c├┤ng.");
                await loadData();
            } catch (error) {
                manualState.submitting = false;
                elements.manualSubmitBtn.disabled = false;
                elements.manualSubmitBtn.innerHTML = `
                    <span class="material-symbols-outlined text-[18px]">check</span>
                    <span>X├íc nhß║¡n chß║Ñm c├┤ng</span>
                `;
                elements.manualErrorMessage.textContent = error.message;
                elements.manualError.classList.remove("hidden");
                showToast("error", error.message);
            }
        };

        // ---- Sß╗▒ kiß╗çn ----

        let searchTimer = null;

        elements.refreshBtn.addEventListener("click", loadData);

        elements.applyFilterBtn.addEventListener("click", () => {
            window.clearTimeout(searchTimer);
            state.search = elements.searchInput.value.trim();
            state.department = elements.departmentSelect.value;
            state.status = elements.statusSelect.value;
            state.date = elements.dateInput.value || getTodayString();
            loadData();
        });

        elements.resetFilterBtn.addEventListener("click", resetFilters);

        elements.searchInput.addEventListener("input", () => {
            window.clearTimeout(searchTimer);
            searchTimer = window.setTimeout(() => {
                state.search = elements.searchInput.value.trim();
                loadData();
            }, 350);
        });

        elements.searchInput.addEventListener("keydown", (event) => {
            if (event.key !== "Enter") return;

            event.preventDefault();
            window.clearTimeout(searchTimer);
            state.search = elements.searchInput.value.trim();
            state.department = elements.departmentSelect.value;
            state.status = elements.statusSelect.value;
            state.date = elements.dateInput.value || getTodayString();
            loadData();
        });

        elements.dateInput.addEventListener("change", () => {
            state.date = elements.dateInput.value || getTodayString();
            loadData();
        });

        elements.departmentSelect.addEventListener("change", () => {
            state.department = elements.departmentSelect.value;
            loadData();
        });

        elements.statusSelect.addEventListener("change", () => {
            state.status = elements.statusSelect.value;
            loadData();
        });

        elements.tableBody.addEventListener("click", (event) => {
            const manualButton = event.target.closest("[data-manual-id]");

            if (manualButton) {
                openManualModal({
                    id: manualButton.getAttribute("data-manual-id"),
                    full_name: manualButton.getAttribute("data-employee-name"),
                    employee_code: manualButton.getAttribute("data-employee-code")
                }, manualButton.getAttribute("data-manual-action") || "check_in");
                return;
            }

            if (event.target.closest("[data-reset-filter]")) {
                resetFilters();
                return;
            }

            if (event.target.closest("[data-retry]")) {
                loadData();
            }
        });

        // Modal chß║Ñm c├┤ng khu├┤n mß║╖t
        elements.faceCheckinBtn.addEventListener("click", openFaceModal);

        elements.faceActionCheckin.addEventListener("click", () => setFaceAction("check_in"));
        elements.faceActionCheckout.addEventListener("click", () => setFaceAction("check_out"));

        elements.faceStartBtn.addEventListener("click", () => {
            startFaceCamera();
        });

        elements.faceCaptureBtn.addEventListener("click", captureFaceAndAttend);

        elements.faceRetryBtn.addEventListener("click", () => {
            startFaceCamera();
        });

        document.querySelectorAll('[data-close-modal="face"]').forEach((element) => {
            element.addEventListener("click", closeFaceModal);
        });

        // Modal chß║Ñm c├┤ng thß╗º c├┤ng
        elements.manualActionCheckin.addEventListener("click", () => setManualAction("check_in"));
        elements.manualActionCheckout.addEventListener("click", () => setManualAction("check_out"));

        elements.manualSubmitBtn.addEventListener("click", submitManualAttendance);

        document.querySelectorAll('[data-close-modal="manual"]').forEach((element) => {
            element.addEventListener("click", closeManualModal);
        });

        // ESC
        document.addEventListener("keydown", (event) => {
            if (event.key !== "Escape") return;

            if (!elements.manualModal.classList.contains("hidden")) {
                closeManualModal();
                return;
            }

            if (!elements.faceModal.classList.contains("hidden")) {
                closeFaceModal();
            }
        });

        // Khß╗ƒi tß║ío
        state.date = getTodayString();
        elements.dateInput.value = state.date;
        renderSkeleton();
        loadData();
    })();
</script>

<%- include("../partials/adminFoot") %>