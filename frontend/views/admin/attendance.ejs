            setLoading(true);

            try {
                const params = new URLSearchParams();

                if (state.date) {
                    params.set("date", state.date);
                }

                if (state.search) {
                    params.set("search", state.search);
                }

                if (state.department) {
                    params.set("department", state.department);
                }

                if (state.status && state.status !== "all") {
                    params.set("status", state.status);
                }

                const query = params.toString();
                const response = await fetch(`${API_BASE}/data${query ? `?${query}` : ""}`, {
                    headers: {
                        Accept: "application/json"
                    }
                });

                let payload = {};

                try {
                    payload = await response.json();
                } catch {
                    payload = {};
                }

                if (requestId !== state.requestId) return;

                if (!response.ok || !payload.success) {
                    throw new Error(payload.message || "Kh├┤ng thß╗â lß║Ñy bß║úng chß║Ñm c├┤ng.");
                }

                state.employees = Array.isArray(payload.employees) ? payload.employees : [];
                state.date = payload.date || state.date;
                state.stats = {
