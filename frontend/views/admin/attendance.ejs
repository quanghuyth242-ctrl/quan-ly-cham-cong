<%- include("../partials/adminHead", { pageTitle: pageTitle || "Bảng chấm công", activePage: activePage || "attendance", user: user }) %>

<style>
    .att-modal-open {
        overflow: hidden;
    }

    @keyframes att-toast-in {
        from {
            opacity: 0;
            transform: translateY(-8px) scale(0.98);
        }
        to {
            opacity: 1;
            transform: translateY(0) scale(1);
        }
    }

    .att-toast-in {
        animation: att-toast-in 0.2s ease-out;
    }

    @keyframes att-modal-in {
        from {
            opacity: 0;
            transform: translateY(8px) scale(0.98);
        }
        to {
            opacity: 1;
            transform: translateY(0) scale(1);
        }
    }

    .att-modal-in {
        animation: att-modal-in 0.18s ease-out;
    }

    @keyframes att-scan {
        0% {
            top: 0;
            opacity: 0;
        }
        12% {
            opacity: 1;
        }
        88% {
            opacity: 1;
        }
        100% {
            top: 100%;
            opacity: 0;
        }
    }

    .att-scan-line {
        animation: att-scan 2.4s ease-in-out infinite;
    }

    @keyframes att-pulse-ring {
        0% {
            transform: scale(0.9);
            opacity: 0.6;
        }
        100% {
            transform: scale(1.5);
            opacity: 0;
        }
    }

    .att-pulse-ring::before {
        content: "";
        position: absolute;
        inset: -4px;
        border-radius: 50%;
        border: 2px solid currentColor;
        animation: att-pulse-ring 1.5s ease-out infinite;
    }
</style>

<!-- Tiêu đề trang -->
<section class="flex flex-col xl:flex-row xl:items-center justify-between gap-space-lg bg-surface-container-lowest p-space-xl rounded-xl shadow-sm">
    <div class="flex flex-col gap-space-xs">
        <div class="flex items-center gap-space-sm text-on-surface-variant font-label-sm text-label-sm">
            <span class="flex h-2 w-2 rounded-full bg-primary"></span>
            <span class="uppercase tracking-wider">Chấm công &amp; theo dõi</span>
        </div>
        <h2 class="font-headline-lg text-headline-lg text-primary tracking-tight">
            Bảng chấm công
        </h2>
        <p class="font-body-md text-body-md text-on-surface-variant max-w-3xl">
            Theo dõi trạng thái chấm công hàng ngày, nhận dữ liệu từ máy chấm công tự động và hỗ trợ nhận diện khuôn mặt, GPS.
        </p>
    </div>

    <div class="flex flex-wrap items-center gap-space-sm">
        <a
            href="/admin/devices"
            class="flex items-center gap-space-xs bg-blue-50 hover:bg-blue-100 text-blue-800 px-space-md py-space-sm rounded-xl font-label-md text-label-md transition-colors"
        >
            <span class="material-symbols-outlined text-[18px]">devices</span>
            <span>Thiết bị chấm công</span>
        </a>
        <button
            id="att-gps-settings-open"
            class="flex items-center gap-space-xs bg-surface-container-high hover:bg-surface-container text-on-surface px-space-md py-space-sm rounded-xl font-label-md text-label-md transition-colors"
            type="button"
        >
            <span class="material-symbols-outlined text-[18px]">location_on</span>
            <span>Cấu hình GPS</span>
        </button>
        <button
            id="att-face-checkin"
            class="flex items-center gap-space-xs bg-primary hover:bg-primary-container text-on-primary px-space-lg py-space-sm rounded-xl font-label-md text-label-md shadow-md transition-all"
            type="button"
        >
            <span class="material-symbols-outlined text-[18px]">face</span>
            <span>Chấm công khuôn mặt</span>
        </button>

        <button
            id="att-refresh"
            class="flex items-center gap-space-xs bg-surface-container-high hover:bg-surface-container text-on-surface px-space-md py-space-sm rounded-xl font-label-md text-label-md transition-colors disabled:opacity-60 disabled:cursor-not-allowed"
            type="button"
        >
            <span id="att-refresh-icon" class="material-symbols-outlined text-[18px] text-on-surface-variant">refresh</span>
            <span>Làm mới</span>
        </button>
    </div>
</section>
<p class="font-body-sm text-body-sm text-on-surface-variant mt-space-sm">
    Bản ghi sẽ tự cập nhật sau khi thiết bị gửi dữ liệu đồng bộ; bảng làm mới tự động mỗi 30 giây.
</p>

<!-- Thống kê -->
<section class="grid grid-cols-2 sm:grid-cols-3 xl:grid-cols-7 gap-space-lg">
    <div class="bg-surface-container-lowest p-space-lg rounded-xl shadow-sm flex items-center justify-between gap-space-sm">
        <div class="flex flex-col min-w-0">
            <span class="font-label-sm text-label-sm text-on-surface-variant uppercase tracking-wider">Tổng NV</span>
            <span id="att-stat-total" class="font-headline-xl text-headline-xl text-on-surface font-bold mt-space-xs">—</span>
        </div>
        <div class="w-9 h-9 rounded-xl bg-surface-container-low text-primary flex items-center justify-center shrink-0">
            <span class="material-symbols-outlined text-[20px]">groups</span>
        </div>
    </div>

    <div class="bg-surface-container-lowest p-space-lg rounded-xl shadow-sm flex items-center justify-between gap-space-sm">
        <div class="flex flex-col min-w-0">
            <span class="font-label-sm text-label-sm text-on-surface-variant uppercase tracking-wider">Đã vào</span>
            <span id="att-stat-checkedin" class="font-headline-xl text-headline-xl text-secondary font-bold mt-space-xs">—</span>
        </div>
        <div class="w-9 h-9 rounded-xl bg-secondary-fixed text-on-secondary-fixed flex items-center justify-center shrink-0">
            <span class="material-symbols-outlined text-[20px]">login</span>
        </div>
    </div>

    <div class="bg-surface-container-lowest p-space-lg rounded-xl shadow-sm flex items-center justify-between gap-space-sm">
        <div class="flex flex-col min-w-0">
            <span class="font-label-sm text-label-sm text-on-surface-variant uppercase tracking-wider">Đã ra</span>
            <span id="att-stat-checkedout" class="font-headline-xl text-headline-xl text-primary font-bold mt-space-xs">—</span>
        </div>
        <div class="w-9 h-9 rounded-xl bg-primary-fixed text-primary flex items-center justify-center shrink-0">
            <span class="material-symbols-outlined text-[20px]">logout</span>
        </div>
    </div>

    <div class="bg-surface-container-lowest p-space-lg rounded-xl shadow-sm flex items-center justify-between gap-space-sm">
        <div class="flex flex-col min-w-0">
            <span class="font-label-sm text-label-sm text-on-surface-variant uppercase tracking-wider">Đi muộn</span>
            <span id="att-stat-late" class="font-headline-xl text-headline-xl text-on-surface font-bold mt-space-xs">—</span>
        </div>
        <div class="w-9 h-9 rounded-xl bg-amber-50 text-amber-600 flex items-center justify-center shrink-0">
            <span class="material-symbols-outlined text-[20px]">schedule</span>
        </div>
    </div>

    <div class="bg-surface-container-lowest p-space-lg rounded-xl shadow-sm flex items-center justify-between gap-space-sm">
        <div class="flex flex-col min-w-0">
            <span class="font-label-sm text-label-sm text-on-surface-variant uppercase tracking-wider">Về sớm</span>
            <span id="att-stat-early" class="font-headline-xl text-headline-xl text-on-surface font-bold mt-space-xs">—</span>
        </div>
        <div class="w-9 h-9 rounded-xl bg-orange-50 text-orange-600 flex items-center justify-center shrink-0">
            <span class="material-symbols-outlined text-[20px]">directions_run</span>
        </div>
    </div>

    <div class="bg-surface-container-lowest p-space-lg rounded-xl shadow-sm flex items-center justify-between gap-space-sm">
        <div class="flex flex-col min-w-0">
            <span class="font-label-sm text-label-sm text-on-surface-variant uppercase tracking-wider">Chưa vào</span>
            <span id="att-stat-notcheckedin" class="font-headline-xl text-headline-xl text-on-surface font-bold mt-space-xs">—</span>
        </div>
        <div class="w-9 h-9 rounded-xl bg-surface-container-high text-on-surface-variant flex items-center justify-center shrink-0">
            <span class="material-symbols-outlined text-[20px]">person_off</span>
        </div>
    </div>

    <div class="bg-surface-container-lowest p-space-lg rounded-xl shadow-sm flex items-center justify-between gap-space-sm">
        <div class="flex flex-col min-w-0">
            <span class="font-label-sm text-label-sm text-on-surface-variant uppercase tracking-wider">Qua thiết bị</span>
            <span id="att-stat-device" class="font-headline-xl text-headline-xl text-blue-700 font-bold mt-space-xs">—</span>
        </div>
        <div class="w-9 h-9 rounded-xl bg-blue-50 text-blue-700 flex items-center justify-center shrink-0">
            <span class="material-symbols-outlined text-[20px]">fingerprint</span>
        </div>
    </div>
</section>

<!-- Danh sách chấm công -->
<section class="bg-surface-container-lowest rounded-xl shadow-sm overflow-hidden">
    <div class="p-space-lg border-b border-surface-container-high">
        <div class="flex flex-col xl:flex-row xl:items-end gap-space-md">
            <div class="w-full xl:w-48">
                <label class="font-label-sm text-label-sm text-on-surface block mb-space-xs" for="att-date">
                    Ngày chấm công
                </label>
                <input
                    id="att-date"
                    class="w-full bg-surface-container-low text-on-surface font-body-sm text-body-sm px-space-md py-space-sm rounded-xl outline-none focus:bg-surface-container focus:ring-2 focus:ring-primary/20 transition-all"
                    name="date"
                    type="date"
                >
            </div>

            <div class="flex-1 min-w-0">
                <label class="font-label-sm text-label-sm text-on-surface block mb-space-xs" for="att-search">
                    Tìm kiếm nhân viên
                </label>
                <div class="relative">
                    <span class="material-symbols-outlined absolute left-space-sm top-1/2 -translate-y-1/2 text-on-surface-variant text-[18px] pointer-events-none">search</span>
                    <input
                        id="att-search"
                        class="w-full bg-surface-container-low text-on-surface font-body-sm text-body-sm pl-8 pr-space-md py-space-sm rounded-xl outline-none focus:bg-surface-container focus:ring-2 focus:ring-primary/20 transition-all"
                        name="search"
                        type="search"
                        autocomplete="off"
                        placeholder="Nhập mã nhân viên hoặc họ tên..."
                    >
                </div>
            </div>

            <div class="w-full xl:w-48">
                <label class="font-label-sm text-label-sm text-on-surface block mb-space-xs" for="att-department">
                    Phòng ban
                </label>
                <div class="relative">
                    <select
                        id="att-department"
                        class="w-full appearance-none bg-surface-container-low text-on-surface font-body-sm text-body-sm pl-space-md pr-space-xl py-space-sm rounded-xl outline-none focus:bg-surface-container focus:ring-2 focus:ring-primary/20 transition-all cursor-pointer"
                        name="department"
                    >
                        <option value="">Tất cả phòng ban</option>
                    </select>
                    <span class="material-symbols-outlined absolute right-space-sm top-1/2 -translate-y-1/2 text-on-surface-variant pointer-events-none text-[20px]">expand_more</span>
                </div>
            </div>

            <div class="w-full xl:w-48">
                <label class="font-label-sm text-label-sm text-on-surface block mb-space-xs" for="att-status">
                    Trạng thái
                </label>
                <div class="relative">
                    <select
                        id="att-status"
                        class="w-full appearance-none bg-surface-container-low text-on-surface font-body-sm text-body-sm pl-space-md pr-space-xl py-space-sm rounded-xl outline-none focus:bg-surface-container focus:ring-2 focus:ring-primary/20 transition-all cursor-pointer"
                        name="status"
                    >
                        <option value="all">Tất cả trạng thái</option>
                        <option value="checked_in">Đã check-in</option>
                        <option value="checked_out">Đã check-out</option>
                        <option value="not_checked_in">Chưa check-in</option>
                        <option value="late">Đi muộn</option>
                        <option value="early_leave">Về sớm</option>
                    </select>
                    <span class="material-symbols-outlined absolute right-space-sm top-1/2 -translate-y-1/2 text-on-surface-variant pointer-events-none text-[20px]">expand_more</span>
                </div>
            </div>

            <div class="flex items-center gap-space-sm">
                <button
                    id="att-apply-filter"
                    class="flex items-center justify-center gap-space-xs bg-primary hover:bg-primary-container text-on-primary px-space-lg py-space-sm rounded-xl font-label-md text-label-md shadow-md transition-all"
                    type="button"
                >
                    <span class="material-symbols-outlined text-[18px]">filter_alt</span>
                    <span>Lọc</span>
                </button>
                <button
                    id="att-reset-filter"
                    class="px-space-md py-space-sm text-on-surface-variant hover:text-on-surface font-label-md text-label-md rounded-xl hover:bg-surface-container-low transition-colors"
                    type="button"
                >
                    Xóa lọc
                </button>
            </div>
        </div>
    </div>

    <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse">
            <thead>
                <tr class="bg-surface-container-low text-on-surface-variant font-label-sm text-label-sm uppercase tracking-wider">
                    <th class="py-space-md px-space-lg font-semibold">Nhân viên</th>
                    <th class="py-space-md px-space-md font-semibold">Phòng ban</th>
                    <th class="py-space-md px-space-md font-semibold">Ca làm</th>
                    <th class="py-space-md px-space-md font-semibold">Check-in</th>
                    <th class="py-space-md px-space-md font-semibold">Check-out</th>
                    <th class="py-space-md px-space-md font-semibold">Trạng thái</th>
                    <th class="py-space-md px-space-lg font-semibold text-right">Thao tác</th>
                </tr>
            </thead>
            <tbody id="att-table-body" class="divide-y divide-surface-container-low text-body-sm text-on-surface"></tbody>
        </table>
    </div>

    <div class="p-space-lg bg-surface-container-low flex flex-col sm:flex-row items-center justify-between gap-space-sm text-body-sm text-on-surface-variant">
        <span id="att-table-summary">Đang tải dữ liệu...</span>
        <span id="att-table-date"></span>
    </div>
</section>

<!-- Modal chấm công khuôn mặt -->
<div
    id="att-face-modal"
    class="fixed inset-0 z-[60] hidden"
    role="dialog"
    aria-modal="true"
    aria-labelledby="att-face-title"
    aria-hidden="true"
>
    <div class="absolute inset-0 bg-black/50 backdrop-blur-sm" data-close-modal="face"></div>

    <div class="relative flex min-h-full items-center justify-center p-space-lg">
        <div class="w-full max-w-3xl bg-surface-container-lowest rounded-xl shadow-xl overflow-hidden att-modal-in max-h-[92vh] flex flex-col">
            <div class="flex items-start justify-between gap-space-md px-space-xl py-space-lg border-b border-surface-container-high shrink-0">
                <div class="flex items-center gap-space-md min-w-0">
                    <div class="w-11 h-11 rounded-full bg-primary text-on-primary font-semibold flex items-center justify-center shrink-0">
                        <span class="material-symbols-outlined text-[24px]">face</span>
                    </div>
                    <div class="min-w-0">
                        <h3 id="att-face-title" class="font-headline-sm text-headline-sm text-primary font-semibold truncate">
                            Chấm công bằng khuôn mặt
                        </h3>
                        <p class="font-body-sm text-body-sm text-on-surface-variant">
                            Nhận diện tự động — không cần chọn nhân viên
                        </p>
                    </div>
                </div>

                <button
                    class="p-space-sm rounded-xl text-on-surface-variant hover:bg-surface-container-high transition-colors"
                    data-close-modal="face"
                    type="button"
                    aria-label="Đóng"
                >
                    <span class="material-symbols-outlined">close</span>
                </button>
            </div>

            <div class="p-space-xl overflow-y-auto flex flex-col gap-space-lg">
                <!-- Chọn loại chấm công -->
                <div class="flex items-center gap-space-sm">
                    <label class="font-label-sm text-label-sm text-on-surface-variant uppercase tracking-wider shrink-0">Loại:</label>
                    <div class="flex gap-space-sm">
                        <button
                            id="att-face-action-checkin"
                            class="flex items-center gap-space-xs px-space-lg py-space-sm rounded-xl font-label-md text-label-md transition-colors bg-primary text-on-primary"
                            type="button"
                            data-action="check_in"
                        >
                            <span class="material-symbols-outlined text-[18px]">login</span>
                            <span>Check-in</span>
                        </button>
                        <button
                            id="att-face-action-checkout"
                            class="flex items-center gap-space-xs px-space-lg py-space-sm rounded-xl font-label-md text-label-md transition-colors bg-surface-container-high text-on-surface-variant hover:bg-surface-container"
                            type="button"
                            data-action="check_out"
                        >
                            <span class="material-symbols-outlined text-[18px]">logout</span>
                            <span>Check-out</span>
                        </button>
                    </div>
                </div>

                <!-- Lỗi -->
                <div id="att-face-error" class="hidden flex items-start gap-space-sm p-space-md rounded-xl bg-error-container border border-error/20 text-on-error-container">
                    <span class="material-symbols-outlined text-[20px] shrink-0">error</span>
                    <p id="att-face-error-message" class="font-body-sm text-body-sm"></p>
                </div>

                <!-- Camera -->
                <div class="relative w-full aspect-video bg-surface-container-high rounded-xl overflow-hidden">
                    <video
                        id="att-face-video"
                        class="w-full h-full object-cover scale-x-[-1]"
                        autoplay
                        muted
                        playsinline
                    ></video>

                    <div id="att-face-placeholder" class="absolute inset-0 flex flex-col items-center justify-center gap-space-sm text-on-surface-variant bg-surface-container-high">
                        <span class="material-symbols-outlined text-[36px]">videocam_off</span>
                        <p class="font-body-sm text-body-sm">Camera chưa bật</p>
                    </div>

                    <div class="absolute inset-0 flex items-center justify-center pointer-events-none">
                        <div class="w-[38%] h-[74%] border-2 border-white/80 rounded-[50%] shadow-[0_0_0_9999px_rgba(0,0,0,0.28)]"></div>
                    </div>

                    <div class="absolute left-0 right-0 top-0 h-0.5 bg-primary/80 att-scan-line pointer-events-none"></div>

                    <div class="absolute bottom-space-md left-1/2 -translate-x-1/2 flex items-center gap-space-xs px-space-md py-space-sm rounded-full bg-black/60 text-white backdrop-blur-sm max-w-[90%]">
                        <span id="att-face-status-icon" class="material-symbols-outlined text-[18px]">progress_activity</span>
                        <span id="att-face-status-text" class="font-body-sm text-body-sm text-center">Bấm nút bên dưới để bắt đầu</span>
                    </div>
                </div>

                <!-- Kết quả nhận diện -->
                <div id="att-face-result" class="hidden">
                    <div class="flex items-center gap-space-md p-space-lg rounded-xl bg-green-50 border border-green-200">
                        <div class="w-12 h-12 rounded-full bg-green-100 text-green-600 flex items-center justify-center shrink-0 relative att-pulse-ring">
                            <span class="material-symbols-outlined text-[26px]">check_circle</span>
                        </div>
                        <div class="flex flex-col gap-space-xs min-w-0">
                            <p id="att-face-result-message" class="font-label-md text-label-md text-green-700 font-semibold"></p>
                            <p id="att-face-result-employee" class="font-body-sm text-body-sm text-green-600"></p>
                            <p id="att-face-result-detail" class="font-body-sm text-body-sm text-on-surface-variant"></p>
                        </div>
                    </div>
                </div>

                <!-- Hướng dẫn -->
                <p id="att-face-hint" class="font-body-sm text-body-sm text-on-surface-variant text-center">
                    Nhìn thẳng vào camera, giữ khuôn mặt trong khung oval. Hệ thống sẽ tự động nhận diện.
                </p>

                <!-- Nút điều khiển -->
                <div class="flex flex-col-reverse sm:flex-row sm:items-center sm:justify-between gap-space-sm">
                    <button
                        class="px-space-lg py-space-sm bg-surface-container-high hover:bg-surface-container text-on-surface font-label-md text-label-md rounded-xl transition-colors"
                        data-close-modal="face"
                        type="button"
                    >
                        Đóng
                    </button>
                    <div class="flex flex-col sm:flex-row gap-space-sm">
                        <button
                            id="att-face-start"
                            class="flex items-center justify-center gap-space-xs bg-primary hover:bg-primary-container text-on-primary px-space-lg py-space-sm rounded-xl font-label-md text-label-md transition-colors"
                            type="button"
                        >
                            <span class="material-symbols-outlined text-[18px]">videocam</span>
                            <span>Bắt đầu camera</span>
                        </button>
                        <button
                            id="att-face-capture"
                            class="hidden items-center justify-center gap-space-xs bg-primary hover:bg-primary-container text-on-primary px-space-lg py-space-sm rounded-xl font-label-md text-label-md transition-colors disabled:opacity-50 disabled:cursor-not-allowed"
                            type="button"
                            disabled
                        >
                            <span class="material-symbols-outlined text-[18px]">photo_camera</span>
                            <span>Chấm công</span>
                        </button>
                        <button
                            id="att-face-retry"
                            class="hidden items-center justify-center gap-space-xs bg-surface-container-high hover:bg-surface-container text-on-surface px-space-lg py-space-sm rounded-xl font-label-md text-label-md transition-colors"
                            type="button"
                        >
                            <span class="material-symbols-outlined text-[18px]">refresh</span>
                            <span>Thử lại</span>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal chấm công thủ công -->
<div
    id="att-manual-modal"
    class="fixed inset-0 z-[65] hidden"
    role="dialog"
    aria-modal="true"
    aria-labelledby="att-manual-title"
    aria-hidden="true"
>
    <div class="absolute inset-0 bg-black/40 backdrop-blur-sm" data-close-modal="manual"></div>

    <div class="relative flex min-h-full items-center justify-center p-space-lg">
        <div class="w-full max-w-lg bg-surface-container-lowest rounded-xl shadow-xl overflow-hidden att-modal-in">
            <div class="flex items-start justify-between gap-space-md px-space-xl py-space-lg border-b border-surface-container-high">
                <div class="flex items-center gap-space-md min-w-0">
                    <div class="w-11 h-11 rounded-full bg-secondary-fixed text-on-secondary-fixed font-semibold flex items-center justify-center shrink-0">
                        <span class="material-symbols-outlined text-[24px]">edit_note</span>
                    </div>
                    <div class="min-w-0">
