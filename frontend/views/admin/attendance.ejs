            elements.faceActionCheckin.classList.toggle("hover:bg-surface-container", !isCheckIn);

            elements.faceActionCheckout.classList.toggle("bg-primary", !isCheckIn);
            elements.faceActionCheckout.classList.toggle("text-on-primary", !isCheckIn);
            elements.faceActionCheckout.classList.toggle("bg-surface-container-high", isCheckIn);
            elements.faceActionCheckout.classList.toggle("text-on-surface-variant", isCheckIn);
            elements.faceActionCheckout.classList.toggle("hover:bg-surface-container", isCheckIn);
        };

        const openFaceModal = () => {
            faceState.open = true;
            faceState.capturing = false;
            faceState.starting = false;

            hideFaceError();
            hideFaceResult();
            elements.facePlaceholder.classList.remove("hidden");
            elements.faceStartBtn.classList.remove("hidden");
            elements.faceStartBtn.classList.add("flex");
