<%- include("../partials/adminHead", {
    pageTitle: "Bảng chấm công",
    activePage: "attendance"
}) %>

<section class="flex flex-col gap-space-xl">
    <%- include("../partials/alerts", { success: success, error: error }) %>

    <section class="relative overflow-hidden flex flex-col xl:flex-row xl:items-center justify-between gap-space-lg bg-surface-container-lowest p-space-lg md:p-space-xl rounded-xl border border-surface-container-high/60 shadow-sm">
        <div class="absolute inset-y-0 left-0 w-1 bg-primary"></div>
        <div class="flex flex-col gap-space-xs">
            <div class="flex items-center gap-space-sm text-on-surface-variant font-label-sm text-label-sm">
                <span class="flex h-2 w-2 rounded-full bg-primary-container"></span>
                <span class="uppercase tracking-wider">Theo dõi thời gian làm việc</span>
            </div>
            <h2 class="font-headline-lg text-headline-lg text-primary tracking-tight">Bảng chấm công</h2>
            <p class="font-body-md text-body-md text-on-surface-variant">
                Theo dõi giờ vào, giờ ra và tình trạng chấm công của nhân viên.
            </p>
            <div class="flex flex-wrap items-center gap-x-space-md gap-y-space-xs mt-space-sm font-body-sm text-body-sm">
                <span class="inline-flex items-center gap-space-xs text-green-700" role="status" aria-live="polite">
                    <span class="w-2 h-2 rounded-full bg-green-500"></span>
                    <span id="attendance-sync-status">Tự đồng bộ mỗi 30 giây</span>
                </span>
                <span id="attendance-last-updated" class="text-on-surface-variant">Đang tải thời gian cập nhật...</span>
            </div>
        </div>

        <div class="flex flex-wrap items-center gap-space-sm">
            <button
                id="open-create-attendance"
                class="flex items-center justify-center gap-space-xs px-space-lg py-space-sm bg-primary hover:bg-primary-container text-on-primary rounded-xl font-label-md text-label-md shadow-md transition-colors"
                type="button"
            >
                <span class="material-symbols-outlined text-[20px]">edit_calendar</span>
                <span>Điều chỉnh chấm công</span>
            </button>
            <a
                href="/admin/attendance/reports"
                class="flex items-center justify-center gap-space-xs px-space-lg py-space-sm bg-surface-container-low hover:bg-surface-container-high text-on-surface-variant rounded-xl font-label-md text-label-md transition-colors"
            >
                <span class="material-symbols-outlined text-[20px]">bar_chart</span>
                <span>Xem báo cáo</span>
            </a>
            <button
                id="export-attendance"
                class="flex items-center justify-center w-10 h-10 bg-surface-container-low hover:bg-surface-container-high text-on-surface-variant rounded-xl transition-all active:scale-[0.98] disabled:opacity-50 disabled:cursor-not-allowed"
                type="button"
                title="Xuất bảng chấm công CSV"
                aria-label="Xuất bảng chấm công CSV"
            >
                <span class="material-symbols-outlined text-[20px]">download</span>
            </button>
            <button
                id="refresh-attendance"
                class="flex items-center justify-center gap-space-xs px-space-lg py-space-sm bg-surface-container-low hover:bg-surface-container-high text-on-surface-variant rounded-xl font-label-md text-label-md transition-colors disabled:opacity-50 disabled:cursor-not-allowed"
                type="button"
            >
                <span class="material-symbols-outlined text-[20px]">sync</span>
                <span>Đồng bộ ngay</span>
            </button>
            <button
                id="toggle-auto-sync-attendance"
                class="flex items-center justify-center gap-space-xs px-space-lg py-space-sm bg-primary-fixed text-primary rounded-xl font-label-md text-label-md transition-colors"
                type="button"
                aria-pressed="true"
            >
                <span id="auto-sync-attendance-icon" class="material-symbols-outlined text-[20px]">pause_circle</span>
                <span id="auto-sync-attendance-label">Tạm dừng tự động</span>
            </button>
        </div>
    </section>

    <section class="flex flex-col gap-space-md" aria-label="Thống kê toàn hệ thống">
        <div>
            <h3 class="font-headline-sm text-headline-sm text-primary">Số liệu toàn hệ thống</h3>
            <p class="font-body-sm text-body-sm text-on-surface-variant mt-space-xs">
                Tổng hợp một bản ghi gần nhất cho mỗi nhân viên, không thay đổi theo bộ lọc danh sách.
            </p>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-space-lg">
        <button type="button" data-attendance-status-filter="" class="text-left bg-surface-container-lowest p-space-lg rounded-xl border border-surface-container-high/60 shadow-sm flex items-center justify-between hover:ring-2 hover:ring-primary/10 transition-all">
            <div class="flex flex-col">
                <span class="font-label-sm text-label-sm text-on-surface-variant uppercase tracking-wider">Tổng nhân viên</span>
                <span id="totalEmployeesCount" class="font-headline-xl text-headline-xl text-primary font-bold mt-space-xs"><%= stats.total_employees %></span>
            </div>
            <div class="w-11 h-11 rounded-xl bg-primary-fixed text-primary flex items-center justify-center">
                <span class="material-symbols-outlined text-[24px]">groups</span>
            </div>
        </button>

        <button type="button" data-attendance-status-filter="present" class="text-left bg-surface-container-lowest p-space-lg rounded-xl border border-surface-container-high/60 shadow-sm flex items-center justify-between hover:ring-2 hover:ring-green-100 transition-all">
            <div class="flex flex-col">
                <span class="font-label-sm text-label-sm text-on-surface-variant uppercase tracking-wider">Có mặt</span>
                <span id="totalPresentCount" class="font-headline-xl text-headline-xl text-green-600 font-bold mt-space-xs"><%= stats.present %></span>
            </div>
            <div class="w-11 h-11 rounded-xl bg-green-50 text-green-600 flex items-center justify-center">
                <span class="material-symbols-outlined text-[24px]">task_alt</span>
            </div>
        </button>

        <button type="button" data-attendance-status-filter="late" class="text-left bg-surface-container-lowest p-space-lg rounded-xl border border-surface-container-high/60 shadow-sm flex items-center justify-between hover:ring-2 hover:ring-orange-100 transition-all">
            <div class="flex flex-col">
                <span class="font-label-sm text-label-sm text-on-surface-variant uppercase tracking-wider">Đi muộn</span>
                <span id="totalLateCount" class="font-headline-xl text-headline-xl text-orange-500 font-bold mt-space-xs"><%= stats.late %></span>
            </div>
            <div class="w-11 h-11 rounded-xl bg-orange-50 text-orange-600 flex items-center justify-center">
                <span class="material-symbols-outlined text-[24px]">schedule</span>
            </div>
        </button>

        <button type="button" data-attendance-status-filter="absent" class="text-left bg-surface-container-lowest p-space-lg rounded-xl border border-surface-container-high/60 shadow-sm flex items-center justify-between hover:ring-2 hover:ring-red-100 transition-all">
            <div class="flex flex-col">
                <span class="font-label-sm text-label-sm text-on-surface-variant uppercase tracking-wider">Vắng mặt</span>
                <span id="totalAbsentCount" class="font-headline-xl text-headline-xl text-red-500 font-bold mt-space-xs"><%= stats.absent %></span>
            </div>
            <div class="w-11 h-11 rounded-xl bg-red-50 text-red-600 flex items-center justify-center">
                <span class="material-symbols-outlined text-[24px]">person_off</span>
            </div>
        </button>
        </div>
    </section>

    <section class="bg-surface-container-lowest rounded-xl border border-surface-container-high/60 shadow-sm p-space-lg md:p-space-xl">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-space-md mb-space-lg">
            <div>
                <h3 class="font-headline-sm text-headline-sm text-on-surface">Tìm kiếm và lọc chấm công</h3>
                <p class="font-body-sm text-body-sm text-on-surface-variant mt-space-xs">Lọc danh sách theo nhân viên, ngày hoặc trạng thái.</p>
            </div>
            <button
                id="clear-attendance-filters"
                class="inline-flex items-center justify-center gap-space-xs px-space-md py-space-sm bg-surface-container-low hover:bg-surface-container-high text-on-surface-variant rounded-xl font-label-md text-label-md transition-colors"
                type="button"
            >
                <span class="material-symbols-outlined text-[18px]">restart_alt</span>
                <span>Xóa bộ lọc</span>
            </button>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-space-md">
            <label class="flex flex-col gap-space-xs">
                <span class="font-label-sm text-label-sm text-on-surface-variant">Nhân viên</span>
                <span class="relative">
                    <span class="material-symbols-outlined absolute left-space-md top-1/2 -translate-y-1/2 text-on-surface-variant text-[20px] pointer-events-none">search</span>
                    <input
                        id="keyword"
                        type="search"
                        placeholder="Tên hoặc mã nhân viên..."
                        class="w-full bg-surface-container-low text-on-surface font-body-md text-body-md pl-11 pr-space-md py-space-md rounded-xl outline-none focus:ring-2 focus:ring-primary-container transition-shadow"
                        oninput="scheduleFilterRecords()"
                    >
                    <button
                        id="clear-attendance-search"
                        type="button"
                        class="hidden absolute right-space-sm top-1/2 -translate-y-1/2 p-1 text-on-surface-variant hover:text-primary rounded-md"
                        aria-label="Xóa từ khóa tìm kiếm"
                    >
                        <span class="material-symbols-outlined text-[18px]">close</span>
                    </button>
                </span>
            </label>

            <label class="flex flex-col gap-space-xs">
                <span class="font-label-sm text-label-sm text-on-surface-variant">Ngày chấm công</span>
                <input
                    id="dateFilter"
                    type="date"
                    class="w-full bg-surface-container-low text-on-surface font-body-md text-body-md px-space-md py-space-md rounded-xl outline-none focus:ring-2 focus:ring-primary-container transition-shadow"
                    onchange="filterRecords()"
                >
            </label>

            <label class="flex flex-col gap-space-xs">
                <span class="font-label-sm text-label-sm text-on-surface-variant">Trạng thái</span>
                <select
                    id="statusFilter"
                    class="w-full bg-surface-container-low text-on-surface font-body-md text-body-md px-space-md py-space-md rounded-xl outline-none focus:ring-2 focus:ring-primary-container transition-shadow"
                    onchange="filterRecords()"
                >
                    <option value="">Tất cả trạng thái</option>
                    <option value="present">Đúng giờ</option>
                    <option value="late">Đi muộn</option>
                    <option value="absent">Vắng mặt</option>
                </select>
            </label>
        </div>
    </section>

    <section class="flex flex-col gap-space-md" aria-label="Tổng quan chấm công theo bộ lọc">
        <div>
            <h3 class="font-headline-sm text-headline-sm text-primary">Tổng quan theo bộ lọc</h3>
            <p class="font-body-sm text-body-sm text-on-surface-variant mt-space-xs">
                Tỷ lệ chuyên cần tính số lượt đúng giờ và đi muộn trên tổng lượt ghi nhận.
            </p>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 2xl:grid-cols-5 gap-space-lg">
            <article class="bg-surface-container-lowest p-space-lg rounded-xl shadow-sm flex items-center justify-between">
                <div class="flex flex-col">
                    <span class="font-label-sm text-label-sm text-on-surface-variant uppercase tracking-wider">Đi muộn</span>
                    <span id="lateOverviewCount" class="font-headline-xl text-headline-xl text-orange-600 font-bold mt-space-xs"><%= overview.late %></span>
                    <span class="font-body-sm text-body-sm text-on-surface-variant">Theo giờ ca hoặc trạng thái ghi nhận</span>
                </div>
                <div class="w-11 h-11 rounded-xl bg-orange-50 text-orange-600 flex items-center justify-center">
                    <span class="material-symbols-outlined text-[24px]">more_time</span>
                </div>
            </article>

            <article class="bg-surface-container-lowest p-space-lg rounded-xl shadow-sm flex items-center justify-between">
                <div class="flex flex-col">
                    <span class="font-label-sm text-label-sm text-on-surface-variant uppercase tracking-wider">Về sớm</span>
                    <span id="earlyOverviewCount" class="font-headline-xl text-headline-xl text-red-600 font-bold mt-space-xs"><%= overview.early %></span>
                    <span class="font-body-sm text-body-sm text-on-surface-variant">Ra trước giờ kết thúc ca</span>
                </div>
                <div class="w-11 h-11 rounded-xl bg-red-50 text-red-600 flex items-center justify-center">
                    <span class="material-symbols-outlined text-[24px]">logout</span>
                </div>
            </article>

            <article class="bg-surface-container-lowest p-space-lg rounded-xl shadow-sm flex items-center justify-between">
                <div class="flex flex-col">
                    <span class="font-label-sm text-label-sm text-on-surface-variant uppercase tracking-wider">Chưa có ca đối chiếu</span>
                    <span id="unassignedOverviewCount" class="font-headline-xl text-headline-xl text-primary font-bold mt-space-xs"><%= overview.unassigned %></span>
                    <span class="font-body-sm text-body-sm text-on-surface-variant">Không thể xác định đi muộn/về sớm</span>
                </div>
                <div class="w-11 h-11 rounded-xl bg-primary-fixed text-primary flex items-center justify-center">
                    <span class="material-symbols-outlined text-[24px]">event_busy</span>
                </div>
            </article>

            <article class="bg-surface-container-lowest p-space-lg rounded-xl shadow-sm flex items-center justify-between">
                <div class="flex flex-col">
                    <span class="font-label-sm text-label-sm text-on-surface-variant uppercase tracking-wider">Tỷ lệ chuyên cần</span>
                    <span class="mt-space-xs">
                        <span id="attendanceRateCount" class="font-headline-xl text-headline-xl text-green-600 font-bold"><%= overview.attendanceRate %></span>
                        <span class="font-headline-md text-headline-md text-green-600">%</span>
                    </span>
                    <span id="attendanceRateDetail" class="font-body-sm text-body-sm text-on-surface-variant"><%= overview.attended %> / <%= records.length %> nhân viên</span>
                </div>
                <div class="w-11 h-11 rounded-xl bg-green-50 text-green-600 flex items-center justify-center">
                    <span class="material-symbols-outlined text-[24px]">percent</span>
                </div>
            </article>

            <article class="bg-surface-container-lowest p-space-lg rounded-xl shadow-sm flex items-center justify-between">
                <div class="flex flex-col">
                    <span class="font-label-sm text-label-sm text-on-surface-variant uppercase tracking-wider">Tình hình vắng mặt</span>
                    <span id="absenceOverviewCount" class="font-headline-xl text-headline-xl text-red-600 font-bold mt-space-xs"><%= overview.absent %> lượt</span>
                    <span id="absenceOverviewRate" class="font-body-sm text-body-sm text-on-surface-variant"><%= overview.absenceRate %>% tổng lượt ghi nhận</span>
                </div>
                <div class="w-11 h-11 rounded-xl bg-red-50 text-red-600 flex items-center justify-center">
                    <span class="material-symbols-outlined text-[24px]">person_off</span>
                </div>
            </article>
        </div>
    </section>

    <section class="bg-surface-container-lowest rounded-xl shadow-sm overflow-hidden">
        <div class="p-space-lg md:p-space-xl border-b border-surface-container-high flex flex-col sm:flex-row sm:items-center justify-between gap-space-sm">
            <div>
                <h3 class="font-headline-sm text-headline-sm text-on-surface">Danh sách chấm công</h3>
                <p class="font-body-sm text-body-sm text-on-surface-variant mt-space-xs">
                    Mỗi nhân viên hiển thị một dòng với bản ghi chấm công gần nhất.
                </p>
            </div>
            <span id="attendanceCount" class="font-body-sm text-body-sm text-on-surface-variant" aria-live="polite"></span>
        </div>

        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse min-w-[1200px]">
                <caption class="sr-only">Danh sách thời gian chấm công của nhân viên</caption>
                <thead>
                    <tr class="bg-surface-container-low text-on-surface-variant font-label-sm text-label-sm uppercase tracking-wider">
                        <th class="py-space-md px-space-lg font-semibold sticky left-0 z-[2] bg-surface-container-low">Mã NV</th>
                        <th class="py-space-md px-space-md font-semibold">Nhân viên</th>
                        <th class="py-space-md px-space-md font-semibold">Ngày</th>
                        <th class="py-space-md px-space-md font-semibold">Ca làm</th>
                        <th class="py-space-md px-space-md font-semibold">Giờ vào</th>
                        <th class="py-space-md px-space-md font-semibold">Giờ ra</th>
                        <th class="py-space-md px-space-md font-semibold">Đi muộn</th>
                        <th class="py-space-md px-space-md font-semibold">Về sớm</th>
                        <th class="py-space-md px-space-md font-semibold">Số giờ</th>
                        <th class="py-space-md px-space-md font-semibold">Trạng thái</th>
                        <th class="py-space-md px-space-lg font-semibold text-right sticky right-0 z-[2] bg-surface-container-low">Thao tác</th>
                    </tr>
                </thead>
                <tbody id="attendanceBody" class="divide-y divide-surface-container-low text-body-sm text-on-surface">
                    <%- include("attendanceRows", { records: records }) %>
                </tbody>
            </table>
        </div>
    </section>
</section>

<div id="attendance-modal" class="fixed inset-0 z-50 hidden">
    <div class="absolute inset-0 bg-black/40" data-close-attendance-modal></div>
    <div class="relative min-h-full flex items-center justify-center p-space-lg overflow-y-auto">
        <div class="w-full max-w-xl bg-surface-container-lowest rounded-xl shadow-[0_16px_48px_rgba(0,0,0,0.18)] overflow-hidden max-h-[calc(100vh-2rem)] overflow-y-auto">
            <div class="flex items-center justify-between px-space-xl py-space-lg border-b border-surface-container-high">
                <div>
                    <h3 id="attendance-modal-title" class="font-headline-md text-headline-md text-primary font-semibold">Điều chỉnh chấm công</h3>
                    <p class="font-body-sm text-body-sm text-on-surface-variant mt-space-xs">Cập nhật nhân viên, ngày, giờ và trạng thái chấm công.</p>
                </div>
                <button class="p-space-sm rounded-xl text-on-surface-variant hover:bg-surface-container-high transition-colors" data-close-attendance-modal type="button" aria-label="Đóng">
                    <span class="material-symbols-outlined">close</span>
                </button>
            </div>

            <form id="attendance-form" action="/admin/attendance/create" method="POST" class="p-space-xl flex flex-col gap-space-lg">
                <div id="attendance-form-error" class="hidden items-start gap-space-sm p-space-md rounded-xl bg-error-container/60 border border-error/30 text-on-error-container text-body-md" role="alert">
                    <span class="material-symbols-outlined text-[20px]">error</span>
                    <span id="attendance-form-error-text"></span>
                </div>

                <div class="flex flex-col gap-space-xs">
                    <label class="font-label-sm text-label-sm text-on-surface" for="attendance-employee">Nhân viên <span class="text-error">*</span></label>
                    <select id="attendance-employee" name="employee_id" class="bg-surface-container-low text-on-surface font-body-md text-body-md px-space-md py-space-sm rounded-xl outline-none focus:ring-2 focus:ring-primary-container" required>
                        <option value="">-- Chọn nhân viên --</option>
                        <% employees.forEach((employee) => { %>
                            <option value="<%= employee.id %>">
                                <%= employee.employee_code %> - <%= employee.full_name %><%= employee.department ? ` (${employee.department})` : "" %>
                            </option>
                        <% }) %>
                    </select>
                    <p id="attendance-employee-lock-note" class="hidden text-body-sm text-on-surface-variant">
                        Nhân viên được cố định khi điều chỉnh bản ghi chấm công.
                    </p>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-space-lg">
                    <div class="flex flex-col gap-space-xs">
                        <label class="font-label-sm text-label-sm text-on-surface" for="attendance-date">Ngày chấm công <span class="text-error">*</span></label>
                        <input id="attendance-date" name="work_date" type="date" class="bg-surface-container-low text-on-surface font-data-mono text-data-mono px-space-md py-space-sm rounded-xl outline-none focus:ring-2 focus:ring-primary-container" required>
                    </div>
                    <div class="flex flex-col gap-space-xs">
                        <label class="font-label-sm text-label-sm text-on-surface" for="attendance-status">Trạng thái <span class="text-error">*</span></label>
                        <select id="attendance-status" name="status" class="bg-surface-container-low text-on-surface font-body-md text-body-md px-space-md py-space-sm rounded-xl outline-none focus:ring-2 focus:ring-primary-container" required>
                            <option value="auto">Tự xác định theo ca</option>
                            <option value="present">Đúng giờ</option>
                            <option value="late">Đi muộn</option>
                            <option value="absent">Vắng mặt</option>
                        </select>
                    </div>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-space-lg">
                    <div class="flex flex-col gap-space-xs">
                        <label class="font-label-sm text-label-sm text-on-surface" for="attendance-check-in">Giờ vào</label>
                        <input id="attendance-check-in" name="check_in" type="time" class="bg-surface-container-low text-on-surface font-data-mono text-data-mono px-space-md py-space-sm rounded-xl outline-none focus:ring-2 focus:ring-primary-container">
                    </div>
                    <div class="flex flex-col gap-space-xs">
                        <label class="font-label-sm text-label-sm text-on-surface" for="attendance-check-out">Giờ ra</label>
                        <input id="attendance-check-out" name="check_out" type="time" class="bg-surface-container-low text-on-surface font-data-mono text-data-mono px-space-md py-space-sm rounded-xl outline-none focus:ring-2 focus:ring-primary-container">
                    </div>
                </div>

                <p class="font-body-sm text-on-surface-variant">
                    Trạng thái tự xác định theo giờ bắt đầu ca được phân, không áp dụng thời gian ân hạn.
                    Chọn trạng thái thủ công nếu cần ghi đè; vắng mặt thì để trống giờ vào và giờ ra.
                </p>

                <div class="flex items-center justify-end gap-space-sm pt-space-md border-t border-surface-container-high">
                    <button class="px-space-lg py-space-sm bg-surface-container-high hover:bg-surface-variant text-on-surface font-label-md text-label-md rounded-xl transition-colors" data-close-attendance-modal type="button">
                        Hủy
                    </button>
                    <button id="attendance-submit" class="flex items-center gap-space-xs px-space-lg py-space-sm bg-primary hover:bg-primary-container text-on-primary font-label-md text-label-md rounded-xl shadow-md transition-colors disabled:opacity-60 disabled:cursor-not-allowed" type="submit">
                        <span class="material-symbols-outlined text-[18px]">save</span>
                        <span id="attendance-submit-label">Lưu dữ liệu</span>
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<div id="attendance-history-modal" class="fixed inset-0 z-[60] hidden">
    <div class="absolute inset-0 bg-black/40" data-close-history-modal></div>
    <div class="relative min-h-full flex items-center justify-center p-space-lg overflow-y-auto">
        <section class="w-full max-w-6xl max-h-[calc(100vh-2rem)] overflow-hidden bg-surface-container-lowest rounded-xl shadow-[0_16px_48px_rgba(0,0,0,0.18)]" role="dialog" aria-modal="true">
            <div class="flex items-center justify-between px-space-xl py-space-lg border-b border-surface-container-high">
                <div>
                    <h3 id="attendance-history-title" class="font-headline-md text-headline-md text-primary font-semibold">Lịch sử chấm công</h3>
                    <p id="attendance-history-description" class="font-body-sm text-body-sm text-on-surface-variant mt-space-xs"></p>
                </div>
                <button class="p-space-sm rounded-xl text-on-surface-variant hover:bg-surface-container-high transition-colors" data-close-history-modal type="button" aria-label="Đóng">
                    <span class="material-symbols-outlined">close</span>
                </button>
            </div>
            <div class="overflow-auto max-h-[calc(100vh-8rem)] p-space-lg">
                <table class="w-full min-w-[960px] text-left">
                    <thead class="bg-surface-container-low text-on-surface-variant font-label-sm text-label-sm uppercase">
                        <tr>
                            <th class="px-space-md py-space-sm">Ngày</th>
                            <th class="px-space-md py-space-sm">Ca làm</th>
                            <th class="px-space-md py-space-sm">Giờ vào</th>
                            <th class="px-space-md py-space-sm">Giờ ra</th>
                            <th class="px-space-md py-space-sm">Đi muộn</th>
                            <th class="px-space-md py-space-sm">Về sớm</th>
                            <th class="px-space-md py-space-sm">Số giờ</th>
                            <th class="px-space-md py-space-sm">Trạng thái</th>
                        </tr>
                    </thead>
                    <tbody id="attendance-history-body" class="divide-y divide-surface-container-low text-body-md text-on-surface"></tbody>
                </table>
            </div>
        </section>
    </div>
</div>

<script>
document.addEventListener("DOMContentLoaded", () => {
    const modal = document.getElementById("attendance-modal");
    const form = document.getElementById("attendance-form");
    const modalTitle = document.getElementById("attendance-modal-title");
    const errorBox = document.getElementById("attendance-form-error");
    const errorText = document.getElementById("attendance-form-error-text");
    const employeeSelect = document.getElementById("attendance-employee");
    const dateInput = document.getElementById("attendance-date");
    const checkInInput = document.getElementById("attendance-check-in");
    const checkOutInput = document.getElementById("attendance-check-out");
    const statusSelect = document.getElementById("attendance-status");
    const historyModal = document.getElementById("attendance-history-modal");
    const historyTitle = document.getElementById("attendance-history-title");
    const historyDescription = document.getElementById("attendance-history-description");
    const historyBody = document.getElementById("attendance-history-body");

    const showError = (message) => {
        errorText.textContent = message;
        errorBox.classList.remove("hidden");
        errorBox.classList.add("flex");
    };

    const clearError = () => {
        errorText.textContent = "";
        errorBox.classList.add("hidden");
        errorBox.classList.remove("flex");
    };

    const resetSubmitButton = () => {
        const submitButton = document.getElementById("attendance-submit");
        const submitLabel = document.getElementById("attendance-submit-label");
        submitButton.disabled = false;
        submitButton.removeAttribute("aria-busy");
        submitLabel.textContent = "Lưu dữ liệu";
    };

    const syncStatusFields = () => {
        const isAbsent = statusSelect.value === "absent";
        checkInInput.disabled = isAbsent;
        checkOutInput.disabled = isAbsent;
        checkInInput.required = !isAbsent;
        if (isAbsent) {
            checkInInput.value = "";
            checkOutInput.value = "";
        }
    };

    const openModal = () => {
        modal.classList.remove("hidden");
        document.body.classList.add("shift-modal-open");
        (employeeSelect.disabled ? dateInput : employeeSelect).focus();
    };

    const closeModal = () => {
        modal.classList.add("hidden");
        document.body.classList.remove("shift-modal-open");
        clearError();
    };

    const closeHistoryModal = () => {
        historyModal.classList.add("hidden");
        document.body.classList.remove("shift-modal-open");
    };

    window.openAttendanceHistory = async (button) => {
        historyTitle.textContent = `${button.dataset.employeeCode} - ${button.dataset.employeeName}`;
        historyDescription.textContent = "Đang tải tất cả ngày chấm công...";
        historyBody.innerHTML = '<tr><td colspan="8" class="px-space-md py-space-xl text-center text-on-surface-variant">Đang tải...</td></tr>';
        historyModal.classList.remove("hidden");
        document.body.classList.add("shift-modal-open");

        try {
            const response = await fetch(`/admin/attendance/employee/${button.dataset.employeeId}/history`, {
                headers: { Accept: "application/json" },
                cache: "no-store"
            });
            const data = await response.json();
            if (!response.ok) throw new Error(data.error || "Không thể tải lịch sử chấm công.");

            historyDescription.textContent = `${data.records.length} ngày chấm công đã ghi nhận`;
            const statusLabels = { present: "Đúng giờ", late: "Đi muộn", absent: "Vắng mặt" };
            historyBody.innerHTML = data.records.length
                ? data.records.map((record) => `
                    <tr>
                        <td class="px-space-md py-space-sm font-data-mono">${record.work_date}</td>
                        <td class="px-space-md py-space-sm">
                            ${record.has_schedule
                                ? `<div class="flex flex-col"><span class="font-label-md text-label-md text-on-surface">${record.shift_code ? `<span class="font-data-mono text-primary mr-1">${record.shift_code}</span>` : ""}${record.shift_name || "—"}</span><span class="font-body-sm text-body-sm text-on-surface-variant">${record.scheduled_start || "—"} – ${record.scheduled_end || "—"}</span></div>`
                                : '<span class="font-body-sm text-body-sm text-outline">Không có ca áp dụng</span>'}
                        </td>
                        <td class="px-space-md py-space-sm font-data-mono">${record.check_in || "—"}</td>
                        <td class="px-space-md py-space-sm font-data-mono">${record.check_out || "—"}</td>
                        <td class="px-space-md py-space-sm">
                            ${record.status === "absent"
                                ? '<span class="text-outline">—</span>'
                                : record.late_minutes > 0
                                    ? `<span class="font-label-md text-label-md text-orange-700">Trễ ${record.late_minutes} phút</span>`
                                    : record.status === "late"
                                        ? '<span class="font-label-md text-label-md text-orange-700">Đi muộn</span>'
                                        : record.has_schedule
                                            ? '<span class="font-body-sm text-body-sm text-green-700">Đúng giờ</span>'
                                            : '<span class="text-outline">—</span>'}
                        </td>
                        <td class="px-space-md py-space-sm">
                            ${record.status === "absent"
                                ? '<span class="text-outline">—</span>'
                                : record.early_leave_minutes > 0
                                    ? `<span class="font-label-md text-label-md text-red-700">Sớm ${record.early_leave_minutes} phút</span>`
                                    : record.has_schedule && record.check_out
                                        ? '<span class="font-body-sm text-body-sm text-green-700">Đủ giờ</span>'
                                        : '<span class="text-outline">—</span>'}
                        </td>
                        <td class="px-space-md py-space-sm font-data-mono">${Number(record.total_hours || 0)} giờ</td>
                        <td class="px-space-md py-space-sm">
                            ${record.status === "present"
                                ? '<span class="inline-flex items-center gap-1.5 px-space-sm py-1 rounded-full bg-green-50 text-green-700 text-xs font-semibold"><span class="w-1.5 h-1.5 rounded-full bg-green-500"></span>Đúng giờ</span>'
                                : record.status === "late"
                                    ? '<span class="inline-flex items-center gap-1.5 px-space-sm py-1 rounded-full bg-orange-50 text-orange-700 text-xs font-semibold"><span class="w-1.5 h-1.5 rounded-full bg-orange-500"></span>Đi muộn</span>'
                                    : record.status === "absent"
                                        ? '<span class="inline-flex items-center gap-1.5 px-space-sm py-1 rounded-full bg-red-50 text-red-700 text-xs font-semibold"><span class="w-1.5 h-1.5 rounded-full bg-red-500"></span>Vắng mặt</span>'
                                        : `<span class="inline-flex px-space-sm py-1 rounded-full bg-surface-container-high text-on-surface-variant text-xs font-semibold">${statusLabels[record.status] || record.status}</span>`}
                        </td>
                    </tr>
                `).join("")
                : '<tr><td colspan="8" class="px-space-md py-space-xl text-center text-on-surface-variant">Chưa có lịch sử chấm công.</td></tr>';
        } catch (error) {
            historyDescription.textContent = "Không thể tải lịch sử";
            historyBody.innerHTML = `<tr><td colspan="8" class="px-space-md py-space-xl text-center text-error">${error.message}</td></tr>`;
        }
    };

    const resetForm = () => {
        form.reset();
        resetSubmitButton();
        form.action = "/admin/attendance/create";
        modalTitle.textContent = "Điều chỉnh chấm công";
        employeeSelect.disabled = false;
        document.getElementById("attendance-employee-lock-note").classList.add("hidden");
        statusSelect.value = "auto";

        const today = new Date();
        dateInput.value = [
            today.getFullYear(),
            String(today.getMonth() + 1).padStart(2, "0"),
            String(today.getDate()).padStart(2, "0")
        ].join("-");

        syncStatusFields();
        clearError();
    };

    document.getElementById("open-create-attendance").addEventListener("click", () => {
        resetForm();
        openModal();
    });

    document.querySelectorAll("[data-close-attendance-modal]").forEach((button) => {
        button.addEventListener("click", closeModal);
    });
    document.querySelectorAll("[data-close-history-modal]").forEach((button) => {
        button.addEventListener("click", closeHistoryModal);
    });

    document.getElementById("attendanceBody").addEventListener("click", (event) => {
        const button = event.target.closest("[data-edit-attendance]");
        const historyButton = event.target.closest("[data-view-attendance-history]");
        if (!button && !historyButton) return;

        if (historyButton) {
            window.openAttendanceHistory(historyButton);
            return;
        }

        const data = button.dataset;
        form.reset();
        resetSubmitButton();
        form.action = `/admin/attendance/${data.id}/update`;
        modalTitle.textContent = "Điều chỉnh dữ liệu chấm công";
        employeeSelect.value = data.employeeId;
        employeeSelect.disabled = true;
        document.getElementById("attendance-employee-lock-note").classList.remove("hidden");
        dateInput.value = data.workDate;
        checkInInput.value = data.checkIn;
        checkOutInput.value = data.checkOut;
        statusSelect.value = data.status;
        syncStatusFields();
        clearError();
        openModal();
    });

    statusSelect.addEventListener("change", syncStatusFields);

    document.addEventListener("keydown", (event) => {
        if (event.key === "Escape" && !modal.classList.contains("hidden")) {
            closeModal();
        }
        if (event.key === "Escape" && !historyModal.classList.contains("hidden")) {
            closeHistoryModal();
        }
    });

    form.addEventListener("submit", (event) => {
        clearError();
        const submitButton = document.getElementById("attendance-submit");
        const submitLabel = document.getElementById("attendance-submit-label");

        if (statusSelect.value === "absent" && (checkInInput.value || checkOutInput.value)) {
            event.preventDefault();
            showError("Bản ghi vắng mặt không được có giờ vào hoặc giờ ra.");
            return;
        }

        if (statusSelect.value !== "absent" && !checkInInput.value) {
            event.preventDefault();
            showError("Vui lòng nhập giờ vào cho bản ghi có mặt.");
            return;
        }

        if (checkOutInput.value && checkOutInput.value <= checkInInput.value) {
            event.preventDefault();
            showError("Giờ ra phải sau giờ vào.");
            return;
        }

        submitButton.disabled = true;
        submitButton.setAttribute("aria-busy", "true");
        submitLabel.textContent = "Đang lưu...";
    });
});

function filterRecords() {
    const keywordInput = document.getElementById("keyword");
    const keyword = keywordInput.value.trim().toLocaleLowerCase();
    document.getElementById("clear-attendance-search").classList.toggle("hidden", !keywordInput.value);
    const date = document.getElementById("dateFilter").value;
    const status = document.getElementById("statusFilter").value;
    const rows = document.querySelectorAll(".attendance-row");
    let visible = 0;
    let attendedRows = 0;
    let absentRows = 0;
    let lateRows = 0;
    let earlyRows = 0;
    let unassignedRows = 0;

    rows.forEach((row) => {
        const matchesKeyword = !keyword
            || row.dataset.name.includes(keyword)
            || row.dataset.codeSearch.includes(keyword);
        const matchesDate = !date || row.dataset.date === date;
        const matchesStatus = !status || row.dataset.status === status;
        const show = matchesKeyword && matchesDate && matchesStatus;

        row.classList.toggle("hidden", !show);
        if (!show) return;

        visible += 1;
        if (row.dataset.status === "present" || row.dataset.status === "late") attendedRows += 1;
        if (row.dataset.status === "absent") absentRows += 1;
        if (row.dataset.isLate === "true") lateRows += 1;
        if (row.dataset.isEarly === "true") earlyRows += 1;
        if (row.dataset.noSchedule === "true") unassignedRows += 1;
    });

    const attendanceRate = visible > 0
        ? Math.round((attendedRows / visible) * 100)
        : 0;
    const absenceRate = visible > 0
        ? Math.round((absentRows / visible) * 100)
        : 0;

    document.getElementById("attendanceRateCount").textContent = attendanceRate;
    document.getElementById("attendanceRateDetail").textContent =
        `${attendedRows} / ${visible} nhân viên`;
    document.getElementById("absenceOverviewCount").textContent = `${absentRows} lượt`;
    document.getElementById("absenceOverviewRate").textContent =
        `${absenceRate}% tổng lượt ghi nhận`;
    document.getElementById("lateOverviewCount").textContent = lateRows;
    document.getElementById("earlyOverviewCount").textContent = earlyRows;
    document.getElementById("unassignedOverviewCount").textContent = unassignedRows;

    document.getElementById("emptyMessage").classList.toggle("hidden", visible !== 0);
    document.getElementById("attendanceCount").textContent = `Hiển thị ${visible} / ${rows.length} nhân viên`;
    document.getElementById("export-attendance").disabled = visible === 0;
}

let attendanceFilterTimeout;

function scheduleFilterRecords() {
    window.clearTimeout(attendanceFilterTimeout);
    attendanceFilterTimeout = window.setTimeout(filterRecords, 150);
}

function exportCSV() {
    const rows = [...document.querySelectorAll(".attendance-row")]
        .filter((row) => !row.classList.contains("hidden"));

    if (rows.length === 0) return;

    const data = [
        ["Mã nhân viên", "Nhân viên", "Ngày", "Ca làm", "Giờ vào", "Giờ ra", "Đi muộn (phút)", "Về sớm (phút)", "Số giờ", "Trạng thái"],
        ...rows.map((row) => [
            row.dataset.code,
            row.dataset.employeeName,
            row.dataset.date,
            row.dataset.shiftName,
            row.dataset.checkIn,
            row.dataset.checkOut,
            row.dataset.lateMinutes,
            row.dataset.earlyMinutes,
            row.dataset.totalHours,
            { present: "Đúng giờ", late: "Đi muộn", absent: "Vắng mặt" }[row.dataset.status] || row.dataset.status
        ])
    ];

    const csv = "\uFEFF" + data.map((row) =>
        row.map((value) => `"${value.replace(/"/g, '""')}"`).join(",")
    ).join("\n");

    const blob = new Blob([csv], { type: "text/csv;charset=utf-8;" });
    const url = URL.createObjectURL(blob);
    const link = document.createElement("a");

    link.href = url;
    link.download = "bao-cao-cham-cong.csv";
    link.click();
    window.setTimeout(() => URL.revokeObjectURL(url), 0);
}

let attendanceRefreshInProgress = false;
let lastAttendanceRowsHtml = null;
let lastEmployeeOptionsSignature = null;
let attendanceAutoSyncEnabled = true;
let attendanceAutoSyncTimer = null;

const formatRefreshTime = (date) => new Intl.DateTimeFormat("vi-VN", {
    hour: "2-digit",
    minute: "2-digit",
    second: "2-digit"
}).format(date);

function updateEmployeeOptions(employees) {
    const employeeSelect = document.getElementById("attendance-employee");
    const selectedEmployeeId = employeeSelect.value;
    const placeholder = document.createElement("option");
    placeholder.value = "";
    placeholder.textContent = "-- Chọn nhân viên --";
    employeeSelect.replaceChildren(placeholder);

    employees.forEach((employee) => {
        const option = document.createElement("option");
        option.value = String(employee.id);
        option.textContent = `${employee.employee_code} - ${employee.full_name}${employee.department ? ` (${employee.department})` : ""}`;
        employeeSelect.append(option);
    });

    employeeSelect.value = employees.some(
        (employee) => String(employee.id) === selectedEmployeeId
    ) ? selectedEmployeeId : "";
}

async function refreshAttendance(manual = false) {
    if (attendanceRefreshInProgress) return;
    if (!manual && !attendanceAutoSyncEnabled) return;
    if (!manual && document.visibilityState !== "visible") return;

    const modal = document.getElementById("attendance-modal");
    if (!manual && modal && !modal.classList.contains("hidden")) {
        document.getElementById("attendance-sync-status").textContent =
            "Tạm hoãn đồng bộ khi đang điều chỉnh";
        return;
    }

    const refreshButton = document.getElementById("refresh-attendance");
    const syncStatus = document.getElementById("attendance-sync-status");
    const lastUpdated = document.getElementById("attendance-last-updated");
    attendanceRefreshInProgress = true;
    refreshButton.disabled = true;
    refreshButton.setAttribute("aria-busy", "true");
    const refreshIcon = refreshButton.querySelector(".material-symbols-outlined");
    if (refreshIcon) refreshIcon.classList.add("animate-spin");
    syncStatus.classList.remove("text-red-600");
    syncStatus.classList.add("text-primary");
    syncStatus.textContent = "Đang đồng bộ dữ liệu...";

    try {
        const response = await fetch("/admin/attendance/refresh", {
            headers: { Accept: "application/json" },
            cache: "no-store"
        });
        const data = await response.json();

        if (!response.ok) {
            throw new Error(data.error || "Không thể đồng bộ dữ liệu chấm công.");
        }

        if (lastAttendanceRowsHtml !== data.rowsHtml) {
            document.getElementById("attendanceBody").innerHTML = data.rowsHtml;
            lastAttendanceRowsHtml = data.rowsHtml;
            filterRecords();
        }
        document.getElementById("totalEmployeesCount").textContent = data.stats.total_employees;
        document.getElementById("totalPresentCount").textContent = data.stats.present;
        document.getElementById("totalLateCount").textContent = data.stats.late;
        document.getElementById("totalAbsentCount").textContent = data.stats.absent;
        const employeeOptionsSignature = JSON.stringify(data.employees);
        if (lastEmployeeOptionsSignature !== employeeOptionsSignature) {
            updateEmployeeOptions(data.employees);
            lastEmployeeOptionsSignature = employeeOptionsSignature;
        }

        syncStatus.classList.remove("text-primary");
        syncStatus.textContent = "Tự đồng bộ mỗi 30 giây";
        lastUpdated.textContent = `Cập nhật lần cuối ${formatRefreshTime(new Date(data.refreshedAt))}`;
    } catch (error) {
        console.error("Lỗi đồng bộ bảng chấm công:", error);
        syncStatus.classList.remove("text-primary");
        syncStatus.classList.add("text-red-600");
        syncStatus.textContent = "Đồng bộ thất bại; hệ thống sẽ thử lại";
    } finally {
        attendanceRefreshInProgress = false;
        refreshButton.disabled = false;
        refreshButton.removeAttribute("aria-busy");
        const refreshIcon = refreshButton.querySelector(".material-symbols-outlined");
        if (refreshIcon) refreshIcon.classList.remove("animate-spin");
    }
}

document.addEventListener("DOMContentLoaded", () => {
    const clearButton = document.getElementById("clear-attendance-filters");
    const refreshButton = document.getElementById("refresh-attendance");
    const lastUpdated = document.getElementById("attendance-last-updated");
    const autoSyncButton = document.getElementById("toggle-auto-sync-attendance");
    const autoSyncIcon = document.getElementById("auto-sync-attendance-icon");
    const autoSyncLabel = document.getElementById("auto-sync-attendance-label");

    clearButton.addEventListener("click", () => {
        document.getElementById("keyword").value = "";
        document.getElementById("dateFilter").value = "";
        document.getElementById("statusFilter").value = "";
        filterRecords();
    });

    document.getElementById("clear-attendance-search").addEventListener("click", () => {
        document.getElementById("keyword").value = "";
        document.getElementById("clear-attendance-search").classList.add("hidden");
        filterRecords();
        document.getElementById("keyword").focus();
    });

    document.querySelectorAll("[data-attendance-status-filter]").forEach((button) => {
        button.addEventListener("click", () => {
            const statusFilter = document.getElementById("statusFilter");
            statusFilter.value = button.dataset.attendanceStatusFilter;
            filterRecords();
            document.getElementById("statusFilter").closest("section").scrollIntoView({
                behavior: "smooth",
                block: "start"
            });
        });
    });

    lastUpdated.textContent = `Trang tải lúc ${formatRefreshTime(new Date())}`;
    refreshButton.addEventListener("click", () => refreshAttendance(true));
    document.getElementById("export-attendance").addEventListener("click", async () => {
        const exportButton = document.getElementById("export-attendance");
        exportButton.disabled = true;
        try {
            const response = await fetch("/admin/attendance/export-csv", { cache: "no-store" });
            if (!response.ok) throw new Error("Không thể xuất CSV lịch sử chấm công.");
            const blob = await response.blob();
            const url = URL.createObjectURL(blob);
            const link = document.createElement("a");
            link.href = url;
            link.download = "lich-su-cham-cong.csv";
            link.click();
            window.setTimeout(() => URL.revokeObjectURL(url), 0);
        } catch (error) {
            window.alert(error.message);
        } finally {
            exportButton.disabled = false;
        }
    });
    const startAttendanceAutoSync = () => {
        window.clearInterval(attendanceAutoSyncTimer);
        attendanceAutoSyncTimer = window.setInterval(() => refreshAttendance(), 30000);
    };
    startAttendanceAutoSync();

    autoSyncButton.addEventListener("click", () => {
        attendanceAutoSyncEnabled = !attendanceAutoSyncEnabled;
        autoSyncButton.setAttribute("aria-pressed", String(attendanceAutoSyncEnabled));
        autoSyncIcon.textContent = attendanceAutoSyncEnabled ? "pause_circle" : "play_circle";
        autoSyncLabel.textContent = attendanceAutoSyncEnabled ? "Tạm dừng tự động" : "Bật tự đồng bộ";
        document.getElementById("attendance-sync-status").textContent =
            attendanceAutoSyncEnabled ? "Tự đồng bộ mỗi 30 giây" : "Tự đồng bộ đang tạm dừng";

        if (attendanceAutoSyncEnabled) {
            startAttendanceAutoSync();
            refreshAttendance(true);
        } else {
            window.clearInterval(attendanceAutoSyncTimer);
        }
    });
    document.addEventListener("visibilitychange", () => {
        if (document.visibilityState === "visible") refreshAttendance();
    });
    window.addEventListener("online", () => {
        if (attendanceAutoSyncEnabled) refreshAttendance(true);
    });

    filterRecords();
});
</script>

