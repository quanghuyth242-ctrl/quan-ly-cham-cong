        const formatTime = (value) => {
            if (!value) return "ΓÇö";

            const date = new Date(value);

            if (Number.isNaN(date.getTime())) return "ΓÇö";

            return new Intl.DateTimeFormat("vi-VN", {
                hour: "2-digit",
                minute: "2-digit",
                hour12: false
            }).format(date);
        };

        const formatDate = (value) => {
            if (!value) return "ΓÇö";

            const date = new Date(value);

            if (Number.isNaN(date.getTime())) return "ΓÇö";

            return new Intl.DateTimeFormat("vi-VN", {
                weekday: "long",
                day: "2-digit",
                month: "2-digit",
                year: "numeric"
            }).format(date);
        };

        const getInitials = (name) => {
            const parts = String(name || "").trim().split(/\s+/).filter(Boolean);

            if (parts.length === 0) return "?";

            return parts
                .slice(-2)
                .map((part) => part.charAt(0))
                .join("")
                .toUpperCase();
        };

        const getTodayString = () => {
            const now = new Date();
            const year = now.getFullYear();
            const month = String(now.getMonth() + 1).padStart(2, "0");
            const day = String(now.getDate()).padStart(2, "0");

            return `${year}-${month}-${day}`;
        };

        const statusBadgeHtml = (employee) => {
            if (!employee.check_in) {
                return `<span class="inline-flex items-center gap-1.5 px-space-sm py-0.5 rounded-full bg-surface-container-high text-on-surface-variant text-[11px] font-semibold whitespace-nowrap"><span class="w-1.5 h-1.5 rounded-full bg-outline"></span>Ch╞░a chß║Ñm</span>`;
            }

            const evaluation = employee.evaluation;

            if (!evaluation) {
                if (employee.check_out) {
                    return `<span class="inline-flex items-center gap-1.5 px-space-sm py-0.5 rounded-full bg-green-50 text-green-700 border border-green-200 text-[11px] font-semibold whitespace-nowrap"><span class="w-1.5 h-1.5 rounded-full bg-green-500"></span>─É├ú xong</span>`;
                }
                return `<span class="inline-flex items-center gap-1.5 px-space-sm py-0.5 rounded-full bg-blue-50 text-blue-700 border border-blue-200 text-[11px] font-semibold whitespace-nowrap"><span class="w-1.5 h-1.5 rounded-full bg-blue-500"></span>─Éang l├ám</span>`;
            }

            const badges = [];

            if (evaluation.isLate) {
                badges.push(`<span class="inline-flex items-center gap-1 px-space-sm py-0.5 rounded-full bg-amber-50 text-amber-700 border border-amber-200 text-[11px] font-semibold whitespace-nowrap"><span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span>Muß╗Ön ${evaluation.lateMinutes}p</span>`);
            }

            if (evaluation.isEarlyLeave) {
                badges.push(`<span class="inline-flex items-center gap-1 px-space-sm py-0.5 rounded-full bg-orange-50 text-orange-700 border border-orange-200 text-[11px] font-semibold whitespace-nowrap"><span class="w-1.5 h-1.5 rounded-full bg-orange-500"></span>Sß╗¢m ${evaluation.earlyLeaveMinutes}p</span>`);
            }

            if (badges.length === 0) {
                if (employee.check_out) {
                    return `<span class="inline-flex items-center gap-1.5 px-space-sm py-0.5 rounded-full bg-green-50 text-green-700 border border-green-200 text-[11px] font-semibold whitespace-nowrap"><span class="w-1.5 h-1.5 rounded-full bg-green-500"></span>─É├║ng giß╗¥</span>`;
                }
                return `<span class="inline-flex items-center gap-1.5 px-space-sm py-0.5 rounded-full bg-blue-50 text-blue-700 border border-blue-200 text-[11px] font-semibold whitespace-nowrap"><span class="w-1.5 h-1.5 rounded-full bg-blue-500"></span>─Éang l├ám</span>`;
            }

            return badges.join(" ");
        };

        const showToast = (type, message) => {
            const config = {
                success: {
                    icon: "check_circle",
                    classes: "bg-green-50 border-green-200 text-green-700"
                },
                error: {
                    icon: "error",
                    classes: "bg-error-container border-error/30 text-on-error-container"
                },
                info: {
                    icon: "info",
                    classes: "bg-surface-container-lowest border-surface-container-high text-on-surface"
                }
            };

            const toastConfig = config[type] || config.info;
            const toast = document.createElement("div");

            toast.className = `att-toast-in flex items-start gap-space-sm p-space-md rounded-xl border shadow-lg ${toastConfig.classes}`;
            toast.setAttribute("role", type === "error" ? "alert" : "status");
            toast.innerHTML = `
                <span class="material-symbols-outlined text-[20px] shrink-0">${toastConfig.icon}</span>
                <p class="font-body-sm text-body-sm flex-1">${escapeHtml(message)}</p>
                <button class="p-0.5 rounded-lg opacity-70 hover:opacity-100 transition-opacity shrink-0" type="button" aria-label="─É├│ng th├┤ng b├ío" data-dismiss-toast>
                    <span class="material-symbols-outlined text-[18px]">close</span>
                </button>
            `;

            toast.querySelector("[data-dismiss-toast]").addEventListener("click", () => toast.remove());
            elements.toastContainer.appendChild(toast);

            window.setTimeout(() => {
                toast.style.transition = "opacity 0.2s ease, transform 0.2s ease";
                toast.style.opacity = "0";
                toast.style.transform = "translateY(-6px)";
                window.setTimeout(() => toast.remove(), 200);
            }, 4500);
        };

        const syncBodyScroll = () => {
            const hasOpenModal = !elements.faceModal.classList.contains("hidden")
                || !elements.manualModal.classList.contains("hidden");

            document.body.classList.toggle("att-modal-open", hasOpenModal);
        };

        const openModal = (modal) => {
            state.lastFocused = document.activeElement;
            modal.classList.remove("hidden");
            modal.setAttribute("aria-hidden", "false");
            syncBodyScroll();

            const focusTarget = modal.querySelector("[data-autofocus]") || modal.querySelector("button");

            if (focusTarget) {
                focusTarget.focus();
            }
        };

        const closeModal = (modal, restoreFocus = true) => {
            modal.classList.add("hidden");
            modal.setAttribute("aria-hidden", "true");
            syncBodyScroll();

            if (restoreFocus && state.lastFocused && typeof state.lastFocused.focus === "function") {
                state.lastFocused.focus();
                state.lastFocused = null;
            }
        };

        // ---- Render ----

        const renderSkeleton = () => {
            elements.tableBody.innerHTML = Array.from({ length: 5 }, () => `
                <tr class="animate-pulse">
                    <td class="py-space-md px-space-lg">
                        <div class="flex items-center gap-space-md">
