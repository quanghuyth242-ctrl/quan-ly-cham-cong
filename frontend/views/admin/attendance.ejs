            }

            faceState.detecting = false;
        };

        const closeFaceModal = () => {
            if (faceState.capturing) return;

            faceState.open = false;
            faceState.requestId += 1;
            faceState.capturing = false;
            stopFaceDetectionLoop();
            stopFaceCamera();
            closeModal(elements.faceModal);
        };

        const updateFaceDetectionState = (detections) => {
            const video = elements.faceVideo;

            if (!video.videoWidth) {
                setFaceStatus("─Éang chuß║⌐n bß╗ï camera...", "loading");
                elements.faceCaptureBtn.disabled = true;
                return;
            }

            if (detections.length === 0) {
                setFaceStatus("Kh├┤ng ph├ít hiß╗çn khu├┤n mß║╖t", "searching");
                elements.faceHint.textContent = "─É╞░a khu├┤n mß║╖t v├áo giß╗»a khung oval v├á ─æß║úm bß║úo ─æß╗º ├ính s├íng.";
                elements.faceCaptureBtn.disabled = true;
                return;
            }

            if (detections.length > 1) {
                setFaceStatus("C├│ nhiß╗üu khu├┤n mß║╖t trong khung h├¼nh", "warning");
                elements.faceHint.textContent = "Chß╗ë ─æß╗â mß╗Öt ng╞░ß╗¥i trong khung h├¼nh tr╞░ß╗¢c khi chß║Ñm c├┤ng.";
                elements.faceCaptureBtn.disabled = true;
                return;
            }

            const box = detections[0].box;
            const widthRatio = box.width / video.videoWidth;
            const centerX = box.x + box.width / 2;
            const centerY = box.y + box.height / 2;
            const offsetX = Math.abs(centerX - video.videoWidth / 2) / video.videoWidth;
            const offsetY = Math.abs(centerY - video.videoHeight / 2) / video.videoHeight;

            if (widthRatio < 0.15) {
                setFaceStatus("Khu├┤n mß║╖t qu├í nhß╗Å", "warning");
                elements.faceHint.textContent = "─É╞░a khu├┤n mß║╖t lß║íi gß║ºn camera h╞ín.";
                elements.faceCaptureBtn.disabled = true;
                return;
            }

            if (offsetX > 0.22 || offsetY > 0.22) {
                setFaceStatus("Khu├┤n mß║╖t ch╞░a ß╗ƒ giß╗»a khung", "warning");
                elements.faceHint.textContent = "Di chuyß╗ân khu├┤n mß║╖t v├áo giß╗»a khung oval.";
                elements.faceCaptureBtn.disabled = true;
                return;
            }

            setFaceStatus("─É├ú ph├ít hiß╗çn khu├┤n mß║╖t", "success");
            elements.faceHint.textContent = "Giß╗» y├¬n, nh├¼n thß║│ng v├áo camera v├á bß║Ñm Chß║Ñm c├┤ng.";
            elements.faceCaptureBtn.disabled = false;
        };

        const startFaceDetectionLoop = () => {
            stopFaceDetectionLoop();

            const loopId = faceState.requestId;

            const scheduleNext = () => {
                if (faceState.capturing) return;
                if (loopId !== faceState.requestId) return;
                if (!faceState.open) return;

                faceState.detectionTimer = window.setTimeout(runDetection, 350);
