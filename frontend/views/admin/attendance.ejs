            elements.faceStatusIcon.classList.toggle("animate-spin", type === "loading");
            elements.faceStatusIcon.classList.toggle("text-green-400", type === "success");
            elements.faceStatusIcon.classList.toggle("text-amber-300", type === "warning");
            elements.faceStatusIcon.classList.toggle("text-red-300", type === "error");
