<div
    id="att-gps-settings-modal"
    class="fixed inset-0 z-[70] hidden"
    role="dialog"
    aria-modal="true"
    aria-labelledby="att-gps-settings-title"
    aria-hidden="true"
    data-latitude="<%= typeof gpsSettings !== 'undefined' && gpsSettings && gpsSettings.latitude !== null ? gpsSettings.latitude : '' %>"
    data-longitude="<%= typeof gpsSettings !== 'undefined' && gpsSettings && gpsSettings.longitude !== null ? gpsSettings.longitude : '' %>"
    data-radius="<%= typeof gpsSettings !== 'undefined' && gpsSettings ? gpsSettings.radius_m : 100 %>"
    data-configured="<%= typeof gpsSettings !== 'undefined' && gpsSettings && gpsSettings.configured ? 'true' : 'false' %>"
>
    <div class="absolute inset-0 bg-black/40 backdrop-blur-sm" data-close-modal="gps-settings"></div>
    <div class="relative flex min-h-full items-center justify-center p-space-lg">
        <section class="w-full max-w-xl bg-surface-container-lowest rounded-xl shadow-xl overflow-hidden">
            <div class="flex items-start justify-between gap-space-md px-space-xl py-space-lg border-b border-surface-container-high">
                <div>
                    <h3 id="att-gps-settings-title" class="font-headline-sm text-headline-sm text-primary font-semibold">Cấu hình vùng chấm công GPS</h3>
                    <p id="att-gps-settings-status" class="font-body-sm text-body-sm text-on-surface-variant mt-space-xs"></p>
                </div>
                <button class="p-space-sm rounded-xl text-on-surface-variant hover:bg-surface-container-high" data-close-modal="gps-settings" type="button" aria-label="Đóng">
                    <span class="material-symbols-outlined">close</span>
                </button>
            </div>
            <form id="att-gps-settings-form" class="p-space-xl flex flex-col gap-space-lg">
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-space-md">
                    <div>
                        <label class="font-label-sm text-on-surface block mb-space-xs" for="att-gps-latitude">Vĩ độ</label>
                        <input id="att-gps-latitude" name="latitude" type="number" step="any" min="-90" max="90" required class="w-full bg-surface-container-low px-space-md py-space-sm rounded-xl outline-none focus:ring-2 focus:ring-primary/20">
                    </div>
                    <div>
                        <label class="font-label-sm text-on-surface block mb-space-xs" for="att-gps-longitude">Kinh độ</label>
                        <input id="att-gps-longitude" name="longitude" type="number" step="any" min="-180" max="180" required class="w-full bg-surface-container-low px-space-md py-space-sm rounded-xl outline-none focus:ring-2 focus:ring-primary/20">
                    </div>
                </div>
                <button id="att-gps-use-current" class="self-start flex items-center gap-space-xs text-primary hover:text-primary-container font-label-sm" type="button">
                    <span class="material-symbols-outlined text-[18px]">my_location</span>
                    <span>Dùng vị trí hiện tại làm cơ sở</span>
                </button>
                <div>
                    <label class="font-label-sm text-on-surface block mb-space-xs" for="att-gps-radius">Bán kính cho phép (mét)</label>
                    <input id="att-gps-radius" name="radius_m" type="number" min="20" max="5000" step="1" required class="w-full bg-surface-container-low px-space-md py-space-sm rounded-xl outline-none focus:ring-2 focus:ring-primary/20">
                    <p class="font-body-sm text-body-sm text-on-surface-variant mt-space-xs">Cho phép từ 20 đến 5.000 mét tính từ vị trí cơ sở.</p>
                </div>
                <div id="att-gps-settings-error" class="hidden p-space-md rounded-xl bg-error-container text-on-error-container font-body-sm" role="alert"></div>
            </form>
            <div class="flex flex-col-reverse sm:flex-row sm:justify-end gap-space-sm px-space-xl py-space-lg border-t border-surface-container-high bg-surface-container-low">
                <button class="px-space-lg py-space-sm bg-surface-container-high hover:bg-surface-container text-on-surface font-label-md rounded-xl" data-close-modal="gps-settings" type="button">Đóng</button>
                <button id="att-gps-settings-save" class="flex items-center justify-center gap-space-xs bg-primary hover:bg-primary-container text-on-primary px-space-lg py-space-sm rounded-xl font-label-md disabled:opacity-60" type="submit" form="att-gps-settings-form">
                    <span class="material-symbols-outlined text-[18px]">save</span>
                    <span>Lưu cấu hình</span>
                </button>
            </div>
        </section>
    </div>
</div>

