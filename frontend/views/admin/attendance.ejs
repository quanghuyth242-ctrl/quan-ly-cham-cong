            setFaceStatus("Bß║Ñm n├║t b├¬n d╞░ß╗¢i ─æß╗â bß║»t ─æß║ºu", "info");
            elements.faceHint.textContent = "Nh├¼n thß║│ng v├áo camera, giß╗» khu├┤n mß║╖t trong khung oval. Hß╗ç thß╗æng sß║╜ tß╗▒ ─æß╗Öng nhß║¡n diß╗çn.";
            setFaceAction("check_in");

            openModal(elements.faceModal);
        };

        // ---- Chß║Ñm c├┤ng thß╗º c├┤ng ----

        const closeManualModal = () => {
            if (manualState.submitting) return;

            manualState.open = false;
            closeModal(elements.manualModal);
