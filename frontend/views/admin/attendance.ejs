<!-- Modal cấu hình vùng GPS -->
<div
    id="att-gps-settings-modal"
    class="fixed inset-0 z-[70] hidden"
    role="dialog"
    aria-modal="true"
    aria-labelledby="att-gps-settings-title"
    aria-hidden="true"
    data-latitude="<%= typeof gpsSettings !== 'undefined' && gpsSettings && gpsSettings.latitude !== null ? gpsSettings.latitude : '' %>"
    data-longitude="<%= typeof gpsSettings !== 'undefined' && gpsSettings && gpsSettings.longitude !== null ? gpsSettings.longitude : '' %>"
    data-radius="<%= typeof gpsSettings !== 'undefined' && gpsSettings ? gpsSettings.radius_m : 100 %>"
    data-configured="<%= typeof gpsSettings !== 'undefined' && gpsSettings && gpsSettings.configured ? 'true' : 'false' %>"
>
    <div class="absolute inset-0 bg-black/40 backdrop-blur-sm" data-close-modal="gps-settings"></div>
    <div class="relative flex min-h-full items-center justify-center p-space-lg">
        <section class="w-full max-w-xl bg-surface-container-lowest rounded-xl shadow-xl overflow-hidden">
            <div class="flex items-start justify-between gap-space-md px-space-xl py-space-lg border-b border-surface-container-high">
                <div>
                    <h3 id="att-gps-settings-title" class="font-headline-sm text-headline-sm text-primary font-semibold">Cấu hình vùng chấm công GPS</h3>
                    <p id="att-gps-settings-status" class="font-body-sm text-body-sm text-on-surface-variant mt-space-xs"></p>
                </div>
                <button class="p-space-sm rounded-xl text-on-surface-variant hover:bg-surface-container-high" data-close-modal="gps-settings" type="button" aria-label="Đóng">
                    <span class="material-symbols-outlined">close</span>
                </button>
            </div>
            <form id="att-gps-settings-form" class="p-space-xl flex flex-col gap-space-lg">
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-space-md">
                    <div>
                        <label class="font-label-sm text-on-surface block mb-space-xs" for="att-gps-latitude">Vĩ độ</label>
                        <input id="att-gps-latitude" name="latitude" type="number" step="any" min="-90" max="90" required class="w-full bg-surface-container-low px-space-md py-space-sm rounded-xl outline-none focus:ring-2 focus:ring-primary/20">
                    </div>
                    <div>
                        <label class="font-label-sm text-on-surface block mb-space-xs" for="att-gps-longitude">Kinh độ</label>
                        <input id="att-gps-longitude" name="longitude" type="number" step="any" min="-180" max="180" required class="w-full bg-surface-container-low px-space-md py-space-sm rounded-xl outline-none focus:ring-2 focus:ring-primary/20">
                    </div>
                </div>
                <button id="att-gps-use-current" class="self-start flex items-center gap-space-xs text-primary hover:text-primary-container font-label-sm" type="button">
                    <span class="material-symbols-outlined text-[18px]">my_location</span>
                    <span>Dùng vị trí hiện tại làm cơ sở</span>
                </button>
                <div>
                    <label class="font-label-sm text-on-surface block mb-space-xs" for="att-gps-radius">Bán kính cho phép (mét)</label>
                    <input id="att-gps-radius" name="radius_m" type="number" min="20" max="5000" step="1" required class="w-full bg-surface-container-low px-space-md py-space-sm rounded-xl outline-none focus:ring-2 focus:ring-primary/20">
                    <p class="font-body-sm text-body-sm text-on-surface-variant mt-space-xs">Cho phép từ 20 đến 5.000 mét tính từ vị trí cơ sở.</p>
                </div>
                <div id="att-gps-settings-error" class="hidden p-space-md rounded-xl bg-error-container text-on-error-container font-body-sm" role="alert"></div>
            </form>
            <div class="flex flex-col-reverse sm:flex-row sm:justify-end gap-space-sm px-space-xl py-space-lg border-t border-surface-container-high bg-surface-container-low">
                <button class="px-space-lg py-space-sm bg-surface-container-high hover:bg-surface-container text-on-surface font-label-md rounded-xl" data-close-modal="gps-settings" type="button">Đóng</button>
                <button id="att-gps-settings-save" class="flex items-center justify-center gap-space-xs bg-primary hover:bg-primary-container text-on-primary px-space-lg py-space-sm rounded-xl font-label-md disabled:opacity-60" type="submit" form="att-gps-settings-form">
                    <span class="material-symbols-outlined text-[18px]">save</span>
                    <span>Lưu cấu hình</span>
                </button>
            </div>
        </section>
    </div>
</div>

<!-- Thông báo -->
<div
    id="att-toast-container"
    class="fixed top-20 right-4 z-[80] flex flex-col gap-space-sm w-80 max-w-[90vw]"
    aria-live="polite"
    aria-atomic="false"
></div>

<script>
    (() => {
        "use strict";

        const API_BASE = "/admin/attendance";

        const state = {
            date: "",
            search: "",
            department: "",
            status: "all",
            employees: [],
            departments: [],
            stats: {
                total: 0,
                checkedIn: 0,
                checkedOut: 0,
                late: 0,
                earlyLeave: 0,
                deviceRecords: 0,
                notCheckedIn: 0
            },
            requestId: 0,
            lastFocused: null
        };

        const elements = {
            refreshBtn: document.getElementById("att-refresh"),
            refreshIcon: document.getElementById("att-refresh-icon"),
            faceCheckinBtn: document.getElementById("att-face-checkin"),
            gpsSettingsOpenBtn: document.getElementById("att-gps-settings-open"),
            dateInput: document.getElementById("att-date"),
            searchInput: document.getElementById("att-search"),
            departmentSelect: document.getElementById("att-department"),
            statusSelect: document.getElementById("att-status"),
            applyFilterBtn: document.getElementById("att-apply-filter"),
            resetFilterBtn: document.getElementById("att-reset-filter"),
            statTotal: document.getElementById("att-stat-total"),
            statCheckedIn: document.getElementById("att-stat-checkedin"),
            statCheckedOut: document.getElementById("att-stat-checkedout"),
            statLate: document.getElementById("att-stat-late"),
            statEarly: document.getElementById("att-stat-early"),
            statDevice: document.getElementById("att-stat-device"),
            statNotCheckedIn: document.getElementById("att-stat-notcheckedin"),
            tableBody: document.getElementById("att-table-body"),
            tableSummary: document.getElementById("att-table-summary"),
            tableDate: document.getElementById("att-table-date"),
            faceModal: document.getElementById("att-face-modal"),
            faceVideo: document.getElementById("att-face-video"),
            facePlaceholder: document.getElementById("att-face-placeholder"),
            faceStatusIcon: document.getElementById("att-face-status-icon"),
            faceStatusText: document.getElementById("att-face-status-text"),
            faceHint: document.getElementById("att-face-hint"),
            faceError: document.getElementById("att-face-error"),
            faceErrorMessage: document.getElementById("att-face-error-message"),
            faceResult: document.getElementById("att-face-result"),
            faceResultMessage: document.getElementById("att-face-result-message"),
            faceResultEmployee: document.getElementById("att-face-result-employee"),
            faceResultDetail: document.getElementById("att-face-result-detail"),
            faceStartBtn: document.getElementById("att-face-start"),
            faceCaptureBtn: document.getElementById("att-face-capture"),
            faceRetryBtn: document.getElementById("att-face-retry"),
            faceActionCheckin: document.getElementById("att-face-action-checkin"),
            faceActionCheckout: document.getElementById("att-face-action-checkout"),
            manualModal: document.getElementById("att-manual-modal"),
            manualEmployeeName: document.getElementById("att-manual-employee-name"),
            manualEmployeeCode: document.getElementById("att-manual-employee-code"),
            manualActionCheckin: document.getElementById("att-manual-action-checkin"),
            manualActionCheckout: document.getElementById("att-manual-action-checkout"),
            manualReason: document.getElementById("att-manual-reason"),
            manualError: document.getElementById("att-manual-error"),
            manualErrorMessage: document.getElementById("att-manual-error-message"),
            manualSubmitBtn: document.getElementById("att-manual-submit"),
            gpsModal: document.getElementById("att-gps-modal"),
            gpsEmployee: document.getElementById("att-gps-employee"),
            gpsActionLabel: document.getElementById("att-gps-action-label"),
            gpsError: document.getElementById("att-gps-error"),
            gpsErrorMessage: document.getElementById("att-gps-error-message"),
            gpsSubmitBtn: document.getElementById("att-gps-submit"),
            gpsSettingsModal: document.getElementById("att-gps-settings-modal"),
            gpsSettingsStatus: document.getElementById("att-gps-settings-status"),
            gpsSettingsForm: document.getElementById("att-gps-settings-form"),
            gpsLatitude: document.getElementById("att-gps-latitude"),
            gpsLongitude: document.getElementById("att-gps-longitude"),
            gpsRadius: document.getElementById("att-gps-radius"),
            gpsUseCurrentBtn: document.getElementById("att-gps-use-current"),
            gpsSettingsError: document.getElementById("att-gps-settings-error"),
            gpsSettingsSaveBtn: document.getElementById("att-gps-settings-save"),
            toastContainer: document.getElementById("att-toast-container")
        };

        const faceState = {
            open: false,
            action: "check_in",
            stream: null,
            faceapi: null,
            detectionTimer: null,
            detecting: false,
            requestId: 0,
            starting: false,
            capturing: false
        };

        const manualState = {
            open: false,
            employee: null,
            action: "check_in",
            submitting: false
        };

        const gpsState = {
            employee: null,
            action: "check_in",
            submitting: false
        };

        let faceApiModelsPromise = null;
        let faceApiScriptPromise = null;

        const escapeHtml = (value) => String(value ?? "").replace(/[&<>"']/g, (character) => ({
            "&": "&amp;",
            "<": "&lt;",
            ">": "&gt;",
            '"': "&quot;",
            "'": "&#39;"
        }[character]));

        const setText = (element, value) => {
            if (element) {
                element.textContent = value === null || value === undefined || value === "" ? "—" : value;
            }
        };

        const formatTime = (value) => {
            if (!value) return "—";

            const date = new Date(value);

            if (Number.isNaN(date.getTime())) return "—";

            return new Intl.DateTimeFormat("vi-VN", {
                hour: "2-digit",
                minute: "2-digit",
                hour12: false
            }).format(date);
        };

        const formatDate = (value) => {
            if (!value) return "—";

            const date = new Date(value);

            if (Number.isNaN(date.getTime())) return "—";

            return new Intl.DateTimeFormat("vi-VN", {
                weekday: "long",
                day: "2-digit",
                month: "2-digit",
                year: "numeric"
            }).format(date);
        };

        const getInitials = (name) => {
            const parts = String(name || "").trim().split(/\s+/).filter(Boolean);

            if (parts.length === 0) return "?";

            return parts
                .slice(-2)
                .map((part) => part.charAt(0))
                .join("")
                .toUpperCase();
        };

        const getTodayString = () => {
            const now = new Date();
            const year = now.getFullYear();
            const month = String(now.getMonth() + 1).padStart(2, "0");
            const day = String(now.getDate()).padStart(2, "0");

            return `${year}-${month}-${day}`;
        };

        const gpsLocationHtml = (latitude, longitude, accuracy, distance) => {
            if (latitude === null || latitude === undefined || latitude === ""
                || longitude === null || longitude === undefined || longitude === "") {
                return "";
            }

            const lat = Number(latitude);
            const lng = Number(longitude);
            if (!Number.isFinite(lat) || !Number.isFinite(lng)) return "";

            const coordinates = `${lat.toFixed(6)},${lng.toFixed(6)}`;
            const mapUrl = `https://www.google.com/maps?q=${encodeURIComponent(`${lat},${lng}`)}`;
            const accuracyLabel = Number.isFinite(Number(accuracy))
                ? `±${Math.round(Number(accuracy))}m`
                : "GPS";
            const distanceLabel = Number.isFinite(Number(distance))
                ? ` · cách cơ sở ${Math.round(Number(distance))}m`
                : "";

            return `<a class="inline-flex items-center gap-0.5 text-[10px] text-primary hover:underline font-sans whitespace-nowrap" href="${mapUrl}" target="_blank" rel="noopener noreferrer" title="${coordinates}${distanceLabel}">${accuracyLabel}${distanceLabel}</a>`;
        };

        const statusBadgeHtml = (employee) => {
            if (!employee.check_in) {
                return `<span class="inline-flex items-center gap-1.5 px-space-sm py-0.5 rounded-full bg-surface-container-high text-on-surface-variant text-[11px] font-semibold whitespace-nowrap"><span class="w-1.5 h-1.5 rounded-full bg-outline"></span>Chưa chấm</span>`;
            }

            const evaluation = employee.evaluation;

            if (!evaluation) {
                if (employee.check_out) {
                    return `<span class="inline-flex items-center gap-1.5 px-space-sm py-0.5 rounded-full bg-green-50 text-green-700 border border-green-200 text-[11px] font-semibold whitespace-nowrap"><span class="w-1.5 h-1.5 rounded-full bg-green-500"></span>Đã xong</span>`;
                }
                return `<span class="inline-flex items-center gap-1.5 px-space-sm py-0.5 rounded-full bg-blue-50 text-blue-700 border border-blue-200 text-[11px] font-semibold whitespace-nowrap"><span class="w-1.5 h-1.5 rounded-full bg-blue-500"></span>Đang làm</span>`;
            }

            const badges = [];

            if (evaluation.isLate) {
                badges.push(`<span class="inline-flex items-center gap-1 px-space-sm py-0.5 rounded-full bg-amber-50 text-amber-700 border border-amber-200 text-[11px] font-semibold whitespace-nowrap"><span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span>Muộn ${evaluation.lateMinutes}p</span>`);
            }

            if (evaluation.isEarlyLeave) {
                badges.push(`<span class="inline-flex items-center gap-1 px-space-sm py-0.5 rounded-full bg-orange-50 text-orange-700 border border-orange-200 text-[11px] font-semibold whitespace-nowrap"><span class="w-1.5 h-1.5 rounded-full bg-orange-500"></span>Sớm ${evaluation.earlyLeaveMinutes}p</span>`);
            }

            if (badges.length === 0) {
                if (employee.check_out) {
                    return `<span class="inline-flex items-center gap-1.5 px-space-sm py-0.5 rounded-full bg-green-50 text-green-700 border border-green-200 text-[11px] font-semibold whitespace-nowrap"><span class="w-1.5 h-1.5 rounded-full bg-green-500"></span>Đúng giờ</span>`;
                }
                return `<span class="inline-flex items-center gap-1.5 px-space-sm py-0.5 rounded-full bg-blue-50 text-blue-700 border border-blue-200 text-[11px] font-semibold whitespace-nowrap"><span class="w-1.5 h-1.5 rounded-full bg-blue-500"></span>Đang làm</span>`;
            }

            return badges.join(" ");
        };

        const showToast = (type, message) => {
            const config = {
                success: {
                    icon: "check_circle",
                    classes: "bg-green-50 border-green-200 text-green-700"
                },
                error: {
                    icon: "error",
                    classes: "bg-error-container border-error/30 text-on-error-container"
                },
                info: {
                    icon: "info",
                    classes: "bg-surface-container-lowest border-surface-container-high text-on-surface"
                }
            };

            const toastConfig = config[type] || config.info;
            const toast = document.createElement("div");

            toast.className = `att-toast-in flex items-start gap-space-sm p-space-md rounded-xl border shadow-lg ${toastConfig.classes}`;
            toast.setAttribute("role", type === "error" ? "alert" : "status");
            toast.innerHTML = `
                <span class="material-symbols-outlined text-[20px] shrink-0">${toastConfig.icon}</span>
                <p class="font-body-sm text-body-sm flex-1">${escapeHtml(message)}</p>
                <button class="p-0.5 rounded-lg opacity-70 hover:opacity-100 transition-opacity shrink-0" type="button" aria-label="Đóng thông báo" data-dismiss-toast>
                    <span class="material-symbols-outlined text-[18px]">close</span>
                </button>
            `;

            toast.querySelector("[data-dismiss-toast]").addEventListener("click", () => toast.remove());
            elements.toastContainer.appendChild(toast);

            window.setTimeout(() => {
                toast.style.transition = "opacity 0.2s ease, transform 0.2s ease";
                toast.style.opacity = "0";
                toast.style.transform = "translateY(-6px)";
                window.setTimeout(() => toast.remove(), 200);
            }, 4500);
        };

        const syncBodyScroll = () => {
            const hasOpenModal = !elements.faceModal.classList.contains("hidden")
                || !elements.manualModal.classList.contains("hidden")
                || !elements.gpsModal.classList.contains("hidden")
                || !elements.gpsSettingsModal.classList.contains("hidden");

            document.body.classList.toggle("att-modal-open", hasOpenModal);
        };

        const openModal = (modal) => {
            state.lastFocused = document.activeElement;
            modal.classList.remove("hidden");
            modal.setAttribute("aria-hidden", "false");
            syncBodyScroll();

            const focusTarget = modal.querySelector("[data-autofocus]") || modal.querySelector("button");

            if (focusTarget) {
                focusTarget.focus();
            }
        };

        const closeModal = (modal, restoreFocus = true) => {
            modal.classList.add("hidden");
            modal.setAttribute("aria-hidden", "true");
            syncBodyScroll();

            if (restoreFocus && state.lastFocused && typeof state.lastFocused.focus === "function") {
                state.lastFocused.focus();
                state.lastFocused = null;
            }
        };

        // ---- Render ----

        const renderSkeleton = () => {
            elements.tableBody.innerHTML = Array.from({ length: 5 }, () => `
                <tr class="animate-pulse">
                    <td class="py-space-md px-space-lg">
                        <div class="flex items-center gap-space-md">
                            <div class="w-9 h-9 rounded-full bg-surface-container-high shrink-0"></div>
                            <div class="flex flex-col gap-1.5 flex-1">
                                <div class="h-3 bg-surface-container-high rounded w-32 max-w-full"></div>
                                <div class="h-2.5 bg-surface-container-high rounded w-24 max-w-full"></div>
                            </div>
                        </div>
                    </td>
                    <td class="py-space-md px-space-md"><div class="h-3 bg-surface-container-high rounded w-20"></div></td>
                    <td class="py-space-md px-space-md"><div class="h-3 bg-surface-container-high rounded w-16"></div></td>
                    <td class="py-space-md px-space-md"><div class="h-3 bg-surface-container-high rounded w-14"></div></td>
                    <td class="py-space-md px-space-md"><div class="h-3 bg-surface-container-high rounded w-14"></div></td>
                    <td class="py-space-md px-space-md"><div class="h-5 bg-surface-container-high rounded-full w-20"></div></td>
                    <td class="py-space-md px-space-lg"><div class="h-7 bg-surface-container-high rounded-lg w-28 ml-auto"></div></td>
                </tr>
            `).join("");
        };

        const renderStats = () => {
            const { total, checkedIn, checkedOut, late, earlyLeave, deviceRecords, notCheckedIn } = state.stats;

            setText(elements.statTotal, total);
            setText(elements.statCheckedIn, checkedIn);
            setText(elements.statCheckedOut, checkedOut);
            setText(elements.statLate, late);
            setText(elements.statEarly, earlyLeave);
            setText(elements.statDevice, deviceRecords);
            setText(elements.statNotCheckedIn, notCheckedIn);
        };

        const updateSummary = () => {
            elements.tableSummary.textContent = `Hiển thị ${state.employees.length} nhân viên`;
            elements.tableDate.textContent = `Ngày: ${formatDate(state.date + "T00:00:00")}`;
        };

        const renderRow = (employee) => {
            const initials = getInitials(employee.full_name);
            const safeName = escapeHtml(employee.full_name);
            const safeCode = escapeHtml(employee.employee_code);
            const checkIn = employee.check_in ? formatTime(employee.check_in) : "—";
            const checkOut = employee.check_out ? formatTime(employee.check_out) : "—";
            const shiftName = employee.evaluation?.shift?.shift_name || "—";
            const expectedTime = employee.evaluation?.expectedStart && employee.evaluation?.expectedEnd
                ? `${escapeHtml(employee.evaluation.expectedStart)} - ${escapeHtml(employee.evaluation.expectedEnd)}`
                : "";
            const faceRegistered = Boolean(employee.face_registered);

            const canCheckIn = !employee.check_in;
            const canCheckOut = employee.check_in && !employee.check_out;
            const canGpsAttend = state.date === getTodayString() && (canCheckIn || canCheckOut);

            let actions = "";

            if (canCheckIn || canCheckOut) {
                const action = canCheckIn ? "check_in" : "check_out";
                if (canGpsAttend) {
                    actions += `
                    <button
                        class="flex items-center gap-1 px-space-sm py-1 bg-primary-fixed text-primary hover:bg-primary hover:text-on-primary font-label-sm text-label-sm rounded-lg transition-colors"
                        data-gps-id="${escapeHtml(employee.employee_id)}"
                        data-gps-action="${action}"
                        data-employee-name="${safeName}"
                        data-employee-code="${safeCode}"
                        type="button"
                        title="${canCheckIn ? "Check-in GPS" : "Check-out GPS"}"
                    >
                        <span class="material-symbols-outlined text-[16px]">my_location</span>
                        <span>GPS ${canCheckIn ? "vào" : "ra"}</span>
                    </button>
                    `;
                }
                actions += `
                    <button
                        class="flex items-center gap-1 px-space-sm py-1 bg-secondary-fixed text-on-secondary-fixed hover:bg-secondary hover:text-white font-label-sm text-label-sm rounded-lg transition-colors"
                        data-manual-id="${escapeHtml(employee.employee_id)}"
                        data-manual-action="${canCheckIn ? "check_in" : "check_out"}"
                        data-employee-name="${safeName}"
                        data-employee-code="${safeCode}"
                        type="button"
                        title="${canCheckIn ? "Check-in thủ công" : "Check-out thủ công"}"
                    >
                        <span class="material-symbols-outlined text-[16px]">${canCheckIn ? "login" : "logout"}</span>
                        <span>${canCheckIn ? "Check-in" : "Check-out"}</span>
                    </button>
                `;
            }

            return `
                <tr class="hover:bg-surface-container-low/70 align-middle transition-colors">
                    <td class="py-space-md px-space-lg">
                        <div class="flex items-center gap-space-md">
                            <div class="w-9 h-9 rounded-full bg-primary-fixed text-on-primary-fixed font-semibold flex items-center justify-center text-sm shrink-0">
                                ${escapeHtml(initials)}
                            </div>
                            <div class="flex flex-col min-w-0">
                                <span class="font-label-md text-label-md text-on-surface font-semibold truncate">${safeName}</span>
                                <span class="font-data-mono text-[11px] text-on-surface-variant truncate">
                                    ${safeCode}${faceRegistered ? ' <span class="text-green-600">●</span>' : ""}
                                    ${employee.record_source === "device" ? '<span class="inline-flex items-center gap-0.5 ml-1 px-1.5 py-0.5 rounded bg-blue-50 text-blue-700 font-sans font-semibold"><span class="material-symbols-outlined text-[12px]">devices</span>Thiết bị</span>' : ""}
                                </span>
                            </div>
                        </div>
                    </td>
                    <td class="py-space-md px-space-md text-on-surface-variant">
                        ${escapeHtml(employee.department || "—")}
                    </td>
                    <td class="py-space-md px-space-md">
                        <div class="flex flex-col">
                            <span class="text-on-surface-variant">${escapeHtml(shiftName)}</span>
                            ${expectedTime ? `<span class="font-data-mono text-[11px] text-on-surface-variant">${expectedTime}</span>` : ""}
                        </div>
                    </td>
                    <td class="py-space-md px-space-md font-data-mono text-data-mono whitespace-nowrap ${employee.evaluation?.isLate ? "text-amber-600 font-semibold" : "text-on-surface-variant"}">
                        ${escapeHtml(checkIn)}
                        ${gpsLocationHtml(employee.check_in_latitude, employee.check_in_longitude, employee.check_in_accuracy_m, employee.check_in_distance_m)}
                    </td>
                    <td class="py-space-md px-space-md font-data-mono text-data-mono whitespace-nowrap ${employee.evaluation?.isEarlyLeave ? "text-orange-600 font-semibold" : "text-on-surface-variant"}">
                        ${escapeHtml(checkOut)}
                        ${gpsLocationHtml(employee.check_out_latitude, employee.check_out_longitude, employee.check_out_accuracy_m, employee.check_out_distance_m)}
                    </td>
                    <td class="py-space-md px-space-md">
                        ${statusBadgeHtml(employee)}
                    </td>
                    <td class="py-space-md px-space-lg">
                        <div class="flex items-center justify-end gap-space-xs flex-wrap">
                            ${actions}
                        </div>
                    </td>
                </tr>
            `;
        };

        const renderTable = () => {
            if (state.employees.length === 0) {
                elements.tableBody.innerHTML = `
                    <tr>
                        <td colspan="7" class="py-space-2xl px-space-lg">
                            <div class="flex flex-col items-center justify-center gap-space-sm text-center">
                                <div class="w-14 h-14 rounded-full bg-surface-container-low text-on-surface-variant flex items-center justify-center">
                                    <span class="material-symbols-outlined text-[28px]">group_off</span>
                                </div>
                                <p class="font-label-md text-label-md text-on-surface">Không tìm thấy nhân viên phù hợp</p>
                                <p class="font-body-sm text-body-sm text-on-surface-variant">Thử thay đổi ngày, từ khóa hoặc bộ lọc.</p>
                                <button
                                    class="mt-space-xs flex items-center gap-space-xs bg-surface-container-high hover:bg-surface-container text-on-surface px-space-md py-space-sm rounded-xl font-label-sm text-label-sm transition-colors"
                                    data-reset-filter
                                    type="button"
                                >
                                    <span class="material-symbols-outlined text-[18px]">filter_alt_off</span>
                                    <span>Xóa bộ lọc</span>
                                </button>
                            </div>
                        </td>
                    </tr>
                `;
                return;
            }

            elements.tableBody.innerHTML = state.employees.map(renderRow).join("");
        };

        const renderErrorState = (message) => {
            elements.tableBody.innerHTML = `
                <tr>
                    <td colspan="7" class="py-space-2xl px-space-lg">
                        <div class="flex flex-col items-center justify-center gap-space-sm text-center">
                            <div class="w-14 h-14 rounded-full bg-error-container text-on-error-container flex items-center justify-center">
                                <span class="material-symbols-outlined text-[28px]">cloud_off</span>
                            </div>
                            <p class="font-label-md text-label-md text-on-surface">Không tải được dữ liệu</p>
                            <p class="font-body-sm text-body-sm text-on-surface-variant max-w-md">${escapeHtml(message)}</p>
                            <button
                                class="mt-space-xs flex items-center gap-space-xs bg-primary hover:bg-primary-container text-on-primary px-space-md py-space-sm rounded-xl font-label-sm text-label-sm transition-colors"
                                data-retry
                                type="button"
                            >
                                <span class="material-symbols-outlined text-[18px]">refresh</span>
                                <span>Thử lại</span>
                            </button>
                        </div>
                    </td>
                </tr>
            `;
        };

        const setLoading = (loading) => {
            elements.refreshBtn.disabled = loading;
            elements.refreshIcon.classList.toggle("animate-spin", loading);

            if (loading) {
                elements.tableSummary.textContent = "Đang tải dữ liệu...";

                if (state.employees.length === 0) {
                    renderSkeleton();
                }

                elements.tableBody.classList.toggle("opacity-60", state.employees.length > 0);
            } else {
                elements.tableBody.classList.remove("opacity-60");
            }
        };

        const populateDepartments = (departments) => {
            const current = elements.departmentSelect.value;

            elements.departmentSelect.innerHTML = `<option value="">Tất cả phòng ban</option>`;

            departments.forEach((dept) => {
                const option = document.createElement("option");
                option.value = dept;
                option.textContent = dept;
                elements.departmentSelect.appendChild(option);
            });

            if (current) {
                elements.departmentSelect.value = current;
            }
        };

        const loadData = async () => {
            const requestId = ++state.requestId;

            setLoading(true);

            try {
                const params = new URLSearchParams();

                if (state.date) {
                    params.set("date", state.date);
                }

                if (state.search) {
                    params.set("search", state.search);
                }

                if (state.department) {
                    params.set("department", state.department);
                }

                if (state.status && state.status !== "all") {
                    params.set("status", state.status);
                }

                const query = params.toString();
                const response = await fetch(`${API_BASE}/data${query ? `?${query}` : ""}`, {
                    headers: {
                        Accept: "application/json"
                    }
                });

                let payload = {};

                try {
                    payload = await response.json();
                } catch {
                    payload = {};
                }

                if (requestId !== state.requestId) return;

                if (!response.ok || !payload.success) {
                    throw new Error(payload.message || "Không thể lấy bảng chấm công.");
                }

                state.employees = Array.isArray(payload.employees) ? payload.employees : [];
                state.date = payload.date || state.date;
                state.stats = {
                    total: Number(payload.stats?.total || 0),
                    checkedIn: Number(payload.stats?.checkedIn || 0),
                    checkedOut: Number(payload.stats?.checkedOut || 0),
                    late: Number(payload.stats?.late || 0),
                    earlyLeave: Number(payload.stats?.earlyLeave || 0),
                    deviceRecords: Number(payload.stats?.deviceRecords || 0),
                    notCheckedIn: Number(payload.stats?.notCheckedIn || 0)
                };

                if (Array.isArray(payload.departments)) {
                    state.departments = payload.departments;
                    populateDepartments(payload.departments);
                }

                if (elements.dateInput.value !== state.date) {
                    elements.dateInput.value = state.date;
                }

                renderStats();
                renderTable();
                updateSummary();
            } catch (error) {
                if (requestId !== state.requestId) return;

                state.employees = [];
                renderErrorState(error.message);
                elements.tableSummary.textContent = "Không tải được dữ liệu";
                elements.tableDate.textContent = "";
                showToast("error", error.message);
            } finally {
                if (requestId === state.requestId) {
                    setLoading(false);
                }
            }
        };

        const resetFilters = () => {
            window.clearTimeout(searchTimer);
            elements.searchInput.value = "";
            elements.departmentSelect.value = "";
            elements.statusSelect.value = "all";
            elements.dateInput.value = getTodayString();
            state.search = "";
            state.department = "";
            state.status = "all";
            state.date = getTodayString();
            loadData();
        };

        // ---- Chấm công khuôn mặt ----

        const FACE_API_SCRIPT_URL = "/vendor/face-api/face-api.js";
        const FACE_API_MODEL_URL = "/vendor/face-api/models";

        const loadFaceApiScript = () => {
            if (window.faceapi) {
                return Promise.resolve(window.faceapi);
            }

            if (faceApiScriptPromise) {
                return faceApiScriptPromise;
            }

            faceApiScriptPromise = new Promise((resolve, reject) => {
                const script = document.createElement("script");

                script.src = FACE_API_SCRIPT_URL;
                script.async = true;
                script.onload = () => {
                    if (window.faceapi) {
                        resolve(window.faceapi);
                    } else {
                        faceApiScriptPromise = null;
                        reject(new Error("Thư viện nhận diện khuôn mặt không khả dụng."));
                    }
                };
                script.onerror = () => {
                    faceApiScriptPromise = null;
                    reject(new Error("Không tải được thư viện nhận diện khuôn mặt."));
                };
                document.head.appendChild(script);
            });

            return faceApiScriptPromise;
        };

        const ensureFaceApiModels = () => {
            if (faceApiModelsPromise) {
                return faceApiModelsPromise;
            }

            faceApiModelsPromise = (async () => {
                const faceapi = await loadFaceApiScript();

                if (faceapi.tf && faceapi.tf.setBackend) {
                    try {
                        await faceapi.tf.setBackend("webgl");
                    } catch {
                        // Trình duyệt không hỗ trợ WebGL thì dùng backend mặc định.
                    }

                    await faceapi.tf.ready();
                }

                await Promise.all([
                    faceapi.nets.tinyFaceDetector.loadFromUri(FACE_API_MODEL_URL),
                    faceapi.nets.faceLandmark68TinyNet.loadFromUri(FACE_API_MODEL_URL),
                    faceapi.nets.faceRecognitionNet.loadFromUri(FACE_API_MODEL_URL)
                ]);

                return faceapi;
            })().catch((error) => {
                faceApiModelsPromise = null;
                throw error;
            });

            return faceApiModelsPromise;
        };

        const setFaceStatus = (text, type = "info") => {
            const icons = {
                info: "info",
                loading: "progress_activity",
                searching: "person_search",
                success: "check_circle",
                warning: "warning",
                error: "error"
            };

            elements.faceStatusText.textContent = text;
            elements.faceStatusIcon.textContent = icons[type] || "info";
            elements.faceStatusIcon.classList.toggle("animate-spin", type === "loading");
            elements.faceStatusIcon.classList.toggle("text-green-400", type === "success");
            elements.faceStatusIcon.classList.toggle("text-amber-300", type === "warning");
            elements.faceStatusIcon.classList.toggle("text-red-300", type === "error");
        };

        const showFaceError = (message) => {
            elements.faceErrorMessage.textContent = message;
            elements.faceError.classList.remove("hidden");
        };

        const hideFaceError = () => {
            elements.faceError.classList.add("hidden");
            elements.faceErrorMessage.textContent = "";
        };

        const hideFaceResult = () => {
            elements.faceResult.classList.add("hidden");
        };

        const stopFaceCamera = () => {
            if (faceState.stream) {
                faceState.stream.getTracks().forEach((track) => track.stop());
                faceState.stream = null;
            }

            if (elements.faceVideo) {
                elements.faceVideo.pause();
                elements.faceVideo.srcObject = null;
            }

            elements.facePlaceholder.classList.remove("hidden");
        };

        const stopFaceDetectionLoop = () => {
            if (faceState.detectionTimer) {
                window.clearTimeout(faceState.detectionTimer);
                faceState.detectionTimer = null;
            }

            faceState.detecting = false;
        };

        const closeFaceModal = () => {
            if (faceState.capturing) return;

            faceState.open = false;
            faceState.requestId += 1;
            faceState.capturing = false;
            stopFaceDetectionLoop();
            stopFaceCamera();
            closeModal(elements.faceModal);
        };

        const updateFaceDetectionState = (detections) => {
            const video = elements.faceVideo;

            if (!video.videoWidth) {
                setFaceStatus("Đang chuẩn bị camera...", "loading");
                elements.faceCaptureBtn.disabled = true;
                return;
            }

            if (detections.length === 0) {
                setFaceStatus("Không phát hiện khuôn mặt", "searching");
                elements.faceHint.textContent = "Đưa khuôn mặt vào giữa khung oval và đảm bảo đủ ánh sáng.";
                elements.faceCaptureBtn.disabled = true;
                return;
            }

            if (detections.length > 1) {
                setFaceStatus("Có nhiều khuôn mặt trong khung hình", "warning");
                elements.faceHint.textContent = "Chỉ để một người trong khung hình trước khi chấm công.";
                elements.faceCaptureBtn.disabled = true;
                return;
            }

            const box = detections[0].box;
            const widthRatio = box.width / video.videoWidth;
            const centerX = box.x + box.width / 2;
            const centerY = box.y + box.height / 2;
            const offsetX = Math.abs(centerX - video.videoWidth / 2) / video.videoWidth;
            const offsetY = Math.abs(centerY - video.videoHeight / 2) / video.videoHeight;

            if (widthRatio < 0.15) {
                setFaceStatus("Khuôn mặt quá nhỏ", "warning");
                elements.faceHint.textContent = "Đưa khuôn mặt lại gần camera hơn.";
                elements.faceCaptureBtn.disabled = true;
                return;
            }

            if (offsetX > 0.22 || offsetY > 0.22) {
                setFaceStatus("Khuôn mặt chưa ở giữa khung", "warning");
                elements.faceHint.textContent = "Di chuyển khuôn mặt vào giữa khung oval.";
                elements.faceCaptureBtn.disabled = true;
                return;
            }

            setFaceStatus("Đã phát hiện khuôn mặt", "success");
            elements.faceHint.textContent = "Giữ yên, nhìn thẳng vào camera và bấm Chấm công.";
            elements.faceCaptureBtn.disabled = false;
        };

        const startFaceDetectionLoop = () => {
            stopFaceDetectionLoop();

            const loopId = faceState.requestId;

            const scheduleNext = () => {
                if (faceState.capturing) return;
                if (loopId !== faceState.requestId) return;
                if (!faceState.open) return;

                faceState.detectionTimer = window.setTimeout(runDetection, 350);
            };

            const runDetection = async () => {
                if (faceState.capturing) return;
                if (loopId !== faceState.requestId) return;

                if (
                    !faceState.open
                    || faceState.detecting
                    || !faceState.faceapi
                ) {
                    scheduleNext();
                    return;
                }

                faceState.detecting = true;

                try {
                    const options = new faceState.faceapi.TinyFaceDetectorOptions({
                        inputSize: 224,
                        scoreThreshold: 0.5
                    });
                    const detections = await faceState.faceapi.detectAllFaces(elements.faceVideo, options);

                    if (faceState.capturing) return;
                    if (loopId !== faceState.requestId) return;
                    if (!faceState.open) return;

                    updateFaceDetectionState(detections);
                } catch (error) {
                    if (faceState.capturing) return;
                    if (loopId !== faceState.requestId) return;

                    console.error("Lỗi nhận diện khuôn mặt:", error);
                    setFaceStatus("Không thể nhận diện khuôn mặt", "error");
                    showFaceError("Không thể nhận diện khuôn mặt từ camera. Vui lòng thử lại.");
                    elements.faceCaptureBtn.disabled = true;
                    elements.faceRetryBtn.classList.remove("hidden");
                    elements.faceRetryBtn.classList.add("flex");
                } finally {
                    if (loopId === faceState.requestId) {
                        faceState.detecting = false;
                        scheduleNext();
                    }
                }
            };

            runDetection();
        };

        const startFaceCamera = async () => {
            if (faceState.starting) return;

            faceState.starting = true;
            faceState.capturing = false;
            stopFaceDetectionLoop();
            stopFaceCamera();
            faceState.requestId += 1;
            const requestId = faceState.requestId;

            hideFaceError();
            hideFaceResult();
            elements.facePlaceholder.classList.remove("hidden");
            elements.faceStartBtn.classList.add("hidden");
            elements.faceStartBtn.classList.remove("flex");
            elements.faceCaptureBtn.classList.remove("hidden");
            elements.faceCaptureBtn.classList.add("flex");
            elements.faceCaptureBtn.disabled = true;
            elements.faceRetryBtn.classList.add("hidden");
            elements.faceRetryBtn.classList.remove("flex");
            setFaceStatus("Đang khởi động camera...", "loading");

            try {
                if (!window.isSecureContext) {
                    throw new Error("Camera chỉ hoạt động trên HTTPS hoặc localhost.");
                }

                if (!navigator.mediaDevices || !navigator.mediaDevices.getUserMedia) {
                    throw new Error("Trình duyệt không hỗ trợ truy cập camera.");
                }

                const stream = await navigator.mediaDevices.getUserMedia({
                    video: {
                        facingMode: "user",
                        width: { ideal: 640 },
                        height: { ideal: 480 }
                    },
                    audio: false
                });

                if (
                    !faceState.open
                    || requestId !== faceState.requestId
                ) {
                    stream.getTracks().forEach((track) => track.stop());
                    return;
                }

                faceState.stream = stream;
                elements.faceVideo.srcObject = stream;

                stream.getVideoTracks().forEach((track) => {
                    track.addEventListener("ended", () => {
                        if (requestId !== faceState.requestId) return;
                        if (!faceState.open) return;

                        stopFaceDetectionLoop();
                        stopFaceCamera();
                        setFaceStatus("Camera đã bị ngắt", "error");
                        showFaceError("Camera đã bị ngắt. Vui lòng thử lại.");
                        elements.faceCaptureBtn.disabled = true;
                        elements.faceRetryBtn.classList.remove("hidden");
                        elements.faceRetryBtn.classList.add("flex");
                    });
                });

                await new Promise((resolve) => {
                    if (elements.faceVideo.readyState >= 1) {
                        resolve();
                        return;
                    }

                    elements.faceVideo.onloadedmetadata = () => resolve();
                });

                await elements.faceVideo.play();

                if (
                    !faceState.open
                    || requestId !== faceState.requestId
                ) {
                    return;
                }

                elements.facePlaceholder.classList.add("hidden");
                setFaceStatus("Đang tải mô hình nhận diện...", "loading");

                const faceapi = await ensureFaceApiModels();

                if (
                    !faceState.open
                    || requestId !== faceState.requestId
                ) {
                    return;
                }

                faceState.faceapi = faceapi;
                setFaceStatus("Đang tìm khuôn mặt...", "searching");
                startFaceDetectionLoop();
            } catch (error) {
                console.error("Lỗi khởi động camera:", error);

                if (requestId !== faceState.requestId) return;

                stopFaceCamera();

                let message = "Không thể khởi động camera. Vui lòng thử lại.";

                if (error.name === "NotAllowedError" || error.name === "PermissionDeniedError") {
                    message = "Bạn đã từ chối quyền truy cập camera. Hãy cấp quyền camera trong trình duyệt rồi thử lại.";
                } else if (error.name === "NotFoundError" || error.name === "DevicesNotFoundError") {
                    message = "Không tìm thấy camera trên thiết bị.";
                } else if (error.name === "NotReadableError" || error.name === "TrackStartError") {
                    message = "Camera đang được ứng dụng khác sử dụng.";
                } else if (error.message) {
                    message = error.message;
                }

                setFaceStatus("Không thể khởi động camera", "error");
                showFaceError(message);
                elements.faceCaptureBtn.disabled = true;
                elements.faceRetryBtn.classList.remove("hidden");
                elements.faceRetryBtn.classList.add("flex");
            } finally {
                if (requestId === faceState.requestId) {
                    faceState.starting = false;
                }
            }
        };

        const captureFaceAndAttend = async () => {
            if (!faceState.faceapi || !faceState.stream || faceState.capturing) return;

            const captureRequestId = faceState.requestId;

            stopFaceDetectionLoop();
            faceState.capturing = true;
            elements.faceCaptureBtn.disabled = true;
            hideFaceError();
            hideFaceResult();
            setFaceStatus("Đang trích xuất và gửi dữ liệu khuôn mặt...", "loading");

            try {
                const options = new faceState.faceapi.TinyFaceDetectorOptions({
                    inputSize: 320,
                    scoreThreshold: 0.5
                });
                const detections = await faceState.faceapi
                    .detectAllFaces(elements.faceVideo, options)
                    .withFaceLandmarks(true)
                    .withFaceDescriptors();

                if (captureRequestId !== faceState.requestId) return;
                if (!faceState.open) return;

                if (detections.length === 0) {
                    throw new Error("Không phát hiện khuôn mặt. Vui lòng nhìn thẳng vào camera và thử lại.");
                }

                if (detections.length > 1) {
                    throw new Error("Có nhiều khuôn mặt trong khung hình. Chỉ để một người và thử lại.");
                }

                const detection = detections[0];
                const descriptor = Array.from(detection.descriptor);

                if (descriptor.length !== 128 || !descriptor.every((value) => Number.isFinite(value))) {
                    throw new Error("Dữ liệu khuôn mặt không hợp lệ. Vui lòng thử lại.");
                }

                // Gửi lên server
                const controller = new AbortController();
                const timeoutId = window.setTimeout(() => controller.abort(), 20000);

                try {
                    const response = await fetch(`${API_BASE}/face`, {
                        method: "POST",
                        headers: {
                            "Content-Type": "application/json",
                            Accept: "application/json"
                        },
                        body: JSON.stringify({
                            descriptor,
                            action: faceState.action
                        }),
                        signal: controller.signal
                    });

                    let payload = {};

                    try {
                        payload = await response.json();
                    } catch {
                        payload = {};
                    }

                    if (captureRequestId !== faceState.requestId) return;

                    if (!response.ok || !payload.success) {
                        throw new Error(payload.message || "Không thể chấm công.");
                    }

                    // Thành công
                    faceState.capturing = false;
                    setFaceStatus("Chấm công thành công!", "success");

                    const employee = payload.employee;
                    elements.faceResultMessage.textContent = payload.message || "Chấm công thành công!";
                    elements.faceResultEmployee.textContent = employee
                        ? `${employee.full_name} (${employee.employee_code})`
                        : "";

                    const eval_ = payload.evaluation;
                    let detailParts = [];

                    if (eval_) {
                        if (eval_.isLate) {
                            detailParts.push(`Đi muộn ${eval_.lateMinutes} phút`);
                        }
                        if (eval_.isEarlyLeave) {
                            detailParts.push(`Về sớm ${eval_.earlyLeaveMinutes} phút`);
                        }
                        if (eval_.suggestedStatus === "present") {
                            detailParts.push("Đúng giờ");
                        }
                    }

                    elements.faceResultDetail.textContent = detailParts.join(" • ");
                    elements.faceResult.classList.remove("hidden");
                    elements.faceCaptureBtn.disabled = true;

                    showToast("success", payload.message || "Chấm công thành công!");
                    await loadData();
                } finally {
                    window.clearTimeout(timeoutId);
                }
            } catch (error) {
                if (captureRequestId !== faceState.requestId) return;

                console.error("Lỗi chấm công khuôn mặt:", error);
                faceState.capturing = false;

                const message = error.name === "AbortError"
                    ? "Hết thời gian chờ phản hồi từ máy chủ."
                    : error.message;

                setFaceStatus("Chưa thể chấm công", "error");
                showFaceError(message);
                elements.faceCaptureBtn.disabled = false;

                if (
                    faceState.open
                    && faceState.stream
                    && faceState.faceapi
                ) {
                    startFaceDetectionLoop();
                }
            }
        };

        const setFaceAction = (action) => {
            faceState.action = action;
            const isCheckIn = action === "check_in";

            elements.faceActionCheckin.classList.toggle("bg-primary", isCheckIn);
            elements.faceActionCheckin.classList.toggle("text-on-primary", isCheckIn);
            elements.faceActionCheckin.classList.toggle("bg-surface-container-high", !isCheckIn);
            elements.faceActionCheckin.classList.toggle("text-on-surface-variant", !isCheckIn);
            elements.faceActionCheckin.classList.toggle("hover:bg-surface-container", !isCheckIn);

            elements.faceActionCheckout.classList.toggle("bg-primary", !isCheckIn);
            elements.faceActionCheckout.classList.toggle("text-on-primary", !isCheckIn);
            elements.faceActionCheckout.classList.toggle("bg-surface-container-high", isCheckIn);
            elements.faceActionCheckout.classList.toggle("text-on-surface-variant", isCheckIn);
            elements.faceActionCheckout.classList.toggle("hover:bg-surface-container", isCheckIn);
        };

        const openFaceModal = () => {
            faceState.open = true;
            faceState.capturing = false;
            faceState.starting = false;

            hideFaceError();
            hideFaceResult();
            elements.facePlaceholder.classList.remove("hidden");
            elements.faceStartBtn.classList.remove("hidden");
            elements.faceStartBtn.classList.add("flex");
            elements.faceCaptureBtn.classList.add("hidden");
            elements.faceCaptureBtn.classList.remove("flex");
            elements.faceCaptureBtn.disabled = true;
            elements.faceRetryBtn.classList.add("hidden");
            elements.faceRetryBtn.classList.remove("flex");
            setFaceStatus("Bấm nút bên dưới để bắt đầu", "info");
            elements.faceHint.textContent = "Nhìn thẳng vào camera, giữ khuôn mặt trong khung oval. Hệ thống sẽ tự động nhận diện.";
            setFaceAction("check_in");

            openModal(elements.faceModal);
        };

        // ---- Chấm công thủ công ----

        const closeManualModal = () => {
            if (manualState.submitting) return;

            manualState.open = false;
            closeModal(elements.manualModal);
        };

        const setManualAction = (action) => {
            manualState.action = action;
            const isCheckIn = action === "check_in";

            elements.manualActionCheckin.classList.toggle("bg-primary", isCheckIn);
            elements.manualActionCheckin.classList.toggle("text-on-primary", isCheckIn);
            elements.manualActionCheckin.classList.toggle("bg-surface-container-high", !isCheckIn);
            elements.manualActionCheckin.classList.toggle("text-on-surface-variant", !isCheckIn);
            elements.manualActionCheckin.classList.toggle("hover:bg-surface-container", !isCheckIn);

            elements.manualActionCheckout.classList.toggle("bg-primary", !isCheckIn);
            elements.manualActionCheckout.classList.toggle("text-on-primary", !isCheckIn);
            elements.manualActionCheckout.classList.toggle("bg-surface-container-high", isCheckIn);
            elements.manualActionCheckout.classList.toggle("text-on-surface-variant", isCheckIn);
            elements.manualActionCheckout.classList.toggle("hover:bg-surface-container", isCheckIn);
        };

        const openManualModal = (employee, defaultAction) => {
            if (!employee) return;

            manualState.open = true;
            manualState.employee = employee;
            manualState.submitting = false;

            setText(elements.manualEmployeeName, employee.full_name);
            setText(elements.manualEmployeeCode, employee.employee_code);
            elements.manualReason.value = "";

            elements.manualError.classList.add("hidden");
            elements.manualSubmitBtn.disabled = false;
            elements.manualSubmitBtn.innerHTML = `
                <span class="material-symbols-outlined text-[18px]">check</span>
                <span>Xác nhận chấm công</span>
            `;

            setManualAction(defaultAction || "check_in");
            openModal(elements.manualModal);
            elements.manualReason.focus();
        };

        const submitManualAttendance = async () => {
            if (!manualState.employee || manualState.submitting) return;

            const reason = elements.manualReason.value.trim();

            if (reason.length < 5 || reason.length > 255) {
                elements.manualErrorMessage.textContent = "Vui lòng nhập lý do chấm công thủ công (từ 5 đến 255 ký tự).";
                elements.manualError.classList.remove("hidden");
                elements.manualReason.focus();
                return;
            }

            manualState.submitting = true;
            elements.manualError.classList.add("hidden");
            elements.manualSubmitBtn.disabled = true;
            elements.manualSubmitBtn.innerHTML = `
                <span class="material-symbols-outlined text-[18px] animate-spin">progress_activity</span>
                <span>Đang xử lý...</span>
            `;

            try {
                const response = await fetch(`${API_BASE}/manual`, {
                    method: "POST",
                    headers: {
                        "Content-Type": "application/json",
                        Accept: "application/json"
                    },
                    body: JSON.stringify({
                        employee_id: manualState.employee.id,
                        action: manualState.action,
                        reason
                    })
                });

                let payload = {};

                try {
                    payload = await response.json();
                } catch {
                    payload = {};
                }

                if (!response.ok || !payload.success) {
                    throw new Error(payload.message || "Không thể chấm công thủ công.");
                }

                manualState.submitting = false;
                state.lastFocused = null;
                closeModal(elements.manualModal, false);
                elements.refreshBtn.focus();
                showToast("success", payload.message || "Chấm công thủ công thành công.");
                await loadData();
            } catch (error) {
                manualState.submitting = false;
                elements.manualSubmitBtn.disabled = false;
                elements.manualSubmitBtn.innerHTML = `
                    <span class="material-symbols-outlined text-[18px]">check</span>
                    <span>Xác nhận chấm công</span>
                `;
                elements.manualErrorMessage.textContent = error.message;
                elements.manualError.classList.remove("hidden");
                showToast("error", error.message);
            }
        };

        const getBrowserPosition = () => new Promise((resolve, reject) => {
            if (!window.isSecureContext) {
                reject(new Error("Định vị GPS chỉ hoạt động trên HTTPS hoặc localhost."));
                return;
            }

            if (!navigator.geolocation) {
                reject(new Error("Trình duyệt không hỗ trợ định vị GPS."));
                return;
            }

            navigator.geolocation.getCurrentPosition(
                resolve,
                (error) => {
                    const messages = {
                        1: "Bạn chưa cấp quyền vị trí. Hãy cho phép định vị trong cài đặt trình duyệt.",
                        2: "Không xác định được vị trí hiện tại. Hãy bật GPS và thử lại.",
                        3: "Lấy vị trí quá thời gian chờ. Vui lòng thử lại."
                    };
                    reject(new Error(messages[error.code] || "Không thể lấy vị trí GPS."));
                },
                {
                    enableHighAccuracy: true,
                    timeout: 20000,
                    maximumAge: 0
                }
            );
        });

        const resetGpsSubmitButton = () => {
            elements.gpsSubmitBtn.disabled = false;
            elements.gpsSubmitBtn.innerHTML = `
                <span class="material-symbols-outlined text-[18px]">my_location</span>
                <span>Lấy vị trí và chấm công</span>
            `;
        };

        const openGpsModal = (employee, action) => {
            if (!employee) return;

            gpsState.employee = employee;
            gpsState.action = action === "check_out" ? "check_out" : "check_in";
            gpsState.submitting = false;
            elements.gpsEmployee.textContent = `${employee.full_name} (${employee.employee_code})`;
            elements.gpsActionLabel.textContent = gpsState.action === "check_in" ? "Check-in" : "Check-out";
            elements.gpsError.classList.add("hidden");
            elements.gpsErrorMessage.textContent = "";
            resetGpsSubmitButton();
            openModal(elements.gpsModal);
        };

        const closeGpsModal = () => {
            if (gpsState.submitting) return;
            gpsState.employee = null;
            closeModal(elements.gpsModal);
        };

        const submitGpsAttendance = async () => {
            if (!gpsState.employee || gpsState.submitting) return;

            gpsState.submitting = true;
            elements.gpsSubmitBtn.disabled = true;
            elements.gpsSubmitBtn.innerHTML = `
                <span class="material-symbols-outlined text-[18px] animate-spin">progress_activity</span>
                <span>Đang lấy vị trí...</span>
            `;
            elements.gpsError.classList.add("hidden");

            try {
                const position = await getBrowserPosition();
                const location = position.coords;
                if (location.accuracy > 150) {
                    throw new Error(`Độ chính xác GPS hiện là ±${Math.round(location.accuracy)} m. Hãy bật định vị chính xác và thử lại.`);
                }

                elements.gpsSubmitBtn.innerHTML = `
                    <span class="material-symbols-outlined text-[18px] animate-spin">progress_activity</span>
                    <span>Đang xác nhận trong vùng...</span>
                `;

                const response = await fetch(`${API_BASE}/gps`, {
                    method: "POST",
                    headers: {
                        "Content-Type": "application/json",
                        Accept: "application/json"
                    },
                    body: JSON.stringify({
                        employee_id: gpsState.employee.id,
                        action: gpsState.action,
                        latitude: location.latitude,
                        longitude: location.longitude,
                        accuracy: location.accuracy
                    })
                });
                const payload = await response.json();

                if (!response.ok || !payload.success) {
                    throw new Error(payload.message || "Không thể chấm công GPS.");
                }

                gpsState.submitting = false;
                state.lastFocused = null;
                closeModal(elements.gpsModal, false);
                elements.refreshBtn.focus();
                showToast("success", payload.message);
                await loadData();
            } catch (error) {
                gpsState.submitting = false;
                resetGpsSubmitButton();
                elements.gpsErrorMessage.textContent = error.message;
                elements.gpsError.classList.remove("hidden");
                showToast("error", error.message);
            }
        };

        const openGpsSettingsModal = () => {
            const { gpsSettingsModal: modal } = elements;
            elements.gpsLatitude.value = modal.dataset.latitude || "";
            elements.gpsLongitude.value = modal.dataset.longitude || "";
            elements.gpsRadius.value = modal.dataset.radius || "100";
            elements.gpsSettingsError.classList.add("hidden");
            elements.gpsSettingsStatus.textContent = modal.dataset.configured === "true"
                ? "Đã cấu hình. Nhân viên chỉ chấm công được trong vùng này."
                : "Chưa cấu hình vị trí cơ sở.";
            openModal(modal);
        };

        const useCurrentLocationForGpsSettings = async () => {
            elements.gpsUseCurrentBtn.disabled = true;
            try {
                const position = await getBrowserPosition();
                elements.gpsLatitude.value = position.coords.latitude.toFixed(7);
                elements.gpsLongitude.value = position.coords.longitude.toFixed(7);
                showToast("success", "Đã lấy tọa độ thiết bị. Kiểm tra vị trí rồi bấm Lưu cấu hình.");
            } catch (error) {
                elements.gpsSettingsError.textContent = error.message;
                elements.gpsSettingsError.classList.remove("hidden");
            } finally {
                elements.gpsUseCurrentBtn.disabled = false;
            }
        };

        const saveGpsSettings = async (event) => {
            event.preventDefault();
            if (!elements.gpsSettingsForm.reportValidity()) return;

            elements.gpsSettingsSaveBtn.disabled = true;
            elements.gpsSettingsError.classList.add("hidden");

            try {
                const response = await fetch(`${API_BASE}/gps/settings`, {
                    method: "POST",
                    headers: {
                        "Content-Type": "application/json",
                        Accept: "application/json"
                    },
                    body: JSON.stringify({
                        latitude: elements.gpsLatitude.value,
                        longitude: elements.gpsLongitude.value,
                        radius_m: elements.gpsRadius.value
                    })
                });
                const payload = await response.json();

                if (!response.ok || !payload.success) {
                    throw new Error(payload.message || "Không thể lưu cấu hình GPS.");
                }

                const settings = payload.settings;
                elements.gpsSettingsModal.dataset.latitude = settings.latitude;
                elements.gpsSettingsModal.dataset.longitude = settings.longitude;
                elements.gpsSettingsModal.dataset.radius = settings.radius_m;
                elements.gpsSettingsModal.dataset.configured = String(settings.configured);
                elements.gpsSettingsStatus.textContent = "Đã cấu hình. Nhân viên chỉ chấm công được trong vùng này.";
                state.lastFocused = null;
                closeModal(elements.gpsSettingsModal, false);
                elements.gpsSettingsOpenBtn.focus();
                showToast("success", payload.message);
            } catch (error) {
                elements.gpsSettingsError.textContent = error.message;
                elements.gpsSettingsError.classList.remove("hidden");
                showToast("error", error.message);
            } finally {
                elements.gpsSettingsSaveBtn.disabled = false;
            }
        };

        // ---- Sự kiện ----

        let searchTimer = null;

        elements.refreshBtn.addEventListener("click", loadData);

        elements.applyFilterBtn.addEventListener("click", () => {
            window.clearTimeout(searchTimer);
            state.search = elements.searchInput.value.trim();
            state.department = elements.departmentSelect.value;
            state.status = elements.statusSelect.value;
            state.date = elements.dateInput.value || getTodayString();
            loadData();
        });

        elements.resetFilterBtn.addEventListener("click", resetFilters);

        elements.searchInput.addEventListener("input", () => {
            window.clearTimeout(searchTimer);
            searchTimer = window.setTimeout(() => {
                state.search = elements.searchInput.value.trim();
                loadData();
            }, 350);
        });

        elements.searchInput.addEventListener("keydown", (event) => {
            if (event.key !== "Enter") return;

            event.preventDefault();
            window.clearTimeout(searchTimer);
            state.search = elements.searchInput.value.trim();
            state.department = elements.departmentSelect.value;
            state.status = elements.statusSelect.value;
            state.date = elements.dateInput.value || getTodayString();
            loadData();
        });

        elements.dateInput.addEventListener("change", () => {
            state.date = elements.dateInput.value || getTodayString();
            loadData();
        });

        elements.departmentSelect.addEventListener("change", () => {
            state.department = elements.departmentSelect.value;
            loadData();
        });

        elements.statusSelect.addEventListener("change", () => {
            state.status = elements.statusSelect.value;
            loadData();
        });

        elements.tableBody.addEventListener("click", (event) => {
            const gpsButton = event.target.closest("[data-gps-id]");
            if (gpsButton) {
                openGpsModal({
                    id: gpsButton.getAttribute("data-gps-id"),
                    full_name: gpsButton.getAttribute("data-employee-name"),
                    employee_code: gpsButton.getAttribute("data-employee-code")
                }, gpsButton.getAttribute("data-gps-action"));
                return;
            }

            const manualButton = event.target.closest("[data-manual-id]");

            if (manualButton) {
                openManualModal({
                    id: manualButton.getAttribute("data-manual-id"),
                    full_name: manualButton.getAttribute("data-employee-name"),
                    employee_code: manualButton.getAttribute("data-employee-code")
                }, manualButton.getAttribute("data-manual-action") || "check_in");
                return;
            }

            if (event.target.closest("[data-reset-filter]")) {
                resetFilters();
                return;
            }

            if (event.target.closest("[data-retry]")) {
                loadData();
            }
        });

        // Modal chấm công khuôn mặt
        elements.faceCheckinBtn.addEventListener("click", openFaceModal);

        elements.faceActionCheckin.addEventListener("click", () => setFaceAction("check_in"));
        elements.faceActionCheckout.addEventListener("click", () => setFaceAction("check_out"));

        elements.faceStartBtn.addEventListener("click", () => {
            startFaceCamera();
        });

        elements.faceCaptureBtn.addEventListener("click", captureFaceAndAttend);

        elements.faceRetryBtn.addEventListener("click", () => {
            startFaceCamera();
        });

        document.querySelectorAll('[data-close-modal="face"]').forEach((element) => {
            element.addEventListener("click", closeFaceModal);
        });

        // Modal chấm công thủ công
        elements.manualActionCheckin.addEventListener("click", () => setManualAction("check_in"));
        elements.manualActionCheckout.addEventListener("click", () => setManualAction("check_out"));

        elements.manualSubmitBtn.addEventListener("click", submitManualAttendance);

        document.querySelectorAll('[data-close-modal="manual"]').forEach((element) => {
            element.addEventListener("click", closeManualModal);
        });

        elements.gpsSettingsOpenBtn.addEventListener("click", openGpsSettingsModal);
        elements.gpsSubmitBtn.addEventListener("click", submitGpsAttendance);
        elements.gpsSettingsForm.addEventListener("submit", saveGpsSettings);
        elements.gpsUseCurrentBtn.addEventListener("click", useCurrentLocationForGpsSettings);

        document.querySelectorAll('[data-close-modal="gps"]').forEach((element) => {
            element.addEventListener("click", closeGpsModal);
        });

        document.querySelectorAll('[data-close-modal="gps-settings"]').forEach((element) => {
            element.addEventListener("click", () => closeModal(elements.gpsSettingsModal));
        });

        // ESC
        document.addEventListener("keydown", (event) => {
            if (event.key !== "Escape") return;

            if (!elements.manualModal.classList.contains("hidden")) {
                closeManualModal();
                return;
            }

            if (!elements.faceModal.classList.contains("hidden")) {
                closeFaceModal();
                return;
            }

            if (!elements.gpsModal.classList.contains("hidden")) {
                closeGpsModal();
                return;
            }

            if (!elements.gpsSettingsModal.classList.contains("hidden")) {
                closeModal(elements.gpsSettingsModal);
            }
        });

        // Khởi tạo
        state.date = getTodayString();
        elements.dateInput.value = state.date;
        renderSkeleton();
        loadData();
        window.setInterval(() => {
            if (!document.hidden) loadData();
        }, 30000);
    })();
</script>

<%- include("../partials/adminFoot") %>
