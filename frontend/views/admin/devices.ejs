<%- include("../partials/adminHead", {
    pageTitle: "Quản lý thiết bị chấm công",
    activePage: "devices",
    user: user
}) %>

<section class="flex flex-col gap-space-xl">
    <%- include("../partials/alerts", { success: success, error: error }) %>

    <% if (devices.some((device) => device.is_sample)) { %>
        <div class="flex items-start gap-space-sm p-space-md bg-amber-50 border border-amber-200 rounded-xl text-amber-900" role="status">
            <span class="material-symbols-outlined text-[20px]">info</span>
            <p class="font-body-sm text-body-sm">
                Các thiết bị có nhãn <strong>Mẫu</strong> là dữ liệu mô phỏng để xem giao diện, không phản ánh kết nối phần cứng thật.
            </p>
        </div>
    <% } %>

    <% const deviceTypeLabels = {
        biometric: "Vân tay / Face ID",
        camera: "Camera",
        network: "Thiết bị mạng",
        other: "Khác"
    }; %>

    <style>
        #device-table { width: 100%; min-width: 0; border-collapse: separate; border-spacing: 0; }
        #device-table thead { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }
        #device-table tbody { display: grid; grid-template-columns: minmax(0, 1fr); gap: 1rem; padding: 1rem; }
        #device-table tbody > tr[data-device-row] { display: grid; grid-template-columns: minmax(0, 1fr); overflow: hidden; border: 1px solid rgb(226 232 240); border-radius: 1rem; background: white; box-shadow: 0 1px 2px rgb(15 23 42 / 0.04); transition: border-color 160ms ease, box-shadow 160ms ease; }
        #device-table tbody > tr[data-device-row][hidden] { display: none; }
        #device-table tbody > tr[data-device-row]:hover { border-color: rgb(148 163 184); box-shadow: 0 8px 24px rgb(15 23 42 / 0.08); }
        #device-table td { display: flex; min-width: 0; flex-direction: column; align-items: flex-start; justify-content: center; gap: .35rem; padding: .9rem 1rem; border-bottom: 1px solid rgb(241 245 249); }
        #device-table td::before { color: rgb(100 116 139); font-size: .68rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; content: attr(data-label); }
        #device-table td:first-child { grid-column: 1 / -1; padding: 1.1rem 1rem; background: rgb(248 250 252); }
        #device-table td:first-child::before, #device-table td:last-child::before { display: none; }
        #device-table td:last-child { grid-column: 1 / -1; flex-direction: row; align-items: center; justify-content: space-between; border-bottom: 0; }
        #device-table td:last-child details { flex: 1; }
        #device-table td:last-child details[open] { width: 100%; }
        #device-table td:last-child details[open] form { max-width: 36rem; padding: 1rem; border: 1px solid rgb(226 232 240); border-radius: .75rem; background: rgb(248 250 252); }
        #device-table td:last-child details[open] + form { align-self: flex-start; }
        #device-table #device-filter-empty, #device-table tr.device-empty-row { display: block; padding: 1.5rem; border: 1px dashed rgb(203 213 225); border-radius: 1rem; color: rgb(100 116 139); text-align: center; }
        #device-table #device-filter-empty[hidden] { display: none; }
        @media (min-width: 640px) {
            #device-table tbody > tr[data-device-row] { grid-template-columns: repeat(2, minmax(0, 1fr)); }
            #device-table td:nth-child(4), #device-table td:nth-child(5) { border-bottom: 0; }
        }
    </style>

    <% if (newDevice) { %>
        <section class="bg-green-50 border border-green-200 p-space-lg sm:p-space-xl rounded-xl" role="status">
            <div class="flex items-start gap-space-md">
                <span class="material-symbols-outlined text-green-700 text-[24px]">verified</span>
                <div class="flex flex-col gap-space-sm min-w-0">
                    <h2 class="font-headline-sm text-headline-sm text-green-900">Khóa kết nối cho <%= newDevice.name %></h2>
                    <p class="font-body-sm text-body-sm text-green-800">
                        Sao chép và lưu khóa này vào thiết bị. Khóa chỉ hiển thị một lần và không thể khôi phục từ hệ thống.
                    </p>
                    <div class="bg-white border border-green-200 rounded-lg p-space-md overflow-x-auto">
                        <code class="font-data-mono text-data-mono text-on-surface break-all"><%= newDevice.token %></code>
                    </div>
                    <div class="font-body-sm text-body-sm text-green-800">
                        Dùng khóa này cho cả tín hiệu heartbeat và đồng bộ dữ liệu:
                        <code>/api/devices/<%= newDevice.deviceCode %>/heartbeat</code>
                        <code>/api/devices/<%= newDevice.deviceCode %>/events</code>
                        hoặc <code>/api/devices/<%= newDevice.deviceCode %>/sync</code>,
                        kèm header <code>X-Device-Token</code>.
                    </div>
                    <div class="font-body-sm text-body-sm text-green-800">
                        Máy chủ: <code><%= newDevice.server_url || "chưa khai báo địa chỉ máy chủ" %></code> ·
                        Heartbeat mỗi <strong><%= newDevice.heartbeat_interval_seconds %> giây</strong> ·
                        Đồng bộ <strong><%= newDevice.auto_sync_enabled ? `tự động mỗi ${newDevice.sync_interval_minutes} phút` : 'thủ công' %></strong>
                        qua <code>/api/devices/<%= newDevice.deviceCode %>/<%= newDevice.sync_mode === 'events' ? 'events' : 'sync' %></code>.
                    </div>
                    <p class="font-body-sm text-body-sm text-green-800">
                        Thiết bị có thể lấy cấu hình hiện tại qua GET <code>/api/devices/<%= newDevice.deviceCode %>/config</code>
                        kèm header <code>X-Device-Token</code>.
                    </p>
                </div>
            </div>
        </section>
    <% } %>

    <section class="relative overflow-hidden flex flex-col lg:flex-row lg:items-center justify-between gap-space-lg bg-surface-container-lowest p-space-lg md:p-space-xl rounded-2xl border border-surface-container-high/60 shadow-sm">
        <div class="absolute inset-y-0 left-0 w-1 bg-primary"></div>
        <div class="flex flex-col gap-space-xs">
            <div class="flex items-center gap-space-sm text-on-surface-variant font-label-sm text-label-sm">
                <span class="flex h-2 w-2 rounded-full bg-primary-container"></span>
                <span class="uppercase tracking-wider">Kết nối thiết bị chấm công</span>
            </div>
            <h2 class="font-headline-lg text-headline-lg text-primary tracking-tight">Quản lý thiết bị chấm công</h2>
            <p class="font-body-md text-body-md text-on-surface-variant">
                Trạng thái dựa trên heartbeat theo cấu hình từng thiết bị, với ngưỡng tối thiểu <%= onlineWindowMinutes %> phút.
            </p>
        </div>
        <div class="flex flex-wrap gap-space-sm">
            <button
                id="device-status-refresh"
                type="button"
                class="flex items-center justify-center gap-space-xs px-space-lg py-space-sm bg-primary hover:bg-primary-container text-on-primary rounded-xl font-label-md text-label-md shadow-sm transition-all active:scale-[0.98] disabled:opacity-60"
            >
                <span id="device-status-refresh-icon" class="material-symbols-outlined text-[20px]">refresh</span>
                <span>Kiểm tra trạng thái</span>
            </button>
            <span id="device-status-refresh-result" class="self-center font-body-sm text-body-sm text-on-surface-variant" aria-live="polite"></span>
            <a
                href="/admin/attendance"
                class="flex items-center justify-center gap-space-xs px-space-lg py-space-sm bg-surface-container-low hover:bg-surface-container-high text-on-surface-variant rounded-xl font-label-md text-label-md transition-colors"
            >
                <span class="material-symbols-outlined text-[20px]">table_chart</span>
                <span>Bảng chấm công</span>
            </a>
        </div>
    </section>

    <section class="grid grid-cols-1 sm:grid-cols-3 gap-space-lg" aria-label="Thống kê trạng thái thiết bị">
        <article class="bg-surface-container-lowest p-space-lg rounded-2xl border border-surface-container-high/60 shadow-sm flex items-center justify-between hover:shadow-md transition-shadow">
            <div class="flex flex-col">
                <span class="font-label-sm text-label-sm text-on-surface-variant uppercase tracking-wider">Tổng thiết bị</span>
                <span id="device-stat-total" class="font-headline-xl text-headline-xl text-primary font-bold mt-space-xs"><%= stats.total %></span>
            </div>
            <div class="w-11 h-11 rounded-xl bg-primary-fixed text-primary flex items-center justify-center">
                <span class="material-symbols-outlined text-[24px]">devices</span>
            </div>
        </article>
        <article class="bg-surface-container-lowest p-space-lg rounded-2xl border border-green-100 shadow-sm flex items-center justify-between hover:shadow-md transition-shadow">
            <div class="flex flex-col">
                <span class="font-label-sm text-label-sm text-on-surface-variant uppercase tracking-wider">Đang trực tuyến</span>
                <span id="device-stat-online" class="font-headline-xl text-headline-xl text-green-600 font-bold mt-space-xs"><%= stats.online %></span>
            </div>
            <div class="w-11 h-11 rounded-xl bg-green-50 text-green-600 flex items-center justify-center">
                <span class="material-symbols-outlined text-[24px]">wifi</span>
            </div>
        </article>
        <article class="bg-surface-container-lowest p-space-lg rounded-2xl border border-red-100 shadow-sm flex items-center justify-between hover:shadow-md transition-shadow">
            <div class="flex flex-col">
                <span class="font-label-sm text-label-sm text-on-surface-variant uppercase tracking-wider">Đang ngoại tuyến</span>
                <span id="device-stat-offline" class="font-headline-xl text-headline-xl text-red-600 font-bold mt-space-xs"><%= stats.offline %></span>
            </div>
            <div class="w-11 h-11 rounded-xl bg-red-50 text-red-600 flex items-center justify-center">
                <span class="material-symbols-outlined text-[24px]">wifi_off</span>
            </div>
        </article>
    </section>

    <section class="grid grid-cols-1 xl:grid-cols-3 gap-space-lg">
        <div class="xl:col-span-2 bg-surface-container-lowest rounded-2xl border border-surface-container-high/60 shadow-sm overflow-hidden">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-space-sm p-space-lg sm:p-space-xl border-b border-outline-variant">
                <div>
                    <h3 class="font-headline-sm text-headline-sm text-primary">Danh sách thiết bị</h3>
                    <p class="font-body-sm text-body-sm text-on-surface-variant mt-space-xs">
                        Thiết bị được xem là trực tuyến khi gửi heartbeat trong tối đa 3 chu kỳ đã cấu hình, nhưng không thấp hơn <%= onlineWindowMinutes %> phút.
                    </p>
                </div>
                <div class="flex w-full flex-col sm:w-auto sm:flex-row sm:flex-wrap items-stretch sm:items-center gap-space-sm">
                    <label class="sr-only" for="device-search">Tìm thiết bị</label>
                    <input id="device-search" type="search" placeholder="Tìm theo tên, mã hoặc vị trí" class="min-w-0 sm:w-64 px-space-md py-space-sm bg-surface-container-low border border-outline-variant rounded-xl text-on-surface focus:outline-none focus:ring-2 focus:ring-primary/30">
                    <label class="sr-only" for="device-state-filter">Lọc theo trạng thái</label>
                    <select id="device-state-filter" class="px-space-md py-space-sm bg-surface-container-low border border-outline-variant rounded-xl text-on-surface focus:outline-none focus:ring-2 focus:ring-primary/30">
                        <option value="all">Tất cả trạng thái</option>
                        <option value="online">Trực tuyến</option>
                        <option value="offline">Ngoại tuyến</option>
                        <option value="inactive">Ngừng hoạt động</option>
                    </select>
                    <span id="device-visible-count" aria-live="polite" class="self-start sm:self-center px-space-sm py-1 bg-surface-container-low rounded-full font-label-sm text-label-sm text-on-surface-variant">
                        <%= devices.length %> / <%= devices.length %> thiết bị
                    </span>
                </div>
            </div>

            <div>
                <table id="device-table" class="w-full text-left">
                    <caption class="sr-only">Danh sách thiết bị chấm công và trạng thái kết nối</caption>
                    <thead class="bg-surface-container-low">
                        <tr class="font-label-sm text-label-sm text-on-surface-variant uppercase tracking-wider">
                            <th class="px-space-lg py-space-md font-medium">Thiết bị</th>
                            <th class="px-space-md py-space-md font-medium">Vị trí</th>
                            <th class="px-space-md py-space-md font-medium">Trạng thái</th>
                            <th class="px-space-md py-space-md font-medium">Heartbeat gần nhất</th>
                            <th class="px-space-lg py-space-md font-medium">Đồng bộ gần nhất</th>
                            <th class="px-space-md py-space-md font-medium">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-outline-variant">
                        <% if (devices.length === 0) { %>
                            <tr class="device-empty-row">
                                <td colspan="6" class="px-space-lg py-space-2xl text-center">
                                    <div class="flex flex-col items-center gap-space-sm text-on-surface-variant">
                                        <span class="material-symbols-outlined text-[40px]">devices_other</span>
                                        <span class="font-label-md text-label-md">Chưa có thiết bị nào được đăng ký.</span>
                                        <span class="font-body-sm text-body-sm">Thêm thiết bị và cấu hình gửi heartbeat để bắt đầu theo dõi.</span>
                                    </div>
                                </td>
                            </tr>
                        <% } %>
                        <% devices.forEach((device) => { %>
                            <tr data-device-row data-device-id="<%= device.id %>" data-device-state="<%= !device.is_active ? 'inactive' : device.is_online ? 'online' : 'offline' %>">
                                <td class="px-space-lg py-space-md">
                                    <div class="flex flex-col">
                                        <span class="font-label-md text-label-md text-on-surface"><%= device.name %></span>
                                        <span class="font-body-sm text-body-sm text-on-surface-variant">
                                            <%= device.device_code %> · <%= deviceTypeLabels[device.device_type] || "Khác" %>
                                            <% if (device.is_sample) { %>
                                                <span class="inline-flex px-space-xs py-0.5 ml-1 bg-amber-100 text-amber-800 rounded font-label-sm text-label-sm">Mẫu</span>
                                            <% } %>
                                        </span>
                                    </div>
                                </td>
                                <td data-label="Vị trí" class="px-space-md py-space-md font-body-sm text-body-sm text-on-surface-variant">
                                    <%= device.location || "Chưa cập nhật" %>
                                </td>
                                <td data-label="Trạng thái" class="px-space-md py-space-md">
                                    <% if (!device.is_active) { %>
                                        <span id="device-status-<%= device.id %>" class="inline-flex items-center gap-1.5 px-space-sm py-1 bg-surface-container-high text-on-surface-variant rounded-full font-label-sm text-label-sm">
                                            <span class="w-2 h-2 rounded-full bg-outline"></span>Ngừng hoạt động
                                        </span>
                                    <% } else if (device.is_online) { %>
                                        <span id="device-status-<%= device.id %>" class="inline-flex items-center gap-1.5 px-space-sm py-1 bg-green-50 text-green-700 rounded-full font-label-sm text-label-sm">
                                            <span class="w-2 h-2 rounded-full bg-green-500"></span>Trực tuyến
                                        </span>
                                    <% } else { %>
                                        <span id="device-status-<%= device.id %>" class="inline-flex items-center gap-1.5 px-space-sm py-1 bg-red-50 text-red-700 rounded-full font-label-sm text-label-sm">
                                            <span class="w-2 h-2 rounded-full bg-red-500"></span>Ngoại tuyến
                                        </span>
                                    <% } %>
                                </td>
                                <td data-label="Heartbeat gần nhất" id="device-last-seen-<%= device.id %>" class="px-space-lg py-space-md font-body-sm text-body-sm text-on-surface-variant">
                                    <%= device.last_seen_at || "Chưa gửi tín hiệu" %>
                                </td>
                                <td data-label="Đồng bộ gần nhất" class="px-space-lg py-space-md font-body-sm text-body-sm text-on-surface-variant">
                                    <div class="flex flex-col">
                                        <span><%= device.last_sync_at || "Chưa đồng bộ" %></span>
                                        <% if (device.last_sync_count > 0) { %>
                                            <span class="text-[11px]"><%= device.last_sync_count %> bản ghi gần nhất</span>
                                        <% } %>
                                    </div>
                                </td>
                                <td data-label="Thao tác" class="px-space-md py-space-md">
                                    <details>
                                        <summary class="inline-flex cursor-pointer items-center gap-space-xs px-space-md py-space-sm bg-surface-container-low hover:bg-primary-fixed text-primary rounded-xl font-label-md text-label-md transition-colors">
                                            <span class="material-symbols-outlined text-[18px]">settings</span>Sửa cấu hình
                                        </summary>
                                        <form action="/admin/devices/<%= device.id %>/update" method="POST" class="mt-space-sm min-w-[220px] flex flex-col gap-space-sm">
                                            <label class="font-label-sm text-label-sm">Tên thiết bị
                                                <input name="name" value="<%= device.name %>" maxlength="120" required class="w-full px-space-sm py-1 border border-outline-variant rounded">
                                            </label>
                                            <label class="font-label-sm text-label-sm">Vị trí
                                                <input name="location" value="<%= device.location || '' %>" maxlength="150" class="w-full px-space-sm py-1 border border-outline-variant rounded">
                                            </label>
                                            <label class="font-label-sm text-label-sm">Địa chỉ máy chủ nhận dữ liệu
                                                <input name="server_url" type="url" value="<%= device.server_url || '' %>" maxlength="255" placeholder="http://192.168.1.10:3000" class="w-full px-space-sm py-1 border border-outline-variant rounded">
                                            </label>
                                            <label class="font-label-sm text-label-sm">Chu kỳ heartbeat (giây)
                                                <input name="heartbeat_interval_seconds" type="number" min="10" max="3600" step="1" value="<%= device.heartbeat_interval_seconds || 60 %>" required class="w-full px-space-sm py-1 border border-outline-variant rounded">
                                            </label>
                                            <label class="font-label-sm text-label-sm">Chế độ đồng bộ
                                                <select name="sync_mode" required class="w-full px-space-sm py-1 border border-outline-variant rounded">
                                                    <option value="events" <%= device.sync_mode === 'events' ? 'selected' : '' %>>Lượt chấm công (events)</option>
                                                    <option value="records" <%= device.sync_mode === 'records' ? 'selected' : '' %>>Bản ghi theo ngày (records)</option>
                                                </select>
                                            </label>
                                            <label class="font-label-sm text-label-sm">Tự động đồng bộ
                                                <select name="auto_sync_enabled" required class="w-full px-space-sm py-1 border border-outline-variant rounded">
                                                    <option value="1" <%= device.auto_sync_enabled ? 'selected' : '' %>>Bật</option>
                                                    <option value="0" <%= !device.auto_sync_enabled ? 'selected' : '' %>>Tắt</option>
                                                </select>
                                            </label>
                                            <label class="font-label-sm text-label-sm">Chu kỳ đồng bộ (phút)
                                                <input name="sync_interval_minutes" type="number" min="1" max="1440" step="1" value="<%= device.sync_interval_minutes || 5 %>" required class="w-full px-space-sm py-1 border border-outline-variant rounded">
                                            </label>
                                            <label class="font-label-sm text-label-sm">Loại thiết bị
                                                <select name="device_type" required class="w-full px-space-sm py-1 border border-outline-variant rounded">
                                                    <option value="biometric" <%= device.device_type === 'biometric' ? 'selected' : '' %>>Vân tay / Face ID</option>
                                                    <option value="camera" <%= device.device_type === 'camera' ? 'selected' : '' %>>Camera</option>
                                                    <option value="network" <%= device.device_type === 'network' ? 'selected' : '' %>>Thiết bị mạng</option>
                                                    <option value="other" <%= device.device_type === 'other' ? 'selected' : '' %>>Khác</option>
                                                </select>
                                            </label>
                                            <label class="font-label-sm text-label-sm">Trạng thái
                                                <select name="is_active" required class="w-full px-space-sm py-1 border border-outline-variant rounded">
                                                    <option value="1" <%= device.is_active ? 'selected' : '' %>>Đang hoạt động</option>
                                                    <option value="0" <%= !device.is_active ? 'selected' : '' %>>Ngừng hoạt động</option>
                                                </select>
                                            </label>
                                            <button type="submit" class="px-space-md py-space-sm bg-primary hover:bg-primary-container text-on-primary rounded-xl font-label-md text-label-md">Lưu thay đổi</button>
                                        </form>
                                    </details>
                                    <form action="/admin/devices/<%= device.id %>/delete" method="POST" class="mt-space-xs" onsubmit="return confirm('Xóa thiết bị này? Lịch sử sự kiện của thiết bị sẽ bị xóa, dữ liệu chấm công tổng hợp vẫn được giữ.');">
                                        <button type="submit" class="inline-flex items-center gap-space-xs px-space-md py-space-sm text-red-700 hover:bg-red-50 rounded-xl font-label-md text-label-md transition-colors">
                                            <span class="material-symbols-outlined text-[18px]">delete</span>Xóa
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        <% }); %>
                        <tr id="device-filter-empty" hidden>
                            <td colspan="6" class="px-space-lg py-space-xl text-center text-on-surface-variant">Không tìm thấy thiết bị phù hợp.</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>

        <aside class="bg-surface-container-lowest p-space-lg sm:p-space-xl rounded-2xl border border-surface-container-high/60 shadow-sm flex flex-col gap-space-md">
            <div>
                <h3 class="font-headline-sm text-headline-sm text-primary">Đăng ký thiết bị</h3>
                <p class="font-body-sm text-body-sm text-on-surface-variant mt-space-xs">
                    Tạo mã thiết bị và khóa riêng để thiết bị gửi tín hiệu an toàn.
                </p>
            </div>
            <form action="/admin/devices" method="POST" class="flex flex-col gap-space-md">
                <div class="flex flex-col gap-space-xs">
                    <label for="device_code" class="font-label-md text-label-md text-on-surface">Mã thiết bị</label>
                    <input
                        id="device_code"
                        name="device_code"
                        type="text"
                        maxlength="64"
                        pattern="[A-Za-z0-9][A-Za-z0-9_-]{1,63}"
                        placeholder="VD: MAY-CHAM-CONG-01"
                        required
                        class="w-full px-space-md py-space-sm bg-surface-container-low border border-outline-variant rounded-lg text-on-surface focus:outline-none focus:ring-2 focus:ring-primary"
                    >
                </div>
                <div class="flex flex-col gap-space-xs">
                    <label for="name" class="font-label-md text-label-md text-on-surface">Tên thiết bị</label>
                    <input
                        id="name"
                        name="name"
                        type="text"
                        maxlength="120"
                        placeholder="Máy chấm công sảnh chính"
                        required
                        class="w-full px-space-md py-space-sm bg-surface-container-low border border-outline-variant rounded-lg text-on-surface focus:outline-none focus:ring-2 focus:ring-primary"
                    >
                </div>
                <div class="flex flex-col gap-space-xs">
                    <label for="location" class="font-label-md text-label-md text-on-surface">Vị trí</label>
                    <input
                        id="location"
                        name="location"
                        type="text"
                        maxlength="150"
                        placeholder="Tầng 1, sảnh chính"
                        class="w-full px-space-md py-space-sm bg-surface-container-low border border-outline-variant rounded-lg text-on-surface focus:outline-none focus:ring-2 focus:ring-primary"
                    >
                </div>
                <div class="flex flex-col gap-space-xs">
                    <label for="server_url" class="font-label-md text-label-md text-on-surface">Địa chỉ máy chủ nhận dữ liệu</label>
                    <input id="server_url" name="server_url" type="url" maxlength="255" placeholder="http://192.168.1.10:3000" class="w-full px-space-md py-space-sm bg-surface-container-low border border-outline-variant rounded-lg text-on-surface focus:outline-none focus:ring-2 focus:ring-primary">
                    <span class="font-body-sm text-body-sm text-on-surface-variant">Dùng địa chỉ IP nội bộ hoặc tên miền mà thiết bị truy cập được.</span>
                </div>
                <div class="flex flex-col gap-space-xs">
                    <label for="heartbeat_interval_seconds" class="font-label-md text-label-md text-on-surface">Chu kỳ heartbeat (giây)</label>
                    <input id="heartbeat_interval_seconds" name="heartbeat_interval_seconds" type="number" min="10" max="3600" step="1" value="60" required class="w-full px-space-md py-space-sm bg-surface-container-low border border-outline-variant rounded-lg text-on-surface focus:outline-none focus:ring-2 focus:ring-primary">
                </div>
                <div class="flex flex-col gap-space-xs">
                    <label for="sync_mode" class="font-label-md text-label-md text-on-surface">Chế độ đồng bộ</label>
                    <select id="sync_mode" name="sync_mode" required class="w-full px-space-md py-space-sm bg-surface-container-low border border-outline-variant rounded-lg text-on-surface focus:outline-none focus:ring-2 focus:ring-primary">
                        <option value="events">Lượt chấm công (events)</option>
                        <option value="records">Bản ghi theo ngày (records)</option>
                    </select>
                </div>
                <div class="flex flex-col gap-space-xs">
                    <label for="auto_sync_enabled" class="font-label-md text-label-md text-on-surface">Tự động đồng bộ dữ liệu</label>
                    <select id="auto_sync_enabled" name="auto_sync_enabled" required class="w-full px-space-md py-space-sm bg-surface-container-low border border-outline-variant rounded-lg text-on-surface focus:outline-none focus:ring-2 focus:ring-primary">
                        <option value="1">Bật</option>
                        <option value="0">Tắt</option>
                    </select>
                </div>
                <div class="flex flex-col gap-space-xs">
                    <label for="sync_interval_minutes" class="font-label-md text-label-md text-on-surface">Chu kỳ đồng bộ (phút)</label>
                    <input id="sync_interval_minutes" name="sync_interval_minutes" type="number" min="1" max="1440" step="1" value="5" required class="w-full px-space-md py-space-sm bg-surface-container-low border border-outline-variant rounded-lg text-on-surface focus:outline-none focus:ring-2 focus:ring-primary">
                </div>
                <div class="flex flex-col gap-space-xs">
                    <label for="device_type" class="font-label-md text-label-md text-on-surface">Loại thiết bị</label>
                    <select
                        id="device_type"
                        name="device_type"
                        required
                        class="w-full px-space-md py-space-sm bg-surface-container-low border border-outline-variant rounded-lg text-on-surface focus:outline-none focus:ring-2 focus:ring-primary"
                    >
                        <option value="biometric">Vân tay / Face ID</option>
                        <option value="camera">Camera</option>
                        <option value="network">Thiết bị mạng</option>
                        <option value="other">Khác</option>
                    </select>
                </div>
                <button
                    type="submit"
                    class="flex items-center justify-center gap-space-xs px-space-lg py-space-sm bg-primary hover:bg-primary-container text-on-primary rounded-xl font-label-md text-label-md transition-colors"
                >
                    <span class="material-symbols-outlined text-[20px]">add_circle</span>
                    <span>Đăng ký thiết bị</span>
                </button>
            </form>

            <details class="mt-space-xs rounded-xl border border-surface-container-high/70 bg-surface-container-low p-space-md">
                <summary class="cursor-pointer font-label-md text-label-md text-primary">Hướng dẫn heartbeat và đồng bộ API</summary>
                <div class="mt-space-md flex flex-col gap-space-md">
            <div class="p-space-md bg-white rounded-xl border border-outline-variant">
                <div class="flex items-center gap-space-xs text-primary">
                    <span class="material-symbols-outlined text-[18px]">api</span>
                    <span class="font-label-md text-label-md">Cấu hình heartbeat</span>
                </div>
                <p class="font-body-sm text-body-sm text-on-surface-variant mt-space-xs">
                    Thiết bị gửi POST đến <code>/api/devices/{mã-thiết-bị}/heartbeat</code> kèm header
                    <code>X-Device-Token</code>. Có thể lấy chu kỳ heartbeat và cấu hình đồng bộ qua GET
                    <code>/api/devices/{mã-thiết-bị}/config</code>. Thiết bị được xem là ngoại tuyến khi quá 3 chu kỳ heartbeat
                    (tối thiểu <%= onlineWindowMinutes %> phút) chưa gửi tín hiệu.
                </p>
                <p class="font-body-sm text-body-sm text-on-surface-variant mt-space-sm">
                    Firmware cần đọc cấu hình này để chạy lịch đồng bộ. Khi bật tự động, thiết bị gửi dữ liệu theo chu kỳ đã đặt;
                    khi tắt, thiết bị không gửi lô định kỳ. Máy chủ vẫn tiếp nhận các lô được gửi thủ công.
                </p>
            </div>

            <div class="p-space-md bg-green-50 border border-green-200 rounded-xl">
                <div class="flex items-center gap-space-xs text-green-800">
                    <span class="material-symbols-outlined text-[18px]">fingerprint</span>
                    <span class="font-label-md text-label-md">Nhận lượt chấm công thực tế (HTTP Push)</span>
                </div>
                <p class="font-body-sm text-body-sm text-on-surface-variant mt-space-xs">
                    Cấu hình máy gửi POST đến <code>/api/devices/{mã-thiết-bị}/events</code>,
                    kèm header <code>X-Device-Token</code> và <code>Content-Type: application/json</code>.
                    Dùng địa chỉ IP của máy chủ trong mạng LAN, không dùng localhost. Gửi tối đa 500 lượt mỗi lô:
                </p>
                <pre class="mt-space-sm p-space-sm bg-white rounded-lg overflow-x-auto text-[11px] text-on-surface"><code>{
  "events": [
    {
      "event_id": "LOG-000001",
      "employee_code": "NV001",
      "occurred_at": "2026-11-17 08:30:00",
      "direction": "in"
    },
    {
      "event_id": "LOG-000002",
      "employee_code": "NV001",
      "occurred_at": "2026-11-17 17:05:00",
      "direction": "out"
    }
  ]
}</code></pre>
                <p class="font-body-sm text-body-sm text-on-surface-variant mt-space-sm">
                    Thời điểm dùng giờ địa phương theo định dạng <code>YYYY-MM-DD HH:mm:ss</code>.
                    Hệ thống chống nhận trùng, lưu lượt vào/ra và tự tổng hợp giờ vào sớm nhất, giờ ra muộn nhất
                    vào bảng chấm công. Chỉ gửi mã nhân viên và thời điểm; không gửi ảnh hoặc dữ liệu sinh trắc học.
                </p>
            </div>

            <div class="p-space-md bg-surface-container-low rounded-xl">
                <div class="flex items-center gap-space-xs text-primary">
                    <span class="material-symbols-outlined text-[18px]">sync</span>
                    <span class="font-label-md text-label-md">Đồng bộ bản ghi tổng hợp theo ngày</span>
                </div>
                <p class="font-body-sm text-body-sm text-on-surface-variant mt-space-xs">
                    Thiết bị gửi POST đến <code>/api/devices/{mã-thiết-bị}/sync</code> với cùng header
                    <code>X-Device-Token</code>. Gửi tối đa 500 bản ghi trong mỗi lô:
                </p>
                <pre class="mt-space-sm p-space-sm bg-surface-container-high rounded-lg overflow-x-auto text-[11px] text-on-surface"><code>{
  "records": [
    {
      "employee_code": "NV001",
      "work_date": "2026-11-17",
      "check_in": "07:30",
      "check_out": "17:00",
      "status": "present"
    }
  ]
}</code></pre>
                <p class="font-body-sm text-body-sm text-on-surface-variant mt-space-sm">
                    Chỉ bản ghi do thiết bị tạo mới hoặc đồng bộ trước đó mới được cập nhật; dữ liệu đã điều chỉnh thủ công được giữ nguyên.
                </p>
            </div>
                </div>
            </details>
        </aside>
    </section>
</section>

<script>
    (() => {
        const button = document.getElementById("device-status-refresh");
        const icon = document.getElementById("device-status-refresh-icon");
        const searchInput = document.getElementById("device-search");
        const stateFilter = document.getElementById("device-state-filter");
        const deviceRows = [...document.querySelectorAll("[data-device-row]")];
        const normalize = (value) => value.toLocaleLowerCase("vi").normalize("NFD").replace(/[\u0300-\u036f]/g, "");
        let checking = false;

        const filterDevices = () => {
            const query = normalize(searchInput.value.trim());
            const selectedState = stateFilter.value;
            let visibleCount = 0;

            deviceRows.forEach((row) => {
                const searchableText = `${row.cells[0].textContent} ${row.cells[1].textContent}`;
                const matchesQuery = normalize(searchableText).includes(query);
                const matchesState = selectedState === "all" || row.dataset.deviceState === selectedState;
                row.hidden = !matchesQuery || !matchesState;
                if (!row.hidden) visibleCount += 1;
            });

            document.getElementById("device-visible-count").textContent =
                `${visibleCount} / ${deviceRows.length} thiết bị`;
            document.getElementById("device-filter-empty").hidden = visibleCount > 0 || deviceRows.length === 0;
        };

        const checkDeviceStatuses = async () => {
            if (checking || document.visibilityState !== "visible") return;
            checking = true;
            button.disabled = true;
            icon.classList.add("animate-spin");

            try {
                const response = await fetch("/admin/devices/refresh", {
                    headers: { Accept: "application/json" },
                    cache: "no-store"
                });
                const data = await response.json();
                if (!response.ok) throw new Error(data.error || "Không thể kiểm tra trạng thái thiết bị.");

                data.devices.forEach((device) => {
                    const row = document.querySelector(`[data-device-id="${device.id}"]`);
                    if (row) row.dataset.deviceState = !device.is_active ? "inactive" : device.is_online ? "online" : "offline";

                    const badge = document.getElementById(`device-status-${device.id}`);
                    if (badge) {
                        if (!device.is_active) {
                            badge.className = "inline-flex items-center gap-1.5 px-space-sm py-1 bg-surface-container-high text-on-surface-variant rounded-full font-label-sm text-label-sm";
                            badge.innerHTML = '<span class="w-2 h-2 rounded-full bg-outline"></span>Ngừng hoạt động';
                        } else if (device.is_online) {
                            badge.className = "inline-flex items-center gap-1.5 px-space-sm py-1 bg-green-50 text-green-700 rounded-full font-label-sm text-label-sm";
                            badge.innerHTML = '<span class="w-2 h-2 rounded-full bg-green-500"></span>Trực tuyến';
                        } else {
                            badge.className = "inline-flex items-center gap-1.5 px-space-sm py-1 bg-red-50 text-red-700 rounded-full font-label-sm text-label-sm";
                            badge.innerHTML = '<span class="w-2 h-2 rounded-full bg-red-500"></span>Ngoại tuyến';
                        }
                    }

                    const lastSeen = document.getElementById(`device-last-seen-${device.id}`);
                    if (lastSeen) lastSeen.textContent = device.last_seen_at || "Chưa gửi tín hiệu";
                });

                document.getElementById("device-stat-total").textContent = data.stats.total;
                document.getElementById("device-stat-online").textContent = data.stats.online;
                document.getElementById("device-stat-offline").textContent = data.stats.offline;
                filterDevices();
                document.getElementById("device-status-refresh-result").textContent =
                    `Đã kiểm tra lúc ${new Date(data.checked_at).toLocaleTimeString("vi-VN")}`;
            } catch (error) {
                console.error("Lỗi kiểm tra trạng thái thiết bị:", error);
                document.getElementById("device-status-refresh-result").textContent = "Kiểm tra thất bại · Thử lại";
            } finally {
                checking = false;
                button.disabled = false;
                icon.classList.remove("animate-spin");
            }
        };

        searchInput.addEventListener("input", filterDevices);
        stateFilter.addEventListener("change", filterDevices);
        button.addEventListener("click", checkDeviceStatuses);
        window.setInterval(checkDeviceStatuses, 30000);
    })();
</script>

<%- include("../partials/adminFoot") %>
