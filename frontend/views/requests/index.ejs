                                        <span class="material-symbols-outlined text-teal-700 text-[18px]">luggage</span>
                                    <% } else if (item.type === 'explanation') { %>
                                        <span class="material-symbols-outlined text-secondary text-[18px]">edit_document</span>
                                    <% } else if (item.type === 'resignation') { %>
                                        <span class="material-symbols-outlined text-error text-[18px]">person_remove</span>
                                    <% } else { %>
                                        <span class="material-symbols-outlined text-secondary text-[18px]">event_busy</span>
                                    <% } %>
                                    <span class="font-label-md text-label-md text-on-surface"><%= item.typeLabel %></span>
                                </div>
                            </td>
                            <td class="py-space-md px-space-md">
                                <div class="flex flex-col">
                                    <span class="font-label-md text-label-md text-on-surface font-semibold"><%= item.employeeName %></span>
                                    <span class="font-data-mono text-[11px] text-on-surface-variant"><%= item.employeeId %> • <%= item.department %></span>
                                </div>
                            </td>
                            <td class="py-space-md px-space-md">
                                <div class="flex flex-col gap-0.5">
                                    <span class="font-data-mono text-data-mono text-on-surface"><%= item.fromDate %></span>
                                    <% if (item.toDate && item.toDate !== item.fromDate) { %>
                                        <span class="font-body-sm text-body-sm text-on-surface-variant">đến <span class="font-data-mono"><%= item.toDate %></span></span>
                                    <% } %>
                                    <% if (item.type === "overtime" && item.overtime_start_time && item.overtime_end_time) { %>
                                        <span class="font-body-sm text-violet-700">Tăng ca <span class="font-data-mono"><%= item.overtime_start_time %>–<%= item.overtime_end_time %></span></span>
                                    <% } %>
                                </div>
                            </td>
                            <td class="py-space-md px-space-md max-w-[360px]">
                                <p class="font-body-sm text-body-sm text-on-surface-variant line-clamp-2" title="<%= item.reason %>"><%= item.destination ? `${item.destination} · ` : "" %><%= item.reason %></p>
                                <% if (item.status === "rejected") { const declineReason = item.employee_response === "rejected" ? item.employee_response_note : item.review_note; if (declineReason) { %><p class="mt-1 text-[11px] text-error"><strong>Lý do từ chối:</strong> <%= declineReason %></p><% } } %>
                                 <% if (item.reviewedAt) { %><p class="mt-1 text-[11px] text-on-surface-variant"><strong><%= item.status === "rejected" ? "Từ chối bởi" : "Duyệt bởi" %>:</strong> <%= item.reviewerName || "Admin" %> · <%= item.reviewedAt %></p><% } %>
                                 <% if (item.status === "approved" && item.reviewNote) { %><p class="mt-1 text-[11px] text-on-surface-variant"><strong>Ghi chú duyệt:</strong> <%= item.reviewNote %></p><% } %>
                            </td>
                            <td class="py-space-md px-space-md">
                                <% if (item.status === 'approved') { %>
                                    <span class="inline-flex items-center gap-1.5 px-space-sm py-0.5 rounded-full bg-green-50 text-green-700 text-[11px] font-semibold">
                                        <span class="w-1.5 h-1.5 rounded-full bg-green-500"></span>
                                        <%= item.statusLabel %>
                                    </span>
                                <% } else if (item.status === 'rejected') { %>
                                    <span class="inline-flex items-center gap-1.5 px-space-sm py-0.5 rounded-full bg-error-container text-on-error-container text-[11px] font-semibold">
                                        <span class="w-1.5 h-1.5 rounded-full bg-error"></span>
                                        <%= item.statusLabel %>
                                    </span>
                                <% } else { %>
                                    <span class="inline-flex items-center gap-1.5 px-space-sm py-0.5 rounded-full bg-secondary-fixed text-on-secondary-fixed text-[11px] font-semibold">
                                        <span class="w-1.5 h-1.5 rounded-full bg-secondary"></span>
                                        <%= item.statusLabel %>
                                    </span>
                                <% } %>
                                 <% if (item.statusHint) { %><p class="mt-1 text-[11px] text-on-surface-variant"><%= item.statusHint %></p><% } %>
                                 <% if (item.durationLabel) { %><p class="mt-0.5 text-[11px] text-on-surface-variant"><%= item.durationLabel %></p><% } %>
                             </td>
                             <td class="py-space-md px-space-lg text-right">
                                <span class="font-data-mono text-[11px] text-on-surface-variant whitespace-nowrap"><%= item.createdAt %></span>
                            </td>
                            <td class="py-space-md px-space-lg">
                                <div class="flex justify-end gap-space-xs">
                                    <button type="button" data-review-action="track" title="Theo dõi trạng thái đơn" class="inline-flex items-center gap-1 px-space-sm py-1 rounded-lg bg-primary-fixed/60 hover:bg-primary-fixed text-primary font-label-sm"><span class="material-symbols-outlined text-[16px]">timeline</span>Theo dõi</button>
                                    <button type="button" data-review-action="view" title="Xem chi tiết đơn" class="inline-flex items-center gap-1 px-space-sm py-1 rounded-lg bg-surface-container-low hover:bg-surface-container-high text-on-surface-variant font-label-sm"><span class="material-symbols-outlined text-[16px]">visibility</span>Xem</button>
                                    <% if (item.canReview) { %>
                                        <button type="button" data-review-action="approve" title="Phê duyệt đơn" class="inline-flex items-center gap-1 px-space-sm py-1 rounded-lg bg-green-50 hover:bg-green-100 text-green-700 font-label-sm"><span class="material-symbols-outlined text-[16px]">check</span>Duyệt</button>
                                        <button type="button" data-review-action="reject" title="Từ chối đơn" class="inline-flex items-center gap-1 px-space-sm py-1 rounded-lg bg-error-container hover:bg-red-100 text-error font-label-sm"><span class="material-symbols-outlined text-[16px]">close</span>Từ chối</button>
                                    <% } %>
                                </div>
                            </td>
                        </tr>
                    <% }) %>
                    <tr id="request-empty-filter" class="hidden">
                        <td colspan="8" class="py-space-2xl px-space-lg text-center">
                            <div class="flex flex-col items-center gap-space-sm text-on-surface-variant">
                                <span class="material-symbols-outlined text-[40px] text-outline">search_off</span>
                                <span class="font-label-md text-label-md">Không tìm thấy đơn phù hợp</span>
                                <span class="font-body-sm text-body-sm">Thử thay đổi từ khóa hoặc bộ lọc.</span>
                            </div>
                        </td>
                    </tr>
                <% } %>
            </tbody>
        </table>
    </div>

    <div class="px-space-lg py-space-md border-t border-surface-container-high flex flex-col sm:flex-row sm:items-center justify-between gap-space-md">
        <div class="flex items-center gap-space-md">
            <span id="request-range-label" class="font-body-sm text-body-sm text-on-surface-variant"></span>
            <label class="inline-flex items-center gap-space-xs font-body-sm text-body-sm text-on-surface-variant">
                Hiển thị
                <select id="request-page-size" aria-label="Số đơn mỗi trang" class="bg-surface-container-low text-on-surface font-label-sm text-label-sm py-1 pl-space-sm pr-space-md rounded-lg outline-none cursor-pointer">
                    <option value="10">10</option>
                    <option value="20">20</option>
                    <option value="50">50</option>
                </select>
                đơn/trang
            </label>
        </div>
        <div class="flex items-center gap-space-xs">
            <button type="button" id="request-page-prev" class="inline-flex items-center gap-1 px-space-md py-1 rounded-lg bg-surface-container-low hover:bg-surface-container-high text-on-surface-variant font-label-sm text-label-sm disabled:opacity-40 disabled:cursor-not-allowed"><span class="material-symbols-outlined text-[16px]">chevron_left</span>Trước</button>
            <span id="request-page-indicator" class="px-space-sm font-label-sm text-label-sm text-on-surface-variant whitespace-nowrap"></span>
            <button type="button" id="request-page-next" class="inline-flex items-center gap-1 px-space-md py-1 rounded-lg bg-surface-container-low hover:bg-surface-container-high text-on-surface-variant font-label-sm text-label-sm disabled:opacity-40 disabled:cursor-not-allowed">Sau<span class="material-symbols-outlined text-[16px]">chevron_right</span></button>
        </div>
    </div>
</section>
<% } %>

<!-- Modal xem chi tiết / phê duyệt / từ chối đơn -->
<div id="review-modal" class="fixed inset-0 z-50 hidden" role="dialog" aria-modal="true" aria-labelledby="review-modal-title">
    <div class="absolute inset-0 bg-black/40 backdrop-blur-xs" data-close-review-modal></div>
    <div class="relative mx-auto mt-[5vh] w-[min(640px,calc(100%-2rem))] max-h-[90vh] overflow-y-auto rounded-2xl bg-surface-container-lowest shadow-xl">
        <div class="sticky top-0 z-10 flex items-start justify-between gap-space-md border-b border-surface-container-high bg-surface-container-lowest px-space-xl py-space-lg">
            <div>
                <h3 id="review-modal-title" class="font-headline-md text-headline-md text-primary font-semibold">Chi tiết đơn</h3>
                <p id="review-modal-subtitle" class="font-body-sm text-body-sm text-on-surface-variant mt-space-xs"></p>
            </div>
            <button type="button" class="p-space-sm rounded-xl text-on-surface-variant hover:bg-surface-container-high transition-colors" data-close-review-modal aria-label="Đóng">
                <span class="material-symbols-outlined">close</span>
            </button>
        </div>

        <div id="review-modal-detail" class="px-space-xl py-space-lg flex flex-col gap-space-sm"></div>

        <form id="review-form" method="POST" class="hidden px-space-xl pb-space-xl flex flex-col gap-space-md border-t border-surface-container-high pt-space-lg">
            <label for="review-note" class="flex flex-col gap-space-xs">
                <span id="review-note-label" class="font-label-sm text-label-sm text-on-surface">Ghi chú phê duyệt</span>
                <textarea id="review-note" name="review_note" maxlength="500" rows="4" class="bg-surface-container-low text-on-surface font-body-md text-body-md px-space-md py-space-sm rounded-xl outline-none focus:ring-2 focus:ring-primary-container resize-y" placeholder="Ghi chú để nhân viên nắm rõ quyết định..."></textarea>
                <span id="review-note-hint" class="font-body-sm text-body-sm text-on-surface-variant"></span>
            </label>
            <div class="flex justify-end gap-space-sm">
                <button type="button" data-close-review-modal class="px-space-lg py-space-sm bg-surface-container-high hover:bg-surface-variant text-on-surface font-label-md text-label-md rounded-xl transition-colors">Hủy</button>
                <button id="review-submit" type="submit" class="px-space-lg py-space-sm bg-primary hover:bg-primary-container text-on-primary font-label-md text-label-md rounded-xl transition-colors">Xác nhận</button>
            </div>
        </form>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        const showInlineError = (boxId, textId, message) => {
            const box = document.getElementById(boxId);
            const text = document.getElementById(textId);
            if (!box || !text) return;
            text.textContent = message;
            box.classList.remove('hidden');
            box.classList.add('flex');
        };

        const clearInlineError = (boxId, textId) => {
            const box = document.getElementById(boxId);
            const text = document.getElementById(textId);
            if (!box || !text) return;
            text.textContent = '';
            box.classList.add('hidden');
            box.classList.remove('flex');
        };

        const leaveForm = document.getElementById('leave-form');
        if (leaveForm) {
            leaveForm.addEventListener('submit', (event) => {
                clearInlineError('leave-form-error', 'leave-form-error-text');

                const type = leaveForm.leave_type.value;
                const from = leaveForm.from_date.value;
                const to = leaveForm.to_date.value;
                const reason = (leaveForm.reason.value || '').trim();

                if (!type) {
                    event.preventDefault();
                    showInlineError('leave-form-error', 'leave-form-error-text', 'Vui lòng chọn loại đơn nghỉ.');
                    return;
                }

                if (from && to && to < from) {
                    event.preventDefault();
                    showInlineError('leave-form-error', 'leave-form-error-text', 'Ngày kết thúc phải lớn hơn hoặc bằng ngày bắt đầu.');
                    return;
                }

                if (reason.length < 10) {
                    event.preventDefault();
                    showInlineError('leave-form-error', 'leave-form-error-text', 'Lý do nghỉ cần tối thiểu 10 ký tự để mô tả rõ nội dung.');
                }
            });
        }

        const explanationForm = document.getElementById('explanation-form');
        if (explanationForm) {
            const explanationParams = new URLSearchParams(window.location.search);
            explanationParams.set('tab', 'explanation');
            explanationParams.delete('success');
            explanationParams.delete('error');
            explanationForm.action = `/admin/requests/explanation?${explanationParams.toString()}`;

            explanationForm.addEventListener('submit', (event) => {
                clearInlineError('explanation-form-error', 'explanation-form-error-text');

                if (!explanationForm.employee_id.value) {
                    event.preventDefault();
                    showInlineError('explanation-form-error', 'explanation-form-error-text', 'Vui lòng chọn nhân viên giải trình.');
                    return;
                }

                const type = explanationForm.explanation_type.value;
                const subject = (explanationForm.subject.value || '').trim();
                const reason = (explanationForm.reason.value || '').trim();
                const fromTime = explanationForm.from_time.value;
                const toTime = explanationForm.to_time.value;

                if (!type) {
                    event.preventDefault();
                    showInlineError('explanation-form-error', 'explanation-form-error-text', 'Vui lòng chọn loại giải trình.');
                    return;
                }

                if (subject.length < 5) {
                    event.preventDefault();
                    showInlineError('explanation-form-error', 'explanation-form-error-text', 'Tiêu đề giải trình cần tối thiểu 5 ký tự.');
                    return;
                }

                if (reason.length < 20) {
                    event.preventDefault();
                    showInlineError('explanation-form-error', 'explanation-form-error-text', 'Nội dung giải trình cần tối thiểu 20 ký tự để đảm bảo rõ ràng.');
                    return;
                }

                if (fromTime && toTime && toTime <= fromTime) {
                    event.preventDefault();
                    showInlineError('explanation-form-error', 'explanation-form-error-text', 'Thời gian "đến" phải sau thời gian "từ" (nếu cùng ngày).');
                }
            });
        }

        const filterParams = new URLSearchParams(window.location.search);
        const initialDateField = ['fromDate', 'createdAt'].includes(filterParams.get('dateField'))
            ? filterParams.get('dateField')
            : 'fromDate';
        const syncFilterParams = (pairs) => {
            const params = new URLSearchParams(window.location.search);
            pairs.forEach(([key, el]) => {
                const value = typeof el === 'string' ? el.trim() : (el?.value || '').trim();
                if (value) params.set(key, value);
                else params.delete(key);
            });
            const query = params.toString();
            window.history.replaceState(null, '', `${window.location.pathname}${query ? `?${query}` : ''}`);
        };
        const matchesDateFilter = (row, field, from, to) => {
            if (!from && !to) return true;
            const raw = field === 'createdAt' ? row.dataset.createdDate : row.dataset.fromDate;
            const value = (raw || '').slice(0, 10);
            if (!value) return false;
            if (from && value < from) return false;
            if (to && value > to) return false;
            return true;
        };

        const searchInput = document.getElementById('request-search');
        const statusFilter = document.getElementById('request-status-filter');
        const typeFilter = document.getElementById('request-type-filter');
        const requestDateField = document.getElementById('request-date-field');
        const requestDateFrom = document.getElementById('request-date-from');
        const requestDateTo = document.getElementById('request-date-to');
        const listTableBody = document.getElementById('request-table-body');
        const rows = Array.from(document.querySelectorAll('#request-table-body .request-row'));
        const emptyFilterRow = document.getElementById('request-empty-filter');
        const visibleCount = document.getElementById('request-visible-count');
        const rangeLabel = document.getElementById('request-range-label');
        const pageIndicator = document.getElementById('request-page-indicator');
        const pagePrev = document.getElementById('request-page-prev');
        const pageNext = document.getElementById('request-page-next');
        const pageSizeSelect = document.getElementById('request-page-size');
        const exportButton = document.getElementById('request-export-csv');
        const sortButtons = Array.from(document.querySelectorAll('[data-sort-column]'));
        const sortKeys = ['code', 'type', 'employee', 'fromDate', 'status', 'createdAt'];
        const defaultSortKey = 'createdAt';
        const defaultPageSize = 10;
        const detailCache = new Map();

        if (searchInput) searchInput.value = filterParams.get('q') || '';
        if (statusFilter) statusFilter.value = filterParams.get('status') || '';
        if (typeFilter) typeFilter.value = filterParams.get('type') || '';
        if (requestDateField) requestDateField.value = initialDateField;
        if (requestDateFrom) requestDateFrom.value = filterParams.get('dateFrom') || '';
        if (requestDateTo) requestDateTo.value = filterParams.get('dateTo') || '';

        const parsedPageSize = Number.parseInt(filterParams.get('perPage'), 10);
        let pageSize = [10, 20, 50].includes(parsedPageSize) ? parsedPageSize : defaultPageSize;
        if (pageSizeSelect) pageSizeSelect.value = String(pageSize);
        let sortKey = sortKeys.includes(filterParams.get('sort')) ? filterParams.get('sort') : defaultSortKey;
        let sortOrder = filterParams.get('order') === 'asc' ? 'asc' : 'desc';
        const parsedPage = Number.parseInt(filterParams.get('page'), 10);
        let currentPage = Number.isSafeInteger(parsedPage) && parsedPage > 0 ? parsedPage : 1;
        let filteredRows = rows;

        const detailOf = (row) => {
            if (!detailCache.has(row)) {
                let detail = {};
                try { detail = JSON.parse(row.dataset.detail || '{}'); } catch { detail = {}; }
                detailCache.set(row, detail);
            }
            return detailCache.get(row);
        };
        const sortValueOf = (row, key) => {
            const detail = detailOf(row);
            if (key === 'code') return detail.code || '';
            if (key === 'type') return detail.typeLabel || '';
            if (key === 'employee') return detail.employeeName || '';
            if (key === 'status') return detail.statusLabel || '';
            if (key === 'fromDate') return row.dataset.fromDate || '';
            if (key === 'createdAt') return row.dataset.createdDate || '';
            return '';
        };
        const syncSortIndicators = () => {
            sortButtons.forEach((button) => {
                const key = button.dataset.sortColumn;
                const icon = document.querySelector(`[data-sort-icon="${key}"]`);
                if (icon) icon.textContent = key === sortKey ? (sortOrder === 'asc' ? 'arrow_upward' : 'arrow_downward') : 'unfold_more';
                const header = button.closest('th');
                if (header) header.setAttribute('aria-sort', key === sortKey ? (sortOrder === 'asc' ? 'ascending' : 'descending') : 'none');
            });
        };

        const renderList = () => {
            const query = (searchInput?.value || '').trim().toLowerCase();
            const status = statusFilter?.value || '';
            const type = typeFilter?.value || '';
            const dateField = requestDateField?.value || 'fromDate';
            const dateFrom = requestDateFrom?.value || '';
            const dateTo = requestDateTo?.value || '';

            filteredRows = rows.filter((row) => (!query || (row.dataset.search || '').includes(query))
                && (!status || row.dataset.status === status)
                && (!type || row.dataset.type === type)
                && matchesDateFilter(row, dateField, dateFrom, dateTo));
            filteredRows.sort((a, b) => {
                const compared = String(sortValueOf(a, sortKey)).localeCompare(
                    String(sortValueOf(b, sortKey)), 'vi', { numeric: true, sensitivity: 'base' }
                );
                return sortOrder === 'asc' ? compared : -compared;
            });

            const pageCount = Math.max(1, Math.ceil(filteredRows.length / pageSize));
            currentPage = Math.min(Math.max(1, currentPage), pageCount);
            const start = (currentPage - 1) * pageSize;
            const pageRows = filteredRows.slice(start, start + pageSize);
            const shownRows = new Set(pageRows);
            rows.forEach((row) => row.classList.toggle('hidden', !shownRows.has(row)));
            pageRows.forEach((row) => {
                if (listTableBody) listTableBody.insertBefore(row, emptyFilterRow || null);
            });

            if (visibleCount) visibleCount.textContent = String(filteredRows.length);
            if (emptyFilterRow) emptyFilterRow.classList.toggle('hidden', filteredRows.length !== 0);
            if (rangeLabel) rangeLabel.textContent = filteredRows.length
                ? `Hiển thị ${start + 1}–${start + pageRows.length} / ${filteredRows.length} đơn`
                : 'Không có đơn nào khớp bộ lọc';
            if (pageIndicator) pageIndicator.textContent = `Trang ${currentPage} / ${pageCount}`;
            if (pagePrev) pagePrev.disabled = currentPage <= 1;
            if (pageNext) pageNext.disabled = currentPage >= pageCount;
            syncSortIndicators();
            syncFilterParams([
                ['q', searchInput], ['status', statusFilter], ['type', typeFilter],
                ['dateField', requestDateField], ['dateFrom', requestDateFrom], ['dateTo', requestDateTo],
                ['page', currentPage > 1 ? String(currentPage) : ''],
                ['perPage', pageSize !== defaultPageSize ? String(pageSize) : ''],
                ['sort', sortKey !== defaultSortKey ? sortKey : ''],
                ['order', sortOrder === 'asc' ? 'asc' : '']
            ]);
        };

        const requestFilterInputs = [searchInput, statusFilter, typeFilter, requestDateField, requestDateFrom, requestDateTo];
        requestFilterInputs.forEach((el) => {
            if (!el) return;
            const eventName = el.tagName === 'INPUT' ? 'input' : 'change';
            el.addEventListener(eventName, () => { currentPage = 1; renderList(); });
        });
        sortButtons.forEach((button) => {
            button.addEventListener('click', () => {
                const key = button.dataset.sortColumn;
                if (!sortKeys.includes(key)) return;
                if (sortKey === key) {
                    sortOrder = sortOrder === 'asc' ? 'desc' : 'asc';
                } else {
                    sortKey = key;
                    sortOrder = ['fromDate', 'createdAt'].includes(key) ? 'desc' : 'asc';
                }
                currentPage = 1;
                renderList();
            });
        });
        pagePrev?.addEventListener('click', () => {
            if (currentPage <= 1) return;
            currentPage -= 1;
            renderList();
        });
        pageNext?.addEventListener('click', () => {
            currentPage += 1;
            renderList();
        });
        pageSizeSelect?.addEventListener('change', () => {
            const nextSize = Number.parseInt(pageSizeSelect.value, 10);
            pageSize = [10, 20, 50].includes(nextSize) ? nextSize : defaultPageSize;
            currentPage = 1;
            renderList();
        });
        exportButton?.addEventListener('click', () => {
            const columns = ['Mã đơn', 'Loại đơn', 'Nhân viên', 'Mã nhân viên', 'Phòng ban', 'Từ ngày', 'Đến ngày', 'Khung giờ', 'Tiêu đề', 'Lý do / nội dung', 'Trạng thái', 'Người duyệt', 'Ngày duyệt', 'Ghi chú duyệt', 'Lý do từ chối', 'Ngày tạo'];
            const escapeCsv = (value) => {
                const text = String(value ?? '');
                const safe = /^[=+\-@]/.test(text) ? `'${text}` : text;
                return `"${safe.replace(/"/g, '""')}"`;
            };
            const lines = [columns, ...filteredRows.map((row) => {
                const detail = detailOf(row);
                return [
                    detail.code, detail.typeLabel, detail.employeeName, detail.employeeId, detail.department,
                    detail.fromDate, detail.toDate && detail.toDate !== detail.fromDate ? detail.toDate : '',
                    detail.time, detail.subject, detail.reason, detail.statusLabel,
                    detail.reviewedAt ? (detail.reviewerName || 'Admin') : '', detail.reviewedAt || '',
                    detail.reviewNote,
                    detail.employeeResponseNote || (detail.statusLabel === 'Từ chối' ? detail.reviewNote : ''),
                    detail.createdAt
                ];
            })].map((cells) => cells.map(escapeCsv).join(','));
            const url = URL.createObjectURL(new Blob(['\uFEFF', lines.join('\r\n')], { type: 'text/csv;charset=utf-8' }));
            const link = document.createElement('a');
            link.href = url;
            link.download = `danh-sach-don-${new Date().toISOString().slice(0, 10)}.csv`;
            document.body.appendChild(link);
            link.click();
            link.remove();
            window.setTimeout(() => URL.revokeObjectURL(url), 0);
        });
        if (listTableBody) renderList();

        const explanationFilter = document.getElementById('explanation-status-filter');
        const explanationDateField = document.getElementById('explanation-date-field');
        const explanationDateFrom = document.getElementById('explanation-date-from');
        const explanationDateTo = document.getElementById('explanation-date-to');
        const explanationRows = Array.from(document.querySelectorAll('.explanation-row'));
        const explanationEmpty = document.getElementById('explanation-empty-filter');

        if (explanationFilter) explanationFilter.value = filterParams.get('status') || '';
        if (explanationDateField) explanationDateField.value = initialDateField;
        if (explanationDateFrom) explanationDateFrom.value = filterParams.get('dateFrom') || '';
        if (explanationDateTo) explanationDateTo.value = filterParams.get('dateTo') || '';

        const applyExplanationFilter = () => {
            const status = explanationFilter?.value || '';
            const dateField = explanationDateField?.value || 'fromDate';
            const dateFrom = explanationDateFrom?.value || '';
            const dateTo = explanationDateTo?.value || '';
            let count = 0;
            explanationRows.forEach((row) => {
                const visible = (!status || row.dataset.status === status)
                    && matchesDateFilter(row, dateField, dateFrom, dateTo);
                row.classList.toggle('hidden', !visible);
                if (visible) count += 1;
            });
            if (explanationEmpty) explanationEmpty.classList.toggle('hidden', count !== 0 || explanationRows.length === 0);
            syncFilterParams([
                ['status', explanationFilter], ['dateField', explanationDateField],
                ['dateFrom', explanationDateFrom], ['dateTo', explanationDateTo]
            ]);
        };

        const explanationFilterInputs = [explanationFilter, explanationDateField, explanationDateFrom, explanationDateTo];
        explanationFilterInputs.forEach((el) => {
            if (!el) return;
            const eventName = el.tagName === 'INPUT' ? 'input' : 'change';
            el.addEventListener(eventName, applyExplanationFilter);
        });
        if (explanationFilterInputs.some(Boolean)) applyExplanationFilter();

        const leaveStatusFilter = document.getElementById('leave-status-filter');
        const leaveCategoryFilter = document.getElementById('leave-category-filter');
        const leaveDateField = document.getElementById('leave-date-field');
        const leaveDateFrom = document.getElementById('leave-date-from');
        const leaveDateTo = document.getElementById('leave-date-to');
        const leaveRows = Array.from(document.querySelectorAll('.leave-row'));
        const leaveEmpty = document.getElementById('leave-empty-filter');

        if (leaveStatusFilter) leaveStatusFilter.value = filterParams.get('status') || '';
        if (leaveCategoryFilter) leaveCategoryFilter.value = filterParams.get('category') || '';
        if (leaveDateField) leaveDateField.value = initialDateField;
        if (leaveDateFrom) leaveDateFrom.value = filterParams.get('dateFrom') || '';
        if (leaveDateTo) leaveDateTo.value = filterParams.get('dateTo') || '';

        const applyLeaveFilter = () => {
            const status = leaveStatusFilter?.value || '';
            const category = leaveCategoryFilter?.value || '';
            const dateField = leaveDateField?.value || 'fromDate';
            const dateFrom = leaveDateFrom?.value || '';
            const dateTo = leaveDateTo?.value || '';
            let count = 0;
            leaveRows.forEach((row) => {
                const visible = (!status || row.dataset.status === status)
                    && (!category || row.dataset.category === category)
                    && matchesDateFilter(row, dateField, dateFrom, dateTo);
                row.classList.toggle('hidden', !visible);
                if (visible) count += 1;
            });
            if (leaveEmpty) leaveEmpty.classList.toggle('hidden', count !== 0 || leaveRows.length === 0);
            syncFilterParams([
                ['status', leaveStatusFilter], ['category', leaveCategoryFilter],
                ['dateField', leaveDateField], ['dateFrom', leaveDateFrom], ['dateTo', leaveDateTo]
            ]);
        };

        const leaveFilterInputs = [leaveStatusFilter, leaveCategoryFilter, leaveDateField, leaveDateFrom, leaveDateTo];
        leaveFilterInputs.forEach((el) => {
            if (!el) return;
            const eventName = el.tagName === 'INPUT' ? 'input' : 'change';
            el.addEventListener(eventName, applyLeaveFilter);
        });
        if (leaveFilterInputs.some(Boolean)) applyLeaveFilter();

        const categoryStatusFilter = document.getElementById('category-explanation-status-filter');
        const categoryDateField = document.getElementById('category-explanation-date-field');
        const categoryDateFrom = document.getElementById('category-explanation-date-from');
        const categoryDateTo = document.getElementById('category-explanation-date-to');
        const categoryRows = Array.from(document.querySelectorAll('.category-explanation-row'));
        const categoryEmpty = document.getElementById('category-explanation-empty-filter');

        if (categoryStatusFilter) categoryStatusFilter.value = filterParams.get('status') || '';
        if (categoryDateField) categoryDateField.value = initialDateField;
        if (categoryDateFrom) categoryDateFrom.value = filterParams.get('dateFrom') || '';
        if (categoryDateTo) categoryDateTo.value = filterParams.get('dateTo') || '';

        const applyCategoryFilter = () => {
            const status = categoryStatusFilter?.value || '';
            const dateField = categoryDateField?.value || 'fromDate';
            const dateFrom = categoryDateFrom?.value || '';
            const dateTo = categoryDateTo?.value || '';
            let count = 0;
            categoryRows.forEach((row) => {
                const visible = (!status || row.dataset.status === status)
                    && matchesDateFilter(row, dateField, dateFrom, dateTo);
                row.classList.toggle('hidden', !visible);
                if (visible) count += 1;
            });
            if (categoryEmpty) categoryEmpty.classList.toggle('hidden', count !== 0 || categoryRows.length === 0);
            syncFilterParams([
                ['status', categoryStatusFilter], ['dateField', categoryDateField],
                ['dateFrom', categoryDateFrom], ['dateTo', categoryDateTo]
            ]);
        };

        const categoryFilterInputs = [categoryStatusFilter, categoryDateField, categoryDateFrom, categoryDateTo];
        categoryFilterInputs.forEach((el) => {
            if (!el) return;
            const eventName = el.tagName === 'INPUT' ? 'input' : 'change';
            el.addEventListener(eventName, applyCategoryFilter);
        });
        if (categoryFilterInputs.some(Boolean)) applyCategoryFilter();

        // Xem chi tiết / phê duyệt / từ chối trong cùng một modal.
        const reviewModal = document.getElementById('review-modal');
        const reviewTitle = document.getElementById('review-modal-title');
        const reviewSubtitle = document.getElementById('review-modal-subtitle');
        const reviewDetail = document.getElementById('review-modal-detail');
        const reviewForm = document.getElementById('review-form');
        const reviewNote = document.getElementById('review-note');
        const reviewNoteLabel = document.getElementById('review-note-label');
        const reviewNoteHint = document.getElementById('review-note-hint');
        const reviewSubmit = document.getElementById('review-submit');
        const reviewTableBodies = Array.from(document.querySelectorAll('[data-review-table-body]'));
        let reviewMode = 'view';

        const appendDetailField = (label, value, tone) => {
            if (!value) return;
            const row = document.createElement('div');
            row.className = 'grid grid-cols-[110px_1fr] gap-space-sm text-body-sm';
            const key = document.createElement('span');
            key.className = 'font-label-sm text-label-sm text-on-surface-variant';
            key.textContent = label;
            const val = document.createElement('span');
            val.className = 'text-on-surface whitespace-pre-wrap break-words';
            if (tone === 'error') val.classList.add('text-error');
            if (tone === 'success') val.classList.add('text-green-700');
            val.textContent = value;
            row.append(key, val);
            reviewDetail.appendChild(row);
        };

        const renderTimeline = (detail) => {
            const summary = document.createElement('div');
            summary.className = 'flex flex-col gap-space-xs rounded-xl bg-surface-container-low p-space-md';
            const statusLine = document.createElement('div');
            statusLine.className = 'flex items-center gap-space-sm';
            const dot = document.createElement('span');
            dot.className = 'w-2.5 h-2.5 rounded-full '
                + (detail.statusTone === 'success' ? 'bg-green-500' : detail.statusTone === 'error' ? 'bg-error' : 'bg-secondary');
            const label = document.createElement('span');
            label.className = 'font-label-md text-label-md text-on-surface font-semibold';
            label.textContent = detail.statusLabel || 'Đang cập nhật';
            statusLine.append(dot, label);
            summary.appendChild(statusLine);
            [detail.statusHint, detail.durationLabel].forEach((text) => {
                if (!text) return;
                const line = document.createElement('p');
                line.className = 'font-body-sm text-body-sm text-on-surface-variant';
                line.textContent = text;
                summary.appendChild(line);
            });
            reviewDetail.appendChild(summary);

            const steps = Array.isArray(detail.timeline) ? detail.timeline : [];
            if (steps.length === 0) {
                const empty = document.createElement('p');
                empty.className = 'font-body-sm text-body-sm text-on-surface-variant mt-space-md';
                empty.textContent = 'Chưa có lịch sử trạng thái.';
                reviewDetail.appendChild(empty);
                return;
            }

            const heading = document.createElement('p');
            heading.className = 'font-label-sm text-label-sm text-on-surface-variant uppercase tracking-wider mt-space-sm';
            heading.textContent = 'Lịch sử trạng thái';
            reviewDetail.appendChild(heading);

            const list = document.createElement('ol');
            list.className = 'relative flex flex-col gap-space-md mt-space-xs';
            steps.forEach((step, index) => {
                const item = document.createElement('li');
                item.className = 'relative pl-space-xl';
                if (index < steps.length - 1) {
                    const connector = document.createElement('span');
                    connector.className = 'absolute left-[9px] top-5 bottom-[-16px] w-px bg-surface-container-high';
                    item.appendChild(connector);
                }
                const marker = document.createElement('span');
                marker.className = 'absolute left-0 top-1 w-[19px] h-[19px] rounded-full flex items-center justify-center text-white '
                    + (step.state === 'error' ? 'bg-error' : step.state === 'current' ? 'bg-secondary' : 'bg-primary');
                const icon = document.createElement('span');
                icon.className = 'material-symbols-outlined text-[13px] leading-none';
                icon.textContent = step.state === 'error' ? 'close' : step.state === 'current' ? 'schedule' : 'check';
                marker.appendChild(icon);

                const body = document.createElement('div');
                body.className = 'flex flex-col gap-0.5 pb-space-md';
                const title = document.createElement('p');
                title.className = 'font-label-md text-label-md text-on-surface font-semibold';
                title.textContent = step.label || '';
                body.appendChild(title);
                const meta = [step.time, step.actor].filter(Boolean).join(' · ');
                if (meta) {
                    const metaEl = document.createElement('p');
                    metaEl.className = 'font-body-sm text-body-sm text-on-surface-variant';
                    metaEl.textContent = meta;
                    body.appendChild(metaEl);
                }
                if (step.note) {
                    const note = document.createElement('p');
                    note.className = 'font-body-sm text-body-sm text-on-surface-variant whitespace-pre-wrap break-words';
                    note.textContent = step.note;
                    body.appendChild(note);
                }
                item.append(marker, body);
                list.appendChild(item);
            });
            reviewDetail.appendChild(list);
        };

        const openReviewModal = (row, mode) => {
            let detail = {};
            try { detail = JSON.parse(row.dataset.detail || '{}'); } catch { detail = {}; }
            reviewMode = mode;
            reviewDetail.replaceChildren();
            const isExplanation = Boolean(detail.typeLabel && detail.typeLabel.startsWith('Giải trình'));
            const isLateExplanation = isExplanation
                && (detail.returnTab === 'late_explanation' || detail.typeLabel.includes('Đi muộn'));
            const isEarlyLeaveExplanation = isExplanation
                && (detail.returnTab === 'early_leave_explanation' || detail.typeLabel.includes('Về sớm'));
            const explanationName = isLateExplanation ? 'giải trình đi muộn'
                : isEarlyLeaveExplanation ? 'giải trình về sớm' : 'giải trình';
            const isLeave = detail.returnTab === 'leave';
            const isTracking = mode === 'track';
            reviewTitle.textContent = isTracking
                ? 'Theo dõi trạng thái'
                : isExplanation
                    ? (mode === 'approve' ? `Phê duyệt ${explanationName}` : mode === 'reject' ? `Từ chối ${explanationName}` : `Chi tiết ${explanationName}`)
                    : isLeave
                        ? (mode === 'approve' ? 'Phê duyệt đơn nghỉ' : mode === 'reject' ? 'Từ chối đơn nghỉ' : 'Chi tiết đơn nghỉ')
                        : (mode === 'approve' ? 'Phê duyệt đơn' : mode === 'reject' ? 'Từ chối đơn' : 'Chi tiết đơn');
            reviewSubtitle.textContent = [detail.code, detail.typeLabel, detail.statusLabel].filter(Boolean).join(' · ');

            if (isTracking) {
                appendDetailField('Mã đơn', detail.code);
                appendDetailField('Nhân viên', [detail.employeeName, detail.employeeId].filter(Boolean).join(' · '));
                appendDetailField('Trạng thái hiện tại', [detail.statusLabel, detail.statusHint].filter(Boolean).join(' · '));
                appendDetailField('Nội dung', detail.reason);
                renderTimeline(detail);
            } else {
                appendDetailField('Mã đơn', detail.code);
                appendDetailField('Nhân viên', [detail.employeeName, detail.employeeId].filter(Boolean).join(' · '));
                appendDetailField('Phòng ban', detail.department);
                appendDetailField('Loại giải trình', detail.categoryLabel);
                appendDetailField(detail.typeLabel && detail.typeLabel.startsWith('Giải trình') ? 'Ngày phát sinh' : 'Thời gian', [detail.fromDate, detail.toDate && detail.toDate !== detail.fromDate ? `→ ${detail.toDate}` : '', detail.time].filter(Boolean).join(' '));
                appendDetailField('Tiêu đề', detail.subject);
                appendDetailField('Nội dung', detail.reason);
                appendDetailField('Địa điểm', detail.destination);
                appendDetailField('Trạng thái', [detail.statusLabel, detail.statusHint].filter(Boolean).join(' · '));
                appendDetailField('Ngày gửi', detail.createdAt);
                appendDetailField(detail.statusLabel === 'Từ chối' ? 'Người từ chối' : 'Người duyệt', detail.reviewedAt ? `${detail.reviewerName || 'Admin'} · ${detail.reviewedAt}` : '');
                appendDetailField('Ghi chú duyệt', detail.statusLabel === 'Từ chối' && !detail.employeeResponseNote ? '' : detail.reviewNote, 'success');
                appendDetailField('Lý do từ chối', detail.employeeResponseNote || (detail.statusLabel === 'Từ chối' ? detail.reviewNote : ''), 'error');
            }

            if (mode === 'view' || isTracking) {
                reviewForm.classList.add('hidden');
            } else {
                reviewForm.classList.remove('hidden');
                const returnTab = detail.returnTab || 'list';
                const actionParams = new URLSearchParams(window.location.search);
                actionParams.set('tab', returnTab);
                actionParams.delete('success');
                actionParams.delete('error');
                reviewForm.action = `/admin/requests/${detail.id}/${mode}?${actionParams.toString()}`;
                reviewNote.value = '';
                reviewNote.setCustomValidity('');
                const rejecting = mode === 'reject';
                reviewNoteLabel.textContent = rejecting
                    ? (isExplanation ? `Lý do từ chối ${explanationName} *` : isLeave ? 'Lý do từ chối đơn nghỉ *' : 'Lý do từ chối *')
                    : (isExplanation ? `Ghi chú phê duyệt ${explanationName} (không bắt buộc)` : isLeave ? 'Ghi chú phê duyệt đơn nghỉ (không bắt buộc)' : 'Ghi chú phê duyệt (không bắt buộc)');
                reviewNoteHint.textContent = rejecting
                    ? 'Bắt buộc từ 10 đến 500 ký tự để nhân viên nắm rõ.'
                    : 'Tối đa 500 ký tự. Ghi chú được lưu cùng quyết định và hiển thị ở danh sách.';
                reviewSubmit.textContent = rejecting ? 'Xác nhận từ chối' : 'Xác nhận duyệt';
                reviewSubmit.className = rejecting
                    ? 'px-space-lg py-space-sm bg-error hover:bg-error/90 text-white font-label-md text-label-md rounded-xl transition-colors'
                    : 'px-space-lg py-space-sm bg-primary hover:bg-primary-container text-on-primary font-label-md text-label-md rounded-xl transition-colors';
            }
            reviewModal.classList.remove('hidden');
            document.body.classList.add('overflow-hidden');
            if (mode !== 'view' && !isTracking) window.setTimeout(() => reviewNote.focus(), 0);
        };

        const closeReviewModal = () => {
            if (!reviewModal || reviewModal.classList.contains('hidden')) return;
            reviewModal.classList.add('hidden');
            document.body.classList.remove('overflow-hidden');
        };

        reviewTableBodies.forEach((tableBody) => {
            tableBody.addEventListener('click', (event) => {
                const button = event.target.closest('[data-review-action]');
                if (!button) return;
                const row = button.closest('.request-row');
                if (row) openReviewModal(row, button.dataset.reviewAction);
            });
        });

        reviewModal?.querySelectorAll('[data-close-review-modal]').forEach((el) => {
            el.addEventListener('click', closeReviewModal);
        });

        reviewNote?.addEventListener('input', () => reviewNote.setCustomValidity(''));
        reviewForm?.addEventListener('submit', (event) => {
            if (reviewMode !== 'reject') return;
            if (reviewNote.value.trim().length < 10) {
                event.preventDefault();
                reviewNote.setCustomValidity('Lý do từ chối cần từ 10 đến 500 ký tự.');
                reviewNote.reportValidity();
            }
        });

        // Realtime: danh sách và lịch sử trạng thái tự cập nhật khi có đơn thay đổi.
        const updateBanner = document.getElementById('requests-update-banner');
        const refreshButton = document.getElementById('requests-refresh');
        const showUpdateBanner = () => {
            if (!updateBanner) return;
            updateBanner.classList.remove('hidden');
            updateBanner.classList.add('flex');
        };
        refreshButton?.addEventListener('click', () => window.location.reload());
        if (typeof EventSource !== 'undefined') {
            try {
                const stream = new EventSource('/api/overview/stream');
                const hasOpenModal = () => reviewModal && !reviewModal.classList.contains('hidden');
                stream.addEventListener('requests', () => {
                    if (hasOpenModal()) return showUpdateBanner();
                    window.location.reload();
                });
                stream.addEventListener('attendance', () => {
                    if (hasOpenModal()) showUpdateBanner();
                });
            } catch (error) {
                // Không hỗ trợ SSE thì người dùng vẫn có thể tải lại trang bằng tay.
            }
        }

        document.addEventListener('keydown', (event) => {
            if (event.key === 'Escape') closeReviewModal();
        });
    });
</script>

<%- include("../partials/adminFoot") %>
