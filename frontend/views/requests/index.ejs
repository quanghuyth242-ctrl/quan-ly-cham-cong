        </div>
        <span class="font-body-sm text-body-sm text-on-surface-variant">
            Hiển thị <strong id="request-visible-count" class="text-on-surface"><%= requests.length %></strong> / <strong class="text-on-surface"><%= requests.length %></strong> đơn
        </span>
    </div>

    <div class="px-space-lg py-space-sm bg-primary-fixed/30 text-primary text-body-sm border-b border-primary/10 flex items-start gap-space-sm">
        <span class="material-symbols-outlined text-[18px] shrink-0">fact_check</span>
        <span>Duyệt đơn nghỉ sẽ ghi nhận ngày nghỉ vào chấm công; duyệt công tác cập nhật giờ theo ca đã phân; duyệt tăng ca ghi nhận trạng thái tăng ca. Đơn đã xử lý không thể duyệt lại — hãy kiểm tra kỹ trước khi xác nhận.</span>
    </div>

    <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse min-w-[980px]">
            <thead>
                <tr class="bg-surface-container-low text-on-surface-variant font-label-sm text-label-sm uppercase tracking-wider">
                    <th class="py-space-md px-space-lg font-semibold">Mã đơn</th>
                    <th class="py-space-md px-space-md font-semibold">Loại đơn</th>
                    <th class="py-space-md px-space-md font-semibold">Nhân viên</th>
                    <th class="py-space-md px-space-md font-semibold">Thời gian</th>
                    <th class="py-space-md px-space-md font-semibold">Lý do / nội dung</th>
                    <th class="py-space-md px-space-md font-semibold">Trạng thái</th>
                    <th class="py-space-md px-space-lg font-semibold text-right">Ngày tạo</th>
                    <th class="py-space-md px-space-lg font-semibold text-right">Xử lý</th>
                </tr>
            </thead>
            <tbody id="request-table-body" data-review-table-body class="divide-y divide-surface-container-low text-body-sm text-on-surface">
                <% if (requests.length === 0) { %>
                    <tr>
                        <td colspan="8" class="py-space-2xl px-space-lg text-center">
                            <div class="flex flex-col items-center gap-space-sm text-on-surface-variant">
                                <span class="material-symbols-outlined text-[40px] text-outline">inbox</span>
                                <span class="font-label-md text-label-md">Chưa có đơn nào</span>
                                <span class="font-body-sm text-body-sm">Tạo đơn công tác để theo dõi quy trình phê duyệt và ngày công.</span>
                            </div>
                        </td>
                    </tr>
                <% } else { %>
                    <% requests.forEach((item) => { %>
                        <tr class="request-row hover:bg-surface-container-low/70 transition-colors align-top"
                            data-status="<%= item.status %>"
                            data-type="<%= item.type %>"
                            data-search="<%= [item.code, item.typeLabel, item.employeeName, item.employeeId, item.reason, item.destination, item.department].join(' ').toLowerCase() %>"
                            data-detail="<%= JSON.stringify({
                                id: item.id, code: item.code, typeLabel: item.typeLabel, returnTab: 'list',
                                employeeName: item.employeeName, employeeId: item.employeeId, department: item.department,
                                fromDate: item.fromDate, toDate: item.toDate, reason: item.reason,
                                destination: item.destination, subject: item.subject, time: item.timeLabel,
                                statusLabel: item.statusLabel, createdAt: item.createdAt,
                                reviewerName: item.reviewerName, reviewedAt: item.reviewedAt,
                                reviewNote: item.reviewNote, employeeResponseNote: item.employeeResponseNote
                            }) %>">
                            <td class="py-space-md px-space-lg">
                                <span class="inline-flex px-space-sm py-1 rounded-lg bg-primary-fixed text-primary font-data-mono text-data-mono font-semibold"><%= item.code %></span>
                            </td>
                            <td class="py-space-md px-space-md">
                                <div class="flex items-center gap-space-xs">
                                    <% if (item.type === 'overtime') { %>
                                        <span class="material-symbols-outlined text-violet-700 text-[18px]">more_time</span>
                                    <% } else if (item.type === 'business_trip') { %>
                                        <span class="material-symbols-outlined text-teal-700 text-[18px]">luggage</span>
                                    <% } else if (item.type === 'explanation') { %>
                                        <span class="material-symbols-outlined text-secondary text-[18px]">edit_document</span>
                                    <% } else if (item.type === 'resignation') { %>
                                        <span class="material-symbols-outlined text-error text-[18px]">person_remove</span>
                                    <% } else { %>
                                        <span class="material-symbols-outlined text-secondary text-[18px]">event_busy</span>
                                    <% } %>
                                    <span class="font-label-md text-label-md text-on-surface"><%= item.typeLabel %></span>
                                </div>
                            </td>
                            <td class="py-space-md px-space-md">
                                <div class="flex flex-col">
                                    <span class="font-label-md text-label-md text-on-surface font-semibold"><%= item.employeeName %></span>
                                    <span class="font-data-mono text-[11px] text-on-surface-variant"><%= item.employeeId %> • <%= item.department %></span>
                                </div>
                            </td>
                            <td class="py-space-md px-space-md">
                                <div class="flex flex-col gap-0.5">
                                    <span class="font-data-mono text-data-mono text-on-surface"><%= item.fromDate %></span>
                                    <% if (item.toDate && item.toDate !== item.fromDate) { %>
                                        <span class="font-body-sm text-body-sm text-on-surface-variant">đến <span class="font-data-mono"><%= item.toDate %></span></span>
                                    <% } %>
                                    <% if (item.type === "overtime" && item.overtime_start_time && item.overtime_end_time) { %>
                                        <span class="font-body-sm text-violet-700">Tăng ca <span class="font-data-mono"><%= item.overtime_start_time %>–<%= item.overtime_end_time %></span></span>
                                    <% } %>
                                </div>
                            </td>
                            <td class="py-space-md px-space-md max-w-[360px]">
                                <p class="font-body-sm text-body-sm text-on-surface-variant line-clamp-2" title="<%= item.reason %>"><%= item.destination ? `${item.destination} · ` : "" %><%= item.reason %></p>
                                <% if (item.status === "rejected") { const declineReason = item.employee_response === "rejected" ? item.employee_response_note : item.review_note; if (declineReason) { %><p class="mt-1 text-[11px] text-error"><strong>Lý do từ chối:</strong> <%= declineReason %></p><% } } %>
                                 <% if (item.reviewedAt) { %><p class="mt-1 text-[11px] text-on-surface-variant"><strong><%= item.status === "rejected" ? "Từ chối bởi" : "Duyệt bởi" %>:</strong> <%= item.reviewerName || "Admin" %> · <%= item.reviewedAt %></p><% } %>
                                 <% if (item.status === "approved" && item.reviewNote) { %><p class="mt-1 text-[11px] text-on-surface-variant"><strong>Ghi chú duyệt:</strong> <%= item.reviewNote %></p><% } %>
                            </td>
                            <td class="py-space-md px-space-md">
                                <% if (item.status === 'approved') { %>
                                    <span class="inline-flex items-center gap-1.5 px-space-sm py-0.5 rounded-full bg-green-50 text-green-700 text-[11px] font-semibold">
                                        <span class="w-1.5 h-1.5 rounded-full bg-green-500"></span>
                                        <%= item.statusLabel %>
                                    </span>
                                <% } else if (item.status === 'rejected') { %>
                                    <span class="inline-flex items-center gap-1.5 px-space-sm py-0.5 rounded-full bg-error-container text-on-error-container text-[11px] font-semibold">
                                        <span class="w-1.5 h-1.5 rounded-full bg-error"></span>
                                        <%= item.statusLabel %>
                                    </span>
                                <% } else { %>
                                    <span class="inline-flex items-center gap-1.5 px-space-sm py-0.5 rounded-full bg-secondary-fixed text-on-secondary-fixed text-[11px] font-semibold">
                                        <span class="w-1.5 h-1.5 rounded-full bg-secondary"></span>
                                        <%= item.statusLabel %>
                                    </span>
                                <% } %>
                            </td>
                            <td class="py-space-md px-space-lg text-right">
                                <span class="font-data-mono text-[11px] text-on-surface-variant whitespace-nowrap"><%= item.createdAt %></span>
                            </td>
                            <td class="py-space-md px-space-lg">
                                <div class="flex justify-end gap-space-xs">
                                    <button type="button" data-review-action="view" title="Xem chi tiết đơn" class="inline-flex items-center gap-1 px-space-sm py-1 rounded-lg bg-surface-container-low hover:bg-surface-container-high text-on-surface-variant font-label-sm"><span class="material-symbols-outlined text-[16px]">visibility</span>Xem</button>
                                    <% if (item.canReview) { %>
                                        <button type="button" data-review-action="approve" title="Phê duyệt đơn" class="inline-flex items-center gap-1 px-space-sm py-1 rounded-lg bg-green-50 hover:bg-green-100 text-green-700 font-label-sm"><span class="material-symbols-outlined text-[16px]">check</span>Duyệt</button>
                                        <button type="button" data-review-action="reject" title="Từ chối đơn" class="inline-flex items-center gap-1 px-space-sm py-1 rounded-lg bg-error-container hover:bg-red-100 text-error font-label-sm"><span class="material-symbols-outlined text-[16px]">close</span>Từ chối</button>
                                    <% } %>
                                </div>
                            </td>
                        </tr>
                    <% }) %>
                    <tr id="request-empty-filter" class="hidden">
                        <td colspan="8" class="py-space-2xl px-space-lg text-center">
                            <div class="flex flex-col items-center gap-space-sm text-on-surface-variant">
                                <span class="material-symbols-outlined text-[40px] text-outline">search_off</span>
                                <span class="font-label-md text-label-md">Không tìm thấy đơn phù hợp</span>
                                <span class="font-body-sm text-body-sm">Thử thay đổi từ khóa hoặc bộ lọc.</span>
                            </div>
                        </td>
                    </tr>
                <% } %>
            </tbody>
        </table>
    </div>
</section>
<% } %>

<!-- Modal xem chi tiết / phê duyệt / từ chối đơn -->
<div id="review-modal" class="fixed inset-0 z-50 hidden" role="dialog" aria-modal="true" aria-labelledby="review-modal-title">
    <div class="absolute inset-0 bg-black/40 backdrop-blur-xs" data-close-review-modal></div>
    <div class="relative mx-auto mt-[5vh] w-[min(640px,calc(100%-2rem))] max-h-[90vh] overflow-y-auto rounded-2xl bg-surface-container-lowest shadow-xl">
        <div class="sticky top-0 z-10 flex items-start justify-between gap-space-md border-b border-surface-container-high bg-surface-container-lowest px-space-xl py-space-lg">
            <div>
                <h3 id="review-modal-title" class="font-headline-md text-headline-md text-primary font-semibold">Chi tiết đơn</h3>
                <p id="review-modal-subtitle" class="font-body-sm text-body-sm text-on-surface-variant mt-space-xs"></p>
            </div>
            <button type="button" class="p-space-sm rounded-xl text-on-surface-variant hover:bg-surface-container-high transition-colors" data-close-review-modal aria-label="Đóng">
                <span class="material-symbols-outlined">close</span>
            </button>
        </div>

        <div id="review-modal-detail" class="px-space-xl py-space-lg flex flex-col gap-space-sm"></div>

        <form id="review-form" method="POST" class="hidden px-space-xl pb-space-xl flex flex-col gap-space-md border-t border-surface-container-high pt-space-lg">
            <label for="review-note" class="flex flex-col gap-space-xs">
                <span id="review-note-label" class="font-label-sm text-label-sm text-on-surface">Ghi chú phê duyệt</span>
                <textarea id="review-note" name="review_note" maxlength="500" rows="4" class="bg-surface-container-low text-on-surface font-body-md text-body-md px-space-md py-space-sm rounded-xl outline-none focus:ring-2 focus:ring-primary-container resize-y" placeholder="Ghi chú để nhân viên nắm rõ quyết định..."></textarea>
                <span id="review-note-hint" class="font-body-sm text-body-sm text-on-surface-variant"></span>
            </label>
            <div class="flex justify-end gap-space-sm">
                <button type="button" data-close-review-modal class="px-space-lg py-space-sm bg-surface-container-high hover:bg-surface-variant text-on-surface font-label-md text-label-md rounded-xl transition-colors">Hủy</button>
                <button id="review-submit" type="submit" class="px-space-lg py-space-sm bg-primary hover:bg-primary-container text-on-primary font-label-md text-label-md rounded-xl transition-colors">Xác nhận</button>
            </div>
        </form>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        const showInlineError = (boxId, textId, message) => {
            const box = document.getElementById(boxId);
            const text = document.getElementById(textId);
            if (!box || !text) return;
            text.textContent = message;
            box.classList.remove('hidden');
            box.classList.add('flex');
        };

        const clearInlineError = (boxId, textId) => {
            const box = document.getElementById(boxId);
            const text = document.getElementById(textId);
            if (!box || !text) return;
            text.textContent = '';
            box.classList.add('hidden');
            box.classList.remove('flex');
        };

        const leaveForm = document.getElementById('leave-form');
        if (leaveForm) {
            leaveForm.addEventListener('submit', (event) => {
                clearInlineError('leave-form-error', 'leave-form-error-text');

                const type = leaveForm.leave_type.value;
                const from = leaveForm.from_date.value;
                const to = leaveForm.to_date.value;
                const reason = (leaveForm.reason.value || '').trim();

                if (!type) {
                    event.preventDefault();
                    showInlineError('leave-form-error', 'leave-form-error-text', 'Vui lòng chọn loại đơn nghỉ.');
                    return;
                }

                if (from && to && to < from) {
                    event.preventDefault();
                    showInlineError('leave-form-error', 'leave-form-error-text', 'Ngày kết thúc phải lớn hơn hoặc bằng ngày bắt đầu.');
                    return;
                }

                if (reason.length < 10) {
                    event.preventDefault();
                    showInlineError('leave-form-error', 'leave-form-error-text', 'Lý do nghỉ cần tối thiểu 10 ký tự để mô tả rõ nội dung.');
                }
            });
        }

        const explanationForm = document.getElementById('explanation-form');
        if (explanationForm) {
            explanationForm.addEventListener('submit', (event) => {
                clearInlineError('explanation-form-error', 'explanation-form-error-text');

                if (!explanationForm.employee_id.value) {
                    event.preventDefault();
                    showInlineError('explanation-form-error', 'explanation-form-error-text', 'Vui lòng chọn nhân viên giải trình.');
                    return;
                }

                const type = explanationForm.explanation_type.value;
                const subject = (explanationForm.subject.value || '').trim();
                const reason = (explanationForm.reason.value || '').trim();
                const fromTime = explanationForm.from_time.value;
                const toTime = explanationForm.to_time.value;

                if (!type) {
                    event.preventDefault();
                    showInlineError('explanation-form-error', 'explanation-form-error-text', 'Vui lòng chọn loại giải trình.');
                    return;
                }

                if (subject.length < 5) {
                    event.preventDefault();
                    showInlineError('explanation-form-error', 'explanation-form-error-text', 'Tiêu đề giải trình cần tối thiểu 5 ký tự.');
                    return;
                }

                if (reason.length < 20) {
                    event.preventDefault();
                    showInlineError('explanation-form-error', 'explanation-form-error-text', 'Nội dung giải trình cần tối thiểu 20 ký tự để đảm bảo rõ ràng.');
                    return;
                }

                if (fromTime && toTime && toTime <= fromTime) {
                    event.preventDefault();
                    showInlineError('explanation-form-error', 'explanation-form-error-text', 'Thời gian "đến" phải sau thời gian "từ" (nếu cùng ngày).');
                }
            });
        }

        const searchInput = document.getElementById('request-search');
        const statusFilter = document.getElementById('request-status-filter');
        const typeFilter = document.getElementById('request-type-filter');
        const rows = Array.from(document.querySelectorAll('.request-row'));
        const emptyFilterRow = document.getElementById('request-empty-filter');
        const visibleCount = document.getElementById('request-visible-count');

        const applyFilters = () => {
            const query = (searchInput?.value || '').trim().toLowerCase();
            const status = statusFilter?.value || '';
            const type = typeFilter?.value || '';
            let count = 0;

            rows.forEach((row) => {
                const matchSearch = !query || (row.dataset.search || '').includes(query);
                const matchStatus = !status || row.dataset.status === status;
                const matchType = !type || row.dataset.type === type;
                const visible = matchSearch && matchStatus && matchType;

                row.classList.toggle('hidden', !visible);
                if (visible) count += 1;
            });

            if (visibleCount) visibleCount.textContent = String(count);
            if (emptyFilterRow) emptyFilterRow.classList.toggle('hidden', count !== 0 || rows.length === 0);
        };

        [searchInput, statusFilter, typeFilter].forEach((el) => {
            if (!el) return;
            const eventName = el.tagName === 'INPUT' ? 'input' : 'change';
            el.addEventListener(eventName, applyFilters);
        });

        const explanationFilter = document.getElementById('explanation-status-filter');
        const explanationRows = Array.from(document.querySelectorAll('.explanation-row'));
        const explanationEmpty = document.getElementById('explanation-empty-filter');
        const applyExplanationFilter = () => {
            const status = explanationFilter?.value || '';
            let count = 0;
            explanationRows.forEach((row) => {
                const visible = !status || row.dataset.status === status;
                row.classList.toggle('hidden', !visible);
                if (visible) count += 1;
            });
            if (explanationEmpty) explanationEmpty.classList.toggle('hidden', count !== 0 || explanationRows.length === 0);
        };
        explanationFilter?.addEventListener('change', applyExplanationFilter);

        // Xem chi tiết / phê duyệt / từ chối trong cùng một modal.
        const reviewModal = document.getElementById('review-modal');
        const reviewTitle = document.getElementById('review-modal-title');
        const reviewSubtitle = document.getElementById('review-modal-subtitle');
        const reviewDetail = document.getElementById('review-modal-detail');
        const reviewForm = document.getElementById('review-form');
        const reviewNote = document.getElementById('review-note');
        const reviewNoteLabel = document.getElementById('review-note-label');
        const reviewNoteHint = document.getElementById('review-note-hint');
        const reviewSubmit = document.getElementById('review-submit');
        const reviewTableBodies = Array.from(document.querySelectorAll('[data-review-table-body]'));
        let reviewMode = 'view';

        const appendDetailField = (label, value, tone) => {
            if (!value) return;
            const row = document.createElement('div');
            row.className = 'grid grid-cols-[110px_1fr] gap-space-sm text-body-sm';
            const key = document.createElement('span');
            key.className = 'font-label-sm text-label-sm text-on-surface-variant';
            key.textContent = label;
            const val = document.createElement('span');
            val.className = 'text-on-surface whitespace-pre-wrap break-words';
            if (tone === 'error') val.classList.add('text-error');
            if (tone === 'success') val.classList.add('text-green-700');
            val.textContent = value;
            row.append(key, val);
            reviewDetail.appendChild(row);
        };

        const openReviewModal = (row, mode) => {
            let detail = {};
            try { detail = JSON.parse(row.dataset.detail || '{}'); } catch { detail = {}; }
            reviewMode = mode;
            reviewDetail.replaceChildren();
            const isExplanation = Boolean(detail.typeLabel && detail.typeLabel.startsWith('Giải trình'));
            reviewTitle.textContent = isExplanation
                ? (mode === 'approve' ? 'Phê duyệt giải trình' : mode === 'reject' ? 'Từ chối giải trình' : 'Chi tiết giải trình')
                : (mode === 'approve' ? 'Phê duyệt đơn' : mode === 'reject' ? 'Từ chối đơn' : 'Chi tiết đơn');
            reviewSubtitle.textContent = [detail.code, detail.typeLabel, detail.statusLabel].filter(Boolean).join(' · ');

            appendDetailField('Nhân viên', [detail.employeeName, detail.employeeId].filter(Boolean).join(' · '));
            appendDetailField('Phòng ban', detail.department);
            appendDetailField(detail.typeLabel && detail.typeLabel.startsWith('Giải trình') ? 'Ngày phát sinh' : 'Thời gian', [detail.fromDate, detail.toDate && detail.toDate !== detail.fromDate ? `→ ${detail.toDate}` : '', detail.time].filter(Boolean).join(' '));
            appendDetailField('Tiêu đề', detail.subject);
            appendDetailField('Nội dung', detail.reason);
            appendDetailField('Địa điểm', detail.destination);
            appendDetailField('Ngày gửi', detail.createdAt);
            appendDetailField(detail.statusLabel === 'Từ chối' ? 'Người từ chối' : 'Người duyệt', detail.reviewedAt ? `${detail.reviewerName || 'Admin'} · ${detail.reviewedAt}` : '');
            appendDetailField('Ghi chú duyệt', detail.reviewNote, 'success');
            appendDetailField('Lý do từ chối', detail.employeeResponseNote, 'error');

            if (mode === 'view') {
                reviewForm.classList.add('hidden');
            } else {
                reviewForm.classList.remove('hidden');
                const returnTab = detail.returnTab === 'explanation' ? 'explanation' : 'list';
                reviewForm.action = `/admin/requests/${detail.id}/${mode}?tab=${returnTab}`;
                reviewNote.value = '';
                reviewNote.setCustomValidity('');
                const rejecting = mode === 'reject';
                reviewNoteLabel.textContent = rejecting
                    ? (isExplanation ? 'Lý do từ chối giải trình *' : 'Lý do từ chối *')
                    : (isExplanation ? 'Ghi chú phê duyệt giải trình (không bắt buộc)' : 'Ghi chú phê duyệt (không bắt buộc)');
                reviewNoteHint.textContent = rejecting
                    ? 'Bắt buộc từ 10 đến 500 ký tự để nhân viên nắm rõ.'
                    : 'Tối đa 500 ký tự. Ghi chú được lưu cùng quyết định và hiển thị ở danh sách.';
                reviewSubmit.textContent = rejecting ? 'Xác nhận từ chối' : 'Xác nhận duyệt';
                reviewSubmit.className = rejecting
                    ? 'px-space-lg py-space-sm bg-error hover:bg-error/90 text-white font-label-md text-label-md rounded-xl transition-colors'
                    : 'px-space-lg py-space-sm bg-primary hover:bg-primary-container text-on-primary font-label-md text-label-md rounded-xl transition-colors';
            }
            reviewModal.classList.remove('hidden');
            document.body.classList.add('overflow-hidden');
            if (mode !== 'view') window.setTimeout(() => reviewNote.focus(), 0);
        };

        const closeReviewModal = () => {
            if (!reviewModal || reviewModal.classList.contains('hidden')) return;
            reviewModal.classList.add('hidden');
            document.body.classList.remove('overflow-hidden');
        };

        reviewTableBodies.forEach((tableBody) => {
            tableBody.addEventListener('click', (event) => {
                const button = event.target.closest('[data-review-action]');
                if (!button) return;
                const row = button.closest('.request-row');
                if (row) openReviewModal(row, button.dataset.reviewAction);
            });
        });

        reviewModal?.querySelectorAll('[data-close-review-modal]').forEach((el) => {
            el.addEventListener('click', closeReviewModal);
        });

        reviewNote?.addEventListener('input', () => reviewNote.setCustomValidity(''));
        reviewForm?.addEventListener('submit', (event) => {
            if (reviewMode !== 'reject') return;
            if (reviewNote.value.trim().length < 10) {
                event.preventDefault();
                reviewNote.setCustomValidity('Lý do từ chối cần từ 10 đến 500 ký tự.');
                reviewNote.reportValidity();
            }
        });

        document.addEventListener('keydown', (event) => {
            if (event.key === 'Escape') closeReviewModal();
        });
    });
</script>

<%- include("../partials/adminFoot") %>
