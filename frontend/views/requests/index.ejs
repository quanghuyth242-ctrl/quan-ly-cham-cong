            <input id="explanation-date-to" type="date" aria-label="Đến ngày" placeholder="Đến ngày" class="w-full sm:w-36 bg-surface-container-low text-on-surface font-label-sm text-label-sm px-space-md py-space-sm rounded-xl outline-none">
