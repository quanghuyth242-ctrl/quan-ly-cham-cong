                    <th class="py-space-md px-space-md font-semibold">Tiêu đề / nội dung</th>
                    <th class="py-space-md px-space-md font-semibold">Trạng thái</th>
                    <th class="py-space-md px-space-lg font-semibold text-right">Xử lý</th>
                </tr>
            </thead>
            <tbody id="explanation-table-body" data-review-table-body class="divide-y divide-surface-container-low text-body-sm text-on-surface">
                <% if (explanationRequests.length === 0) { %>
                    <tr>
                        <td colspan="7" class="py-space-2xl px-space-lg text-center">
                            <div class="flex flex-col items-center gap-space-sm text-on-surface-variant">
                                <span class="material-symbols-outlined text-[40px] text-outline">edit_document</span>
                                <span class="font-label-md text-label-md">Chưa có đơn giải trình nào</span>
                                <span class="font-body-sm text-body-sm">Gửi giải trình ở form phía trên để tạo đơn chờ phê duyệt.</span>
                            </div>
                        </td>
                    </tr>
                <% } else { %>
                    <% explanationRequests.forEach((item) => { %>
                        <tr class="request-row explanation-row hover:bg-surface-container-low/70 transition-colors align-top"
                            data-status="<%= item.status %>"
                            data-detail="<%= JSON.stringify({
                                id: item.id, code: item.code, typeLabel: item.typeLabel, returnTab: 'explanation',
                                employeeName: item.employeeName, employeeId: item.employeeId, department: item.department,
                                fromDate: item.fromDate, toDate: item.toDate, subject: item.subject,
                                time: item.timeLabel, reason: item.reason, destination: "",
                                statusLabel: item.statusLabel, createdAt: item.createdAt,
                                reviewerName: item.reviewerName, reviewedAt: item.reviewedAt,
                                reviewNote: item.reviewNote, employeeResponseNote: item.employeeResponseNote
                            }) %>">
                            <td class="py-space-md px-space-lg">
                                <span class="inline-flex px-space-sm py-1 rounded-lg bg-primary-fixed text-primary font-data-mono text-data-mono font-semibold"><%= item.code %></span>
                            </td>
                            <td class="py-space-md px-space-md">
                                <div class="flex flex-col">
                                    <span class="font-label-md text-label-md text-on-surface font-semibold"><%= item.employeeName %></span>
                                    <span class="font-data-mono text-[11px] text-on-surface-variant"><%= item.employeeId %> • <%= item.department %></span>
                                </div>
                            </td>
                            <td class="py-space-md px-space-md">
                                <span class="inline-flex items-center gap-1.5 font-label-md text-label-md text-on-surface">
                                    <span class="material-symbols-outlined text-secondary text-[16px]">edit_document</span>
                                    <%= item.categoryLabel %>
                                </span>
                            </td>
                            <td class="py-space-md px-space-md">
                                <div class="flex flex-col gap-0.5">
                                    <span class="font-data-mono text-data-mono text-on-surface"><%= item.fromDate %></span>
                                    <% if (item.timeLabel) { %><span class="font-body-sm text-body-sm text-on-surface-variant"><%= item.timeLabel %></span><% } %>
                                </div>
                            </td>
                            <td class="py-space-md px-space-md max-w-[360px]">
                                <span class="font-label-md text-label-md text-on-surface"><%= item.subject %></span>
                                <p class="font-body-sm text-body-sm text-on-surface-variant line-clamp-2" title="<%= item.reason %>"><%= item.reason %></p>
                                <% if (item.reviewedAt) { %><p class="mt-1 text-[11px] text-on-surface-variant"><strong><%= item.status === "rejected" ? "Từ chối bởi" : "Duyệt bởi" %>:</strong> <%= item.reviewerName || "Admin" %> · <%= item.reviewedAt %></p><% } %>
                                <% if (item.reviewNote) { %><p class="mt-1 text-[11px] text-on-surface-variant"><strong><%= item.status === "rejected" ? "Lý do từ chối" : "Ghi chú duyệt" %>:</strong> <%= item.reviewNote %></p><% } %>
                            </td>
                            <td class="py-space-md px-space-md">
                                <% if (item.status === "approved") { %>
                                    <span class="inline-flex items-center gap-1.5 px-space-sm py-0.5 rounded-full bg-green-50 text-green-700 text-[11px] font-semibold"><span class="w-1.5 h-1.5 rounded-full bg-green-500"></span><%= item.statusLabel %></span>
                                <% } else if (item.status === "rejected") { %>
                                    <span class="inline-flex items-center gap-1.5 px-space-sm py-0.5 rounded-full bg-error-container text-on-error-container text-[11px] font-semibold"><span class="w-1.5 h-1.5 rounded-full bg-error"></span><%= item.statusLabel %></span>
                                <% } else { %>
                                    <span class="inline-flex items-center gap-1.5 px-space-sm py-0.5 rounded-full bg-secondary-fixed text-on-secondary-fixed text-[11px] font-semibold"><span class="w-1.5 h-1.5 rounded-full bg-secondary"></span><%= item.statusLabel %></span>
                                <% } %>
                            </td>
                            <td class="py-space-md px-space-lg">
                                <div class="flex justify-end gap-space-xs">
                                    <button type="button" data-review-action="view" title="Xem chi tiết giải trình" class="inline-flex items-center gap-1 px-space-sm py-1 rounded-lg bg-surface-container-low hover:bg-surface-container-high text-on-surface-variant font-label-sm"><span class="material-symbols-outlined text-[16px]">visibility</span>Xem</button>
                                    <% if (item.canReview) { %>
                                        <button type="button" data-review-action="approve" title="Phê duyệt giải trình" class="inline-flex items-center gap-1 px-space-sm py-1 rounded-lg bg-green-50 hover:bg-green-100 text-green-700 font-label-sm"><span class="material-symbols-outlined text-[16px]">check</span>Duyệt</button>
                                        <button type="button" data-review-action="reject" title="Từ chối giải trình" class="inline-flex items-center gap-1 px-space-sm py-1 rounded-lg bg-error-container hover:bg-red-100 text-error font-label-sm"><span class="material-symbols-outlined text-[16px]">close</span>Từ chối</button>
                                    <% } %>
                                </div>
                            </td>
                        </tr>
                    <% }) %>
                    <tr id="explanation-empty-filter" class="hidden">
                        <td colspan="7" class="py-space-2xl px-space-lg text-center text-body-sm text-on-surface-variant">Không có giải trình nào với trạng thái này.</td>
                    </tr>
                <% } %>
            </tbody>
        </table>
    </div>
</section>
<% } %>

<% if (activeTab === "list") { %>
<section class="bg-surface-container-lowest rounded-xl shadow-sm overflow-hidden">
    <div class="p-space-lg border-b border-surface-container-high flex flex-col lg:flex-row lg:items-center justify-between gap-space-md">
        <div class="flex flex-col sm:flex-row gap-space-sm flex-1">
            <div class="relative flex-1 sm:max-w-xs">
                <span class="material-symbols-outlined absolute left-space-sm top-1/2 -translate-y-1/2 text-on-surface-variant text-[18px]">search</span>
                <input id="request-search" type="text" placeholder="Tìm theo mã đơn, tên, loại..." class="w-full bg-surface-container-low text-on-surface font-body-sm text-body-sm pl-8 pr-space-md py-space-sm rounded-xl outline-none focus:bg-surface-container transition-all">
            </div>
            <div class="relative sm:w-48">
                <select id="request-status-filter" class="w-full appearance-none bg-surface-container-low text-on-surface font-label-sm text-label-sm py-space-sm pl-space-md pr-space-xl rounded-xl outline-none cursor-pointer">
                    <option value="">Tất cả trạng thái</option>
                    <option value="pending">Chờ duyệt</option>
                    <option value="awaiting_employee">Chờ nhân viên xác nhận</option>
                    <option value="approved">Đã duyệt</option>
                    <option value="rejected">Từ chối</option>
                </select>
                <span class="material-symbols-outlined absolute right-space-sm top-1/2 -translate-y-1/2 text-on-surface-variant pointer-events-none text-[20px]">expand_more</span>
