<!doctype html>
<html lang="vi">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Đơn xin tăng ca</title>
    <style>
        body{margin:0;background:#f4f7fb;color:#172033;font:15px/1.5 Inter,Arial,sans-serif}.wrap{max-width:920px;margin:40px auto;padding:0 20px}.top,.card{background:#fff;border:1px solid #e4e9f1;border-radius:16px;padding:24px;margin-bottom:20px;box-shadow:0 4px 18px #1720330a}.top{display:flex;justify-content:space-between;align-items:center}.muted{color:#657188}.grid{display:grid;grid-template-columns:1fr 1fr;gap:16px}label{display:block;font-weight:600;margin-bottom:6px}input,textarea{box-sizing:border-box;width:100%;border:1px solid #cfd7e4;border-radius:9px;padding:11px;font:inherit}textarea{min-height:110px;resize:vertical}.wide{grid-column:1/-1}button{border:0;border-radius:9px;background:#2459c4;color:white;padding:12px 18px;font-weight:700;cursor:pointer}.alert{padding:12px 15px;border-radius:9px;margin-bottom:14px;background:#e9f7ee;color:#176436}.error{background:#fff0ef;color:#a32620}table{width:100%;border-collapse:collapse}th,td{text-align:left;border-bottom:1px solid #e8ecf2;padding:12px 8px}th{color:#657188;font-size:13px}.pill{border-radius:20px;padding:4px 10px;background:#fff3d7;color:#875600;font-size:12px}.approved{background:#e7f6ec;color:#176436}.rejected{background:#ffeded;color:#a32620}a{color:#2459c4;text-decoration:none}@media(max-width:650px){.grid{grid-template-columns:1fr}.wide{grid-column:auto}.top{align-items:flex-start;gap:12px;flex-direction:column}.card{overflow-x:auto}}
    </style>
</head>
<body><div class="wrap">
    <div class="top"><div><h1 style="margin:0 0 4px">Đơn xin tăng ca</h1><div class="muted"><%= employee ? `${employee.full_name} · ${employee.employee_code}` : "Hồ sơ nhân viên" %></div></div><a href="/">← Trang chủ</a></div>
    <% if (success) { %><div class="alert"><%= success %></div><% } %>
    <% if (error) { %><div class="alert error"><%= error %></div><% } %>
    <% if (employee) { %>
    <section class="card"><h2 style="margin-top:0">Gửi yêu cầu</h2><p class="muted">Đơn sẽ ở trạng thái chờ duyệt. Bảng chấm công chỉ ghi nhận tăng ca sau khi admin duyệt.</p>
        <form action="/requests/overtime" method="post" class="grid">
            <div><label for="from_date">Từ ngày</label><input id="from_date" name="from_date" type="date" required></div>
            <div><label for="to_date">Đến ngày</label><input id="to_date" name="to_date" type="date" required></div>
            <div><label for="start_time">Giờ bắt đầu tăng ca</label><input id="start_time" name="start_time" type="time" required></div>
            <div><label for="end_time">Giờ kết thúc tăng ca</label><input id="end_time" name="end_time" type="time" required></div>
            <div class="wide"><label for="reason">Lý do / nội dung công việc</label><textarea id="reason" name="reason" minlength="10" maxlength="5000" required></textarea></div>
            <div class="wide"><button type="submit">Gửi đơn xin tăng ca</button></div>
        </form>
    </section>
    <section class="card"><h2 style="margin-top:0">Đơn tăng ca của tôi</h2>
        <% if (!requests.length) { %><p class="muted">Bạn chưa gửi đơn tăng ca nào.</p><% } else { %>
        <table><thead><tr><th>Mã đơn</th><th>Thời gian</th><th>Khung giờ tăng ca</th><th>Lý do</th><th>Trạng thái</th><th>Ngày gửi</th><th>Phản hồi</th></tr></thead><tbody>
        <% requests.forEach((item) => { const labels = {pending:"Chờ admin duyệt",awaiting_employee:"Chờ bạn xác nhận",approved:"Đã duyệt/đồng ý",rejected:item.employee_response === "rejected" ? "Bạn đã từ chối" : "Admin từ chối"}; %>
            <tr><td><%= item.request_code %></td><td><%= item.from_date %><%= item.to_date !== item.from_date ? ` – ${item.to_date}` : "" %></td><td><%= item.overtime_start_time || "—" %> – <%= item.overtime_end_time || "—" %></td><td><%= item.reason %><% if (item.status === "rejected") { const declineReason = item.employee_response === "rejected" ? item.employee_response_note : item.review_note; if (declineReason) { %><p class="muted"><strong>Lý do từ chối:</strong> <%= declineReason %></p><% } } %><% if (item.status === "approved" && item.reviewed_date) { %><p class="muted"><strong>Duyệt bởi:</strong> <%= item.reviewer_name || "Admin" %> · <%= item.reviewed_date %></p><% } %><% if (item.status === "approved" && item.review_note) { %><p class="muted"><strong>Ghi chú duyệt:</strong> <%= item.review_note %></p><% } %></td><td><span class="pill <%= item.status %>"><%= labels[item.status] || item.status %></span></td><td><%= item.created_date %></td><td><% if (item.status === "awaiting_employee") { %><div style="display:grid;gap:6px;white-space:nowrap"><form action="/requests/<%= item.id %>/respond" method="post"><input type="hidden" name="decision" value="accept"><button type="submit">Đồng ý</button></form><details><summary style="cursor:pointer;color:#a32620">Từ chối</summary><form action="/requests/<%= item.id %>/respond" method="post"><input type="hidden" name="decision" value="reject"><textarea name="response_note" minlength="10" maxlength="500" required rows="2" placeholder="Lý do từ chối (10–500 ký tự)"></textarea><button type="submit" style="background:#a32620">Xác nhận từ chối</button></form></details></div><% } else { %>—<% } %></td></tr>
        <% }) %></tbody></table><% } %>
    </section>
    <% } %>
</div></body></html>
