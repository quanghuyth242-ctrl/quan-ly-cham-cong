<%- include("partials/adminHead", { pageTitle: "Phân ca nhân viên", activePage: "assignments", user: user }) %>

<%- include("partials/alerts", { success: success, error: error }) %>

<div id="schedule-sync" data-revision="<%= syncRevision || '' %>" data-sync-url="/admin/shift-assignments/sync-state" class="flex flex-wrap items-center justify-between gap-space-sm px-space-md py-space-sm rounded-xl bg-surface-container-low text-on-surface-variant font-body-sm text-body-sm" role="status">
    <div class="flex flex-wrap items-center gap-space-sm">
        <span id="schedule-sync-status">Đồng bộ tự động đang bật · kiểm tra mỗi 30 giây.</span>
        <label class="inline-flex items-center gap-1 cursor-pointer font-label-sm text-label-sm" title="Bật/tắt tự động đồng bộ lịch phân ca">
            <input id="schedule-sync-toggle" type="checkbox" class="accent-primary" checked>
            <span>Tự động</span>
        </label>
        <label class="inline-flex items-center gap-1 font-label-sm text-label-sm">
            <span>Chu kỳ</span>
            <select id="schedule-sync-interval" class="bg-surface-container-lowest text-on-surface-variant font-label-sm text-label-sm px-2 py-1 rounded-lg border border-surface-container-high cursor-pointer outline-none">
                <option value="15000">15 giây</option>
                <option value="30000" selected>30 giây</option>
                <option value="60000">60 giây</option>
            </select>
        </label>
    </div>
    <button id="schedule-sync-refresh" class="hidden items-center gap-space-xs px-space-md py-space-sm rounded-lg bg-primary text-on-primary font-label-sm text-label-sm" type="button">
        <span class="material-symbols-outlined text-[18px]">sync</span>
        <span>Cập nhật dữ liệu mới</span>
    </button>
</div>

<section class="relative overflow-hidden flex flex-col xl:flex-row xl:items-center justify-between gap-space-lg bg-surface-container-lowest p-space-lg md:p-space-xl rounded-xl border border-surface-container-high/60 shadow-sm">
    <div class="absolute inset-y-0 left-0 w-1 bg-primary"></div>
    <div class="flex flex-col gap-space-xs">
        <div class="flex items-center gap-space-sm text-on-surface-variant font-label-sm text-label-sm">
            <span class="flex h-2 w-2 rounded-full bg-primary-container"></span>
            <span class="uppercase tracking-wider">Lịch làm việc &amp; phân ca</span>
        </div>
        <h2 class="font-headline-lg text-headline-lg text-primary tracking-tight">Phân ca nhân viên</h2>
        <p class="font-body-md text-body-md text-on-surface-variant">
            Gán ca làm việc theo khoảng thời gian áp dụng cho từng nhân viên và theo dõi lịch phân ca hiện tại.
        </p>
    </div>

    <% const canAssign = employees.length > 0 && activeShifts.length > 0; %>

    <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-space-sm self-start xl:self-auto">
        <nav class="flex items-center p-1 rounded-xl bg-surface-container-high" aria-label="Chuyển mục ca và lịch trực">
            <a href="/admin/shifts" class="flex items-center gap-space-xs px-space-md py-space-sm rounded-lg text-on-surface-variant hover:text-primary font-label-md text-label-md transition-colors">
                <span class="material-symbols-outlined text-[18px]">schedule</span>
                Danh sách ca
            </a>
            <a href="/admin/shift-assignments" class="flex items-center gap-space-xs px-space-md py-space-sm rounded-lg bg-surface-container-lowest text-primary shadow-sm font-label-md text-label-md">
                <span class="material-symbols-outlined text-[18px]">calendar_month</span>
                Lịch trực
            </a>
        </nav>

        <!-- Toggle Chế độ xem: Lịch phân ca / Danh sách -->
        <div class="flex items-center p-1 rounded-xl bg-surface-container-high" role="tablist" aria-label="Chế độ xem phân ca">
            <button
                id="toggle-view-calendar"
                type="button"
                role="tab"
                aria-selected="<%= viewMode === 'calendar' ? 'true' : 'false' %>"
                class="flex items-center gap-space-xs px-space-md py-space-sm rounded-lg font-label-md text-label-md transition-all <%= viewMode === 'calendar' ? 'bg-primary text-on-primary shadow-sm' : 'text-on-surface-variant hover:text-primary' %>"
            >
                <span class="material-symbols-outlined text-[18px]">calendar_view_week</span>
                <span>Lịch phân ca</span>
            </button>
            <button
                id="toggle-view-list"
                type="button"
                role="tab"
                aria-selected="<%= viewMode === 'list' ? 'true' : 'false' %>"
                class="flex items-center gap-space-xs px-space-md py-space-sm rounded-lg font-label-md text-label-md transition-all <%= viewMode === 'list' ? 'bg-primary text-on-primary shadow-sm' : 'text-on-surface-variant hover:text-primary' %>"
            >
                <span class="material-symbols-outlined text-[18px]">table_rows</span>
                <span>Danh sách</span>
            </button>
        </div>

        <button
        id="open-create-assignment"
        class="flex items-center justify-center gap-space-xs px-space-lg py-space-sm rounded-xl font-label-md text-label-md shadow-md transition-all self-start lg:self-auto <%= canAssign ? 'bg-primary hover:bg-primary-container text-on-primary' : 'bg-surface-container-high text-outline cursor-not-allowed' %>"
        type="button"
        <%= canAssign ? "" : "disabled" %>
        title="<%= canAssign ? 'Phân ca cho nhân viên' : 'Cần có nhân viên và ca đang hoạt động để phân ca' %>"
    >
        <span class="material-symbols-outlined text-[20px]">person_add</span>
        <span>Phân ca mới</span>
        </button>
    </div>
</section>

<% if (!canAssign) { %>
    <div class="flex items-start gap-space-sm p-space-md rounded-xl bg-amber-50 border border-amber-200 text-amber-800 text-body-md">
        <span class="material-symbols-outlined text-[20px]">info</span>
        <span>
            <% if (employees.length === 0 && activeShifts.length === 0) { %>
                Chưa có nhân viên và ca làm việc đang hoạt động. Vui lòng thêm dữ liệu trước khi phân ca.
            <% } else if (employees.length === 0) { %>
                Chưa có nhân viên trong hệ thống. Vui lòng thêm nhân viên trước khi phân ca.
            <% } else { %>
                Không có ca làm việc đang hoạt động. Vui lòng kích hoạt hoặc thêm ca làm việc trước khi phân ca.
            <% } %>
        </span>
    </div>
<% } %>

<section class="grid grid-cols-1 sm:grid-cols-3 gap-space-lg">
    <a href="/admin/shift-assignments?status=active" class="bg-surface-container-lowest p-space-lg rounded-xl border border-surface-container-high/60 shadow-sm flex items-center justify-between hover:ring-2 hover:ring-primary/10 transition-all">
        <div class="flex flex-col">
            <span class="font-label-sm text-label-sm text-on-surface-variant uppercase tracking-wider">Phân ca đang áp dụng</span>
            <span class="font-headline-xl text-headline-xl text-primary font-bold mt-space-xs"><%= stats.activeAssignments %></span>
        </div>
        <div class="w-11 h-11 rounded-xl bg-primary-fixed text-primary flex items-center justify-center">
            <span class="material-symbols-outlined text-[24px]">assignment_ind</span>
        </div>
    </a>

    <div class="bg-surface-container-lowest p-space-lg rounded-xl border border-surface-container-high/60 shadow-sm flex items-center justify-between">
        <div class="flex flex-col">
            <span class="font-label-sm text-label-sm text-on-surface-variant uppercase tracking-wider">Nhân viên đã phân ca</span>
            <span class="font-headline-xl text-headline-xl text-on-surface font-bold mt-space-xs"><%= stats.assignedEmployees %></span>
        </div>
        <div class="w-11 h-11 rounded-xl bg-green-50 text-green-600 flex items-center justify-center">
            <span class="material-symbols-outlined text-[24px]">groups</span>
        </div>
    </div>

    <a href="/admin/shift-assignments?status=cancelled" class="bg-surface-container-lowest p-space-lg rounded-xl border border-surface-container-high/60 shadow-sm flex items-center justify-between hover:ring-2 hover:ring-surface-variant transition-all">
        <div class="flex flex-col">
            <span class="font-label-sm text-label-sm text-on-surface-variant uppercase tracking-wider">Phân ca đã hủy</span>
            <span class="font-headline-xl text-headline-xl text-on-surface font-bold mt-space-xs"><%= stats.cancelledAssignments %></span>
        </div>
        <div class="w-11 h-11 rounded-xl bg-surface-container-high text-on-surface-variant flex items-center justify-center">
            <span class="material-symbols-outlined text-[24px]">cancel</span>
        </div>
    </a>
</section>

<%
    // Cùng thứ tự bảng màu với shift-calendar.js để chú giải và ô lịch luôn khớp.
    const SHIFT_PALETTE_EJS = [
        { bg: 'bg-blue-50/90 hover:bg-blue-100', border: 'border-blue-200', text: 'text-blue-900', dot: 'bg-blue-600' },
        { bg: 'bg-emerald-50/90 hover:bg-emerald-100', border: 'border-emerald-200', text: 'text-emerald-900', dot: 'bg-emerald-600' },
        { bg: 'bg-amber-50/90 hover:bg-amber-100', border: 'border-amber-200', text: 'text-amber-900', dot: 'bg-amber-600' },
        { bg: 'bg-purple-50/90 hover:bg-purple-100', border: 'border-purple-200', text: 'text-purple-900', dot: 'bg-purple-600' },
        { bg: 'bg-indigo-50/90 hover:bg-indigo-100', border: 'border-indigo-200', text: 'text-indigo-900', dot: 'bg-indigo-600' },
        { bg: 'bg-teal-50/90 hover:bg-teal-100', border: 'border-teal-200', text: 'text-teal-900', dot: 'bg-teal-600' }
    ];
    const shiftColorIndexEjs = {};
    activeShifts.forEach((shift, index) => {
        shiftColorIndexEjs[String(shift.shift_code || '').toUpperCase()] = index % SHIFT_PALETTE_EJS.length;
    });
    const getShiftColorEjs = (code) => {
        const key = String(code || '').toUpperCase();
        if (Number.isInteger(shiftColorIndexEjs[key])) return SHIFT_PALETTE_EJS[shiftColorIndexEjs[key]];
        let hash = 0;
        for (let i = 0; i < key.length; i += 1) hash = (hash * 31 + key.charCodeAt(i)) >>> 0;
        return SHIFT_PALETTE_EJS[hash % SHIFT_PALETTE_EJS.length];
    };
%>

<!-- CHẾ ĐỘ XEM: LỊCH PHÂN CA (CALENDAR / SCHEDULE MATRIX) -->
<div id="calendar-view-container" class="<%= viewMode === 'calendar' ? '' : 'hidden' %> flex flex-col gap-space-lg">
    <section class="bg-surface-container-lowest rounded-xl shadow-sm border border-surface-container-high/60 overflow-hidden flex flex-col">
        <!-- Toolbar điều khiển lịch -->
        <div class="p-space-lg border-b border-surface-container-high bg-surface-container-lowest flex flex-col xl:flex-row xl:items-center justify-between gap-space-md">
            <!-- Điều hướng tuần -->
            <div class="flex flex-wrap items-center gap-space-sm">
                <div class="flex items-center bg-surface-container-low rounded-xl p-1 border border-surface-container-high shadow-xs">
                    <button
                        id="cal-prev-btn"
                        type="button"
                        class="p-1 rounded-lg text-on-surface-variant hover:text-primary hover:bg-surface-container-high transition-colors"
                        title="Tuần trước"
                        aria-label="Tuần trước"
                        data-date="<%= weekInfo.prevWeekDate %>"
                    >
                        <span class="material-symbols-outlined text-[20px]">chevron_left</span>
                    </button>
                    <button
                        id="cal-today-btn"
                        type="button"
                        class="px-space-md py-1 rounded-lg text-label-sm font-semibold text-primary hover:bg-surface-container-high transition-colors flex items-center gap-1"
                        title="Trở về tuần hiện tại"
                        aria-label="Trở về tuần hiện tại"
                    >
                        <span class="material-symbols-outlined text-[16px]">today</span>
                        <span>Hôm nay</span>
                    </button>
                    <button
                        id="cal-next-btn"
                        type="button"
                        class="p-1 rounded-lg text-on-surface-variant hover:text-primary hover:bg-surface-container-high transition-colors"
                        title="Tuần sau"
                        aria-label="Tuần sau"
                        data-date="<%= weekInfo.nextWeekDate %>"
                    >
                        <span class="material-symbols-outlined text-[20px]">chevron_right</span>
                    </button>
                </div>

                <div class="relative flex items-center">
                    <input
                        id="cal-date-picker"
                        type="date"
                        value="<%= weekInfo.selectedDate %>"
                        class="bg-surface-container-low border border-surface-container-high text-on-surface font-data-mono text-body-sm px-space-md py-1.5 rounded-xl outline-none focus:ring-2 focus:ring-primary-container cursor-pointer"
                        title="Chọn ngày để xem lịch tuần"
                    >
                </div>

                <div class="flex items-center gap-space-xs pl-space-xs">
                    <span id="cal-period-title" class="font-headline-sm text-headline-sm text-primary font-bold">
                        Tuần <%= weekInfo.weekStart.slice(8, 10) %>/<%= weekInfo.weekStart.slice(5, 7) %> – <%= weekInfo.weekEnd.slice(8, 10) %>/<%= weekInfo.weekEnd.slice(5, 7) %>/<%= weekInfo.weekEnd.slice(0, 4) %>
                    </span>
                </div>
            </div>

            <!-- Bộ lọc nhanh trên lịch & Tiện ích in ấn -->
            <div class="flex flex-wrap items-center gap-space-sm">
                <select
                    id="cal-dept-filter"
                    class="bg-surface-container-low text-on-surface-variant font-label-sm text-label-sm px-space-md py-space-sm rounded-xl outline-none border border-surface-container-high cursor-pointer"
                >
                    <option value="">Tất cả phòng ban</option>
                    <% departments.forEach((dept) => { %>
                        <option value="<%= dept %>" <%= filters.department === dept ? "selected" : "" %>><%= dept %></option>
                    <% }) %>
                </select>

                <select
                    id="cal-shift-filter"
                    class="bg-surface-container-low text-on-surface-variant font-label-sm text-label-sm px-space-md py-space-sm rounded-xl outline-none border border-surface-container-high cursor-pointer"
                >
                    <option value="">Tất cả ca làm</option>
                    <% activeShifts.forEach((s) => { %>
                        <option value="<%= s.id %>" <%= filters.shiftId === String(s.id) ? "selected" : "" %>><%= s.shift_code %> - <%= s.shift_name %></option>
                    <% }) %>
                </select>

                <div class="relative w-48 sm:w-56">
                    <span class="material-symbols-outlined absolute left-2.5 top-1/2 -translate-y-1/2 text-on-surface-variant text-[16px]">search</span>
                    <input
                        id="cal-search-input"
                        type="text"
                        value="<%= filters.search %>"
                        placeholder="Tìm tên hoặc mã..."
                        class="w-full bg-surface-container-low border border-surface-container-high text-on-surface font-body-sm text-body-sm pl-8 pr-2.5 py-space-sm rounded-xl outline-none focus:ring-2 focus:ring-primary-container"
                    >
                </div>

                <button
                    id="cal-print-btn"
                    type="button"
                    class="flex items-center gap-1 bg-surface-container-low hover:bg-surface-container-high text-on-surface-variant px-space-md py-space-sm rounded-xl font-label-md text-label-md border border-surface-container-high transition-colors"
                    title="In bảng lịch phân ca"
                    aria-label="In bảng lịch phân ca"
                >
                    <span class="material-symbols-outlined text-[18px]">print</span>
                    <span class="hidden sm:inline">In lịch</span>
                </button>
            </div>
        </div>

        <!-- Chú giải trực quan: màu ca + trạng thái ô -->
        <div class="px-space-lg py-space-sm border-b border-surface-container-high/60 flex flex-wrap items-center gap-x-space-md gap-y-2 bg-surface-container-lowest">
            <span class="uppercase tracking-wider font-semibold text-on-surface-variant text-[11px]">Chú giải</span>
            <% activeShifts.forEach((shift) => { const c = getShiftColorEjs(shift.shift_code); %>
                <span
                    class="inline-flex items-center gap-1.5 text-[11px] text-on-surface px-1.5 py-0.5 rounded-lg cursor-grab active:cursor-grabbing select-none hover:bg-surface-container-high transition-colors"
                    title="Kéo ca <%= shift.shift_name %> vào ô trống để phân ca nhanh"
                    draggable="true"
                    data-drag-shift="<%= shift.id %>"
                    data-drag-shift-name="<%= shift.shift_name %>"
                >
                    <span class="material-symbols-outlined text-[13px] text-outline/70 shrink-0">drag_indicator</span>
                    <span class="w-2.5 h-2.5 rounded-full <%= c.dot %> shrink-0"></span>
                    <span class="font-bold"><%= shift.shift_code %></span>
                    <span class="text-on-surface-variant"><%= shift.shift_name %></span>
                </span>
            <% }) %>
            <span class="inline-flex items-center gap-1.5 text-[11px] text-on-surface-variant">
                <span class="w-2.5 h-2.5 rounded-full bg-primary shrink-0"></span>
                Hôm nay
            </span>
            <span class="inline-flex items-center gap-1.5 text-[11px] text-on-surface-variant">
                <span class="w-3 h-3 rounded-md border border-dashed border-outline-variant/60 shrink-0"></span>
                Nghỉ ca
            </span>
            <span class="inline-flex items-center gap-1.5 text-[11px] text-on-surface-variant">
                <span class="material-symbols-outlined text-[14px] text-outline shrink-0">add</span>
                Chưa phân ca
            </span>
        </div>

        <!-- Trạng thái tải khi tự động đồng bộ/tải lại lịch -->
        <div id="cal-matrix-loading" class="hidden items-center gap-2 px-space-lg py-2 bg-primary-fixed/30 text-primary text-label-sm border-b border-primary/10" role="status">
            <span class="material-symbols-outlined text-[16px] animate-spin">progress_activity</span>
            <span>Đang cập nhật lịch…</span>
        </div>

        <p class="px-space-lg pt-space-sm text-[11px] text-on-surface-variant sm:hidden">Cuộn ngang để xem các ngày trong tuần →</p>

        <!-- Bảng ma trận lịch -->
        <div id="cal-matrix-wrapper" class="overflow-x-auto relative">
            <table id="cal-schedule-table" class="w-full text-left border-collapse min-w-[1000px]">
                <thead>
                    <tr class="bg-surface-container-low/80 border-b border-surface-container-high text-on-surface font-label-sm text-label-sm">
                        <th class="py-3 px-3 w-64 min-w-[240px] sticky left-0 z-20 bg-surface-container-low/95 backdrop-blur-sm border-r border-surface-container-high">
                            <div class="flex items-center justify-between">
                                <span class="uppercase tracking-wider font-semibold text-on-surface-variant flex items-center gap-1" title="Sắp xếp: Mã nhân viên mới nhất đến cũ nhất">
                                    <span>Nhân viên</span>
                                    <span class="material-symbols-outlined text-[14px] text-primary" title="Mã NV mới nhất → cũ nhất">arrow_downward</span>
                                </span>
                                <span id="cal-emp-count-badge" class="px-2 py-0.5 rounded-full bg-surface-container-high text-on-surface-variant text-[11px] font-semibold">
                                    <%= scheduleMatrix.employees.length %> NV
                                </span>
                            </div>
                        </th>
                        <% scheduleMatrix.days.forEach((day) => { %>
                            <th class="py-3 px-2 text-center min-w-[130px] border-r border-surface-container-high/60 <%= day.isToday ? 'bg-primary/5 ring-1 ring-inset ring-primary/20' : (day.isWeekend ? 'bg-surface-container-high/30' : '') %>">
                                <div class="flex flex-col items-center gap-0.5">
                                    <span class="text-[12px] font-semibold <%= day.isToday ? 'text-primary' : 'text-on-surface-variant' %>">
                                        <%= day.weekdayLabel %>
                                    </span>
                                    <div class="flex items-center gap-1">
                                        <span class="font-data-mono text-[13px] font-bold <%= day.isToday ? 'px-2 py-0.5 rounded-full bg-primary text-on-primary' : (day.isWeekend ? 'text-amber-700' : 'text-on-surface') %>">
                                            <%= String(day.dayNumber).padStart(2, '0') %>/<%= String(day.monthNumber).padStart(2, '0') %>
                                        </span>
                                    </div>
                                    <% if (day.isToday) { %>
                                        <span class="text-[10px] uppercase font-bold text-primary tracking-wider">Hôm nay</span>
                                    <% } %>
                                </div>
                            </th>
                        <% }) %>
                    </tr>
                </thead>
                <tbody id="cal-matrix-tbody" class="divide-y divide-surface-container-high/50 text-body-sm">
                    <% if (scheduleMatrix.employees.length === 0) { %>
                        <tr>
                            <td colspan="<%= scheduleMatrix.days.length + 1 %>" class="py-12 px-4 text-center text-on-surface-variant">
                                <div class="flex flex-col items-center gap-2">
                                    <span class="material-symbols-outlined text-[36px] text-outline">group_off</span>
                                    <span class="font-label-md">Không tìm thấy nhân viên nào phù hợp bộ lọc.</span>
                                    <button type="button" data-clear-calendar-filters class="mt-1 px-space-md py-1 rounded-lg bg-primary text-on-primary font-label-sm text-label-sm hover:bg-primary-container transition-colors">
                                        Xóa bộ lọc
                                    </button>
                                </div>
                            </td>
                        </tr>
                    <% } else { %>
                        <% scheduleMatrix.employees.forEach((emp) => { %>
                            <tr class="hover:bg-surface-container-low/60 transition-colors" data-emp-row="true" data-emp-name="<%= emp.full_name %>" data-emp-code="<%= emp.employee_code %>" data-emp-dept="<%= emp.department || '' %>">
                                <td class="py-2.5 px-3 sticky left-0 z-10 bg-surface-container-lowest border-r border-surface-container-high shadow-xs">
                                    <div class="flex items-center justify-between gap-2">
                                        <div class="flex items-center gap-2.5 min-w-0">
                                            <div class="w-8 h-8 rounded-full bg-primary-fixed text-primary font-bold text-xs flex items-center justify-center shrink-0">
                                                <%= emp.full_name.trim().slice(0, 2).toUpperCase() %>
                                            </div>
                                            <div class="flex flex-col min-w-0">
                                                <span class="font-label-md text-label-md text-on-surface font-semibold truncate" title="<%= emp.full_name %>">
                                                    <%= emp.full_name %>
                                                </span>
                                                <span class="font-data-mono text-[11px] text-on-surface-variant truncate">
                                                    <%= emp.employee_code %><%= emp.department ? ` · ${emp.department}` : '' %>
                                                </span>
                                            </div>
                                        </div>
                                        <button
                                            type="button"
                                            class="p-1.5 rounded-lg text-on-surface-variant hover:text-primary hover:bg-primary-fixed/50 transition-colors shrink-0"
                                            title="Xem lịch chi tiết của <%= emp.full_name %>"
                                            data-view-employee-calendar
                                            data-id="<%= emp.id %>"
                                            data-name="<%= emp.full_name %>"
                                            data-code="<%= emp.employee_code %>"
                                            data-dept="<%= emp.department || '' %>"
                                        >
                                            <span class="material-symbols-outlined text-[18px]">calendar_month</span>
                                        </button>
                                    </div>
                                </td>

                                <% scheduleMatrix.days.forEach((day) => { %>
                                    <% const cell = scheduleMatrix.matrix[emp.id] && scheduleMatrix.matrix[emp.id][day.dateStr]; %>
                                    <td class="p-1.5 border-r border-surface-container-high/50 align-top <%= day.isToday ? 'bg-primary/5' : (day.isWeekend ? 'bg-surface-container-high/15' : '') %>">
                                        <% if (cell && cell.type === 'work') { %>
                                            <% const c = getShiftColorEjs(cell.shiftCode); %>
                                            <div
                                                class="flex flex-col p-2 rounded-xl border <%= c.bg %> <%= c.border %> <%= c.text %> cursor-pointer transition-all shadow-xs group"
                                                data-cell-work
                                                data-emp-id="<%= emp.id %>"
                                                data-emp-name="<%= emp.full_name %>"
                                                data-emp-code="<%= emp.employee_code %>"
                                                data-emp-dept="<%= emp.department || '' %>"
                                                data-date="<%= day.dateStr %>"
                                                data-date-label="<%= day.weekdayLabel %>, <%= String(day.dayNumber).padStart(2, '0') %>/<%= String(day.monthNumber).padStart(2, '0') %>/<%= day.dateStr.slice(0, 4) %>"
                                                data-shift-id="<%= cell.shiftId %>"
                                                data-shift-code="<%= cell.shiftCode %>"
                                                data-shift-name="<%= cell.shiftName %>"
                                                data-morning="<%= cell.morningTime %>"
                                                data-afternoon="<%= cell.afternoonTime %>"
                                                data-start="<%= cell.startDate %>"
                                                data-end="<%= cell.endDate %>"
                                                data-note="<%= cell.note || '' %>"
                                                data-assignment-id="<%= cell.assignmentId %>"
                                                title="Bấm để đổi ca · kéo sang ô trống để sao chép ca này"
                                                draggable="true"
                                                role="button"
                                                tabindex="0"
                                                aria-label="Đổi ca <%= cell.shiftName %> của <%= emp.full_name %> từ ngày <%= day.dateStr %>"
                                            >
                                                <div class="flex items-center gap-1 font-bold text-[12px] leading-tight">
                                                    <span class="w-1.5 h-1.5 rounded-full <%= c.dot %> shrink-0"></span>
                                                    <span class="truncate min-w-0"><%= cell.shiftName %></span>
                                                    <button type="button" class="ml-auto p-0.5 rounded-md text-on-surface-variant/70 hover:text-primary hover:bg-white/60 shrink-0" data-cell-detail title="Xem chi tiết ca" aria-label="Xem chi tiết ca <%= cell.shiftName %>">
                                                        <span class="material-symbols-outlined text-[14px]">info</span>
                                                    </button>
                                                </div>
                                                <span class="font-data-mono text-[11px] opacity-80 mt-1 truncate">
                                                    <%= cell.morningStart && cell.afternoonEnd ? `${cell.morningStart} - ${cell.afternoonEnd}` : cell.timeFormatted %>
                                                </span>
                                            </div>
                                        <% } else if (cell && cell.type === 'rest') { %>
                                            <div class="h-full min-h-[52px] flex flex-col items-center justify-center p-1.5 rounded-xl bg-surface-container-high/40 text-on-surface-variant/70 text-[11px] font-medium border border-dashed border-outline-variant/40" title="Nghỉ theo quy định ca <%= cell.shiftName || '' %>">
                                                <span class="material-symbols-outlined text-[16px] opacity-60">bedtime</span>
                                                <span>Nghỉ ca</span>
                                            </div>
                                        <% } else { %>
                                            <div
                                                class="h-full min-h-[52px] flex items-center justify-center rounded-xl hover:bg-surface-container-high/50 border border-transparent hover:border-dashed hover:border-outline-variant/60 cursor-pointer group transition-all"
                                                data-cell-add
                                                data-emp-id="<%= emp.id %>"
                                                data-date="<%= day.dateStr %>"
                                                title="Phân ca cho <%= emp.full_name %> từ <%= day.dateStr %>"
                                                role="button"
                                                tabindex="0"
                                                aria-label="Phân ca cho <%= emp.full_name %> từ ngày <%= day.dateStr %>"
                                            >
                                                <span class="material-symbols-outlined text-[18px] text-outline opacity-50 sm:opacity-0 group-hover:opacity-100 transition-opacity">add</span>
                                            </div>
                                        <% } %>
                                    </td>
                                <% }) %>
                            </tr>
                        <% }) %>
                    <% } %>
                </tbody>
                <tfoot class="border-t-2 border-surface-container-high bg-surface-container-low font-label-sm text-label-sm">
                    <tr id="cal-matrix-tfoot-row">
                        <td class="py-3 px-3 sticky left-0 z-10 bg-surface-container-low border-r border-surface-container-high font-bold text-on-surface text-[12px] flex items-center gap-1.5">
                            <span class="material-symbols-outlined text-[18px] text-primary">groups</span>
                            <span>Tổng nhân sự đi làm</span>
                        </td>
                        <% scheduleMatrix.days.forEach((day) => { %>
                            <% const count = (scheduleMatrix.summary[day.dateStr] && scheduleMatrix.summary[day.dateStr].totalWorking) || 0; %>
                            <td class="py-3 px-2 text-center border-r border-surface-container-high/50 <%= day.isToday ? 'bg-primary/5' : '' %>">
                                <span class="inline-flex items-center justify-center px-2 py-0.5 rounded-full text-[12px] font-bold <%= count > 0 ? 'bg-green-100 text-green-800' : 'bg-surface-container-high text-on-surface-variant' %>">
                                    <%= count %> NV
                                </span>
                            </td>
                        <% }) %>
                    </tr>
                </tfoot>
            </table>
        </div>

        <!-- Chú thích ca làm việc (Legend) -->
        <div class="p-space-md border-t border-surface-container-high bg-surface-container-lowest flex flex-wrap items-center justify-between gap-space-md text-[12px]">
            <div class="flex flex-wrap items-center gap-space-md">
                <span class="font-semibold text-on-surface-variant flex items-center gap-1">
                    <span class="material-symbols-outlined text-[16px] text-primary">palette</span>
                    Chú thích ca:
                </span>
                <% activeShifts.forEach((s) => { %>
                    <% const col = getShiftColorEjs(s.shift_code); %>
                    <div class="flex items-center gap-1.5 px-2.5 py-1 rounded-lg border text-[11px] font-medium bg-surface-container-low border-surface-container-high">
                        <span class="w-2.5 h-2.5 rounded-full <%= col.dot %>"></span>
                        <strong class="text-on-surface"><%= s.shift_code %>:</strong>
                        <span class="text-on-surface-variant"><%= s.shift_name %> (<%= s.morning_start %>-<%= s.afternoon_end %>)</span>
                    </div>
                <% }) %>
                <div class="flex items-center gap-1.5 px-2.5 py-1 rounded-lg border text-[11px] font-medium bg-surface-container-low border-surface-container-high text-on-surface-variant">
                    <span class="w-2.5 h-2.5 rounded-full bg-outline/40"></span>
                    <span>Nghỉ theo ca</span>
                </div>
                <div class="flex items-center gap-1.5 px-2.5 py-1 rounded-lg border text-[11px] font-medium bg-surface-container-low border-surface-container-high text-outline">
                    <span class="w-2.5 h-2.5 rounded-full border border-dashed border-outline"></span>
                    <span>Chưa phân ca</span>
                </div>
            </div>
            <span class="text-on-surface-variant text-[11px]">Bấm vào ô ca để xem chi tiết / điều chỉnh · Bấm (+) để phân ca nhanh</span>
        </div>
    </section>
</div>

<!-- CHẾ ĐỘ XEM: DANH SÁCH (TABLE / LIST VIEW) -->
<div id="list-view-container" class="<%= viewMode === 'list' ? '' : 'hidden' %>">
<section class="bg-surface-container-lowest rounded-xl shadow-sm overflow-hidden">
    <div class="p-space-lg border-b border-surface-container-high">
        <form method="GET" action="/admin/shift-assignments" class="flex flex-col gap-space-md">
            <div class="flex flex-col lg:flex-row gap-space-sm">
                <div class="relative flex-1">
                    <span class="material-symbols-outlined absolute left-space-sm top-1/2 -translate-y-1/2 text-on-surface-variant text-[18px]">search</span>
                    <input
                        id="assignment-search"
                        class="w-full bg-surface-container-low text-on-surface font-body-sm text-body-sm pl-8 pr-space-md py-space-sm rounded-xl outline-none focus:bg-surface-container transition-all"
                        name="search"
                        value="<%= filters.search %>"
                        placeholder="Tìm theo tên nhân viên, mã nhân viên hoặc tên ca..."
                        type="text"
                    >
                    <button
                        id="clear-assignment-search"
                        type="button"
                        class="<%= filters.search ? '' : 'hidden' %> absolute right-space-sm top-1/2 -translate-y-1/2 p-1 text-on-surface-variant hover:text-primary rounded-md"
                        aria-label="Xóa từ khóa tìm kiếm"
                    >
                        <span class="material-symbols-outlined text-[18px]">close</span>
                    </button>
                </div>

                <select class="bg-surface-container-low text-on-surface-variant font-label-sm text-label-sm px-space-md py-space-sm rounded-xl outline-none cursor-pointer" name="department">
                    <option value="">Tất cả phòng ban</option>
                    <% departments.forEach((department) => { %>
                        <option value="<%= department %>" <%= filters.department === department ? "selected" : "" %>><%= department %></option>
                    <% }) %>
                </select>

                <select class="bg-surface-container-low text-on-surface-variant font-label-sm text-label-sm px-space-md py-space-sm rounded-xl outline-none cursor-pointer" name="shift_id">
                    <option value="">Tất cả ca làm việc</option>
                    <% activeShifts.forEach((shift) => { %>
                        <option value="<%= shift.id %>" <%= filters.shiftId === String(shift.id) ? "selected" : "" %>><%= shift.shift_code %> - <%= shift.shift_name %></option>
                    <% }) %>
                </select>

                <select class="bg-surface-container-low text-on-surface-variant font-label-sm text-label-sm px-space-md py-space-sm rounded-xl outline-none cursor-pointer" name="status">
                    <option value="" <%= filters.status === "" ? "selected" : "" %>>Tất cả trạng thái</option>
                    <option value="active" <%= filters.status === "active" ? "selected" : "" %>>Đang áp dụng</option>
                    <option value="cancelled" <%= filters.status === "cancelled" ? "selected" : "" %>>Đã hủy</option>
                </select>

                <button class="flex items-center justify-center gap-space-xs bg-primary hover:bg-primary-container text-on-primary px-space-md py-space-sm rounded-xl font-label-md text-label-md transition-colors" type="submit">
                    <span class="material-symbols-outlined text-[18px]">filter_alt</span>
                    <span>Lọc</span>
                </button>

                <a class="flex items-center justify-center gap-space-xs bg-surface-container-low hover:bg-surface-container-high text-on-surface-variant px-space-md py-space-sm rounded-xl font-label-md text-label-md transition-colors" href="/admin/shift-assignments">
                    <span class="material-symbols-outlined text-[18px]">restart_alt</span>
                    <span>Đặt lại</span>
                </a>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-space-sm max-w-2xl">
                <label class="flex flex-col gap-space-xs font-label-sm text-label-sm text-on-surface-variant">
                    Lịch áp dụng từ ngày
                    <input
                        class="bg-surface-container-low text-on-surface font-data-mono text-data-mono px-space-md py-space-sm rounded-xl outline-none focus:ring-2 focus:ring-primary-container"
                        name="start_date"
                        value="<%= filters.startDate || '' %>"
                        type="date"
                    >
                </label>
                <label class="flex flex-col gap-space-xs font-label-sm text-label-sm text-on-surface-variant">
                    Đến ngày
                    <input
                        class="bg-surface-container-low text-on-surface font-data-mono text-data-mono px-space-md py-space-sm rounded-xl outline-none focus:ring-2 focus:ring-primary-container"
                        name="end_date"
                        value="<%= filters.endDate || '' %>"
                        type="date"
                    >
                </label>
            </div>

            <div class="flex items-center justify-between gap-space-sm">
                <span class="font-body-sm text-body-sm text-on-surface-variant">
                    Hiển thị <strong class="text-on-surface"><%= assignments.length %></strong> phân ca
                </span>
                <span class="font-body-sm text-body-sm text-on-surface-variant">
                    <strong class="text-on-surface"><%= activeShifts.length %></strong> ca đang hoạt động
                </span>
            </div>
        </form>
    </div>

    <%# Helper EJS: render action buttons cho 1 assignment (dùng lại cả 2 nơi) %>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-space-md p-space-md lg:hidden">
        <% if (groupedAssignments.length === 0) { %>
            <div class="md:col-span-2 flex flex-col items-center gap-space-sm p-space-2xl rounded-xl border border-dashed border-outline-variant text-center text-on-surface-variant">
                <span class="material-symbols-outlined text-[36px]">event_busy</span>
                <span class="font-label-md text-label-md">Chưa có lịch trực phù hợp</span>
                <span class="font-body-sm text-body-sm">Thử đổi bộ lọc hoặc tạo lịch trực mới.</span>
            </div>
        <% } else { %>
            <% groupedAssignments.forEach((group) => {
                const pA = group.primaryAssignment;
                const others = group.otherAssignments;
                const cardId = `card-others-${group.employee_id}`;
            %>
                <article class="flex flex-col gap-space-md p-space-lg rounded-xl border border-surface-container-high bg-surface-container-lowest shadow-sm">
                    <!-- Header nhân viên -->
                    <div class="flex items-start justify-between gap-space-sm">
                        <div class="flex items-center gap-space-sm min-w-0">
                            <div class="w-10 h-10 rounded-full bg-primary-fixed text-primary font-semibold flex items-center justify-center shrink-0"><%= pA.full_name.slice(0, 2).toUpperCase() %></div>
                            <div class="flex flex-col min-w-0">
                                <h3 class="font-label-md text-label-md text-on-surface font-semibold truncate"><%= pA.full_name %></h3>
                                <span class="font-data-mono text-[11px] text-on-surface-variant"><%= pA.employee_code %><%= pA.department ? ` · ${pA.department}` : '' %></span>
                            </div>
                        </div>
                        <div class="flex items-center gap-1 shrink-0">
                            <% if (others.length > 0) { %>
                                <span class="inline-flex items-center gap-0.5 px-2 py-0.5 rounded-full bg-amber-50 text-amber-700 text-[10px] font-bold border border-amber-200">
                                    <span class="material-symbols-outlined text-[12px]">layers</span>
                                    <%= group.totalAssignments %> ca
                                </span>
                            <% } %>
                            <span class="inline-flex items-center gap-1 px-space-sm py-1 rounded-full <%= pA.status === 'active' ? 'bg-green-50 text-green-700' : 'bg-surface-container-high text-on-surface-variant' %> text-[11px] font-semibold">
                                <span class="w-1.5 h-1.5 rounded-full <%= pA.status === 'active' ? 'bg-green-500' : 'bg-outline' %>"></span>
                                <%= pA.status === 'active' ? 'Đang áp dụng' : 'Đã hủy' %>
                            </span>
                        </div>
                    </div>

                    <!-- Ca làm việc chính -->
                    <div class="p-space-md rounded-lg bg-primary-fixed/40">
                        <div class="flex items-center gap-space-xs text-primary font-label-md text-label-md font-semibold">
                            <span class="material-symbols-outlined text-[18px]">schedule</span>
                            <%= pA.shift_code %> · <%= pA.shift_name %>
                        </div>
                        <div class="mt-1 font-data-mono text-data-mono text-on-surface-variant"><%= pA.morning_start %> – <%= pA.morning_end %> <span class="px-1">|</span> <%= pA.afternoon_start %> – <%= pA.afternoon_end %></div>
                    </div>

                    <div class="grid grid-cols-2 gap-space-sm">
                        <div class="flex flex-col gap-1 p-space-sm rounded-lg bg-surface-container-low">
                            <span class="font-label-sm text-label-sm text-on-surface-variant">Từ ngày</span>
                            <span class="font-data-mono text-data-mono"><%= pA.start_date %></span>
                        </div>
                        <div class="flex flex-col gap-1 p-space-sm rounded-lg bg-surface-container-low">
                            <span class="font-label-sm text-label-sm text-on-surface-variant">Đến ngày</span>
                            <span class="font-data-mono text-data-mono"><%= pA.end_date %></span>
                        </div>
                    </div>

                    <div class="flex flex-wrap gap-1">
                        <% pA.workdays.forEach((day) => { %>
                            <span class="px-space-sm py-0.5 rounded-full bg-surface-container-high text-on-surface-variant text-[11px] font-semibold"><%= weekdayLabels[day] %></span>
                        <% }) %>
                    </div>

                    <!-- Action buttons ca chính -->
                    <div class="flex items-center gap-space-xs pt-space-sm border-t border-surface-container-high">
                        <button class="inline-flex items-center justify-center gap-1 px-2.5 py-1.5 rounded-lg bg-surface-container-high hover:bg-surface-variant text-on-surface font-label-sm text-label-sm transition-colors" type="button" data-view-employee-calendar data-id="<%= pA.employee_id %>" data-name="<%= pA.full_name %>" data-code="<%= pA.employee_code %>" data-dept="<%= pA.department || '' %>" title="Xem lịch tháng">
                            <span class="material-symbols-outlined text-[16px]">calendar_month</span>
                            <span>Lịch</span>
                        </button>
                        <% if (pA.status === 'active') { %>
                            <button class="flex-1 inline-flex justify-center items-center gap-1 px-space-sm py-1.5 rounded-lg bg-primary hover:bg-primary-container text-on-primary font-label-sm text-label-sm shadow-xs transition-colors" data-adjust-shift data-id="<%= pA.id %>" data-employee-name="<%= pA.full_name %>" data-employee-code="<%= pA.employee_code %>" data-department="<%= pA.department || '' %>" data-current-shift-id="<%= pA.shift_id %>" data-current-shift-name="<%= pA.shift_name %>" data-current-shift-time="<%= pA.morning_start %> - <%= pA.morning_end %> | <%= pA.afternoon_start %> - <%= pA.afternoon_end %>" data-start="<%= pA.start_date %>" data-end="<%= pA.end_date %>" data-note="<%= pA.note || '' %>" type="button">
                                <span class="material-symbols-outlined text-[16px]">edit_calendar</span>
                                <span>Điều chỉnh ca</span>
                            </button>
                        <% } %>
                        <button class="inline-flex items-center justify-center p-1.5 rounded-lg bg-surface-container-high hover:bg-surface-variant text-on-surface" data-edit-assignment data-id="<%= pA.id %>" data-employee="<%= pA.employee_id %>" data-shift="<%= pA.shift_id %>" data-start="<%= pA.start_date %>" data-end="<%= pA.end_date %>" data-note="<%= pA.note || '' %>" data-status="<%= pA.status %>" data-current-summary="<%= `${pA.shift_code} · ${pA.shift_name} | ${pA.morning_start}-${pA.morning_end}, ${pA.afternoon_start}-${pA.afternoon_end} | ${pA.start_date} – ${pA.end_date}` %>" type="button">
                            <span class="material-symbols-outlined text-[18px]">tune</span>
                        </button>
                        <% if (pA.status === 'active') { %>
                            <form action="/admin/shift-assignments/<%= pA.id %>/cancel" method="POST" onsubmit="return confirm('Bạn có chắc muốn hủy phân ca này?');">
                                <input class="js-return-to" type="hidden" name="return_to" value="">
                                <button class="inline-flex items-center justify-center p-1.5 rounded-lg bg-error-container/60 text-error" type="submit" title="Hủy phân ca">
                                    <span class="material-symbols-outlined text-[18px]">event_busy</span>
                                </button>
                            </form>
                        <% } %>

                        <!-- Nút mở rộng danh sách các ca khác -->
                        <% if (others.length > 0) { %>
                            <button
                                type="button"
                                class="ml-auto inline-flex items-center gap-1 px-2.5 py-1.5 rounded-lg bg-amber-50 hover:bg-amber-100 text-amber-700 font-label-sm text-label-sm border border-amber-200 transition-colors"
                                data-toggle-others="<%= cardId %>"
                                aria-expanded="false"
                            >
                                <span class="material-symbols-outlined text-[15px]">expand_more</span>
                                <span><%= others.length %> ca khác</span>
                            </button>
                        <% } %>
                    </div>

                    <!-- Danh sách ca bổ sung (ẩn mặc định) -->
                    <% if (others.length > 0) { %>
                        <div id="<%= cardId %>" class="hidden flex flex-col gap-2 border-t border-surface-container-high pt-space-sm">
                            <p class="text-[11px] font-semibold text-on-surface-variant uppercase tracking-wider mb-1">Các ca khác</p>
                            <% others.forEach((o) => { %>
                                <div class="flex flex-col gap-2 p-space-sm rounded-lg border border-surface-container-high bg-surface-container-low">
                                    <div class="flex items-center justify-between gap-2">
                                        <div class="flex items-center gap-1.5 text-primary font-label-sm text-label-sm font-semibold">
                                            <span class="material-symbols-outlined text-[15px]">schedule</span>
                                            <%= o.shift_code %> · <%= o.shift_name %>
                                        </div>
                                        <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full <%= o.status === 'active' ? 'bg-green-50 text-green-700' : 'bg-surface-container-high text-on-surface-variant' %> text-[10px] font-semibold">
                                            <span class="w-1.5 h-1.5 rounded-full <%= o.status === 'active' ? 'bg-green-500' : 'bg-outline' %>"></span>
                                            <%= o.status === 'active' ? 'Đang áp dụng' : 'Đã hủy' %>
                                        </span>
                                    </div>
                                    <div class="font-data-mono text-[11px] text-on-surface-variant"><%= o.morning_start %> – <%= o.morning_end %> | <%= o.afternoon_start %> – <%= o.afternoon_end %></div>
                                    <div class="font-data-mono text-[11px] text-on-surface-variant"><%= o.start_date %> → <%= o.end_date %></div>
                                    <div class="flex gap-1 pt-1 border-t border-surface-container-high">
                                        <% if (o.status === 'active') { %>
                                            <button class="inline-flex items-center gap-1 px-2 py-1 rounded-md bg-primary hover:bg-primary-container text-on-primary text-[11px] font-semibold transition-colors" data-adjust-shift data-id="<%= o.id %>" data-employee-name="<%= o.full_name %>" data-employee-code="<%= o.employee_code %>" data-department="<%= o.department || '' %>" data-current-shift-id="<%= o.shift_id %>" data-current-shift-name="<%= o.shift_name %>" data-current-shift-time="<%= o.morning_start %> - <%= o.morning_end %> | <%= o.afternoon_start %> - <%= o.afternoon_end %>" data-start="<%= o.start_date %>" data-end="<%= o.end_date %>" data-note="<%= o.note || '' %>" type="button">
                                                <span class="material-symbols-outlined text-[13px]">edit_calendar</span> Điều chỉnh
                                            </button>
                                        <% } %>
                                        <button class="inline-flex items-center gap-1 px-2 py-1 rounded-md bg-surface-container-high hover:bg-surface-variant text-on-surface text-[11px] font-semibold transition-colors" data-edit-assignment data-id="<%= o.id %>" data-employee="<%= o.employee_id %>" data-shift="<%= o.shift_id %>" data-start="<%= o.start_date %>" data-end="<%= o.end_date %>" data-note="<%= o.note || '' %>" data-status="<%= o.status %>" data-current-summary="<%= `${o.shift_code} · ${o.shift_name} | ${o.morning_start}-${o.morning_end}, ${o.afternoon_start}-${o.afternoon_end} | ${o.start_date} – ${o.end_date}` %>" type="button">
                                            <span class="material-symbols-outlined text-[13px]">tune</span> Sửa
                                        </button>
                                        <% if (o.status === 'active') { %>
                                            <form action="/admin/shift-assignments/<%= o.id %>/cancel" method="POST" onsubmit="return confirm('Hủy phân ca này?');">
                                                <input class="js-return-to" type="hidden" name="return_to" value="">
                                                <button class="inline-flex items-center gap-1 px-2 py-1 rounded-md bg-error-container/60 text-error text-[11px] font-semibold transition-colors" type="submit">
                                                    <span class="material-symbols-outlined text-[13px]">cancel</span> Hủy
                                                </button>
                                            </form>
                                        <% } %>
                                    </div>
                                </div>
                            <% }) %>
                        </div>
                    <% } %>
                </article>
            <% }) %>
        <% } %>
    </div>

    <div class="hidden lg:block overflow-x-auto">
        <table class="w-full text-left border-collapse min-w-[1050px]">
            <thead>
                <tr class="bg-surface-container-low text-on-surface-variant font-label-sm text-label-sm uppercase tracking-wider">
                    <th class="py-space-md px-space-lg font-semibold">Nhân viên</th>
                    <th class="py-space-md px-space-md font-semibold">Phòng ban</th>
                    <th class="py-space-md px-space-md font-semibold">Ca làm việc</th>
                    <th class="py-space-md px-space-md font-semibold">Thời gian áp dụng</th>
                    <th class="py-space-md px-space-md font-semibold">Ngày làm việc</th>
                    <th class="py-space-md px-space-md font-semibold">Trạng thái</th>
                    <th class="py-space-md px-space-lg font-semibold text-right">Thao tác</th>
                </tr>
            </thead>
            <tbody class="text-body-sm text-on-surface">
                <% if (groupedAssignments.length === 0) { %>
                    <tr>
                        <td colspan="7" class="py-space-2xl px-space-lg text-center">
                            <div class="flex flex-col items-center gap-space-sm text-on-surface-variant">
                                <span class="material-symbols-outlined text-[40px] text-outline">event_busy</span>
                                <span class="font-label-md text-label-md">Chưa có phân ca phù hợp</span>
                                <span class="font-body-sm text-body-sm">Thử thay đổi bộ lọc hoặc tạo phân ca mới.</span>
                            </div>
                        </td>
                    </tr>
                <% } else { %>
                    <% groupedAssignments.forEach((group) => {
                        const pA = group.primaryAssignment;
                        const others = group.otherAssignments;
                        const rowId = `tbl-others-${group.employee_id}`;
                    %>
                        <!-- Hàng chính -->
                        <tr class="border-b border-surface-container-low hover:bg-surface-container-low/70 transition-colors align-top">
                            <td class="py-space-md px-space-lg sticky left-0 z-[1] bg-surface-container-lowest">
                                <div class="flex items-center gap-space-md">
                                    <div class="w-9 h-9 rounded-full bg-primary-fixed text-primary font-semibold flex items-center justify-center text-sm shrink-0">
                                        <%= pA.full_name.slice(0, 2).toUpperCase() %>
                                    </div>
                                    <div class="flex flex-col min-w-0">
                                        <span class="font-label-md text-label-md text-on-surface font-semibold truncate"><%= pA.full_name %></span>
                                        <span class="font-data-mono text-[11px] text-on-surface-variant"><%= pA.employee_code %></span>
                                        <% if (others.length > 0) { %>
                                            <span class="mt-0.5 inline-flex items-center gap-0.5 text-[10px] font-bold text-amber-700">
                                                <span class="material-symbols-outlined text-[11px]">layers</span>
                                                <%= group.totalAssignments %> ca được giao
                                            </span>
                                        <% } %>
                                    </div>
                                </div>
                            </td>
                            <td class="py-space-md px-space-md text-on-surface-variant"><%= pA.department || "—" %></td>
                            <td class="py-space-md px-space-md">
                                <div class="flex flex-col">
                                    <span class="font-label-md text-label-md text-on-surface font-semibold"><%= pA.shift_name %></span>
                                    <span class="font-data-mono text-[11px] text-on-surface-variant">
                                        <%= pA.morning_start %> - <%= pA.morning_end %> |
                                        <%= pA.afternoon_start %> - <%= pA.afternoon_end %>
                                    </span>
                                </div>
                            </td>
                            <td class="py-space-md px-space-md">
                                <div class="flex flex-col font-data-mono text-data-mono">
                                    <span><%= pA.start_date %></span>
                                    <span class="text-on-surface-variant">đến <%= pA.end_date %></span>
                                </div>
                            </td>
                            <td class="py-space-md px-space-md">
                                <div class="flex flex-wrap gap-1 max-w-[190px]">
                                    <% if (pA.workdays.length === 0) { %>
                                        <span class="text-on-surface-variant">—</span>
                                    <% } else { %>
                                        <% pA.workdays.forEach((day) => { %>
                                            <span class="px-space-sm py-0.5 rounded-full bg-surface-container-high text-on-surface-variant text-[11px] font-semibold">
                                                <%= weekdayLabels[day] %>
                                            </span>
                                        <% }) %>
                                    <% } %>
                                </div>
                            </td>
                            <td class="py-space-md px-space-md">
                                <% if (pA.status === "active") { %>
                                    <span class="inline-flex items-center gap-1.5 px-space-sm py-0.5 rounded-full bg-green-50 text-green-700 text-[11px] font-semibold">
                                        <span class="w-1.5 h-1.5 rounded-full bg-green-500"></span>
                                        Đang áp dụng
                                    </span>
                                <% } else { %>
                                    <span class="inline-flex items-center gap-1.5 px-space-sm py-0.5 rounded-full bg-surface-container-high text-on-surface-variant text-[11px] font-semibold">
                                        <span class="w-1.5 h-1.5 rounded-full bg-outline"></span>
                                        Đã hủy
                                    </span>
                                <% } %>
                            </td>
                            <td class="py-space-md px-space-lg sticky right-0 z-[1] bg-surface-container-lowest">
                                <div class="flex items-center justify-end gap-space-xs">
                                    <button class="flex items-center gap-1 px-space-sm py-1 bg-surface-container-high hover:bg-surface-variant text-on-surface font-label-sm text-label-sm rounded-lg transition-colors" data-view-employee-calendar data-id="<%= pA.employee_id %>" data-name="<%= pA.full_name %>" data-code="<%= pA.employee_code %>" data-dept="<%= pA.department || '' %>" title="Xem toàn bộ lịch tháng" type="button">
                                        <span class="material-symbols-outlined text-[16px]">calendar_month</span>
                                        <span>Lịch</span>
                                    </button>

                                    <% if (pA.status === "active") { %>
                                        <button class="flex items-center gap-1 px-space-sm py-1 bg-primary hover:bg-primary-container text-on-primary font-label-sm text-label-sm rounded-lg shadow-xs transition-colors" data-adjust-shift data-id="<%= pA.id %>" data-employee-name="<%= pA.full_name %>" data-employee-code="<%= pA.employee_code %>" data-department="<%= pA.department || '' %>" data-current-shift-id="<%= pA.shift_id %>" data-current-shift-name="<%= pA.shift_name %>" data-current-shift-time="<%= pA.morning_start %> - <%= pA.morning_end %> | <%= pA.afternoon_start %> - <%= pA.afternoon_end %>" data-start="<%= pA.start_date %>" data-end="<%= pA.end_date %>" data-note="<%= pA.note || '' %>" title="Điều chỉnh ca làm việc mới từ một ngày cụ thể" type="button">
                                            <span class="material-symbols-outlined text-[16px]">edit_calendar</span>
                                            <span>Điều chỉnh ca</span>
                                        </button>
                                    <% } %>

                                    <button class="flex items-center gap-1 px-space-sm py-1 bg-surface-container-high hover:bg-surface-variant text-on-surface font-label-sm text-label-sm rounded-lg transition-colors" data-edit-assignment data-id="<%= pA.id %>" data-employee="<%= pA.employee_id %>" data-shift="<%= pA.shift_id %>" data-start="<%= pA.start_date %>" data-end="<%= pA.end_date %>" data-note="<%= pA.note || '' %>" data-status="<%= pA.status %>" data-current-summary="<%= `${pA.shift_code} · ${pA.shift_name} | ${pA.morning_start}-${pA.morning_end}, ${pA.afternoon_start}-${pA.afternoon_end} | ${pA.start_date} – ${pA.end_date}` %>" title="<%= pA.status === 'active' ? 'Chỉnh sửa toàn bộ ngày hoặc ghi chú' : 'Sửa lịch đã hủy' %>" type="button">
                                        <span class="material-symbols-outlined text-[16px]">tune</span>
                                        <span><%= pA.status === 'active' ? 'Sửa' : 'Sửa lịch' %></span>
                                    </button>

                                    <% if (pA.status === "active") { %>
                                        <form action="/admin/shift-assignments/<%= pA.id %>/cancel" method="POST" onsubmit="return confirm('Bạn có chắc muốn hủy phân ca này?');">
                                <input class="js-return-to" type="hidden" name="return_to" value="">
                                            <button class="flex items-center gap-1 px-space-sm py-1 bg-error-container/50 hover:bg-error-container text-error font-label-sm text-label-sm rounded-lg transition-colors" type="submit" title="Hủy phân ca">
                                                <span class="material-symbols-outlined text-[16px]">cancel</span>
                                                <span>Hủy</span>
                                            </button>
                                        </form>
                                    <% } %>

                                    <!-- Nút mở rộng ca khác -->
                                    <% if (others.length > 0) { %>
                                        <button
                                            type="button"
                                            class="flex items-center gap-1 px-space-sm py-1 bg-amber-50 hover:bg-amber-100 text-amber-700 font-label-sm text-label-sm rounded-lg border border-amber-200 transition-colors"
                                            data-toggle-others="<%= rowId %>"
                                            aria-expanded="false"
                                            title="Xem thêm <%= others.length %> ca khác"
                                        >
                                            <span class="material-symbols-outlined text-[15px]">expand_more</span>
                                            <span><%= others.length %> ca khác</span>
                                        </button>
                                    <% } %>
                                </div>
                            </td>
                        </tr>

                        <!-- Hàng mở rộng: danh sách các ca khác (ẩn mặc định) -->
                        <% if (others.length > 0) { %>
                            <tr id="<%= rowId %>" class="hidden bg-amber-50/40 border-b border-amber-100">
                                <td colspan="7" class="px-space-lg py-3">
                                    <div class="flex flex-col gap-2">
                                        <p class="text-[11px] font-semibold text-amber-700 uppercase tracking-wider flex items-center gap-1">
                                            <span class="material-symbols-outlined text-[14px]">layers</span>
                                            Các ca khác của <%= pA.full_name %>
                                        </p>
                                        <% others.forEach((o) => { %>
                                            <div class="flex items-center gap-4 p-space-sm rounded-lg border border-amber-200 bg-white/70 text-body-sm">
                                                <!-- Ca -->
                                                <div class="flex flex-col min-w-[160px]">
                                                    <span class="font-label-md text-label-md text-on-surface font-semibold"><%= o.shift_name %></span>
                                                    <span class="font-data-mono text-[11px] text-on-surface-variant"><%= o.morning_start %> - <%= o.morning_end %> | <%= o.afternoon_start %> - <%= o.afternoon_end %></span>
                                                </div>
                                                <!-- Thời gian -->
                                                <div class="flex flex-col font-data-mono text-[11px] min-w-[140px]">
                                                    <span><%= o.start_date %></span>
                                                    <span class="text-on-surface-variant">đến <%= o.end_date %></span>
                                                </div>
                                                <!-- Trạng thái -->
                                                <div class="min-w-[90px]">
                                                    <% if (o.status === "active") { %>
                                                        <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full bg-green-50 text-green-700 text-[10px] font-semibold border border-green-200">
                                                            <span class="w-1.5 h-1.5 rounded-full bg-green-500"></span>Đang áp dụng
                                                        </span>
                                                    <% } else { %>
                                                        <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full bg-surface-container-high text-on-surface-variant text-[10px] font-semibold">
                                                            <span class="w-1.5 h-1.5 rounded-full bg-outline"></span>Đã hủy
                                                        </span>
                                                    <% } %>
                                                </div>
                                                <!-- Thao tác -->
                                                <div class="flex items-center gap-1 ml-auto">
                                                    <% if (o.status === "active") { %>
                                                        <button class="flex items-center gap-1 px-2 py-1 bg-primary hover:bg-primary-container text-on-primary text-[11px] font-semibold rounded-md transition-colors" data-adjust-shift data-id="<%= o.id %>" data-employee-name="<%= o.full_name %>" data-employee-code="<%= o.employee_code %>" data-department="<%= o.department || '' %>" data-current-shift-id="<%= o.shift_id %>" data-current-shift-name="<%= o.shift_name %>" data-current-shift-time="<%= o.morning_start %> - <%= o.morning_end %> | <%= o.afternoon_start %> - <%= o.afternoon_end %>" data-start="<%= o.start_date %>" data-end="<%= o.end_date %>" data-note="<%= o.note || '' %>" type="button">
                                                            <span class="material-symbols-outlined text-[13px]">edit_calendar</span> Điều chỉnh
                                                        </button>
                                                    <% } %>
                                                    <button class="flex items-center gap-1 px-2 py-1 bg-surface-container-high hover:bg-surface-variant text-on-surface text-[11px] font-semibold rounded-md transition-colors" data-edit-assignment data-id="<%= o.id %>" data-employee="<%= o.employee_id %>" data-shift="<%= o.shift_id %>" data-start="<%= o.start_date %>" data-end="<%= o.end_date %>" data-note="<%= o.note || '' %>" data-status="<%= o.status %>" data-current-summary="<%= `${o.shift_code} · ${o.shift_name} | ${o.morning_start}-${o.morning_end}, ${o.afternoon_start}-${o.afternoon_end} | ${o.start_date} – ${o.end_date}` %>" type="button">
                                                        <span class="material-symbols-outlined text-[13px]">tune</span> Sửa
                                                    </button>
                                                    <% if (o.status === "active") { %>
                                                        <form action="/admin/shift-assignments/<%= o.id %>/cancel" method="POST" onsubmit="return confirm('Hủy phân ca này?');">
                                                <input class="js-return-to" type="hidden" name="return_to" value="">
                                                            <button class="flex items-center gap-1 px-2 py-1 bg-error-container/50 hover:bg-error-container text-error text-[11px] font-semibold rounded-md transition-colors" type="submit">
                                                                <span class="material-symbols-outlined text-[13px]">cancel</span> Hủy
                                                            </button>
                                                        </form>
                                                    <% } %>
                                                </div>
                                            </div>
                                        <% }) %>
                                    </div>
                                </td>
                            </tr>
                        <% } %>
                    <% }) %>
                <% } %>
            </tbody>
        </table>
    </div>
</section>
</div>

<!-- Modal thêm / chỉnh sửa phân ca -->
<div id="assignment-modal" class="fixed inset-0 z-50 hidden">
    <div class="absolute inset-0 bg-black/40" data-close-assignment-modal></div>

    <div class="relative min-h-full flex items-center justify-center p-space-lg">
        <div class="w-full max-w-2xl bg-surface-container-lowest rounded-xl shadow-[0_16px_48px_rgba(0,0,0,0.18)] overflow-hidden">
            <div class="flex items-center justify-between px-space-xl py-space-lg border-b border-surface-container-high">
                <div class="flex flex-col">
                    <h3 id="assignment-modal-title" class="font-headline-md text-headline-md text-primary font-semibold">Phân ca nhân viên</h3>
                    <p id="assignment-modal-description" class="font-body-sm text-body-sm text-on-surface-variant">Chọn nhân viên, ca làm việc và khoảng thời gian áp dụng.</p>
                </div>
                <button class="p-space-sm rounded-xl text-on-surface-variant hover:bg-surface-container-high transition-colors" data-close-assignment-modal type="button" aria-label="Đóng">
                    <span class="material-symbols-outlined">close</span>
                </button>
            </div>

            <form id="assignment-form" action="/admin/shift-assignments/create" method="POST" class="p-space-xl flex flex-col gap-space-lg">
                <input id="assignment_multi_employee_mode_value" type="hidden" name="multi_employee_mode" value="0">
                <input class="js-return-to" type="hidden" name="return_to" value="">
                <div id="assignment-quick-context" class="hidden items-start gap-space-sm p-space-md rounded-xl bg-primary-fixed/40 border border-primary/15 text-primary text-body-md">
                    <span class="material-symbols-outlined text-[20px] shrink-0">bolt</span>
                    <span>Đang phân ca nhanh cho <strong id="assignment-quick-employee" class="font-semibold"></strong> từ ngày <strong id="assignment-quick-date" class="font-data-mono font-semibold"></strong><span id="assignment-quick-shift-holder"></span>. <span id="assignment-quick-action">Chọn ca để lưu.</span></span>
                </div>
                <div id="assignment-form-error" class="hidden items-start gap-space-sm p-space-md rounded-xl bg-error-container/60 border border-error/30 text-on-error-container text-body-md">
                    <span class="material-symbols-outlined text-[20px]">error</span>
                    <span id="assignment-form-error-text"></span>
                </div>
                <div id="assignment-adjustment-current" class="hidden items-start gap-space-sm p-space-md rounded-xl bg-primary-fixed/50 border border-primary/10 text-primary" aria-live="polite">
                    <span class="material-symbols-outlined text-[20px]">schedule</span>
                    <div class="flex flex-col gap-1">
                        <span class="font-label-sm text-label-sm">Lịch đang áp dụng</span>
                        <span id="assignment-adjustment-current-summary" class="font-body-sm text-body-sm"></span>
                    </div>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-space-lg">
                    <div class="flex flex-col gap-space-xs">
                        <label class="font-label-sm text-label-sm text-on-surface" for="assignment_department_filter">Lọc theo phòng ban</label>
                        <select class="bg-surface-container-low text-on-surface font-body-md text-body-md px-space-md py-space-sm rounded-xl outline-none focus:ring-2 focus:ring-primary-container" id="assignment_department_filter">
                            <option value="">Tất cả phòng ban</option>
                            <% departments.forEach((department) => { %>
                                <option value="<%= department %>"><%= department %></option>
                            <% }) %>
                        </select>
                    </div>

                    <div class="flex flex-col gap-space-xs">
                        <label class="font-label-sm text-label-sm text-on-surface" for="assignment_employee">Nhân viên <span class="text-error">*</span></label>
                        <label id="assignment-multi-mode-control" class="inline-flex items-center gap-space-sm font-body-sm text-body-sm text-on-surface-variant cursor-pointer">
                            <input id="assignment_multi_employee_mode" class="w-4 h-4 accent-primary" type="checkbox">
                            Phân cùng ca cho nhiều nhân viên
                        </label>
                        <div class="relative">
                            <span class="material-symbols-outlined absolute left-space-sm top-1/2 -translate-y-1/2 text-on-surface-variant text-[18px]">search</span>
                            <input class="w-full bg-surface-container-low text-on-surface font-body-sm text-body-sm pl-8 pr-space-md py-space-sm rounded-xl outline-none focus:ring-2 focus:ring-primary-container" id="assignment_employee_search" type="search" autocomplete="off" placeholder="Tìm theo mã, tên hoặc phòng ban..." aria-controls="assignment_employee">
                        </div>
                        <select class="bg-surface-container-low text-on-surface font-body-md text-body-md px-space-md py-space-sm rounded-xl outline-none focus:ring-2 focus:ring-primary-container" id="assignment_employee" name="employee_id" required>
                            <option value="">-- Chọn nhân viên --</option>
                            <% employees.forEach((employee) => { %>
                                <option value="<%= employee.id %>" data-code="<%= employee.employee_code %>" data-name="<%= employee.full_name %>" data-department="<%= employee.department || '' %>">
                                    <%= employee.employee_code %> - <%= employee.full_name %><%= employee.department ? ` (${employee.department})` : "" %>
                                </option>
                            <% }) %>
                        </select>
                        <div id="assignment-multi-actions" class="hidden flex-wrap items-center gap-space-xs text-[12px]">
                            <span id="assignment-multi-count" class="font-semibold text-primary">0 nhân viên được chọn</span>
                            <button type="button" id="assignment-select-visible" class="px-2 py-1 rounded-lg bg-primary-fixed/60 text-primary font-semibold hover:bg-primary-fixed transition-colors">Chọn kết quả lọc</button>
                            <button type="button" id="assignment-clear-selection" class="px-2 py-1 rounded-lg bg-surface-container-high text-on-surface-variant font-semibold hover:bg-surface-variant transition-colors">Bỏ chọn</button>
                        </div>
                        <div id="assignment_employee_multi_list" class="hidden max-h-52 overflow-y-auto rounded-xl border border-surface-container-high bg-surface-container-lowest divide-y divide-surface-container-low" role="group" aria-label="Chọn nhiều nhân viên">
                            <% employees.forEach((employee) => { %>
                                <label class="flex items-center gap-space-sm px-space-md py-space-sm hover:bg-surface-container-low cursor-pointer" data-employee-option data-code="<%= employee.employee_code %>" data-name="<%= employee.full_name %>" data-department="<%= employee.department || '' %>">
                                    <input class="w-4 h-4 accent-primary shrink-0" type="checkbox" name="employee_ids" value="<%= employee.id %>">
                                    <span class="flex flex-col min-w-0">
                                        <span class="font-label-md text-label-md text-on-surface truncate"><%= employee.full_name %></span>
                                        <span class="font-body-sm text-body-sm text-on-surface-variant"><%= employee.employee_code %><%= employee.department ? ` · ${employee.department}` : '' %></span>
                                    </span>
                                </label>
                            <% }) %>
                        </div>
                        <span id="assignment-multi-mode-help" class="hidden font-body-sm text-body-sm text-primary">Ca và khoảng ngày sẽ áp dụng cho tất cả người đã chọn; nhân viên bị trùng lịch sẽ được bỏ qua và báo sau khi lưu.</span>
                        <span id="assignment-employee-hint" class="font-body-sm text-body-sm text-on-surface-variant" aria-live="polite"><%= employees.length %> nhân viên đang hoạt động</span>
                    </div>
                </div>

                <div class="flex flex-col gap-space-xs">
                    <label class="font-label-sm text-label-sm text-on-surface" for="assignment_shift">Ca làm việc <span class="text-error">*</span></label>
                    <div class="relative">
                        <span class="material-symbols-outlined absolute left-space-sm top-1/2 -translate-y-1/2 text-on-surface-variant text-[18px]">search</span>
                        <input class="w-full bg-surface-container-low text-on-surface font-body-sm text-body-sm pl-8 pr-space-md py-space-sm rounded-xl outline-none focus:ring-2 focus:ring-primary-container" id="assignment_shift_search" type="search" autocomplete="off" placeholder="Tìm theo mã hoặc tên ca..." aria-controls="assignment_shift">
                    </div>
                    <select class="bg-surface-container-low text-on-surface font-body-md text-body-md px-space-md py-space-sm rounded-xl outline-none focus:ring-2 focus:ring-primary-container" id="assignment_shift" name="shift_id" required>
                        <option value="">-- Chọn ca làm việc --</option>
                        <% activeShifts.forEach((shift) => { %>
                            <option
                                value="<%= shift.id %>"
                                data-code="<%= shift.shift_code %>"
                                data-name="<%= shift.shift_name %>"
                                data-time="<%= shift.morning_start %> - <%= shift.morning_end %> | <%= shift.afternoon_start %> - <%= shift.afternoon_end %>"
                                data-workdays="<%= shift.workdays.map((day) => weekdayLabels[day]).join(', ') %>"
                            >
                                <%= shift.shift_code %> - <%= shift.shift_name %>
