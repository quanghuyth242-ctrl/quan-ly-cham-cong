<script>
// Toggle expand/collapse danh sách ca khác của nhân viên
document.addEventListener('click', function(e) {
    const btn = e.target.closest('[data-toggle-others]');
    if (!btn) return;

    const targetId = btn.dataset.toggleOthers;
    const targetEl = document.getElementById(targetId);
    if (!targetEl) return;

    const isExpanded = btn.getAttribute('aria-expanded') === 'true';

    if (isExpanded) {
        targetEl.classList.add('hidden');
        btn.setAttribute('aria-expanded', 'false');
        // Đổi icon và text
        const icon = btn.querySelector('.material-symbols-outlined');
        const text = btn.querySelector('span:not(.material-symbols-outlined)');
        if (icon) icon.textContent = 'expand_more';
        if (text) {
            // Lấy lại số ca từ title
            const titleMatch = btn.title.match(/(\d+)/);
            const count = titleMatch ? titleMatch[1] : '?';
            text.textContent = `${count} ca khác`;
        }
    } else {
        targetEl.classList.remove('hidden');
        btn.setAttribute('aria-expanded', 'true');
        const icon = btn.querySelector('.material-symbols-outlined');
        const text = btn.querySelector('span:not(.material-symbols-outlined)');
        if (icon) icon.textContent = 'expand_less';
        if (text) text.textContent = 'Thu gọn';
    }
});
</script>

