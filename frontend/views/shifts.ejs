<%- include("partials/adminHead", { pageTitle: "Quản lý ca & lịch trực", activePage: "shifts", user: user }) %>

<%- include("partials/alerts", { success: success, error: error }) %>

<div id="schedule-sync" data-revision="<%= syncRevision || '' %>" class="flex flex-wrap items-center justify-between gap-space-sm px-space-md py-space-sm rounded-xl bg-surface-container-low text-on-surface-variant font-body-sm text-body-sm" role="status">
    <span id="schedule-sync-status">Đồng bộ tự động đang bật · kiểm tra thay đổi mỗi 20 giây.</span>
    <button id="schedule-sync-refresh" class="hidden items-center gap-space-xs px-space-md py-space-sm rounded-lg bg-primary text-on-primary font-label-sm text-label-sm" type="button">
        <span class="material-symbols-outlined text-[18px]">sync</span>
        <span>Cập nhật dữ liệu mới</span>
    </button>
</div>

<section class="relative overflow-hidden flex flex-col xl:flex-row xl:items-center justify-between gap-space-lg bg-surface-container-lowest p-space-lg md:p-space-xl rounded-xl border border-surface-container-high/60 shadow-sm">
    <div class="absolute inset-y-0 left-0 w-1 bg-primary"></div>
    <div class="flex flex-col gap-space-xs">
        <div class="flex items-center gap-space-sm text-on-surface-variant font-label-sm text-label-sm">
            <span class="flex h-2 w-2 rounded-full bg-primary-container"></span>
            <span class="uppercase tracking-wider">Ca làm việc &amp; lịch trực</span>
        </div>
        <h2 class="font-headline-lg text-headline-lg text-primary tracking-tight">Quản lý ca &amp; lịch trực</h2>
        <p class="font-body-md text-body-md text-on-surface-variant">
            Thiết lập khung giờ, ngày làm việc và trạng thái của từng ca; phân ca cho nhân viên để tạo lịch trực.
        </p>
    </div>

    <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-space-sm self-start lg:self-auto">
        <nav class="flex items-center p-1 rounded-xl bg-surface-container-high" aria-label="Chuyển mục ca và lịch trực">
            <a href="/admin/shifts" class="flex items-center gap-space-xs px-space-md py-space-sm rounded-lg bg-surface-container-lowest text-primary shadow-sm font-label-md text-label-md">
                <span class="material-symbols-outlined text-[18px]">schedule</span>
                Danh sách ca
            </a>
            <a href="/admin/shift-assignments" class="flex items-center gap-space-xs px-space-md py-space-sm rounded-lg text-on-surface-variant hover:text-primary font-label-md text-label-md transition-colors">
                <span class="material-symbols-outlined text-[18px]">calendar_month</span>
                Lịch trực
            </a>
        </nav>
        <a href="/admin/shift-assignments" class="flex items-center justify-center gap-space-xs bg-surface-container-low hover:bg-surface-container-high text-on-surface-variant px-space-lg py-space-sm rounded-xl font-label-md text-label-md transition-colors">
            <span class="material-symbols-outlined text-[20px]">event_repeat</span>
            <span>Phân ca nhân viên</span>
        </a>
        <button id="open-create-shift" class="flex items-center justify-center gap-space-xs bg-primary hover:bg-primary-container text-on-primary px-space-lg py-space-sm rounded-xl font-label-md text-label-md shadow-md transition-all" type="button">
            <span class="material-symbols-outlined text-[20px]">add</span>
            <span>Thêm ca làm việc</span>
        </button>
    </div>
</section>

<section class="grid grid-cols-1 sm:grid-cols-3 gap-space-lg" aria-label="Thống kê ca làm việc">
    <a href="/admin/shifts" class="bg-surface-container-lowest p-space-lg rounded-xl border border-surface-container-high/60 shadow-sm flex items-center justify-between hover:ring-2 hover:ring-primary/10 transition-all">
        <div class="flex flex-col">
            <span class="font-label-sm text-label-sm text-on-surface-variant uppercase tracking-wider">Tổng số ca</span>
            <span class="font-headline-xl text-headline-xl text-primary font-bold mt-space-xs"><%= stats.total %></span>
        </div>
        <div class="w-11 h-11 rounded-xl bg-primary-fixed text-primary flex items-center justify-center">
            <span class="material-symbols-outlined text-[24px]">calendar_month</span>
        </div>
    </a>

    <a href="/admin/shifts?status=1" class="bg-surface-container-lowest p-space-lg rounded-xl border border-surface-container-high/60 shadow-sm flex items-center justify-between hover:ring-2 hover:ring-green-100 transition-all">
        <div class="flex flex-col">
            <span class="font-label-sm text-label-sm text-on-surface-variant uppercase tracking-wider">Đang hoạt động</span>
            <span class="font-headline-xl text-headline-xl text-on-surface font-bold mt-space-xs"><%= stats.active %></span>
        </div>
        <div class="w-11 h-11 rounded-xl bg-green-50 text-green-600 flex items-center justify-center">
            <span class="material-symbols-outlined text-[24px]">check_circle</span>
        </div>
    </a>

    <a href="/admin/shifts?status=0" class="bg-surface-container-lowest p-space-lg rounded-xl border border-surface-container-high/60 shadow-sm flex items-center justify-between hover:ring-2 hover:ring-surface-variant transition-all">
        <div class="flex flex-col">
            <span class="font-label-sm text-label-sm text-on-surface-variant uppercase tracking-wider">Ngừng hoạt động</span>
            <span class="font-headline-xl text-headline-xl text-on-surface font-bold mt-space-xs"><%= stats.inactive %></span>
        </div>
        <div class="w-11 h-11 rounded-xl bg-surface-container-high text-on-surface-variant flex items-center justify-center">
            <span class="material-symbols-outlined text-[24px]">pause_circle</span>
        </div>
    </a>
</section>

<section class="bg-surface-container-lowest rounded-xl shadow-sm overflow-hidden">
    <div class="p-space-lg border-b border-surface-container-high">
        <form method="GET" action="/admin/shifts" class="flex flex-col lg:flex-row lg:items-center justify-between gap-space-md">
            <div class="flex flex-col sm:flex-row gap-space-sm flex-1">
                <div class="relative flex-1 sm:max-w-xs">
                    <span class="material-symbols-outlined absolute left-space-sm top-1/2 -translate-y-1/2 text-on-surface-variant text-[18px]">search</span>
                    <input
                        id="shift-search"
                        class="w-full bg-surface-container-low text-on-surface font-body-sm text-body-sm pl-8 pr-space-md py-space-sm rounded-xl outline-none focus:bg-surface-container transition-all"
                        name="search"
                        value="<%= filters.search %>"
                        placeholder="Tìm theo mã hoặc tên ca..."
                        type="text"
                    >
                    <button
                        id="clear-shift-search"
                        type="button"
                        class="<%= filters.search ? '' : 'hidden' %> absolute right-space-sm top-1/2 -translate-y-1/2 p-1 text-on-surface-variant hover:text-primary rounded-md"
                        aria-label="Xóa từ khóa tìm kiếm"
                    >
                        <span class="material-symbols-outlined text-[18px]">close</span>
                    </button>
                </div>

                <div class="relative sm:w-48">
                    <select class="w-full appearance-none bg-surface-container-low text-on-surface font-label-sm text-label-sm py-space-sm pl-space-md pr-space-xl rounded-xl outline-none cursor-pointer" name="status">
                        <option value="" <%= filters.status === "" ? "selected" : "" %>>Tất cả trạng thái</option>
                        <option value="1" <%= filters.status === "1" ? "selected" : "" %>>Đang hoạt động</option>
                        <option value="0" <%= filters.status === "0" ? "selected" : "" %>>Ngừng hoạt động</option>
                    </select>
                    <span class="material-symbols-outlined absolute right-space-sm top-1/2 -translate-y-1/2 text-on-surface-variant pointer-events-none text-[20px]">expand_more</span>
                </div>

                <button class="flex items-center justify-center gap-space-xs bg-primary hover:bg-primary-container text-on-primary px-space-md py-space-sm rounded-xl font-label-md text-label-md transition-colors" type="submit">
                    <span class="material-symbols-outlined text-[18px]">filter_alt</span>
                    <span>Lọc</span>
                </button>

                <a class="flex items-center justify-center gap-space-xs bg-surface-container-low hover:bg-surface-container-high text-on-surface-variant px-space-md py-space-sm rounded-xl font-label-md text-label-md transition-colors" href="/admin/shifts">
                    <span class="material-symbols-outlined text-[18px]">restart_alt</span>
                    <span>Đặt lại</span>
                </a>
            </div>

            <span class="font-body-sm text-body-sm text-on-surface-variant">
                Hiển thị <strong class="text-on-surface"><%= shifts.length %></strong> ca làm việc
            </span>
        </form>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-space-md p-space-md lg:hidden">
        <% if (shifts.length === 0) { %>
            <div class="md:col-span-2 flex flex-col items-center gap-space-sm p-space-2xl rounded-xl border border-dashed border-outline-variant text-center text-on-surface-variant">
                <span class="material-symbols-outlined text-[36px]">event_busy</span>
                <span class="font-label-md text-label-md">Chưa có ca làm việc phù hợp</span>
                <span class="font-body-sm text-body-sm">Thử đổi bộ lọc hoặc thêm ca mới.</span>
            </div>
        <% } else { %>
            <% shifts.forEach((shift) => { %>
                <article class="flex flex-col gap-space-md p-space-lg rounded-xl border border-surface-container-high bg-surface-container-lowest shadow-sm">
                    <div class="flex items-start justify-between gap-space-sm">
                        <div class="flex flex-col gap-1 min-w-0">
                            <span class="inline-flex self-start px-space-sm py-1 rounded-lg bg-primary-fixed text-primary font-data-mono text-data-mono font-semibold"><%= shift.shift_code %></span>
                            <h3 class="font-headline-sm text-headline-sm text-on-surface"><%= shift.shift_name %></h3>
                            <span class="font-body-sm text-body-sm text-on-surface-variant"><%= shift.assignment_count %> lượt phân ca</span>
                        </div>
                        <span class="shrink-0 inline-flex items-center gap-1 px-space-sm py-1 rounded-full <%= shift.status === 1 ? 'bg-green-50 text-green-700' : 'bg-surface-container-high text-on-surface-variant' %> text-[11px] font-semibold">
                            <span class="w-1.5 h-1.5 rounded-full <%= shift.status === 1 ? 'bg-green-500' : 'bg-outline' %>"></span>
                            <%= shift.status === 1 ? 'Đang hoạt động' : 'Ngừng hoạt động' %>
                        </span>
                    </div>

                    <div class="grid grid-cols-2 gap-space-sm">
                        <div class="flex flex-col gap-1 p-space-md rounded-lg bg-amber-50 text-amber-900">
                            <span class="font-label-sm text-label-sm">Buổi sáng</span>
                            <span class="font-data-mono text-data-mono"><%= shift.morning_start %> – <%= shift.morning_end %></span>
                        </div>
                        <div class="flex flex-col gap-1 p-space-md rounded-lg bg-sky-50 text-sky-900">
                            <span class="font-label-sm text-label-sm">Buổi chiều</span>
                            <span class="font-data-mono text-data-mono"><%= shift.afternoon_start %> – <%= shift.afternoon_end %></span>
                        </div>
                    </div>

                    <div class="flex flex-wrap gap-1">
                        <% shift.workdays.forEach((day) => { %>
                            <span class="px-space-sm py-0.5 rounded-full bg-surface-container-high text-on-surface-variant text-[11px] font-semibold"><%= weekdayLabels[day] %></span>
                        <% }) %>
                    </div>

                    <div class="flex items-center gap-space-sm pt-space-sm border-t border-surface-container-high">
                        <button class="flex-1 inline-flex justify-center items-center gap-1 px-space-sm py-space-sm rounded-lg bg-primary-fixed text-primary font-label-sm text-label-sm" data-edit-shift data-id="<%= shift.id %>" data-code="<%= shift.shift_code %>" data-name="<%= shift.shift_name %>" data-morning-start="<%= shift.morning_start %>" data-morning-end="<%= shift.morning_end %>" data-afternoon-start="<%= shift.afternoon_start %>" data-afternoon-end="<%= shift.afternoon_end %>" data-workdays="<%= shift.workdays.join(',') %>" data-status="<%= shift.status %>" type="button">
                            <span class="material-symbols-outlined text-[18px]">edit</span> Chỉnh sửa
                        </button>
                        <form action="/admin/shifts/<%= shift.id %>/toggle-status" method="POST">
                            <button class="inline-flex items-center justify-center gap-1 px-space-sm py-space-sm rounded-lg bg-surface-container-high text-on-surface-variant font-label-sm text-label-sm" type="submit" aria-label="<%= shift.status === 1 ? 'Ngừng hoạt động' : 'Kích hoạt lại' %>">
                                <span class="material-symbols-outlined text-[18px]"><%= shift.status === 1 ? 'pause' : 'play_arrow' %></span>
                            </button>
                        </form>
                        <form action="/admin/shifts/<%= shift.id %>/delete" method="POST" onsubmit="return confirm('Bạn có chắc muốn xóa ca làm việc này? Thao tác không thể hoàn tác.');">
                            <button class="inline-flex items-center justify-center gap-1 px-space-sm py-space-sm rounded-lg <%= shift.assignment_count > 0 ? 'bg-surface-container-high text-outline cursor-not-allowed' : 'bg-error-container/60 text-error' %>" type="submit" aria-label="Xóa ca" <%= shift.assignment_count > 0 ? 'disabled' : '' %>>
                                <span class="material-symbols-outlined text-[18px]">delete</span>
                            </button>
                        </form>
                    </div>
                </article>
            <% }) %>
        <% } %>
    </div>

    <div class="hidden lg:block overflow-x-auto">
        <table class="w-full text-left border-collapse min-w-[980px]">
            <thead>
                <tr class="bg-surface-container-low text-on-surface-variant font-label-sm text-label-sm uppercase tracking-wider">
                    <th class="py-space-md px-space-lg font-semibold">Mã ca</th>
                    <th class="py-space-md px-space-md font-semibold">Tên ca</th>
                    <th class="py-space-md px-space-md font-semibold">Buổi sáng</th>
                    <th class="py-space-md px-space-md font-semibold">Buổi chiều</th>
                    <th class="py-space-md px-space-md font-semibold">Ngày làm việc</th>
                    <th class="py-space-md px-space-md font-semibold">Trạng thái</th>
                    <th class="py-space-md px-space-lg font-semibold text-right">Thao tác</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-surface-container-low text-body-sm text-on-surface">
                <% if (shifts.length === 0) { %>
                    <tr>
                        <td colspan="7" class="py-space-2xl px-space-lg text-center">
                            <div class="flex flex-col items-center gap-space-sm text-on-surface-variant">
                                <span class="material-symbols-outlined text-[40px] text-outline">event_busy</span>
                                <span class="font-label-md text-label-md">Chưa có ca làm việc phù hợp</span>
                                <span class="font-body-sm text-body-sm">Thử thay đổi bộ lọc hoặc thêm ca làm việc mới.</span>
                            </div>
                        </td>
                    </tr>
                <% } else { %>
                    <% shifts.forEach((shift) => { %>
                        <tr class="hover:bg-surface-container-low/70 transition-colors align-top">
                            <td class="py-space-md px-space-lg sticky left-0 z-[1] bg-surface-container-lowest">
                                <span class="inline-flex px-space-sm py-1 rounded-lg bg-primary-fixed text-primary font-data-mono text-data-mono font-semibold">
                                    <%= shift.shift_code %>
                                </span>
                            </td>
                            <td class="py-space-md px-space-md">
                                <div class="flex flex-col">
                                    <span class="font-label-md text-label-md text-on-surface font-semibold"><%= shift.shift_name %></span>
                                    <span class="font-body-sm text-body-sm text-on-surface-variant"><%= shift.assignment_count %> lượt phân ca</span>
                                </div>
                            </td>
                            <td class="py-space-md px-space-md">
                                <div class="flex items-center gap-space-xs text-on-surface">
                                    <span class="material-symbols-outlined text-secondary text-[18px]">light_mode</span>
                                    <span class="font-data-mono text-data-mono"><%= shift.morning_start %> - <%= shift.morning_end %></span>
                                </div>
                            </td>
                            <td class="py-space-md px-space-md">
                                <div class="flex items-center gap-space-xs text-on-surface">
                                    <span class="material-symbols-outlined text-secondary text-[18px]">wb_twilight</span>
                                    <span class="font-data-mono text-data-mono"><%= shift.afternoon_start %> - <%= shift.afternoon_end %></span>
                                </div>
                            </td>
                            <td class="py-space-md px-space-md">
                                <div class="flex flex-wrap gap-1 max-w-[220px]">
                                    <% if (shift.workdays.length === 0) { %>
                                        <span class="text-on-surface-variant">Chưa thiết lập</span>
                                    <% } else { %>
                                        <% shift.workdays.forEach((day) => { %>
                                            <span class="px-space-sm py-0.5 rounded-full bg-surface-container-high text-on-surface-variant text-[11px] font-semibold">
                                                <%= weekdayLabels[day] %>
                                            </span>
                                        <% }) %>
                                    <% } %>
                                </div>
                            </td>
                            <td class="py-space-md px-space-md">
                                <% if (shift.status === 1) { %>
                                    <span class="inline-flex items-center gap-1.5 px-space-sm py-0.5 rounded-full bg-green-50 text-green-700 text-[11px] font-semibold">
                                        <span class="w-1.5 h-1.5 rounded-full bg-green-500"></span>
                                        Đang hoạt động
                                    </span>
                                <% } else { %>
                                    <span class="inline-flex items-center gap-1.5 px-space-sm py-0.5 rounded-full bg-surface-container-high text-on-surface-variant text-[11px] font-semibold">
                                        <span class="w-1.5 h-1.5 rounded-full bg-outline"></span>
                                        Ngừng hoạt động
                                    </span>
                                <% } %>
                            </td>
                            <td class="py-space-md px-space-lg sticky right-0 z-[1] bg-surface-container-lowest">
                                <div class="flex items-center justify-end gap-space-xs">
                                    <button
                                        class="flex items-center gap-1 px-space-sm py-1 bg-surface-container-high hover:bg-surface-variant text-on-surface font-label-sm text-label-sm rounded-lg transition-colors"
                                        data-edit-shift
                                        data-id="<%= shift.id %>"
                                        data-code="<%= shift.shift_code %>"
                                        data-name="<%= shift.shift_name %>"
                                        data-morning-start="<%= shift.morning_start %>"
                                        data-morning-end="<%= shift.morning_end %>"
                                        data-afternoon-start="<%= shift.afternoon_start %>"
                                        data-afternoon-end="<%= shift.afternoon_end %>"
                                        data-workdays="<%= shift.workdays.join(',') %>"
                                        data-status="<%= shift.status %>"
                                        title="Chỉnh sửa ca"
                                        type="button"
                                    >
                                        <span class="material-symbols-outlined text-[16px]">edit</span>
                                        <span>Sửa</span>
                                    </button>

                                    <form action="/admin/shifts/<%= shift.id %>/toggle-status" method="POST">
                                        <button class="flex items-center gap-1 px-space-sm py-1 bg-surface-container-high hover:bg-surface-variant text-on-surface-variant font-label-sm text-label-sm rounded-lg transition-colors" type="submit" title="<%= shift.status === 1 ? 'Ngừng hoạt động' : 'Kích hoạt lại' %>">
                                            <span class="material-symbols-outlined text-[16px]"><%= shift.status === 1 ? "pause" : "play_arrow" %></span>
                                            <span><%= shift.status === 1 ? "Ngừng" : "Kích hoạt" %></span>
                                        </button>
                                    </form>

                                    <form action="/admin/shifts/<%= shift.id %>/delete" method="POST" onsubmit="return confirm('Bạn có chắc muốn xóa ca làm việc này? Thao tác không thể hoàn tác.');">
                                        <button
                                            class="flex items-center gap-1 px-space-sm py-1 font-label-sm text-label-sm rounded-lg transition-colors <%= shift.assignment_count > 0 ? 'bg-surface-container-low text-outline cursor-not-allowed' : 'bg-error-container/50 text-error hover:bg-error-container' %>"
                                            type="submit"
                                            title="<%= shift.assignment_count > 0 ? 'Không thể xóa vì ca đã được phân cho nhân viên' : 'Xóa ca làm việc' %>"
                                            <%= shift.assignment_count > 0 ? "disabled" : "" %>
                                        >
                                            <span class="material-symbols-outlined text-[16px]">delete</span>
                                            <span>Xóa</span>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    <% }) %>
                <% } %>
            </tbody>
        </table>
    </div>
</section>

<!-- Modal thêm / chỉnh sửa ca -->
<div id="shift-modal" class="fixed inset-0 z-50 hidden">
    <div class="absolute inset-0 bg-black/40" data-close-shift-modal></div>

    <div class="relative min-h-full flex items-center justify-center p-space-lg">
        <div class="w-full max-w-2xl bg-surface-container-lowest rounded-xl shadow-[0_16px_48px_rgba(0,0,0,0.18)] overflow-hidden">
            <div class="flex items-center justify-between px-space-xl py-space-lg border-b border-surface-container-high">
                <div class="flex flex-col">
                    <h3 id="shift-modal-title" class="font-headline-md text-headline-md text-primary font-semibold"><%= formFeedback?.mode === 'update' ? 'Chỉnh sửa ca làm việc' : 'Thêm ca làm việc' %></h3>
                    <p class="font-body-sm text-body-sm text-on-surface-variant">Khung giờ làm việc và ngày áp dụng trong tuần.</p>
                </div>
                <button class="p-space-sm rounded-xl text-on-surface-variant hover:bg-surface-container-high transition-colors" data-close-shift-modal type="button" aria-label="Đóng">
                    <span class="material-symbols-outlined">close</span>
                </button>
            </div>

            <form id="shift-form" action="<%= formFeedback?.mode === 'update' ? '/admin/shifts/' + formFeedback.shiftId + '/update' : '/admin/shifts/create' %>" method="POST" class="p-space-xl flex flex-col gap-space-lg">
                <div id="shift-form-error" class="<%= formFeedback ? 'flex' : 'hidden' %> items-start gap-space-sm p-space-md rounded-xl bg-error-container/60 border border-error/30 text-on-error-container text-body-md" role="alert">
                    <span class="material-symbols-outlined text-[20px]">error</span>
                    <span id="shift-form-error-text"><%= formFeedback?.error || '' %></span>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-space-lg">
                    <div class="flex flex-col gap-space-xs">
                        <label class="font-label-sm text-label-sm text-on-surface" for="shift_code">Mã ca <span class="text-error">*</span></label>
                        <input class="bg-surface-container-low text-on-surface font-body-md text-body-md px-space-md py-space-sm rounded-xl outline-none focus:ring-2 focus:ring-primary-container read-only:cursor-not-allowed read-only:bg-surface-container-high" id="shift_code" name="shift_code" value="<%= formFeedback?.values?.shift_code || '' %>" placeholder="Đang tạo mã..." pattern="[A-Za-z0-9_-]{2,50}" maxlength="50" required readonly type="text" aria-describedby="shift-code-hint">
                        <span id="shift-code-hint" class="font-body-sm text-body-sm text-on-surface-variant">Mã ca được hệ thống tạo tự động và không thể chỉnh sửa.</span>
                    </div>

                    <div class="flex flex-col gap-space-xs">
                        <label class="font-label-sm text-label-sm text-on-surface" for="shift_name">Tên ca <span class="text-error">*</span></label>
                        <input class="bg-surface-container-low text-on-surface font-body-md text-body-md px-space-md py-space-sm rounded-xl outline-none focus:ring-2 focus:ring-primary-container" id="shift_name" name="shift_name" value="<%= formFeedback?.values?.shift_name || '' %>" placeholder="VD: Ca hành chính" maxlength="100" required type="text">
                    </div>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-space-lg">
                    <div class="flex flex-col gap-space-xs">
                        <label class="font-label-sm text-label-sm text-on-surface" for="morning_start">Bắt đầu buổi sáng <span class="text-error">*</span></label>
                        <input class="bg-surface-container-low text-on-surface font-data-mono text-data-mono px-space-md py-space-sm rounded-xl outline-none focus:ring-2 focus:ring-primary-container" id="morning_start" name="morning_start" value="<%= formFeedback?.values?.morning_start || '' %>" required type="time">
                    </div>

                    <div class="flex flex-col gap-space-xs">
                        <label class="font-label-sm text-label-sm text-on-surface" for="morning_end">Kết thúc buổi sáng <span class="text-error">*</span></label>
                        <input class="bg-surface-container-low text-on-surface font-data-mono text-data-mono px-space-md py-space-sm rounded-xl outline-none focus:ring-2 focus:ring-primary-container" id="morning_end" name="morning_end" value="<%= formFeedback?.values?.morning_end || '' %>" required type="time">
                    </div>

                    <div class="flex flex-col gap-space-xs">
                        <label class="font-label-sm text-label-sm text-on-surface" for="afternoon_start">Bắt đầu buổi chiều <span class="text-error">*</span></label>
                        <input class="bg-surface-container-low text-on-surface font-data-mono text-data-mono px-space-md py-space-sm rounded-xl outline-none focus:ring-2 focus:ring-primary-container" id="afternoon_start" name="afternoon_start" value="<%= formFeedback?.values?.afternoon_start || '' %>" required type="time">
                    </div>

                    <div class="flex flex-col gap-space-xs">
                        <label class="font-label-sm text-label-sm text-on-surface" for="afternoon_end">Kết thúc buổi chiều <span class="text-error">*</span></label>
                        <input class="bg-surface-container-low text-on-surface font-data-mono text-data-mono px-space-md py-space-sm rounded-xl outline-none focus:ring-2 focus:ring-primary-container" id="afternoon_end" name="afternoon_end" value="<%= formFeedback?.values?.afternoon_end || '' %>" required type="time">
                    </div>
                </div>

                <div class="flex items-start gap-space-sm p-space-md rounded-xl bg-primary-fixed/40 border border-primary/10 text-primary" aria-live="polite">
                    <span class="material-symbols-outlined text-[20px]">calculate</span>
                    <div class="flex flex-col">
                        <span id="shift-duration-summary" class="font-label-md text-label-md font-semibold">Nhập đủ giờ để xem tổng thời gian làm việc.</span>
                        <span class="font-body-sm text-body-sm">Thời gian nghỉ giữa buổi sáng và buổi chiều không tính vào giờ làm.</span>
                    </div>
                </div>

                <div class="flex flex-col gap-space-sm">
                    <span class="font-label-sm text-label-sm text-on-surface">Ngày làm việc trong tuần <span class="text-error">*</span></span>
                    <div class="grid grid-cols-2 sm:grid-cols-4 gap-space-sm">
                        <% Object.entries(weekdayLabels).forEach(([value, label]) => { %>
                            <label class="flex items-center gap-space-sm px-space-md py-space-sm bg-surface-container-low hover:bg-surface-container rounded-xl cursor-pointer transition-colors">
                                <input class="w-4 h-4 accent-primary" name="workdays" value="<%= value %>" <%= formFeedback ? (formFeedback.values.workdays.includes(Number(value)) ? 'checked' : '') : (value !== '7' ? 'checked' : '') %> type="checkbox">
                                <span class="font-body-sm text-body-sm text-on-surface"><%= label %></span>
                            </label>
                        <% }) %>
                    </div>
                </div>

                <div class="flex flex-col gap-space-xs">
                    <label class="font-label-sm text-label-sm text-on-surface" for="shift_status">Trạng thái</label>
                    <select class="bg-surface-container-low text-on-surface font-body-md text-body-md px-space-md py-space-sm rounded-xl outline-none focus:ring-2 focus:ring-primary-container" id="shift_status" name="status">
                        <option value="1" <%= !formFeedback || formFeedback.values.status === '1' ? 'selected' : '' %>>Đang hoạt động</option>
                        <option value="0" <%= formFeedback?.values?.status === '0' ? 'selected' : '' %>>Ngừng hoạt động</option>
                    </select>
                </div>

                <div class="flex items-center justify-end gap-space-sm pt-space-md border-t border-surface-container-high">
                    <button class="px-space-lg py-space-sm bg-surface-container-high hover:bg-surface-variant text-on-surface font-label-md text-label-md rounded-xl transition-colors" data-close-shift-modal type="button">
                        Hủy
                    </button>
                    <button class="flex items-center gap-space-xs px-space-lg py-space-sm bg-primary hover:bg-primary-container text-on-primary font-label-md text-label-md rounded-xl shadow-md transition-colors" type="submit">
                        <span class="material-symbols-outlined text-[18px]">save</span>
                        <span>Lưu ca làm việc</span>
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        const modal = document.getElementById('shift-modal');
        const form = document.getElementById('shift-form');
        const modalTitle = document.getElementById('shift-modal-title');
        const errorBox = document.getElementById('shift-form-error');
        const errorText = document.getElementById('shift-form-error-text');
        const shiftCodeInput = document.getElementById('shift_code');
        const shiftCodeHint = document.getElementById('shift-code-hint');
        const durationSummary = document.getElementById('shift-duration-summary');
        let createMode = <%= formFeedback?.mode === 'update' ? 'false' : 'true' %>;
        let codeSuggestionTimer = null;
        let codeSuggestionRequest = 0;
        let codeSuggestionController = null;

        const showError = (message) => {
            errorText.textContent = message;
            errorBox.classList.remove('hidden');
            errorBox.classList.add('flex');
        };

        const clearError = () => {
            errorText.textContent = '';
            errorBox.classList.add('hidden');
            errorBox.classList.remove('flex');
        };

        const updateDurationSummary = () => {
            const toMinutes = (value) => {
                if (!value || !/^([01]\d|2[0-3]):[0-5]\d$/.test(value)) return null;
                const [hours, minutes] = value.split(':').map(Number);
                return hours * 60 + minutes;
            };
            const values = ['morning_start', 'morning_end', 'afternoon_start', 'afternoon_end']
                .map((name) => toMinutes(form.querySelector(`[name="${name}"]`).value));

            if (values.some((value) => value === null)
                || values[1] <= values[0]
                || values[3] <= values[2]
                || values[2] <= values[1]) {
                durationSummary.textContent = 'Nhập khung giờ hợp lệ để xem tổng thời gian làm việc.';
                return;
            }

            const dailyMinutes = (values[1] - values[0]) + (values[3] - values[2]);
            const workdayCount = form.querySelectorAll('[name="workdays"]:checked').length;
            const formatDuration = (minutes) => {
                const hours = Math.floor(minutes / 60);
                const remainingMinutes = minutes % 60;
                return remainingMinutes ? `${hours} giờ ${remainingMinutes} phút` : `${hours} giờ`;
            };

            durationSummary.textContent = `Thời gian làm việc: ${formatDuration(dailyMinutes)}/ngày · ${formatDuration(dailyMinutes * workdayCount)}/tuần (${workdayCount} ngày).`;
        };

        const openModal = () => {
            modal.classList.remove('hidden');
            document.body.classList.add('shift-modal-open');
        };

        const closeModal = () => {
            modal.classList.add('hidden');
            document.body.classList.remove('shift-modal-open');
            clearError();
        };

        const setFieldValue = (name, value) => {
            const field = form.querySelector(`[name="${name}"]`);

            if (field) {
                field.value = value;
            }
        };

        const resetForm = () => {
            form.reset();
            form.action = '/admin/shifts/create';
            createMode = true;
            modalTitle.textContent = 'Thêm ca làm việc';
            setFieldValue('shift_code', '');
            setFieldValue('shift_name', '');
            setFieldValue('morning_start', '');
            setFieldValue('morning_end', '');
            setFieldValue('afternoon_start', '');
            setFieldValue('afternoon_end', '');
            setFieldValue('status', '1');
            window.clearTimeout(codeSuggestionTimer);
            codeSuggestionRequest += 1;
            codeSuggestionController?.abort();
            shiftCodeHint.textContent = 'Đang lấy mã ca chưa dùng...';
            clearError();

            // Mặc định chọn Thứ 2 - Thứ 7 giống ca hành chính
            form.querySelectorAll('[name="workdays"]').forEach((checkbox) => {
                checkbox.checked = checkbox.value !== '7';
            });
            updateDurationSummary();
            requestShiftCodeSuggestion();
        };

        document.getElementById('open-create-shift').addEventListener('click', () => {
            resetForm();
            openModal();
        });

        const searchInput = document.getElementById('shift-search');
        const clearSearch = document.getElementById('clear-shift-search');
        let searchTimeout;
        searchInput.addEventListener('input', () => {
            clearSearch.classList.toggle('hidden', !searchInput.value);
            window.clearTimeout(searchTimeout);
            searchTimeout = window.setTimeout(() => {
                searchInput.closest('form').submit();
            }, 500);
        });
        clearSearch.addEventListener('click', () => {
            searchInput.value = '';
            clearSearch.classList.add('hidden');
            searchInput.closest('form').submit();
        });

        document.querySelectorAll('[data-close-shift-modal]').forEach((button) => {
            button.addEventListener('click', closeModal);
        });

        form.querySelectorAll('[name="morning_start"], [name="morning_end"], [name="afternoon_start"], [name="afternoon_end"], [name="workdays"]')
            .forEach((field) => field.addEventListener('input', updateDurationSummary));
        form.querySelectorAll('[name="workdays"]').forEach((field) => {
            field.addEventListener('change', updateDurationSummary);
        });

        document.querySelectorAll('[data-edit-shift]').forEach((button) => {
            button.addEventListener('click', () => {
                const data = button.dataset;

                createMode = false;
                shiftCodeHint.textContent = 'Mã ca cố định, không thể chỉnh sửa.';
                form.action = `/admin/shifts/${data.id}/update`;
                modalTitle.textContent = 'Chỉnh sửa ca làm việc';

                setFieldValue('shift_code', data.code);
                setFieldValue('shift_name', data.name);
                setFieldValue('morning_start', data.morningStart);
                setFieldValue('morning_end', data.morningEnd);
                setFieldValue('afternoon_start', data.afternoonStart);
                setFieldValue('afternoon_end', data.afternoonEnd);
                setFieldValue('status', data.status);

                const selectedDays = (data.workdays || '').split(',').filter(Boolean);
                form.querySelectorAll('[name="workdays"]').forEach((checkbox) => {
                    checkbox.checked = selectedDays.includes(checkbox.value);
                });

                updateDurationSummary();
                clearError();
                openModal();
            });
        });

        const requestShiftCodeSuggestion = () => {
            window.clearTimeout(codeSuggestionTimer);
            codeSuggestionRequest += 1;
            const requestId = codeSuggestionRequest;
            codeSuggestionController?.abort();

            if (!createMode) return;

            shiftCodeInput.value = '';
            shiftCodeHint.textContent = 'Đang tìm mã ca chưa sử dụng...';
            codeSuggestionTimer = window.setTimeout(async () => {
                const controller = new AbortController();
                codeSuggestionController = controller;
                try {
                    const response = await fetch('/admin/shifts/suggest-code', {
                        headers: { Accept: 'application/json' },
                        signal: controller.signal
                    });
                    const payload = await response.json();
                    if (requestId !== codeSuggestionRequest || !createMode) return;
                    if (!response.ok || !payload.success) throw new Error(payload.message || 'Không thể tạo mã gợi ý.');
                    shiftCodeInput.value = payload.code;
                    shiftCodeHint.textContent = `Mã ${payload.code} được hệ thống tạo tự động và không thể chỉnh sửa.`;
                } catch (error) {
                    if (error.name === 'AbortError' || requestId !== codeSuggestionRequest) return;
                    shiftCodeHint.textContent = error.message || 'Không thể tạo mã gợi ý.';
                }
            }, 250);
        };

        document.addEventListener('keydown', (event) => {
            if (event.key === 'Escape' && !modal.classList.contains('hidden')) {
                closeModal();
            }
        });

        form.addEventListener('submit', (event) => {
            clearError();

            const morningStart = form.morning_start.value;
            const morningEnd = form.morning_end.value;
            const afternoonStart = form.afternoon_start.value;
            const afternoonEnd = form.afternoon_end.value;
            const hasWorkday = form.querySelector('[name="workdays"]:checked');

            if (morningStart && morningEnd && morningEnd <= morningStart) {
                event.preventDefault();
                showError('Giờ kết thúc buổi sáng phải sau giờ bắt đầu buổi sáng.');
                return;
            }

            if (afternoonStart && afternoonEnd && afternoonEnd <= afternoonStart) {
                event.preventDefault();
                showError('Giờ kết thúc buổi chiều phải sau giờ bắt đầu buổi chiều.');
                return;
            }

            if (morningEnd && afternoonStart && afternoonStart <= morningEnd) {
                event.preventDefault();
                showError('Giờ bắt đầu buổi chiều phải sau giờ kết thúc buổi sáng.');
                return;
            }

            if (!hasWorkday) {
                event.preventDefault();
                showError('Vui lòng chọn ít nhất một ngày làm việc trong tuần.');
            }
        });

        <% if (formFeedback) { %>
            openModal();
            updateDurationSummary();
            <% if (formFeedback.mode === 'update') { %>
                shiftCodeHint.textContent = 'Mã ca cố định, không thể chỉnh sửa.';
                document.getElementById('shift_name').focus();
            <% } else { %>
                document.getElementById('shift_code').focus();
            <% } %>
        <% } %>
    });
</script>

<script src="/js/shift-schedule-sync.js" defer></script>

<%- include("partials/adminFoot") %>
