
<!DOCTYPE html>
<html lang="vi" class="h-full">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Đăng nhập | ChronoTime</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined" rel="stylesheet">

    <script src="https://cdn.tailwindcss.com"></script>

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        primary: "#00288e",
                        "primary-container": "#1e40af",
                        secondary: "#006398",
                        background: "#f7f9fb",
                        "surface-low": "#f2f4f6"
                    },
                    fontFamily: {
                        inter: ["Inter", "sans-serif"]
                    }
                }
            }
        }
    </script>

    <style>
        * {
            font-family: Inter, sans-serif;
        }

        body {
            margin: 0;
            min-height: 100vh;
        }

        ::-webkit-scrollbar {
            display: none;
        }
    </style>
</head>

<body class="min-h-screen bg-background text-gray-900 flex flex-col">

    <!-- HEADER -->
    <header class="w-full bg-white/90 shadow-sm sticky top-0 z-40">
        <div class="px-6 h-16 flex items-center justify-between">

            <div class="flex items-center gap-3">
                <div class="w-9 h-9 rounded-xl bg-primary flex items-center justify-center">
                    <span class="material-symbols-outlined text-white">schedule</span>
                </div>

                <div class="flex flex-col">
                    <span class="font-bold text-primary text-lg">ChronoTime</span>
                    <span class="text-xs text-gray-500">Enterprise Attendance & HR</span>
                </div>
            </div>

            <div class="flex items-center gap-5">
                <div class="flex items-center gap-2 bg-gray-100 px-3 py-2 rounded-lg">
                    <span class="material-symbols-outlined text-gray-500 text-sm">language</span>
                    <span class="text-sm">Tiếng Việt</span>
                </div>

                <div class="hidden sm:flex items-center gap-2 text-sm text-gray-500">
                    <span class="material-symbols-outlined text-blue-500 text-sm">verified_user</span>
                    ISO 27001 Certified
                </div>
            </div>

        </div>
    </header>

    <!-- MAIN -->
    <main class="flex-1 flex items-center justify-center p-5 relative overflow-hidden">

        <div class="absolute inset-0 pointer-events-none opacity-30"
             style="background-image: radial-gradient(#c4c5d5 1px, transparent 1px); background-size: 24px 24px;">
        </div>

        <div class="w-full max-w-5xl relative z-10">

            <div class="bg-white rounded-2xl shadow-xl overflow-hidden grid grid-cols-1 lg:grid-cols-12 min-h-[640px]">

                <!-- LEFT PANEL -->
                <div class="lg:col-span-5 bg-gradient-to-br from-primary via-blue-800 to-slate-800 p-8 sm:p-10 text-white flex flex-col justify-between relative overflow-hidden">

                    <div class="absolute -right-20 -top-20 w-72 h-72 rounded-full bg-blue-400/20 blur-3xl"></div>
                    <div class="absolute -left-16 -bottom-16 w-80 h-80 rounded-full bg-white/10 blur-3xl"></div>

                    <div class="relative z-10 flex flex-col gap-6">

                        <div class="flex items-center gap-3">
                            <div class="w-10 h-10 rounded-xl bg-white/15 flex items-center justify-center">
                                <span class="material-symbols-outlined text-2xl">verified</span>
                            </div>

                            <div>
                                <span class="text-xs tracking-wider text-blue-200 block">
                                    CHRONOTIME ENTERPRISE SUITE
                                </span>
                                <span class="font-bold">ChronoTime Cloud v4.2</span>
                            </div>
                        </div>

                        <div class="mt-3">
                            <h2 class="text-2xl font-bold leading-tight">
                                Giải pháp Chấm công & Quản trị Nhân sự Thông minh
                            </h2>

                            <p class="text-sm text-blue-100 leading-relaxed mt-3">
                                Hợp nhất dữ liệu ca kíp, trích xuất bảng công thời gian thực
                                và quản lý hồ sơ nhân sự tập trung cho doanh nghiệp.
                            </p>
                        </div>

                        <!-- FEATURES -->
                        <div class="flex flex-col gap-4 mt-3">

                            <div class="flex gap-3 p-4 rounded-xl bg-white/10">
                                <div class="w-9 h-9 rounded-lg bg-blue-400/20 flex items-center justify-center shrink-0">
                                    <span class="material-symbols-outlined">face</span>
                                </div>

                                <div>
                                    <p class="font-semibold text-sm">Chấm công AI FaceID & GPS</p>
                                    <p class="text-xs text-blue-100 mt-1">
                                        Hỗ trợ xác thực và quản lý vị trí chấm công.
                                    </p>
                                </div>
                            </div>

                            <div class="flex gap-3 p-4 rounded-xl bg-white/10">
                                <div class="w-9 h-9 rounded-lg bg-blue-400/20 flex items-center justify-center shrink-0">
                                    <span class="material-symbols-outlined">assignment_turned_in</span>
                                </div>

                                <div>
                                    <p class="font-semibold text-sm">Quản lý đơn nghỉ phép</p>
                                    <p class="text-xs text-blue-100 mt-1">
                                        Theo dõi và quản lý quy trình phê duyệt.
                                    </p>
                                </div>
                            </div>

                            <div class="flex gap-3 p-4 rounded-xl bg-white/10">
                                <div class="w-9 h-9 rounded-lg bg-blue-400/20 flex items-center justify-center shrink-0">
                                    <span class="material-symbols-outlined">hub</span>
                                </div>

                                <div>
                                    <p class="font-semibold text-sm">Quản lý nhân sự tập trung</p>
                                    <p class="text-xs text-blue-100 mt-1">
                                        Đồng bộ thông tin nhân viên và dữ liệu chấm công.
                                    </p>
                                </div>
                            </div>

                        </div>
                    </div>

                    <!-- BOTTOM LEFT -->
                    <div class="relative z-10 mt-8">

                        <div class="grid grid-cols-2 gap-3">

                            <div class="p-4 rounded-xl bg-white/10">
                                <span class="text-2xl font-bold block">500+</span>
                                <span class="text-xs text-blue-200">Doanh nghiệp tin dùng</span>
                            </div>

                            <div class="p-4 rounded-xl bg-white/10">
                                <span class="text-2xl font-bold text-cyan-300 block">99.98%</span>
                                <span class="text-xs text-blue-200">SLA Uptime Cloud</span>
                            </div>

                        </div>

                        <div class="mt-4 p-4 rounded-xl bg-white/10 flex items-center gap-3">
                            <div class="w-10 h-10 rounded-full bg-blue-200/20 flex items-center justify-center shrink-0">
                                <span class="material-symbols-outlined">person</span>
                            </div>

                            <div class="min-w-0">
                                <p class="text-xs italic text-blue-50">
                                    "ChronoTime giúp quản lý thời gian làm việc và nhân sự hiệu quả hơn."
                                </p>
                                <span class="text-xs text-blue-200 font-semibold">
                                    ChronoTime Enterprise
                                </span>
                            </div>
                        </div>

                        <div class="flex justify-between text-xs text-blue-200 mt-5">
                            <span>ISO/IEC 27001:2022</span>
                            <span>AES-256 Encryption</span>
                        </div>

                    </div>
                </div>

                <!-- RIGHT PANEL -->
                <div class="lg:col-span-7 bg-white p-8 sm:p-12 flex flex-col justify-between">

                    <div class="flex flex-col gap-8">

                        <!-- STATUS -->
                        <div class="flex items-center justify-between flex-wrap gap-3">

                            <div class="flex items-center gap-2">
                                <span class="w-2.5 h-2.5 rounded-full bg-green-500 animate-pulse"></span>
                                <span class="text-xs text-gray-500">
                                    Cổng truy cập Doanh nghiệp an toàn
                                </span>
                            </div>

                            <div class="px-4 py-2 bg-blue-50 rounded-lg text-sm text-primary font-semibold">
                                Đăng nhập
                            </div>

                        </div>

                        <!-- LOGIN TITLE -->
                        <div>
                            <h1 class="text-2xl font-bold text-gray-900">
                                Chào mừng trở lại
                            </h1>

                            <p class="text-sm text-gray-500 mt-2">
                                Nhập thông tin tài khoản để tiếp tục sử dụng hệ thống.
                            </p>
                        </div>

                        <!-- ERROR MESSAGE -->
                        <% if (typeof error !== "undefined" && error) { %>
                            <div class="flex items-center gap-2 p-3 rounded-xl bg-red-50 border border-red-200 text-red-600 text-sm">
                                <span class="material-symbols-outlined text-lg">error</span>
                                <span><%= error %></span>
                            </div>
                        <% } %>

                        <!-- LOGIN FORM -->
                        <form action="/login" method="POST" class="flex flex-col gap-5">

                            <!-- USERNAME -->
                            <div class="flex flex-col gap-2">

                                <label for="login-identifier" class="text-sm font-semibold text-gray-700">
                                    Tên đăng nhập hoặc mã nhân viên
                                </label>

                                <div class="flex items-center rounded-xl bg-gray-100 px-4 py-3 focus-within:bg-white focus-within:ring-2 focus-within:ring-primary">

                                    <span class="material-symbols-outlined text-gray-400 mr-3">
                                        badge
                                    </span>

                                    <input
                                        class="w-full bg-transparent text-sm text-gray-900 placeholder:text-gray-400 focus:outline-none"
                                        id="login-identifier"
                                        name="username"
                                        placeholder="Nhập tên đăng nhập"
                                        type="text"
                                        autocomplete="username"
                                        required
                                    >

                                </div>
                            </div>

                            <!-- PASSWORD -->
                            <div class="flex flex-col gap-2">

                                <div class="flex justify-between items-center">

                                    <label for="login-password" class="text-sm font-semibold text-gray-700">
                                        Mật khẩu
                                    </label>

                                </div>

                                <div class="flex items-center rounded-xl bg-gray-100 px-4 py-3 focus-within:bg-white focus-within:ring-2 focus-within:ring-primary">

                                    <span class="material-symbols-outlined text-gray-400 mr-3">
                                        lock
                                    </span>

                                    <input
                                        class="w-full bg-transparent text-sm text-gray-900 placeholder:text-gray-400 focus:outline-none"
                                        id="login-password"
                                        name="password"
                                        placeholder="Nhập mật khẩu"
                                        type="password"
                                        autocomplete="current-password"
                                        required
                                    >

                                    <button
                                        type="button"
                                        onclick="togglePasswordVisibility()"
                                        class="text-gray-400 hover:text-gray-700"
                                    >
                                        <span id="password-icon" class="material-symbols-outlined">
                                            visibility
                                        </span>
                                    </button>

                                </div>
                            </div>

                            <!-- REMEMBER -->
                            <div class="flex items-center justify-between flex-wrap gap-3">

                                <label class="flex items-center gap-2 text-sm text-gray-600 cursor-pointer">
                                    <input
                                        type="checkbox"
                                        name="remember"
                                        class="w-4 h-4 accent-primary"
                                    >
                                    Ghi nhớ đăng nhập
                                </label>

                            </div>

                            <!-- BUTTON -->
                            <button
                                type="submit"
                                class="mt-2 w-full py-3 px-6 rounded-xl bg-primary-container hover:bg-primary text-white font-semibold transition-all shadow-md flex items-center justify-center gap-2"
                            >
                                <span>Đăng nhập vào hệ thống</span>
                                <span class="material-symbols-outlined text-xl">
                                    arrow_forward
                                </span>
                            </button>

                        </form>

                    </div>

                    <!-- FOOTER RIGHT -->
                    <div class="mt-10 pt-5 border-t border-gray-200 flex flex-col gap-3 text-xs text-gray-500">

                        <div class="flex items-center gap-2">
                            <span class="material-symbols-outlined text-blue-500">
                                support_agent
                            </span>
                            <span>Hỗ trợ hệ thống quản lý chấm công</span>
                        </div>

                        <div class="flex flex-wrap gap-4">
                            <span class="flex items-center gap-1">
                                <span class="material-symbols-outlined text-sm">security</span>
                                Bảo mật dữ liệu
                            </span>

                            <span class="flex items-center gap-1">
                                <span class="material-symbols-outlined text-sm">lock</span>
                                256-bit TLS Encrypted
                            </span>
                        </div>

                    </div>

                </div>

            </div>
        </div>
    </main>

    <!-- FOOTER -->
    <footer class="w-full bg-white/80 py-4 px-6">
        <div class="flex flex-col sm:flex-row items-center justify-between gap-3 text-xs text-gray-500">

            <div class="flex items-center gap-2">
                <span class="w-2 h-2 rounded-full bg-green-500"></span>
                <span class="font-semibold text-gray-700">ChronoTime Cloud v4.2</span>
                <span>•</span>
                <span>Hệ thống quản lý chấm công nhân sự</span>
            </div>

            <span>© 2026 ChronoTime</span>

        </div>
    </footer>

    <script>
        function togglePasswordVisibility() {
            const password = document.getElementById("login-password");
            const icon = document.getElementById("password-icon");

            if (password.type === "password") {
                password.type = "text";
                icon.textContent = "visibility_off";
            } else {
                password.type = "password";
                icon.textContent = "visibility";
            }
        }
    </script>

</body>
</html>
