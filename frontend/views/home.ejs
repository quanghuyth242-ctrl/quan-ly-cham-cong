<div class="bg-surface-container-lowest p-space-xl rounded-xl shadow-sm flex flex-col gap-space-md">
<div>
<h3 class="font-headline-sm text-headline-sm text-primary font-semibold">Trạng thái thiết bị chấm công</h3>
<p class="font-body-sm text-body-sm text-on-surface-variant mt-space-xs">Theo dõi tín hiệu heartbeat và thời điểm kết nối gần nhất của thiết bị.</p>
</div>
<a href="/admin/devices" class="inline-flex w-fit items-center gap-space-sm px-space-md py-space-sm bg-primary hover:bg-primary-container text-on-primary rounded-xl font-label-md text-label-md transition-colors">
<span class="material-symbols-outlined text-[20px]">devices</span>
<span>Xem trạng thái thiết bị</span>
</a>
</div>
</aside>
</div>
<div id="detailModal" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/40 p-4">
<div class="bg-surface-container-lowest rounded-xl shadow-xl w-full max-w-3xl max-h-[85vh] flex flex-col">
<div class="flex items-center justify-between px-6 py-4 border-b border-surface-container">
<h3 id="detailTitle" class="font-headline-sm text-headline-sm text-on-surface font-semibold"></h3>
<button id="detailClose" type="button" class="p-1 rounded-lg hover:bg-surface-container-low text-on-surface-variant" aria-label="Đóng"><span class="material-symbols-outlined">close</span></button>
</div>
<div class="overflow-auto"><table class="w-full text-left"><thead class="bg-surface-container-low"><tr class="text-on-surface-variant font-label-sm text-label-sm uppercase"><th class="px-6 py-3">Nhân viên</th><th class="px-3 py-3">Phòng ban</th><th class="px-3 py-3">Vào</th><th class="px-3 py-3">Ra</th><th class="px-6 py-3">Trạng thái</th></tr></thead><tbody id="detailBody"></tbody></table></div>
<div class="px-6 py-3 border-t border-surface-container text-right"><a href="/admin/attendance" class="font-label-md text-label-md text-primary font-semibold">Mở bảng chấm công</a></div>
</div></div>
<div id="toastBox" class="fixed top-20 right-6 z-50 flex flex-col gap-2 pointer-events-none"></div>
<div id="overview-data" hidden data-json="<%= JSON.stringify(overviewData) %>"></div>
<script>
(() => {
    const $ = (id) => document.getElementById(id);
    const esc = (v) => String(v ?? '').replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#039;' }[c]));
    const hm = (v) => { const d = v ? new Date(v) : null; return d && !isNaN(d) ? d.toLocaleTimeString('vi-VN', { hour: '2-digit', minute: '2-digit' }) : '--:--'; };
    const src = { gps: 'GPS Mobile', face: 'Nhận diện khuôn mặt', device: 'Thiết bị chấm công', manual: 'Chấm công thủ công' };
    const names = { leave: 'Đơn xin nghỉ phép', explanation: 'Đơn giải trình', overtime: 'Đơn xin tăng ca', business_trip: 'Đơn xin công tác', resignation: 'Đơn nghỉ việc' };

    const renderRows = (rows) => {
        const body = document.querySelector('section.lg\\:col-span-8 table tbody');
        if (!body) return;
        body.innerHTML = rows.length ? rows.map((r) => {
            const bad = r.late || r.early;
            const cls = !r.check_in ? 'bg-surface-container-high text-on-surface-variant' : bad ? 'bg-error-container text-on-error-container' : r.overtime ? 'bg-primary-fixed text-on-primary-fixed' : 'bg-secondary-fixed text-on-secondary-fixed';
            return `<tr class="hover:bg-surface-container-low/70 transition-colors">
<td class="py-space-md px-space-lg"><div class="flex items-center gap-space-md"><div class="w-9 h-9 rounded-full bg-primary-fixed text-on-primary-fixed font-semibold flex items-center justify-center text-sm shrink-0">${esc(r.initials)}</div><div class="flex flex-col min-w-0"><span class="font-label-md text-label-md text-on-surface font-semibold truncate">${esc(r.full_name)}</span><span class="font-data-mono text-[11px] text-on-surface-variant">${esc(r.employee_code)}${r.department ? ' • ' + esc(r.department) : ''}</span></div></div></td>
<td class="py-space-md px-space-md font-data-mono text-data-mono font-semibold ${r.late ? 'text-error' : 'text-primary'}">${hm(r.check_in)}</td>
<td class="py-space-md px-space-md font-data-mono text-data-mono ${r.early ? 'text-error font-semibold' : 'text-on-surface-variant'}">${hm(r.check_out)}</td>
<td class="py-space-md px-space-md"><span class="font-body-sm text-body-sm">${esc(src[r.record_source] || 'Chưa xác định')}</span></td>
<td class="py-space-md px-space-md"><span class="font-data-mono text-[11px] text-on-surface-variant">${r.check_in_latitude != null ? esc(r.check_in_latitude) + ', ' + esc(r.check_in_longitude) : 'Không có vị trí'}</span></td>
<td class="py-space-md px-space-md"><span class="inline-flex items-center gap-1.5 px-space-sm py-0.5 rounded-full ${cls} text-[11px] font-semibold"><span class="w-1.5 h-1.5 rounded-full ${bad ? 'bg-error' : 'bg-secondary'}"></span>${esc(r.displayStatus)}</span></td>
<td class="py-space-md px-space-lg text-right"><a class="p-space-xs text-on-surface-variant hover:text-primary" href="/admin/attendance" title="Mở bảng chấm công"><span class="material-symbols-outlined text-[18px]">visibility</span></a></td></tr>`;
        }).join('') : '<tr><td class="py-space-lg px-space-lg text-on-surface-variant" colspan="7">Chưa có dữ liệu chấm công hôm nay.</td></tr>';
    };

    const renderPending = (list) => {
        const h = Array.from(document.querySelectorAll('h3')).find((n) => n.textContent.includes('Cần Xử Lý Gấp'));
        const box = h && h.closest('.bg-surface-container-lowest');
        if (!box) return;
        const badge = box.querySelector('.bg-error-container');
        if (badge) badge.textContent = `${list.length} Đơn`;
        const wrap = box.querySelector('.flex.flex-col.gap-space-md');
        if (wrap) wrap.innerHTML = list.length ? list.map((q) => `<div class="p-space-md bg-surface-container-low rounded-xl flex flex-col gap-space-xs"><div class="flex items-center justify-between"><span class="font-label-md text-label-md text-on-surface font-semibold">${esc(names[q.request_type] || 'Đơn chờ xử lý')}</span><span class="font-data-mono text-[11px] text-on-surface-variant">${esc(q.created_time || '')}</span></div><p class="font-body-sm text-body-sm text-on-surface-variant"><strong>${esc(q.full_name)}</strong>${q.department ? ' (' + esc(q.department) + ')' : ''}${q.reason ? ' - ' + esc(q.reason) : ''}</p><div class="flex justify-end mt-space-xs"><a class="px-space-md py-1 bg-primary hover:bg-primary-container text-on-primary text-label-sm font-label-sm rounded-lg" href="/admin/requests">Xử lý</a></div></div>`).join('') : '<p class="p-space-md font-body-sm text-body-sm text-on-surface-variant">Không có đơn chờ xử lý.</p>';
        if ($('pendingText')) $('pendingText').textContent = `${list.length} đơn chờ duyệt`;
    };

    const renderWeek = (d) => {
        const w = d.weeklyRates || [], svg = $('weekChart');
        if (!svg || !w.length) return;
        const dm = (s) => s.slice(8, 10) + '/' + s.slice(5, 7);
        $('weekRange').textContent = `Từ ${dm(w[0].date)} đến ${dm(w[w.length - 1].date)}`;
        const past = w.filter((x) => x.date <= d.todayDate);
        const avg = past.length ? Math.round(past.reduce((a, x) => a + x.rate, 0) / past.length * 10) / 10 : 0;
        $('weekAvg').textContent = `TB: ${avg}%`;
        const t = w.find((x) => x.date === d.todayDate);
        $('weekNote').textContent = t ? `Hôm nay: ${t.rate}%` : 'Hôm nay';
        svg.innerHTML = [20, 60].map((y) => `<line class="text-surface-container" stroke="currentColor" stroke-dasharray="3 3" x1="0" x2="320" y1="${y}" y2="${y}"/>`).join('') + '<line class="text-surface-container" stroke="currentColor" x1="0" x2="320" y1="100" y2="100"/>' + w.map((x, i) => {
            const cx = 37 + i * 65, future = x.date > d.todayDate, isToday = x.date === d.todayDate;
            const h = future ? 50 : Math.max(2, Math.round(x.rate * 0.8)), y = 100 - h;
            return `<rect class="${future ? 'fill-surface-container' : isToday ? 'fill-primary' : 'fill-primary-container/70'}" x="${cx - 17}" y="${y}" width="34" height="${h}" rx="4"/><text class="${isToday ? 'fill-primary font-bold' : 'fill-on-surface-variant font-semibold'} text-[11px]" text-anchor="middle" x="${cx}" y="${y - 6}">${future ? '--' : x.rate + '%'}</text><text class="fill-on-surface-variant text-[12px]" text-anchor="middle" x="${cx}" y="118">${esc(x.label)}${isToday ? ' (Nay)' : ''}</text>`;
        }).join('');
    };

    const seen = new Map();
    let firstLoad = true;
    const toast = (r, act) => {
        const isIn = act === 'in', bad = isIn ? r.late : r.early, el = document.createElement('div');
        const note = isIn ? (r.late ? `Đi muộn ${r.late_minutes} phút` : 'Đúng giờ') : (r.early ? `Về sớm ${r.early_minutes} phút` : r.overtime ? `Tăng ca ${r.overtime_minutes} phút` : r.stayed_late ? `Ra muộn ${r.stayed_late_minutes} phút (không có đơn tăng ca)` : 'Về đúng giờ');
        el.className = 'pointer-events-auto flex items-center gap-3 rounded-xl bg-surface-container-lowest px-4 py-3 shadow-lg border-l-4 ' + (bad ? 'border-error' : 'border-secondary');
        el.innerHTML = `<span class="material-symbols-outlined ${bad ? 'text-error' : 'text-secondary'}">${isIn ? 'login' : 'logout'}</span><div><p class="font-label-md text-label-md text-on-surface font-semibold">${esc(r.full_name)} vừa ${isIn ? 'check-in' : 'check-out'} lúc ${hm(isIn ? r.check_in : r.check_out)}</p><p class="font-body-sm text-body-sm ${bad ? 'text-error' : 'text-on-surface-variant'}">${note}</p></div>`;
        $('toastBox').appendChild(el);
        setTimeout(() => el.remove(), 6000);
    };
    const watchRows = (rows) => {
        rows.forEach((r) => {
            const prev = seen.get(r.id), cin = String(r.check_in || ''), cout = String(r.check_out || '');
            if (!firstLoad) {
                if (cin && (!prev || prev.cin !== cin)) toast(r, 'in');
                else if (cout && prev && prev.cout !== cout) toast(r, 'out');
            }
            seen.set(r.id, { cin, cout });
        });
        firstLoad = false;
    };

    const kinds = {
        present: ['Nhân viên có mặt hôm nay', (r) => r.has_check_in],
        ontime: ['Nhân viên đúng giờ', (r) => r.has_check_in && !r.late && !r.early],
        late: ['Nhân viên đi muộn / về sớm', (r) => r.late || r.early],
        overtime: ['Nhân viên tăng ca (có đơn được duyệt)', (r) => r.overtime],
        absent: ['Nhân viên vắng hoặc nghỉ', (r) => !r.has_check_in && (r.absent || r.on_leave)]
    };
    let openKind = null, lastData = window.__lastData = null;
    const renderDetail = () => {
        if (!openKind || !lastData) return;
        const [title, test] = kinds[openKind];
        const list = (lastData.people || []).filter(test);
        const msg = !Array.isArray(lastData.people) ? 'Server chưa gửi danh sách nhân viên. Hãy chép đè notificationService.js rồi chạy lại app.' : !lastData.activeEmployees ? 'Chưa đọc được nhân viên đang hoạt động. Xem cửa sổ PowerShell có dòng "Không tải được dữ liệu tổng quan" không.' : 'Không có nhân viên nào trong nhóm này.';
        $('detailTitle').textContent = `${title} (${list.length})`;
        $('detailBody').innerHTML = list.length ? list.map((r) => `<tr class="border-b border-surface-container-low"><td class="px-6 py-3"><div class="font-label-md text-label-md text-on-surface font-semibold">${esc(r.full_name)}</div><div class="font-data-mono text-[11px] text-on-surface-variant">${esc(r.employee_code)}</div></td><td class="px-3 py-3 font-body-sm text-body-sm">${esc(r.department || '-')}</td><td class="px-3 py-3 font-data-mono text-data-mono ${r.late ? 'text-error' : ''}">${hm(r.check_in)}</td><td class="px-3 py-3 font-data-mono text-data-mono ${r.early ? 'text-error' : 'text-on-surface-variant'}">${hm(r.check_out)}</td><td class="px-6 py-3 font-body-sm text-body-sm ${r.late || r.early || r.absent ? 'text-error' : ''}">${esc(r.displayStatus)}</td></tr>`).join('') : `<tr><td colspan="5" class="px-6 py-6 text-on-surface-variant">${esc(msg)}</td></tr>`;
    };
    const showDetail = (k) => { openKind = k; renderDetail(); $('detailModal').classList.replace('hidden', 'flex'); };
    const hideDetail = () => { openKind = null; $('detailModal').classList.replace('flex', 'hidden'); };
    document.querySelectorAll('[data-detail]').forEach((el) => {
        el.addEventListener('click', (e) => { e.stopPropagation(); showDetail(el.dataset.detail); });
        el.addEventListener('keydown', (e) => { if (e.key === 'Enter') { e.stopPropagation(); showDetail(el.dataset.detail); } });
    });
    $('detailClose').addEventListener('click', hideDetail);
    $('detailModal').addEventListener('click', (e) => { if (e.target.id === 'detailModal') hideDetail(); });
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') hideDetail(); });

    const render = (d) => {
        lastData = d; renderDetail();
        watchRows(d.liveRows || []);
        d.absentOrLeave = (d.leaveEmployees || 0) + (d.absentEmployees || 0);
        d.liveCount = (d.liveRows || []).length;
        document.querySelectorAll('[data-k]').forEach((el) => { const v = d[el.dataset.k]; if (v != null) el.textContent = v; });
        renderRows(d.liveRows || []); renderPending(d.pendingRequests || []); renderWeek(d);
        $('lastUpdated').textContent = (live ? '● Trực tiếp • ' : '○ Đang kết nối lại • ') + new Date().toLocaleTimeString('vi-VN');
    };

    let busy = false, live = false;
    const load = async () => {
        if (busy) return; busy = true;
        try {
            const r = await fetch('/api/overview', { headers: { Accept: 'application/json' }, cache: 'no-store' });
            const j = await r.json();
            if (r.ok && j.success) render(j.data);
        } catch (e) { /* giữ dữ liệu cũ */ } finally { busy = false; }
    };

    const tick = () => {
        const n = new Date();
        $('clockTime').textContent = n.toLocaleTimeString('vi-VN');
        $('clockDate').textContent = '• ' + n.toLocaleDateString('vi-VN', { weekday: 'long', day: '2-digit', month: '2-digit', year: 'numeric' });
    };

    document.addEventListener('DOMContentLoaded', () => {
        render(JSON.parse($('overview-data').dataset.json));
        tick(); setInterval(tick, 1000);
        const es = new EventSource('/api/overview/stream');
        es.addEventListener('attendance', load);
        es.onopen = () => { live = true; load(); };
        es.onerror = () => { live = false; };
        setInterval(load, 10000); // dự phòng khi mất kết nối realtime
        document.addEventListener('visibilitychange', () => { if (!document.hidden) load(); });
    });
})();

</script>
<!-- Interactive script for demo interactions without styling pollution -->
<script>
    document.addEventListener('DOMContentLoaded', () => {
      // Small interactivity for quick buttons
      const actionBtns = document.querySelectorAll('button');
      actionBtns.forEach(btn => {
        btn.addEventListener('click', (e) => {
          if (btn.innerText.includes('Duyệt')) {
            const row = btn.closest('.p-space-md, tr');
            btn.classList.remove('bg-primary', 'hover:bg-primary-container');
            btn.classList.add('bg-surface-container-high', 'text-on-surface-variant');
            btn.innerText = 'Đã duyệt';
            btn.disabled = true;
          }
        });
      });
    });
  </script>
<script>
    document.addEventListener('DOMContentLoaded', () => {
      const menuButton = document.getElementById('user-menu-button');
      const menuDropdown = document.getElementById('user-menu-dropdown');

      if (!menuButton || !menuDropdown) return;

      const closeMenu = () => {
        menuDropdown.classList.add('hidden');
        menuButton.setAttribute('aria-expanded', 'false');
      };

      menuButton.addEventListener('click', (event) => {
        event.stopPropagation();
        const isOpen = !menuDropdown.classList.contains('hidden');
        menuDropdown.classList.toggle('hidden', isOpen);
        menuButton.setAttribute('aria-expanded', String(!isOpen));
      });

      document.addEventListener('click', (event) => {
        if (!menuDropdown.contains(event.target) && !menuButton.contains(event.target)) {
          closeMenu();
        }
      });

      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') {
          closeMenu();
        }
      });
    });
  </script>
</div></main></div></body></html>