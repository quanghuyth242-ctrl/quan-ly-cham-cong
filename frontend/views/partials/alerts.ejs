<% if (locals.success) { %>
    <div data-auto-dismiss class="flex items-start gap-space-sm p-space-md rounded-xl bg-green-50 border border-green-200 text-green-700 text-body-md">
        <span class="material-symbols-outlined text-[20px]">check_circle</span>
        <span><%= success %></span>
    </div>
<% } %>

<% if (locals.error) { %>
    <div data-auto-dismiss class="flex items-start gap-space-sm p-space-md rounded-xl bg-error-container/60 border border-error/30 text-on-error-container text-body-md">
        <span class="material-symbols-outlined text-[20px]">error</span>
        <span><%= error %></span>
    </div>
<% } %>
