        </div>
    </main>
</div>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        const sidebar = document.getElementById('admin-sidebar');
        const overlay = document.getElementById('sidebar-overlay');
        const toggle = document.getElementById('sidebar-toggle');
        const userMenu = document.getElementById('admin-user-menu');
        const userMenuButton = document.getElementById('admin-user-menu-button');
        const userMenuDropdown = document.getElementById('admin-user-menu-dropdown');

        const closeSidebar = () => {
            sidebar.classList.add('hidden');
            sidebar.classList.remove('flex');
            overlay.classList.add('hidden');
        };

        if (toggle) {
            toggle.addEventListener('click', () => {
                const isHidden = sidebar.classList.contains('hidden');
                sidebar.classList.toggle('hidden', !isHidden);
                sidebar.classList.toggle('flex', isHidden);
                overlay.classList.toggle('hidden', !isHidden);
            });
        }

        if (overlay) {
            overlay.addEventListener('click', closeSidebar);
        }

        const setUserMenuOpen = (isOpen) => {
            userMenuDropdown.classList.toggle('hidden', !isOpen);
            userMenuButton.setAttribute('aria-expanded', String(isOpen));
        };

        if (userMenu && userMenuButton && userMenuDropdown) {
            userMenuButton.addEventListener('click', () => {
                setUserMenuOpen(userMenuDropdown.classList.contains('hidden'));
            });

            document.addEventListener('click', (event) => {
                if (!userMenu.contains(event.target)) {
                    setUserMenuOpen(false);
                }
            });

            document.addEventListener('keydown', (event) => {
                if (event.key === 'Escape') {
                    setUserMenuOpen(false);
                }
            });
        }

        // Tự động ẩn thông báo sau 6 giây
        document.querySelectorAll('[data-auto-dismiss]').forEach((element) => {
            window.setTimeout(() => {
                element.style.transition = 'opacity 0.3s ease';
                element.style.opacity = '0';
                window.setTimeout(() => element.remove(), 300);
            }, 6000);
        });
    });
</script>
</body>
</html>
