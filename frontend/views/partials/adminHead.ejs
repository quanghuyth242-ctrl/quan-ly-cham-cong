<%
    const navItems = [
        { key: "dashboard", href: "/", icon: "dashboard", label: "Tổng quan" },
        { key: "attendance", href: "/admin/attendance", icon: "table_chart", label: "Bảng chấm công" },
        { key: "shifts", href: "/admin/shifts", icon: "calendar_month", label: "Quản lý ca & Lịch trực" },
        { key: "assignments", href: "/admin/shift-assignments", icon: "assignment_ind", label: "Phân ca nhân viên" },
        { key: "leave", href: "/admin/requests", icon: "event_note", label: "Đơn nghỉ & Giải trình" },
        { key: "reports", href: "#", icon: "bar_chart", label: "Báo cáo & Thống kê" },
        { key: "settings", href: "#", icon: "tune", label: "Cài đặt & Quy định" }
    ];

    const currentUser = locals.user || null;
    const roleLabels = { admin: "Quản trị viên", employee: "Nhân viên" };
    const userName = currentUser && currentUser.username ? currentUser.username : "Quản trị viên";
    const userRole = currentUser && roleLabels[currentUser.role] ? roleLabels[currentUser.role] : "Quản trị viên";
    const activePageKey = locals.activePage || "";
%>
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= pageTitle %> | ChronoTime</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet">

    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    colors: {
                        primary: "#00288e",
                        "primary-container": "#1e40af",
                        "on-primary": "#ffffff",
                        "on-primary-container": "#a8b8ff",
                        "primary-fixed": "#dde1ff",
                        "secondary": "#006398",
                        "secondary-fixed": "#cce5ff",
                        "on-secondary-fixed": "#001d31",
                        surface: "#f7f9fb",
                        "surface-container-lowest": "#ffffff",
                        "surface-container-low": "#f2f4f6",
                        "surface-container": "#eceef0",
                        "surface-container-high": "#e6e8ea",
                        "on-surface": "#191c1e",
                        "on-surface-variant": "#444653",
                        outline: "#757684",
                        "outline-variant": "#c4c5d5",
                        error: "#ba1a1a",
                        "error-container": "#ffdad6",
                        "on-error-container": "#93000a"
                    },
                    fontFamily: {
                        "headline-xl": ["Inter", "sans-serif"],
                        "headline-lg": ["Inter", "sans-serif"],
                        "headline-md": ["Inter", "sans-serif"],
                        "headline-sm": ["Inter", "sans-serif"],
                        "body-lg": ["Inter", "sans-serif"],
                        "body-md": ["Inter", "sans-serif"],
                        "body-sm": ["Inter", "sans-serif"],
                        "label-md": ["Inter", "sans-serif"],
                        "label-sm": ["Inter", "sans-serif"],
                        "data-mono": ["Inter", "sans-serif"]
                    },
                    fontSize: {
                        "headline-xl": ["32px", { lineHeight: "40px", letterSpacing: "-0.02em", fontWeight: "700" }],
                        "headline-lg": ["24px", { lineHeight: "32px", letterSpacing: "-0.015em", fontWeight: "600" }],
                        "headline-md": ["20px", { lineHeight: "28px", letterSpacing: "-0.01em", fontWeight: "600" }],
                        "headline-sm": ["16px", { lineHeight: "24px", letterSpacing: "-0.005em", fontWeight: "600" }],
                        "body-lg": ["16px", { lineHeight: "24px", fontWeight: "400" }],
                        "body-md": ["14px", { lineHeight: "20px", fontWeight: "400" }],
                        "body-sm": ["12px", { lineHeight: "16px", fontWeight: "400" }],
                        "label-md": ["14px", { lineHeight: "20px", fontWeight: "500" }],
                        "label-sm": ["12px", { lineHeight: "16px", letterSpacing: "0.025em", fontWeight: "600" }],
                        "data-mono": ["13px", { lineHeight: "18px", letterSpacing: "-0.01em", fontWeight: "500" }]
                    },
                    spacing: {
                        "space-xs": "0.25rem",
                        "space-sm": "0.5rem",
                        "space-md": "0.75rem",
                        "space-lg": "1rem",
                        "space-xl": "1.5rem",
                        "space-2xl": "2rem"
                    },
                    borderRadius: {
                        DEFAULT: "0.125rem",
                        lg: "0.25rem",
                        xl: "0.5rem",
                        full: "0.75rem"
                    }
                }
            }
        };
    </script>

    <style>
        * { font-family: Inter, sans-serif; }
        body { margin: 0; overscroll-behavior: none; }
        ::-webkit-scrollbar { display: none; }
        .shift-modal-open { overflow: hidden; }
    </style>
</head>
<body class="bg-surface text-on-surface font-body-md text-body-md min-h-screen">

<div id="sidebar-overlay" class="fixed inset-0 bg-black/40 z-40 hidden md:hidden"></div>

<aside id="admin-sidebar" class="fixed left-0 top-0 h-full w-64 bg-surface-container-lowest border-r border-surface-container-high shadow-[0_1px_8px_rgba(0,0,0,0.04)] z-50 hidden md:flex flex-col justify-between">
    <div class="flex flex-col">
        <div class="h-16 px-space-lg flex items-center gap-space-sm bg-surface-container-lowest border-b border-surface-container-low">
            <div class="w-9 h-9 rounded-xl bg-primary flex items-center justify-center shrink-0">
                <span class="material-symbols-outlined text-on-primary text-[20px]">schedule</span>
            </div>
            <div class="flex flex-col min-w-0">
                <span class="font-headline-sm text-headline-sm text-primary leading-none">ChronoTime</span>
                <span class="font-body-sm text-body-sm text-on-surface-variant leading-none mt-space-xs">Quản lý chấm công</span>
            </div>
        </div>

        <nav aria-label="Điều hướng chính" class="flex flex-col gap-1.5 px-space-md pt-space-lg">
            <% navItems.forEach((item) => { %>
                <a href="<%= item.href %>" <%= activePageKey === item.key ? 'aria-current="page"' : '' %> class="group flex items-center gap-space-md px-space-md py-2.5 whitespace-nowrap rounded-xl transition-all duration-200 font-label-md text-label-md <%= activePageKey === item.key ? 'bg-primary-container text-on-primary shadow-[0_6px_14px_rgba(30,64,175,0.18)]' : 'text-on-surface-variant hover:bg-primary-fixed/60 hover:text-primary' %>">
                    <span class="material-symbols-outlined shrink-0 text-[20px] transition-transform duration-200 group-hover:scale-105"><%= item.icon %></span>
                    <span><%= item.label %></span>
                </a>
            <% }) %>
        </nav>
    </div>

    <div class="p-space-md flex flex-col gap-space-sm">
        <div class="p-space-md bg-surface-container-low rounded-xl flex items-center gap-space-md">
            <div class="w-8 h-8 rounded-full bg-primary flex items-center justify-center shrink-0">
                <span class="material-symbols-outlined text-on-primary text-[18px]">person</span>
            </div>
            <div class="flex flex-col min-w-0">
                <span class="font-label-sm text-label-sm text-on-surface truncate"><%= userName %></span>
                <span class="font-body-sm text-body-sm text-on-surface-variant truncate"><%= userRole %></span>
            </div>
        </div>

        <form action="/logout" method="POST">
            <button class="w-full flex items-center gap-space-sm p-space-md bg-surface-container-low hover:bg-error-container/40 text-on-surface-variant hover:text-error rounded-xl transition-colors font-label-md text-label-md" type="submit">
                <span class="material-symbols-outlined text-[20px]">logout</span>
                <span>Đăng xuất</span>
            </button>
        </form>
    </div>
</aside>

<div class="md:pl-64 min-h-screen flex flex-col">
    <header class="fixed top-0 left-0 md:left-64 right-0 h-16 bg-surface-container-lowest/90 backdrop-blur-xl shadow-[0_1px_8px_rgba(0,0,0,0.04)] z-30 px-space-lg md:px-space-xl flex items-center justify-between gap-space-lg">
        <div class="flex items-center gap-space-md md:gap-space-lg min-w-0">
            <button id="sidebar-toggle" class="md:hidden p-space-sm rounded-xl text-on-surface-variant hover:bg-surface-container-high transition-colors" type="button" aria-label="Mở menu">
                <span class="material-symbols-outlined">menu</span>
            </button>
            <div class="flex flex-col min-w-0">
                <span class="font-label-sm text-label-sm text-on-surface-variant uppercase tracking-wider hidden sm:block">Quản trị hệ thống</span>
                <h1 class="font-headline-sm text-headline-sm text-primary font-semibold truncate"><%= pageTitle %></h1>
            </div>
        </div>

        <div class="flex items-center gap-space-md shrink-0">
            <a href="/" class="hidden sm:flex items-center gap-space-xs bg-surface-container-low hover:bg-surface-container-high px-space-md py-space-sm rounded-xl text-on-surface-variant font-label-md text-label-md transition-colors">
                <span class="material-symbols-outlined text-[18px]">dashboard</span>
                <span>Tổng quan</span>
            </a>

            <div class="flex items-center gap-space-sm">
                <div class="w-8 h-8 rounded-full bg-primary flex items-center justify-center">
                    <span class="material-symbols-outlined text-on-primary text-[18px]">person</span>
                </div>
                <div class="hidden md:flex flex-col">
                    <span class="font-label-md text-label-md text-on-surface leading-tight"><%= userName %></span>
                    <span class="font-body-sm text-body-sm text-on-surface-variant leading-tight"><%= userRole %></span>
                </div>
            </div>
        </div>
    </header>

    <main class="flex-1 pt-16 px-space-lg md:px-space-xl pb-space-2xl">
        <div class="max-w-[1400px] mx-auto flex flex-col gap-space-xl pt-space-xl">
